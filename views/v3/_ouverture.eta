<% /* v3 · ouverture de l'accueil en plein cadre (docs/maquettes-v3, MQ-01 ; css/v3/v3.css § 6). Mêmes données que la v2
      (réglage « Ouverture », settings.hero) et même script (js/v2/site.js : data-ouverture…, À L'ARRÊT par défaut).
      Le cadre prend le format le plus large de la liste et l'écran, à 10 % près ; une photo de ce format, à 10 % près,
      le remplit (recadrée de 10 % au plus, autour de son point fort) ; une photo d'un autre format y est entière, sur le
      noir. Au bureau, l'en-tête et le cartel sont posés sur la photo (voile limité à leur bande) ; au téléphone, le cartel
      vient dessous. Avec une ouverture du téléphone (réglage hero_tel, des verticales de préférence), deux ouvertures :
      chacune n'est montrée (et chargée) que sur son appareil. La promesse (H1) suit la photo. */ %>
<% const tel = it.heroTel && it.heroTel.length ? it.heroTel : null; %>
<% if (tel) { %>
<%~ include('./_plein', { ...it, liste: it.hero, suffixe: '', cls: 'plein-zone--bureau', eager: false }) %>
<%~ include('./_plein', { ...it, liste: tel, suffixe: '-tel', cls: 'plein-zone--tel', eager: false }) %>
<% } else { %>
<%~ include('./_plein', { ...it, liste: it.hero, suffixe: '', cls: '', eager: true }) %>
<% } %>
<div class="wrap promesse"><h1 class="promesse-h1" id="acc-h1"><%= it.promise %></h1><p class="promesse-sous"><%= it.promiseSub %></p></div>
