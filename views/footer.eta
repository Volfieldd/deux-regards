<% const f = it.footerText || { photos: 'Photographies', noRepro: 'reproduction interdite', rights: 'Droits d’utilisation', rightsHref: '/droits' }; %>
<footer class="wrap mono">
  <span><%= it.siteName %><%= it.authorNames ? ' · ' + it.authorNames : '' %></span>
  <span><%= f.photos %> · <%= f.noRepro %> · <a href="<%= f.rightsHref %>"><%= f.rights %></a></span>
</footer>
