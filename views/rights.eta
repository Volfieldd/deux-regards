<% layout('./layout') %>
<% const r = it.r; %>
<header class="top wrap">
  <%~ include('./brand', it) %>
  <%~ include('./nav', it) %>
</header>
<main class="about wrap">
  <h1><%= r.title %></h1>
  <div class="prose">
<% it.paragraphs.forEach(p => { %>
    <p><%= p %></p>
<% }) %>
<% if (it.contact) { %>
    <p><%= r.contact %> <% if (it.contactHref) { %><a class="more" href="<%= it.contactHref %>"><%= it.contact %></a><% } else { %><%= it.contact %><% } %></p>
<% } %>
    <p><a class="more" href="<%= it.u('/droits/demande') %>"><%= it.t.licence.rightsLink %></a></p>
    <h2><%= r.audienceTitle %></h2>
    <p><%= r.audience %></p>
  </div>
</main>
<%~ include('./footer', it) %>
