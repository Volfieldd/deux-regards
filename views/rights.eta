<% layout('./layout') %>
<header class="top wrap">
  <%~ include('./brand', it) %>
  <nav class="eyebrow" aria-label="Navigation"><a href="/#series">Séries</a><a href="/#galerie">Galerie</a><a href="/a-propos">À propos</a></nav>
</header>
<main class="about wrap">
  <h1>Droits d’utilisation</h1>
  <div class="prose">
<% it.paragraphs.forEach(t => { %>
    <p><%= t %></p>
<% }) %>
<% if (it.contact) { %>
    <p>Contact : <% if (it.contactHref) { %><a class="more" href="<%= it.contactHref %>"><%= it.contact %></a><% } else { %><%= it.contact %><% } %></p>
<% } %>
  </div>
</main>
<%~ include('./footer', it) %>
