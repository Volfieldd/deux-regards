<% const b = it.brand || {}; %>
<% if (b.emblem && b.mode === 'embleme') { %>
<a class="brand brand-emblem" href="/"><span class="emblem" aria-hidden="true"></span><span class="wordmark"><span class="name"><%= it.siteName %></span><% if (b.subtitle) { %><span class="subtitle"><%= b.subtitle %></span><% } %></span></a>
<% } else { %>
<% const words = it.siteName.split(' '); const last = words.pop(); %>
<a class="brand" href="/"><%= words.join(' ') %><%= words.length ? ' ' : '' %><i><%= last %></i></a>
<% } %>
