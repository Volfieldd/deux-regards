<% /* Menu du site et sélecteur de langue. it.home : liens d'ancre de l'accueil ; it.current : page active. */ %>
<% const t = it.t; %>
<nav class="eyebrow site-nav" aria-label="<%= t.nav.label %>"><a href="<%= it.home ? '' : it.u('/') %>#series"><%= t.nav.series %></a><a href="<%= it.home ? '' : it.u('/') %>#galerie"><%= t.nav.gallery %></a><% if (it.mapPage) { %><a href="<%= it.u('/carte') %>"<%~ it.current === 'carte' ? ' aria-current="page"' : '' %>><%= t.nav.map %></a><% } %><a href="<%= it.u('/a-propos') %>"<%~ it.current === 'about' ? ' aria-current="page"' : '' %>><%= t.nav.about %></a><% if (it.searchPage) { %><a class="nav-search" href="<%= it.u('/recherche') %>"<%~ it.current === 'search' ? ' aria-current="page"' : '' %>><svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span class="nav-search-t"><%= t.nav.search %></span></a><% } %>
  <%~ include('./langs', it) %>
</nav>
