<% layout('./layout') %>
<% const b = it.brand; %>
<h1>Apparence</h1>
<p class="prose">Le thème change les couleurs et la typographie du site public ; l’admin garde son apparence. « Aperçu » ouvre le site avec un thème sans l’appliquer : vous seul le voyez, pendant une heure ou jusqu’à « Quitter l’aperçu ».</p>

<form class="form" method="post" action="/admin/apparence">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <fieldset class="panel">
    <legend>Thème</legend>
    <div class="themes">
<% Object.entries(it.THEMES).forEach(([id, t]) => { %>
      <div class="theme-card">
        <label class="inline"><input type="radio" name="theme" value="<%= id %>"<%~ id === it.themeId ? ' checked' : '' %>> <strong><%= t.label %></strong><%= id === it.themeId ? ' (actuel)' : '' %></label>
        <span class="swatch swatch-<%= id %>" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mono"><%= t.description %></span>
        <a class="more eyebrow" href="/?theme=<%= id %>" target="_blank" rel="noopener">Aperçu<span class="sr-only"> du thème <%= t.label %> (nouvel onglet)</span></a>
      </div>
<% }) %>
    </div>
  </fieldset>

  <fieldset class="panel form">
    <legend>Marque</legend>
<% Object.entries(it.BRAND_MODES).forEach(([k, label]) => { %>
    <label class="inline"><input type="radio" name="brand_mode" value="<%= k %>"<%~ b.mode === k ? ' checked' : '' %><%~ k === 'embleme' && !b.emblem ? ' disabled' : '' %>> <%= label %><%= k === 'embleme' && !b.emblem ? ' — envoyez d’abord un emblème' : '' %></label>
<% }) %>
    <label>Sous-titre sous le nom <span class="mono">ex. « Photography gallery » · 60 caractères</span><input name="subtitle" value="<%= b.subtitle || '' %>" maxlength="60"></label>
    <p class="mono">Le nom lui-même se règle dans <a href="/admin/reglages">Réglages</a>.</p>
  </fieldset>
  <p class="actions"><button class="btn" type="submit">Enregistrer l’apparence</button></p>
</form>

<section class="panel">
  <h2>Emblème</h2>
<% if (b.emblem) { %>
  <p><img class="emblem-preview" src="/brand/<%= b.emblem %>" alt="Emblème actuel"> <img class="favicon-preview" src="/brand/<%= b.favicon180 %>" alt="Icône d’onglet générée" width="64" height="64"></p>
  <form method="post" action="/admin/apparence/embleme/delete">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn ghost" type="submit">Retirer l’emblème</button>
  </form>
<% } else { %>
  <p>Aucun emblème : le nom du site s’affiche seul.</p>
<% } %>
  <form class="row" method="post" action="/admin/apparence/embleme" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label>Nouvel emblème <span class="mono">le dessin seul, sans le texte (le site écrit le nom) · PNG, WebP ou JPEG · trait sombre sur fond clair, clair sur fond sombre, ou détouré</span>
      <input type="file" name="emblem" accept="image/png,image/webp,image/jpeg" required></label>
    <button class="btn" type="submit">Envoyer</button>
  </form>
  <p class="mono">L’image est transformée en masque : sa couleur suit le thème (blanc sur la galerie noire, noir sur fond clair). Une icône d’onglet est générée.</p>
</section>
