<% layout('./layout') %>
<% const b = it.brand; const t = it.t; %>
<h1><%= t('Apparence') %></h1>
<%~ include('./_compositions', it) %>

<% if (!it.designSettings) { %>
<section class="panel" id="site-public" aria-labelledby="site-public-t">
  <h2 id="site-public-t"><%= t('Site public : v1, v2 ou v3') %></h2>
  <p class="mono"><%= t('La v2 est la nouvelle présentation du site public, issue de l’audit d’ergonomie. Elle couvre toutes les pages publiques, sauf les pages d’erreur et de connexion, qui gardent la présentation v1. L’administration ne change pas.') %></p>
  <p class="mono"><%= t('La v3 reprend les pages de la v2 et leur accessibilité, avec un autre dessin : la photo en plein cadre à l’accueil, l’en-tête posé dessus, des titres plus grands, des boutons sans cadre. Une page sans v2 s’affiche en v1, en v3 comme en v2.') %></p>
  <form class="form" method="post" action="/admin/apparence">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <fieldset>
      <legend><%= t('Version vue par les visiteurs') %></legend>
      <label class="inline"><input type="radio" name="site_public" value="v1"<%~ it.publicVersion === 'v1' ? ' checked' : '' %>> <strong>v1</strong> <span class="mono"><%= t('la présentation d’origine') %></span></label>
      <label class="inline"><input type="radio" name="site_public" value="v2"<%~ it.publicVersion === 'v2' ? ' checked' : '' %>> <strong>v2</strong> <span class="mono"><%= t('la nouvelle présentation') %></span></label>
      <label class="inline"><input type="radio" name="site_public" value="v3"<%~ it.publicVersion === 'v3' ? ' checked' : '' %>> <strong>v3</strong> <span class="mono"><%= t('la v2 redessinée, photo en plein cadre') %></span></label>
    </fieldset>
    <p class="actions"><button class="btn" type="submit"><%= t('Enregistrer la version') %></button></p>
  </form>
<% const ORDRE = { v1: ['v2', 'v3'], v2: ['v1', 'v3'], v3: ['v2', 'v1'] }; const autres = ORDRE[it.publicVersion] || ['v2', 'v3'];
   const forcee = it.vueSession && it.vueSession !== it.publicVersion;
   const APPLIQUEE = { v1: 'La v1 est appliquée : tous les visiteurs la voient.', v2: 'La v2 est appliquée : tous les visiteurs la voient.', v3: 'La v3 est appliquée : tous les visiteurs la voient.' }; %>
  <p class="mono"><%= t(APPLIQUEE[it.publicVersion] || APPLIQUEE.v1) %></p>
  <p class="mono"><%= t('Sur chaque page du site public, de petits boutons « Voir en v1 », « Voir en v2 » ou « Voir en v3 », visibles par vous seul, changent la version que vous voyez, sur cette session : pour comparer, ou voir une version avant de l’appliquer. Les visiteurs voient toujours la version choisie ici. Les Carnets et les galeries privées n’existent qu’en v2 et en v3.') %></p>
<% if (forcee) { %>
  <form class="row" method="post" action="/admin/apparence/apercu-v2">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <input type="hidden" name="vue" value="suivre">
    <input type="hidden" name="vers" value="/admin/apparence">
    <p class="mono"><%= t('Votre vue : la {v}, pour vous seul, sur cette session.', { v: it.vueSession }) %></p>
    <button class="btn ghost" type="submit"><%= t('Revenir à la version des visiteurs') %></button>
  </form>
<% } else { %>
  <p class="mono"><%= t('Votre vue suit ce réglage, comme les visiteurs.') %></p>
<% autres.forEach(autre => { %>
  <form class="row" method="post" action="/admin/apparence/apercu-v2">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <input type="hidden" name="vue" value="<%= autre %>">
    <input type="hidden" name="vers" value="/">
    <button class="btn ghost" type="submit"><%= t('Voir le site en {v}', { v: autre }) %></button>
  </form>
<% }) %>
<% } %>
</section>
<% } else { %><p id="site-public" class="hint"><%= t('Le choix de version est remplacé par « Thèmes et rubriques ». Les réglages historiques sont conservés pour le retour arrière.') %></p><% } %>

<% if (it.designSettings) { %><p class="hint"><%= t('Cette palette ne concerne que les rubriques en V1, V2 ou V3. Les chambres noires ont leur propre palette.') %></p><% } else { %><p class="prose"><%= t('Le thème change les couleurs et la typographie du site public ; l’admin garde son apparence. « Aperçu » ouvre le site avec un thème sans l’appliquer : vous seul le voyez, pendant une heure ou jusqu’à « Quitter l’aperçu ».') %></p><% } %>

<form class="form" method="post" action="/admin/apparence">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <fieldset class="panel">
    <legend><%= t('Thème') %></legend>
    <div class="themes">
<% Object.entries(it.THEMES).forEach(([id, th]) => { %>
      <div class="theme-card">
        <label class="inline"><input type="radio" name="theme" value="<%= id %>"<%~ id === it.themeId ? ' checked' : '' %>> <strong><%= t(th.label) %></strong><%= id === it.themeId ? ` ${t('(actuel)')}` : '' %></label>
        <span class="swatch swatch-<%= id %>" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mono"><%= t(th.description) %></span>
        <% if (!it.designSettings) { %><a class="more eyebrow" href="/?theme=<%= id %>" target="_blank" rel="noopener"><%= t('Aperçu') %><span class="sr-only"> <%= t('du thème {name} (nouvel onglet)', { name: t(th.label) }) %></span></a><% } %>
      </div>
<% }) %>
    </div>
  </fieldset>

  <fieldset class="panel form">
    <legend><%= t('Marque') %></legend>
<% Object.entries(it.BRAND_MODES).forEach(([k, label]) => { %>
    <label class="inline"><input type="radio" name="brand_mode" value="<%= k %>"<%~ b.mode === k ? ' checked' : '' %><%~ k === 'embleme' && !b.emblem && !b.icon ? ' disabled' : '' %>> <%= t(label) %><%= k === 'embleme' && !b.emblem && !b.icon ? ` — ${t('envoyez d’abord un emblème ou une icône')}` : '' %></label>
<% }) %>
    <label><%= t('Sous-titre sous le nom') %> <span class="mono"><%= t('ex. « Photography gallery » · 60 caractères') %></span><input name="subtitle" value="<%= b.subtitle || '' %>" maxlength="60"></label>
    <p class="mono"><%= t('Le nom lui-même se règle dans') %> <a href="/admin/site"><%= t('Site public') %></a>.</p>
  </fieldset>
  <p class="actions"><button class="btn" type="submit"><%= t('Enregistrer l’apparence') %></button></p>
</form>

<% Object.entries(it.BRAND_SLOTS).forEach(([slot, def]) => { const file = b[def.field]; %>
<section class="panel brand-slot" id="marque-<%= slot %>">
  <h2><%= t(def.label) %></h2>
  <p class="mono"><%= t(def.help) %></p>
<% if (file) { %>
  <p class="slot-preview"><img src="/brand/<%= file %>" alt="<%= t('{name} actuel', { name: t(def.label) }) %>"><% if (def.kind !== 'share' && (def.field === 'icon' || (def.field === 'emblem' && !b.icon)) && b.favicon180) { %> <img class="favicon-preview" src="/brand/<%= b.favicon180 %>" alt="<%= t('Icône d’onglet générée') %>" width="64" height="64"><% } %></p>
  <form method="post" action="/admin/apparence/marque/<%= slot %>/delete">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn ghost" type="submit"><%= t('Retirer') %></button>
  </form>
<% } %>
  <form class="row" method="post" action="/admin/apparence/marque/<%= slot %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label><%= file ? t('Remplacer') : t('Envoyer le fichier') %> <span class="mono"><%= t('PNG, WebP ou JPEG · 5 Mo au plus') %></span>
      <input type="file" name="fichier" accept="image/png,image/webp,image/jpeg" required></label>
    <button class="btn" type="submit"><%= t('Envoyer le fichier') %></button>
  </form>
</section>
<% }) %>
