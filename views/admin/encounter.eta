<% layout('./layout') %>
<% const e = it.e; const scopes = c => it.SCOPES.filter(s => c && c[s]).map(s => it.SCOPE_LABELS[s]).join(', ');
   const values = it.values || { ...e, signed: e.consent_source === 'carte' ? 'on' : '', ...Object.fromEntries(it.SCOPES.map(s => [`scope_${s}`, e.consent_source === 'carte' && e.consent && e.consent[s] ? 'on' : ''])) };
   const mail = e.email ? `mailto:${e.email}?subject=${encodeURIComponent(`Votre photo${e.ref ? ` (${e.ref})` : ''} · ${it.siteName}`)}` : null; %>
<p class="mono"><a class="more eyebrow" href="/admin/rencontres">← Personnes photographiées</a></p>
<h1 class="enc-title"><% if (e.hasPortrait) { %><img class="enc-face big" src="/admin/rencontres/<%= e.id %>/portrait?mini=1" alt="" width="64" height="64"><% } %><%= e.anonymized ? 'Refus anonymisé' : it.title %><%= e.name ? ` · ${e.name}` : '' %></h1>
<% if (e.anonymized) { %><p class="hint">Les données de cette personne ont été effacées à sa demande. Il ne reste que son refus, pour que les photos liées ne soient jamais publiées.</p><% } %>
<div class="enc-meta">
  <span class="enc-tag"><%= it.STATUS[e.status] %></span>
<% if (e.author) { %>  <span class="enc-tag"><%= e.author %></span><% } %>
<% if (e.ref) { %>  <span class="enc-tag<%= e.verified ? ' ok' : ' warn' %>"><%= e.verified ? 'carte vérifiée' : 'référence non vérifiée' %></span><% } %>
<% if (e.wants_photo) { %>  <span class="enc-tag">veut recevoir la photo</span><% } %>
<% if (e.refused) { %>  <span class="enc-tag no">Refuse la publication</span>
<% } else if (e.consent) { %>  <span class="enc-tag ok">Accord <%= e.consent_source !== 'en_ligne' ? 'signé' : 'donné en ligne' %> : <%= scopes(e.consent) %></span><% } %>
</div>

<div class="enc-grid">
  <section class="panel" aria-labelledby="enc-who">
    <h2 id="enc-who">La personne</h2>
    <dl class="kv">
      <dt>E-mail</dt><dd><%= e.email || '—' %><% if (mail) { %> · <a class="more" href="<%= mail %>">Écrire</a><% } %></dd>
      <dt>Rencontre</dt><dd><%= [e.met_on, e.met_time, e.place].filter(Boolean).join(' · ') || '—' %></dd>
<% if (e.details) { %>      <dt>Détails</dt><dd><%= e.details %></dd><% } %>
      <dt>Langue</dt><dd><%= { fr: 'français', en: 'anglais', de: 'allemand' }[e.lang] || e.lang %></dd>
<% if (e.lat != null) { %>      <dt>Position</dt><dd class="mono"><%= e.lat.toFixed(3) %>, <%= e.lon.toFixed(3) %> <span class="hint">(à 100 m près)</span></dd><% } %>
<% if (e.adult !== null && e.adult !== undefined) { %>      <dt>Âge</dt><dd><%= e.adult ? 'majeure' : `mineure · parent : ${e.guardian}` %></dd><% } %>
<% if (e.mailed_at) { %>      <dt>Récapitulatif</dt><dd>envoyé le <%= it.fmt(e.mailed_at) %></dd><% } %>
<% if (it.code) { %>      <dt>Code de la carte</dt><dd class="mono"><%= e.ref %>-<%= it.code %></dd><% } %>
    </dl>
<% if (e.hasPortrait || e.hasSignature) { %>    <div class="enc-captures">
<% if (e.hasPortrait) { %>      <figure><a href="/admin/rencontres/<%= e.id %>/portrait" target="_blank" rel="noopener"><img src="/admin/rencontres/<%= e.id %>/portrait" alt="Photo de repère de la personne" width="200"></a><figcaption class="mono">photo de repère</figcaption></figure><% } %>
<% if (e.hasSignature) { %>      <figure><img class="enc-signature" src="/admin/rencontres/<%= e.id %>/signature" alt="Signature de la personne" width="240"><figcaption class="mono">signature<%= e.adult === 0 ? ' (avec le parent)' : '' %></figcaption></figure><% } %>
    </div>
<% } %>
<% if (e.consent && e.consent_source === 'en_ligne') { %>    <p class="cellnote warn">Accord donné en ligne<%= e.verified ? ' avec la carte en main' : ', sans le code de la carte' %> : moins sûr qu’une carte signée. Pour une exposition ou un tirage, demandez une signature.</p><% } %>
    <form class="actions" method="post" action="/admin/rencontres/<%= e.id %>/statut">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% Object.entries(it.STATUS).filter(([k]) => k !== e.status).forEach(([k, label]) => { %>      <button class="btn ghost" type="submit" name="status" value="<%= k %>">Marquer « <%= label %> »</button>
<% }) %>    </form>
  </section>

  <section class="panel" aria-labelledby="enc-history">
    <h2 id="enc-history">Historique</h2>
    <ol class="enc-events">
<% it.events.slice().reverse().forEach(ev => { const d = ev.detail; %>
      <li><span class="mono"><%= it.fmt(ev.at) %></span><br>
<% if (ev.kind === 'visiteur') { %>        Demande sur la page /bonjour<%= ev.verified ? ' (carte vérifiée)' : '' %> :
        <%= [d.wants_photo && 'veut la photo', d.decision === 'accord' && `accepte (${scopes(d.scopes)})`, d.decision === 'refus' && 'refuse la publication', d.rights === 'acces' && 'demande une copie de ses données', d.rights === 'effacement' && 'demande l’effacement de ses données'].filter(Boolean).join(', ') || 'message' %>
<% if (d.message) { %>        <br>« <%= d.message %> »<% } %>
<% } else if (ev.kind === 'carte') { %>        Saisie de la carte<%= d.signed ? ` : accord signé (${scopes(d.scopes)})` : '' %><%= d.card ? ', photo de la carte jointe' : '' %>
<% } else if (ev.kind === 'liaison') { %>        <%= d.retiree ? 'Photo retirée' : `${(d.photos || []).length} photo(s) liée(s)` %>
<% } else if (ev.kind === 'app') { %>        Saisie avec la personne sur le téléphone : <%= d.decision === 'accord' ? `accord signé (${scopes(d.scopes)})` : d.decision === 'refus' ? 'refus de publication' : 'sans décision' %><%= d.position ? ', position notée' : '' %>
<% } else if (ev.kind === 'email') { %>        Récapitulatif envoyé par e-mail
<% } else if (ev.kind === 'export') { %>        Données exportées (archive remise à la personne)
<% } else if (ev.kind === 'droits_traites') { %>        Demande sur les données traitée
<% } else if (ev.kind === 'anonymise') { %>        Données effacées ; refus gardé sans identité
<% } else if (ev.kind === 'lien') { %>        Lien privé créé (photo offerte)
<% } else if (ev.kind === 'refus_applique') { %>        Refus appliqué : <%= (d.photos || []).length %> photo(s) dépubliée(s)
<% } else { %>        <%= ev.kind %><% } %></li>
<% }) %>
    </ol>
  </section>
</div>

<% const due = e.rights_requested_at ? e.rights_requested_at + 30 * 864e5 : null; %>
<% if (!e.anonymized) { %>
<section class="panel" id="droits" aria-labelledby="enc-rights">
  <h2 id="enc-rights">Droits de la personne <span class="mono">RGPD</span></h2>
<% if (e.rights_request && !e.rights_done_at) { %>  <p class="<%= due < Date.now() ? 'err' : 'cellnote warn' %>">Demande <strong><%= e.rights_request === 'acces' ? 'd’accès (copie de ses données)' : 'd’effacement' %></strong> le <%= it.fmt(e.rights_requested_at) %> : à traiter avant le <strong><%= it.fmt(due) %></strong>.<%= e.ref && !e.verified ? ' Référence non vérifiée : assurez-vous que la demande vient bien de cette personne (même adresse e-mail, ou réponse à votre message).' : '' %></p>
<% } else if (e.rights_done_at) { %>  <p class="hint">Dernière demande sur les données traitée le <%= it.fmt(e.rights_done_at) %>.</p>
<% } %>
  <p class="actions">
    <a class="btn ghost" href="/admin/rencontres/<%= e.id %>/export.zip">Exporter ses données (.zip)</a>
<% if (e.rights_request && !e.rights_done_at) { %>    <form method="post" action="/admin/rencontres/<%= e.id %>/droits-traites"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit">Marquer la demande comme traitée</button></form><% } %>
  </p>
  <p class="hint">L’archive contient tout ce que le site garde sur elle (rencontre, choix, accord ou refus, historique), la signature, les photos de repère et de carte, et les photos liées en JPEG : envoyez-la-lui (en pièce jointe ou par votre messagerie).</p>
</section>
<% } %>

<% if (e.refused) { %>
<section class="panel" aria-labelledby="enc-refusal">
  <h2 id="enc-refusal">Refus de publication</h2>
  <p>Les photos liées à cette rencontre <strong>ne peuvent plus être publiées</strong>. <%= it.photos.some(p => p.status === 'published') ? 'Certaines le sont encore :' : 'Aucune n’est publiée.' %></p>
<% if (it.photos.some(p => p.status === 'published')) { %>  <form method="post" action="/admin/rencontres/<%= e.id %>/refus"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn danger" type="submit">Appliquer le refus : dépublier et retirer de la file Instagram</button></form>
<% } %>  <p class="hint">Les posts déjà publiés sur Instagram ne sont pas touchés : supprimez-les dans l’application Instagram.</p>
</section>
<% } %>

<% const ses = it.session; %>
<section class="panel" id="session" aria-labelledby="enc-session">
  <h2 id="enc-session">Photos de la sortie <span class="mono"><%= ses.day ? `${e.author || 'photographe'} · ${ses.day}` : 'date inconnue' %></span></h2>
<% if (!ses.day || !e.author_id) { %>  <p class="hint">Indiquez le photographe et la date de la rencontre (ou de la sortie, ci-dessous) : l’accord couvrira alors toutes ses photos de ce jour-là.</p>
<% } else if (!ses.photos.length) { %>  <p class="hint">Aucune photo de <%= e.author %> datée du <%= ses.day %> pour l’instant (date EXIF). Elles seront couvertes dès leur import. Si l’horloge de l’appareil était décalée, corrigez la « date de la sortie ».</p>
<% } else { %>  <p class="hint"><%= e.consent ? 'L’accord de cette personne couvre' : e.refused ? 'Son refus ne bloque que les photos liées (plus bas) : cochez celles où elle apparaît. Photos du jour' : 'Pas encore de décision ; quand elle en prendra une, elle couvrira' %> les <%= ses.photos.filter(p => !p.excluded).length %> photo<%= ses.photos.filter(p => !p.excluded).length > 1 ? 's' : '' %> de <%= e.author %> prises ce jour-là. Excluez celles qui ne la concernent pas (une autre sortie le même jour, par exemple).</p>
  <div class="enc-photos">
<% ses.photos.forEach(p => { %>    <div class="enc-photo<%= p.excluded ? ' excluded' : '' %>">
      <a href="/admin/photos/<%= p.id %>"><% if (p.ready) { %><%~ it.picture(p, { sizes: '130px', alt: '' }) %><% } %></a>
      <span><%= p.title %> · <%= p.excluded ? 'exclue' : 'couverte' %></span>
      <form method="post" action="/admin/rencontres/<%= e.id %>/session/<%= p.id %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="exclure" value="<%= p.excluded ? '0' : '1' %>"><button class="linkbtn" type="submit"><%= p.excluded ? 'Rétablir' : 'Exclure' %></button></form>
    </div>
<% }) %>  </div>
<% } %>
</section>

<section class="panel" id="photos" aria-labelledby="enc-photos">
  <h2 id="enc-photos">Photos liées <span class="mono">refus, photo offerte, ou photo hors sortie</span></h2>
<% if (it.photos.length) { %>
  <div class="enc-photos">
<% it.photos.forEach(p => { %>    <div class="enc-photo">
      <a href="/admin/photos/<%= p.id %>"><% if (p.ready) { %><%~ it.picture(p, { sizes: '130px', alt: '' }) %><% } %></a>
      <span><%= p.title %> · <%= p.status === 'published' ? 'publiée' : 'brouillon' %></span>
      <form method="post" action="/admin/rencontres/<%= e.id %>/liens"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="photo_id" value="<%= p.id %>"><button class="btn ghost" type="submit">Offrir cette photo</button></form>
      <form method="post" action="/admin/rencontres/<%= e.id %>/photos/<%= p.id %>/retirer"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="linkbtn" type="submit">Retirer</button></form>
    </div>
<% }) %>  </div>
<% if (it.shares.length) { %>
  <h3 id="liens">Photos offertes</h3>
  <p class="hint">Un lien privé vers une version JPEG (2048 px, jamais l’original), valable 30 jours. « Envoyer » prépare le message dans votre messagerie, dans la langue de la personne.</p>
  <ul class="rank plain">
<% it.shares.forEach(s => { const p = it.photos.find(x => x.id === s.photo_id); %>    <li><span class="t"><%= p ? p.title : 'Photo' %> <span class="mono"><%= s.expired ? 'expiré' : `jusqu’au ${s.until}` %> · vu <%= s.views %> fois · téléchargé <%= s.downloads %> fois</span>
      <input class="mono share-url" value="<%= s.url %>" readonly aria-label="Lien privé" data-select-all></span>
<% if (s.mail && !s.expired) { %>      <a class="btn" href="<%= s.mail %>">Envoyer</a><% } %>
      <form method="post" action="/admin/rencontres/<%= e.id %>/liens/<%= s.token %>/retirer"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="linkbtn" type="submit">Retirer le lien</button></form></li>
<% }) %>  </ul>
<% } %>
<% } else { %>  <p class="hint">Aucune photo liée : choisissez-la ci-dessous.</p><% } %>
  <h3>Lier des photos</h3>
  <form class="search-inline" method="get" action="/admin/rencontres/<%= e.id %>#photos">
    <label>Chercher <input name="q" value="<%= it.search %>" placeholder="titre, lieu, adresse…"></label> <button class="btn ghost" type="submit">Chercher</button>
  </form>
  <p class="hint"><%= it.search ? 'Résultats de la recherche.' : `Photos ${e.author ? `de ${e.author}` : ''} ${e.met_on ? `prises ou importées vers le ${e.met_on} d’abord` : 'les plus récentes'}.` %></p>
  <form method="post" action="/admin/rencontres/<%= e.id %>/photos">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <div class="enc-photos">
<% it.candidates.forEach(p => { %>      <div class="enc-photo"><% if (p.ready) { %><%~ it.picture(p, { sizes: '130px', alt: '' }) %><% } %>
        <label><input type="checkbox" name="photo" value="<%= p.id %>"> <span><%= p.title %><br><span class="mono"><%= p.taken_on || '' %> · <%= p.status === 'published' ? 'publiée' : 'brouillon' %></span></span></label></div>
<% }) %>    </div>
<% if (!it.candidates.length) { %>    <p class="hint">Aucune photo trouvée.</p><% } %>
    <p class="actions"><button class="btn" type="submit">Lier les photos cochées</button></p>
  </form>
</section>

<section class="panel" aria-labelledby="enc-card">
  <h2 id="enc-card">Carte signée</h2>
<% if (e.hasCard) { %>  <p><a href="/admin/rencontres/<%= e.id %>/carte" target="_blank" rel="noopener"><img class="enc-card-img" src="/admin/rencontres/<%= e.id %>/carte" alt="Photo de la carte signée" width="480"></a></p><% } %>
  <%~ include('./_encounter-form', { ...it, v: values, action: `/admin/rencontres/${e.id}`, isNew: false }) %>
</section>

<details class="danger"<%~ e.rights_request === 'effacement' && !e.rights_done_at ? ' open' : '' %>>
  <summary>Effacer les données de cette personne</summary>
  <form method="post" action="/admin/rencontres/<%= e.id %>/effacer">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <p>Efface son nom, son adresse, ses messages, sa signature, les photos de repère et de carte, et l’historique.<%= e.refused ? ' Son refus reste appliqué, sans aucune donnée sur elle, tant que des photos liées sont gardées.' : (e.consent ? ' Son accord disparaît aussi : les photos liées ne pourront plus être publiées en s’en prévalant.' : '') %></p>
<% if (it.photos.length) { %>    <label class="inline"><input type="checkbox" name="photos"> Supprimer aussi les <%= it.photos.length %> photo<%= it.photos.length > 1 ? 's' : '' %> où elle apparaît (originaux et images ; effacées des sauvegardes sous 90 jours)</label>
<% } %>    <p class="actions"><button class="btn danger" type="submit">Effacer définitivement</button></p>
  </form>
</details>
