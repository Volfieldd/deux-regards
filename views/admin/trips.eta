<% layout('./layout') %>
<% const t = it.t; %>
<p class="mono"><a class="more eyebrow" href="/admin/sorties">← <%= t('Sorties') %></a></p>
<h1><%= t('Voyages') %></h1>
<p class="prose"><%= t('Un voyage regroupe des sorties : « Maroc 2025 », dix journées de prise de vue. C’est facultatif ; une journée appartient à un voyage au plus. Ses photos et ses personnes se retrouvent sur la page du voyage.') %></p>
<% if (it.can('sorties.gerer')) { %>
<form class="panel form row-form trip-new" method="post" action="/admin/voyages">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <label><%= t('Nouveau voyage') %> <input name="name" maxlength="120" required placeholder="<%= t('Maroc 2025') %>"></label>
<% if (it.allTrips) { %>  <label><%= t('Photographe') %> <select name="author_id"><option value=""><%= it.authors.length === 2 ? t('les deux photographes') : t('tous les photographes') %></option><% it.authors.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select></label>
<% } %>  <p class="actions"><button class="btn" type="submit"><%= t('Créer le voyage') %></button></p>
</form>
<% } %>
<% if (!it.list.length) { %>
<p class="empty"><%= t('Aucun voyage pour l’instant.') %></p>
<% } else { %>
<ul class="trips">
<% it.list.forEach(tr => { %>  <li class="panel trip-row">
    <a class="trip-cover" href="/admin/voyages/<%= tr.id %>" tabindex="-1" aria-hidden="true"><% if (tr.cover && tr.cover.ready) { %><%~ it.picture(tr.cover, { sizes: '120px', alt: '' }) %><% } else { %><span class="ph"></span><% } %></a>
    <div class="trip-body">
      <a class="o-title" href="/admin/voyages/<%= tr.id %>"><strong><%= tr.name %></strong></a>
      <span class="mono"><%= tr.span %> · <%= tr.who %></span>
      <span class="mono"><%= tr.nDays > 1 ? t('{n} journées', { n: tr.nDays }) : t('{n} journée', { n: tr.nDays }) %> · <%= tr.nPhotos > 1 ? t('{n} photos', { n: tr.nPhotos }) : t('{n} photo', { n: tr.nPhotos }) %> (<%= tr.nPublished > 1 ? t('{n} publiées', { n: tr.nPublished }) : t('{n} publiée', { n: tr.nPublished }) %>) · <%= tr.nPeople > 1 ? t('{n} personnes', { n: tr.nPeople }) : t('{n} personne', { n: tr.nPeople }) %></span>
    </div>
  </li>
<% }) %></ul>
<% } %>
