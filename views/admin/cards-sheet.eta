<!doctype html>
<% const T = it.T, a = it.author, t = it.t || (s => s); %>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.title %></title>
  <link rel="stylesheet" href="<%= it.asset('admin/cards.css') %>">
  <script src="<%= it.asset('admin/print.js') %>" defer></script>
</head>
<body>
<div class="bar"<%~ it.lang && it.lang !== 'fr' ? ` lang="${it.lang}"` : '' %>>
  <p><strong><%= it.title %></strong> · <%= it.sheets.length > 1 ? t('{n} feuilles A4.', { n: it.sheets.length }) : t('{n} feuille A4.', { n: it.sheets.length }) %> <%= t('Imprimez à 100 % (taille réelle), puis découpez le long des traits.') %></p>
  <p id="aide-apercu"><%= t('Sur petit écran, faites défiler l’aperçu horizontalement. L’impression garde le format A4.') %></p>
  <p><button type="button" data-print><%= t('Imprimer') %></button> <a href="/admin/rencontres/cartes"><%= t('Retour') %></a></p>
</div>
<main class="apercu" tabindex="0" aria-label="<%= t('Aperçu des planches A4') %>" aria-describedby="aide-apercu">
<% it.sheets.forEach(sheet => { %>
<section class="sheet">
<% sheet.forEach(p => { %>
  <div class="pair">
    <div class="card nous">
      <div class="lab"><%= T.consentLabel %></div>
      <h2><%= T.consent(a.name) %></h2>
      <p class="tr"><%= T.consentTr %></p>
      <div class="box"><% T.scopes(it.host).forEach(s => { %><span><%= s %></span><% }) %></div>
      <div class="f"><% T.fields.forEach(f => { %><div><%= f %></div><% }) %></div>
      <div class="sig"><%= T.signature %></div>
      <div class="ref"><% if (p.ref) { %>Réf. <b><%= p.ref %></b><% } else { %>Réf. <span class="blank"></span><% } %></div>
    </div>
    <div class="card eux">
      <h1><%= T.thanks %></h1>
      <p class="msg"><%= T.thanksText(a.name) %></p>
      <p class="tr"><%= T.thanksTr %></p>
      <div class="qr"><%~ p.qr %></div>
      <div class="qrt"><%= T.qrText %></div>
      <div class="url"><span class="brand"><%= it.siteName %></span> · <%= it.host %>/bonjour</div>
      <div class="ref"><% if (p.ref) { %>Réf. <b><%= p.label %></b><% } else { %>Réf. <span class="blank"></span><% } %></div>
    </div>
  </div>
<% }) %>
</section>
<% }) %>
</main>
</body>
</html>
