<% if (!it.corps) layout('./layout') %>
<% const t = it.t, s = it.saison, c = it.collection, f = it.fields, edit = it.canEdit;
   const langs = [{ code: 'fr', name: 'Français' }, { code: 'en', name: 'English' }, { code: 'de', name: 'Deutsch' }];
   const invalid = field => it.errorField === field, url = `/admin/saisons/${s.id}/collections/${c.id}`;
   const field = (base, lang) => lang === 'fr' ? base : `${base}_${lang}`; %>
<div class="saisons">
<header class="saisons-entete"><a class="saisons-retour" href="/admin/saisons/<%= s.id %>/bilans/<%= it.report.id %>">← <%= it.report.title %></a><h1><%= c.title %></h1><p class="sub"><%= t('Ce prolongement a sa propre présentation et son propre accrochage, comme une nouvelle exposition.') %></p></header>
<% if (it.error) { %><section class="saisons-erreur" role="alert"><h2><%= t('Les modifications n’ont pas été enregistrées.') %></h2><p><%= it.error %></p><% if (invalid('version')) { %><a class="btn ghost" href="<%= url %>"><%= t('Recharger la dernière version') %></a><% } %></section><% } %>
<% if (c.published_at != null) { %><p class="saisons-note"><%= t('Cette collection a été publiée. Sa présentation et son accrochage sont figés.') %></p><% } %>
<form class="form" method="post" action="<%= url %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= it.version %>">
  <section class="panel form" aria-labelledby="presentation-t"><h2 id="presentation-t"><%= t('Présentation du prolongement') %></h2><p class="hint"><%= t('Le français, l’anglais et l’allemand sont nécessaires à la publication. Le brouillon peut rester incomplet.') %></p>
<% langs.forEach(lang => { %>    <fieldset class="saisons-langue"><legend lang="<%= lang.code %>"><%= lang.name %></legend>
<% [{ base: 'title', label: 'Titre', max: 120 }, { base: 'subtitle', label: 'Sous-titre', max: 180 }, { base: 'intro', label: 'Intention', max: 4000, rows: 4 }, { base: 'prologue', label: 'Prologue', max: 2000, rows: 4 }, { base: 'conclusion', label: 'Conclusion', max: 2000, rows: 4 }].forEach(def => { const name = field(def.base, lang.code); %>
      <div class="saisons-champ"><label for="<%= name %>"><%= t(def.label) %></label><% if (def.rows) { %><textarea id="<%= name %>" name="<%= name %>" rows="<%= def.rows %>" maxlength="<%= def.max %>" lang="<%= lang.code %>"<%~ edit ? '' : ' readonly' %><%~ invalid(name) ? ` aria-invalid="true" aria-describedby="${name}-erreur"` : '' %>><%= f[name] %></textarea><% } else { %><input id="<%= name %>" name="<%= name %>" maxlength="<%= def.max %>" value="<%= f[name] %>" lang="<%= lang.code %>"<%~ edit ? '' : ' readonly' %><%~ invalid(name) ? ` aria-invalid="true" aria-describedby="${name}-erreur"` : '' %>><% } %><% if (invalid(name)) { %><p class="err" id="<%= name %>-erreur"><%= it.error %></p><% } %></div>
<% }) %>    </fieldset>
<% }) %>  </section>
  <section class="panel form" aria-labelledby="accrochage-t"><h2 id="accrochage-t"><%= t('Accrochage du prolongement') %></h2><p class="hint" id="ordre-aide"><%= t('Cochez les photographies retenues, puis donnez-leur des positions distinctes. Elles gardent leur série d’origine.') %></p><% if (invalid('photo_ids')) { %><p class="err" id="selection-erreur"><%= it.error %></p><% } %>
    <div class="saisons-champ"><label for="cover_id"><%= t('Photographie de couverture') %></label><select id="cover_id" name="cover_id"<%~ edit ? '' : ' disabled' %><%~ invalid('cover_id') ? ' aria-invalid="true" aria-describedby="couverture-erreur"' : '' %>><option value=""><%= t('Choisir une couverture') %></option><% it.photos.forEach(ph => { %><option value="<%= ph.id %>"<%~ f.cover_id === String(ph.id) ? ' selected' : '' %>><%= ph.title %></option><% }) %></select><% if (invalid('cover_id')) { %><p class="err" id="couverture-erreur"><%= it.error %></p><% } %></div>
<% it.photos.forEach(ph => { %>    <fieldset class="saisons-langue"><legend><%= ph.title %></legend><div class="saisons-choix"><label><input type="checkbox" name="photo_ids[]" value="<%= ph.id %>"<%~ ph.selected ? ' checked' : '' %><%~ edit ? '' : ' disabled' %>><% if (ph.thumb) { %><img class="saisons-vignette" src="<%= ph.thumb %>" width="80" height="<%= Math.round(80 * ph.height / ph.width) %>" alt="" loading="lazy"><% } %> <span><%= t('Retenir « {title} »', { title: ph.title }) %></span></label></div><% if (!ph.available) { %><p class="err"><%= edit ? t('Photo indisponible : décochez-la avant d’enregistrer.') : t('Photo indisponible') %></p><% } %>
      <div class="saisons-champ"><label for="position-<%= ph.id %>"><%= t('Position de « {title} »', { title: ph.title }) %></label><input id="position-<%= ph.id %>" name="position_<%= ph.id %>" type="number" min="1" max="500" value="<%= ph.position %>" aria-describedby="ordre-aide<%= invalid('photo_ids') ? ' selection-erreur' : '' %>"<%~ edit ? '' : ' readonly' %>></div>
<% langs.forEach(lang => { const name = `cartel_${ph.id}${lang.code === 'fr' ? '' : `_${lang.code}`}`; %>      <div class="saisons-champ"><label for="<%= name %>"><%= t('Cartel') %> · <span lang="<%= lang.code %>"><%= lang.name %></span></label><textarea id="<%= name %>" name="<%= name %>" rows="3" maxlength="500" lang="<%= lang.code %>"<%~ edit ? '' : ' readonly' %><%~ invalid('cartels') || invalid(name) ? ` aria-invalid="true" aria-describedby="${name}-erreur"` : '' %>><%= f[name] || '' %></textarea><% if (invalid('cartels') || invalid(name)) { %><p class="err" id="<%= name %>-erreur"><%= it.error %></p><% } %></div>
<% }) %>    </fieldset>
<% }) %><% if (edit) { %><div class="actions"><button class="btn" type="submit"><%= t('Enregistrer la collection') %></button></div><% } %>
  </section>
</form>
<% if (it.confirm) { %><form class="panel form" method="post" action="<%= url %>/<%= it.confirm.action %>" aria-labelledby="confirmation-t"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= it.version %>"><h2 id="confirmation-t"><%= it.confirm.label %></h2><p><%= it.confirm.message %></p><div class="actions"><a class="btn ghost" href="<%= url %>"><%= t('Annuler') %></a><button class="btn" type="submit"><%= it.confirm.label %></button></div></form>
<% } else if (it.canPublish) { %><section class="panel form" aria-labelledby="publication-t"><h2 id="publication-t"><%= t('Publication') %></h2><div class="actions"><% if (c.state === 'brouillon') { %><a class="btn ghost" href="<%= url %>/publier"><%= t('Publier…') %></a><% } else if (c.state === 'publie') { %><a class="btn danger" href="<%= url %>/retirer"><%= t('Retirer…') %></a><% } %></div></section><% } %>
</div>
