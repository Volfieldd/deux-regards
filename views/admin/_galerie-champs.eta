<% /* Champs d'une galerie : titre et texte d'accueil (trois langues : l'invité lit la langue de son accès), fermeture.
      it.values, it.errors ; erreur reliée au champ (aria-invalid, aria-describedby). */ %>
<% const t = it.t, v = it.values || {}, e = it.errors || {};
   const err = k => e[k] ? `<p class="err" id="${k}-err"><span><b>${t('Erreur :')}</b> ${String(e[k]).replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span></p>` : ''; %>
  <div class="champ-a"><label for="g-title"><%= t('Titre de la galerie') %></label><p class="aide" id="g-title-aide"><%= t('Les invités le voient une fois le mot de passe accepté, jamais avant.') %></p>
    <input id="g-title" name="title" maxlength="160" value="<%= v.title || '' %>" aria-describedby="g-title-aide<%= e.title ? ' title-err' : '' %>"<%~ e.title ? ' aria-invalid="true"' : '' %>><%~ err('title') %></div>
  <div class="champ-a"><label for="g-title-en"><%= t('Titre en anglais') %> <span class="facultatif"><%= t('(facultatif)') %></span></label><input id="g-title-en" name="title_en" maxlength="160" lang="en" value="<%= v.title_en || '' %>"></div>
  <div class="champ-a"><label for="g-title-de"><%= t('Titre en allemand') %> <span class="facultatif"><%= t('(facultatif)') %></span></label><input id="g-title-de" name="title_de" maxlength="160" lang="de" value="<%= v.title_de || '' %>"></div>
  <div class="champ-a"><label for="g-intro"><%= t('Mot d’accueil') %> <span class="facultatif"><%= t('(facultatif)') %></span></label><p class="aide" id="g-intro-aide"><%= t('Ce que vous attendez de l’invité : « Marquez d’une étoile celles qui vous intéressent. » Signé de votre nom.') %></p><textarea id="g-intro" name="intro" rows="3" maxlength="2000" aria-describedby="g-intro-aide"><%= v.intro || '' %></textarea></div>
  <div class="champ-a"><label for="g-intro-en"><%= t('Mot d’accueil en anglais') %> <span class="facultatif"><%= t('(facultatif)') %></span></label><textarea id="g-intro-en" name="intro_en" rows="2" maxlength="2000" lang="en"><%= v.intro_en || '' %></textarea></div>
  <div class="champ-a"><label for="g-intro-de"><%= t('Mot d’accueil en allemand') %> <span class="facultatif"><%= t('(facultatif)') %></span></label><textarea id="g-intro-de" name="intro_de" rows="2" maxlength="2000" lang="de"><%= v.intro_de || '' %></textarea></div>
  <div class="champ-a"><label for="g-closes"><%= t('Fermeture de la galerie') %></label><p class="aide" id="g-closes-aide"><%= t('Écrivez-la comme vous voulez : « 30/11/2026 », « 30 nov. 2026 ». Un an au plus. À cette date, tous ses accès cessent de marcher.') %></p>
    <input id="g-closes" name="closes" maxlength="40" value="<%= v.closes || '' %>" aria-describedby="g-closes-aide<%= e.closes ? ' closes-err' : '' %>"<%~ e.closes ? ' aria-invalid="true"' : '' %>><%~ err('closes') %></div>
