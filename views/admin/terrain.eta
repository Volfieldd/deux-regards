<% layout('./layout') %>
<% const a = it.chosen; %>
<h1>Sur le terrain</h1>
<p class="prose">Ce qui part dans la rue avec vous : l’app sur le téléphone, les cartes d’accord à faire signer, et le QR à porter sur vos vêtements.</p>
<% if (!a) { %>
<p class="empty">Ajoutez d’abord un photographe dans <a class="more" href="/admin/auteurs">Photographes</a>.</p>
<% } else { %>
<% if (it.authors.length > 1) { %>
<nav class="chips" aria-label="Photographe">
<% it.authors.forEach(x => { %>  <a class="chip" href="/admin/terrain?photographe=<%= x.id %>"<%~ x.id === a.id ? ' aria-current="page"' : '' %>><%= x.name %> · <%= x.card_prefix || x.slug.charAt(0).toUpperCase() %></a>
<% }) %></nav>
<% } %>
<div class="field-tools">
  <section class="panel field-tool" aria-labelledby="tool-app">
    <h2 id="tool-app">L’app Rencontre</h2>
    <p class="hint">Sur l’iPhone : nouvelle rencontre, accord signé au doigt, visage, position arrondie. Prochaine carte de <%= a.name %> : <strong><%= it.prefix %>-<%= String(it.next).padStart(4, '0') %></strong>.</p>
    <p class="hint">À installer une fois : dans Safari, ouvrez <code><%= it.host %>/admin/rencontre</code>, puis Partager → Sur l’écran d’accueil.</p>
    <p class="actions"><a class="btn" href="/admin/rencontre">Nouvelle rencontre</a></p>
  </section>
  <section class="panel field-tool" aria-labelledby="tool-cards">
    <h2 id="tool-cards">Cartes d’accord</h2>
    <p class="hint">Paires « à signer » (pour vous) et « à remettre » (pour la personne, avec son QR), numérotées ou génériques pour un imprimeur.</p>
    <p class="hint"><%= it.left ? `${it.left} carte${it.left > 1 ? 's' : ''} numérotée${it.left > 1 ? 's' : ''} imprimée${it.left > 1 ? 's' : ''} pas encore utilisée${it.left > 1 ? 's' : ''}.` : 'Aucune carte numérotée en réserve.' %></p>
    <p class="actions"><a class="btn ghost" href="/admin/rencontres/cartes">Préparer une planche</a></p>
  </section>
  <section class="panel field-tool" aria-labelledby="tool-qr">
    <h2 id="tool-qr">QR des vêtements</h2>
<% const f = `/admin/auteurs/${a.id}/qr/vertical-noir`; %>
    <figure class="qr-model noir"><img src="<%= f %>.svg?apercu=1" alt="QR de <%= a.name %> avec le logo, vers <%= it.host %>/bonjour/<%= it.prefix %>" width="240" height="396" loading="lazy">
      <figcaption class="mono"><%= it.host %>/bonjour/<%= it.prefix %> · dos de tee-shirt ou sac, 12 × 19,8 cm</figcaption></figure>
    <p class="hint">À montrer tel quel : la personne le scanne et arrive sur la page de <%= a.name %>, sans numéro de carte. QR de 8 à 10 cm au moins, marge blanche gardée.</p>
    <p class="actions"><a class="btn ghost" href="<%= f %>.svg">SVG pour l’imprimeur</a><a class="btn ghost" href="/admin/auteurs/<%= a.id %>/qr/vertical-blanc.svg">Encre blanche (textile foncé)</a></p>
  </section>
</div>
<section class="panel" aria-labelledby="checklist">
  <h2 id="checklist">Avant de partir</h2>
  <ul class="checklist">
    <li class="<%= it.until ? 'ok' : 'warn' %>"><%= it.until ? `Votre connexion reste valable jusqu’à ${it.until} : reconnectez-vous avant une longue sortie.` : 'Connexion : durée inconnue, reconnectez-vous en début de sortie.' %></li>
    <li class="<%= it.left ? 'ok' : 'warn' %>"><%= it.left ? `${it.left} carte${it.left > 1 ? 's' : ''} numérotée${it.left > 1 ? 's' : ''} en réserve.` : 'Plus de cartes numérotées : imprimez une planche, ou utilisez l’app.' %></li>
    <li class="<%= it.smtp ? 'ok' : 'off' %>"><%= it.smtp ? 'Récapitulatif envoyé automatiquement par e-mail après une rencontre.' : 'Récapitulatif par e-mail : préparé dans l’app Mail (envoi automatique non configuré).' %></li>
  </ul>
</section>
<% } %>
