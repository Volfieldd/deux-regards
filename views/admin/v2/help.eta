<% const t = it.t, E = __eta.e, H = it.help; %>
<% /* Aide (admin v2, vague 4 « suivi et aide » ; UX-A-22). Même contenu, mêmes chapitres réservés, mêmes ancres que la v1
      (views/admin/help.eta ; GET /admin/aide, docs/aide/ rendu par server/help.js) : les liens « Aide sur cette page » ne
      changent pas. La v2 : au téléphone, le sommaire replié (il occupait 2 268 px avant le premier mot) ; au bureau, à
      côté, collant ; avec le script, une recherche qui liste les passages trouvés, le mot surligné dans un extrait et un
      lien direct vers son titre, puis le mot surligné dans la page (CSS Custom Highlight : le texte n'est pas modifié). */ %>
<% layout('./layout', { pageTitle: `${t('Aide')} · ${t('Administration')} · ${it.siteName}` }) %>
<% const fr = H.lang !== it.lang ? ' lang="fr"' : '';
   const chev = '<svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>';
   const loupe = '<svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>';
   const toc = (id) => '<ol' + fr + '>' + H.sections.map(s => '<li><a href="#' + E(s.id) + '">' + E(s.title) + '</a>'
     + (s.headings.length ? '<ol>' + s.headings.map(h => '<li><a href="#' + E(h.id) + '">' + E(h.text) + '</a></li>').join('') + '</ol>' : '') + '</li>').join('') + '</ol>'; %>
<link rel="stylesheet" href="<%= it.asset('admin/v2/suivi-v2.css') %>">
<div class="v2-suivi">
<header class="ep">
  <div class="ep-titre"><h1><%= t('Aide') %></h1></div>
  <p class="ep-meta"><span><%= t('{n} rubriques', { n: H.sections.length }) %></span><% if (H.lang !== it.lang) { %><span><%= t('L’aide est rédigée en français.') %></span><% } %></p>
</header>
<div class="aide">
  <nav class="aide-toc" aria-label="<%= t('Sommaire de l’aide') %>">
    <p class="aide-toc-t"><%= t('Sommaire') %></p>
    <%~ toc() %>
  </nav>
  <div class="aide-corps">
    <div class="aide-cherche js-seul" role="search" aria-label="<%= t('Rechercher dans l’aide') %>" data-aide-cherche>
      <div class="champ-a"><label for="aide-q"><%= t('Rechercher dans l’aide') %></label>
        <div class="aide-q"><%~ loupe %><input type="search" id="aide-q" autocomplete="off" placeholder="<%= t('ex. filigrane, ordre, supprimer') %>" aria-describedby="aide-statut" aria-controls="aide-resultats"></div></div>
      <p class="aide-statut" id="aide-statut" role="status" data-aide-statut></p>
      <ol class="aide-resultats" id="aide-resultats" data-aide-resultats hidden></ol>
    </div>
    <details class="panel plier-p aide-toc-tel">
      <summary><%~ chev %><span><span class="h"><%= t('Sommaire') %></span><span class="sec"><%= t('{n} rubriques', { n: H.sections.length }) %></span></span></summary>
      <nav aria-label="<%= t('Sommaire') %>"><%~ toc() %></nav>
    </details>
<% H.sections.forEach(s => { %>
    <section class="panel aide-section help-section" id="<%= s.id %>" data-help-section aria-labelledby="aide-t-<%= s.id %>"<%~ fr %>>
      <h2 id="aide-t-<%= s.id %>"><%= s.title %></h2>
      <%~ s.html %>
      <p class="aide-haut"><a class="lien-a" href="#contenu"><%= t('Haut de l’aide') %></a></p>
    </section>
<% }) %>
  </div>
</div>
</div>
<%~ include('./_textes-suivi', it) %>
<script src="<%= it.asset('admin/v2/suivi-v2.js') %>" defer></script>
