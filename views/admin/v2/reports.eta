<% const t = it.t, E = __eta.e; %>
<% /* Signalements des visiteurs (admin v2, vague 4 « suivi et aide »). Mêmes signalements, même droit
      (signalements.traiter), mêmes routes que la v1 (views/admin/reports.eta ; GET /admin/signalements, POST
      …/:id/traite et …/:id/supprimer) : le message et l'adresse sont déchiffrés par la route, comme en v1 ; l'adresse n'est
      montrée qu'à qui voit toutes les personnes (la route la vide sinon). La v2 : les filtres Nouveaux et Traités (à
      l'affichage, ?etat=), une carte par signalement (la photo nommée, le type en pastille à symbole, le message dans sa
      langue), « Marquer comme traité », et « Supprimer… » par un dialogue (UX-A-07 : plus de suppression en un clic ;
      Annuler d'abord ; sans script, le dialogue s'ouvre dans la page par son ancre). */ %>
<% layout('./layout', { pageTitle: `${t('Signalements des visiteurs')} · ${t('Administration')} · ${it.siteName}` }) %>
<% const IC = {
     afaire: '<circle cx="12" cy="12" r="8" fill="none" stroke-width="2.6"/>', encours: '<path d="M12 2.7a9.3 9.3 0 0 1 0 18.6z" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="8" fill="none" stroke-width="2.6"/>',
     abouti: '<circle cx="12" cy="12" r="9.3" fill="currentColor" stroke="none"/>', attention: '<path d="M12 2.5l10.5 18.5H1.5z" fill="currentColor" stroke="none"/>',
     corbeille: '<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>', coche: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
     mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>',
   };
   const ic = (k, s = 12) => '<svg class="ic" width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' + IC[k] + '</svg>';
   const etat = (k, label) => '<span class="etat etat--' + k + '">' + ic(k) + E(label) + '</span>';
   const KIND = { inapproprie: ['attention', t('Ne devrait pas être en ligne')], texte: ['encours', t('Suggestion pour le texte')], autre: ['afaire', t('Autre chose')] };
   const LANGUE = { fr: t('en français'), en: t('en anglais'), de: t('en allemand') };
   const when = ms => { const d = new Intl.DateTimeFormat(it.locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Paris' }).format(ms); const h = new Intl.DateTimeFormat(it.locale, { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'Europe/Paris' }).format(ms); return t('{date} à {heure}', { date: d, heure: it.lang === 'fr' ? h.replace(/^0?(\d+):(\d\d)$/, '$1 h $2') : h }); };
   const R = it.reports;
   const nNew = R.filter(r => r.status === 'nouveau').length, nDone = R.length - nNew;
   const list = it.etat ? R.filter(r => r.status === it.etat) : R;
   const csrf = '<input type="hidden" name="_csrf" value="' + E(it.csrf) + '">'; %>
<link rel="stylesheet" href="<%= it.asset('admin/v2/suivi-v2.css') %>">
<p class="help-link"><a href="/admin/aide#site-public-signalements-des-visiteurs"><%= t('Aide sur cette page') %></a></p>
<div class="v2-suivi">
<header class="ep">
  <div class="ep-titre"><h1><%= t('Signalements des visiteurs') %></h1></div>
  <p class="ep-meta"><span><%= nNew > 1 ? t('{n} nouveaux', { n: nNew }) : nNew === 1 ? t('1 nouveau') : t('aucun nouveau') %></span><span><%= nDone > 1 ? t('{n} traités', { n: nDone }) : nDone === 1 ? t('1 traité') : t('aucun traité') %></span></p>
</header>
<p class="rub-intro"><%= t('Envoyés depuis le lien « Signaler » sous chaque photo du site. Message et adresse chiffrés, effacés au bout de 12 mois. Une personne qui se reconnaît est renvoyée vers la page /bonjour (accord ou refus).') %></p>
<nav class="chips filtres-l" aria-label="<%= t('Filtrer les signalements') %>">
  <a class="chip" href="/admin/signalements"<%~ !it.etat ? ' aria-current="page"' : '' %>><%= t('Tous') %> <span class="chip-n"><%= R.length %></span></a>
  <a class="chip" href="/admin/signalements?etat=nouveau"<%~ it.etat === 'nouveau' ? ' aria-current="page"' : '' %>><span class="chip-st chip-st--attention"><%~ ic('attention') %></span><%= t('Nouveaux') %> <span class="chip-n"><%= nNew %></span></a>
  <a class="chip" href="/admin/signalements?etat=traite"<%~ it.etat === 'traite' ? ' aria-current="page"' : '' %>><span class="chip-st chip-st--abouti"><%~ ic('abouti') %></span><%= t('Traités') %> <span class="chip-n"><%= nDone %></span></a>
</nav>
<% if (!list.length) { %>
<p class="panel hint"><%= !R.length ? t('Aucun signalement.') : it.etat === 'nouveau' ? t('Aucun nouveau signalement : tout est traité.') : t('Aucun signalement traité.') %></p>
<% } else { %>
<ul class="sg-liste" aria-label="<%= list.length > 1 ? t('{n} signalements', { n: list.length }) : t('{n} signalement', { n: list.length }) %>">
<% list.forEach(r => { const k = KIND[r.kind] || ['afaire', r.kind]; const id = 'sg-' + r.reportId; %>
  <li class="panel sg<%= r.status === 'nouveau' ? ' sg--nouveau' : '' %>" id="<%= id %>">
    <div class="sg-photo"><% if (r.ready) { %><%~ it.picture(r, { sizes: '96px', alt: '' }) %><% } else { %><span class="sg-vide" aria-hidden="true"></span><% } %></div>
    <div class="sg-corps">
      <h2 class="sg-titre"><a class="ligne-lien" href="/admin/photos/<%= r.pid %>"><%= t('Photo « {title} »', { title: r.title }) %></a></h2>
      <p class="sg-etats"><%~ etat(k[0], k[1]) %><%~ r.status === 'nouveau' ? etat('attention', t('Nouveau')) : etat('abouti', t('Traité')) %></p>
      <p class="sg-quand"><%= when(r.created_at) %> · <%= LANGUE[r.lang] || r.lang.toUpperCase() %></p>
<% if (r.message) { %>      <blockquote class="sg-msg" lang="<%= ['fr', 'en', 'de'].includes(r.lang) ? r.lang : 'und' %>"><p><%= r.message %></p></blockquote>
<% } else { %>      <p class="hint"><%= t('Sans message.') %></p>
<% } %><% if (r.email) { %>      <p class="sg-mail"><a class="lien-a" href="mailto:<%= encodeURIComponent(r.email).replace(/%40/g, '@') %>"><%~ ic('mail', 14) %><%= t('Répondre à {email}', { email: r.email }) %></a></p>
<% } else if (r.hasEmail) { %>      <p class="hint"><%= t('Adresse laissée pour une réponse : seul un administrateur la voit.') %></p>
<% } %>      <div class="sg-actions btns-ligne">
<% if (r.status === 'nouveau') { %>        <form method="post" action="/admin/signalements/<%= r.reportId %>/traite"><%~ csrf %><button class="btn ghost" type="submit"><%~ ic('coche', 16) %><%= t('Marquer comme traité') %></button></form>
<% } %>        <a class="btn danger-c" href="#dlg-<%= id %>" data-ouvre="dlg-<%= id %>"><%= t('Supprimer…') %></a>
      </div>
    </div>
  </li>
<% }) %>
</ul>
<% list.forEach(r => { const id = 'sg-' + r.reportId; %>
<dialog class="confirm cible" id="dlg-<%= id %>" aria-labelledby="dlg-<%= id %>-t" aria-describedby="dlg-<%= id %>-d">
  <form method="post" action="/admin/signalements/<%= r.reportId %>/supprimer">
    <%~ csrf %>
    <h2 id="dlg-<%= id %>-t"><%= t('Supprimer le signalement sur « {title} » ?', { title: r.title }) %></h2>
    <p id="dlg-<%= id %>-d"><%= r.hasEmail ? t('Le message et l’adresse laissée sont effacés ; la photo ne change pas. Cette action est définitive.') : t('Le message est effacé ; la photo ne change pas. Cette action est définitive.') %></p>
    <div class="actions"><a class="btn ghost" href="#<%= id %>" data-annuler><%= t('Annuler') %></a><button class="btn danger" type="submit"><%~ ic('corbeille', 16) %><%= t('Supprimer le signalement') %></button></div>
  </form>
</dialog>
<% }) %>
<% } %>
</div>
