<!doctype html>
<% const t = it.t; %>
<% /* Mon QR de la v2 (MQ-10, état 20 ; UX-A-12) : un titre, une page, un évitement ; l'invitation en français, anglais et
      allemand, le QR du photographe (le même fichier que la v1 : /admin/auteurs/:id/qr/vertical-noir.svg) et l'adresse en
      clair. Le bandeau de la vérification d'identité demandée par la Vigie (it.identite), avant de tendre le téléphone. Les
      données et la route de la v1 (GET /admin/rencontre/qr, server/routes/rencontres.js). */ %>
<% const a = it.author, b = it.brand || {}; %>
<html lang="<%= it.lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#1d1c1a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Rencontre">
  <link rel="manifest" href="/rencontre.webmanifest">
<% if (b.favicon180) { %>  <link rel="apple-touch-icon" href="/brand/<%= b.favicon180 %>">
<% } %>  <title><%= it.title %> · <%= it.siteName %></title>
  <link rel="stylesheet" href="<%= it.asset('admin/app.css') %>">
  <link rel="stylesheet" href="<%= it.asset('admin/v2/app-v2.css') %>">
  <link rel="stylesheet" href="<%= it.asset('admin/v2/publier-v2.css') %>">
</head>
<body class="app-qr-page">
<a class="skip" href="#contenu"><%= t('Aller au contenu') %></a>
<header class="app-bar">
  <a href="/admin/rencontre/accueil?photographe=<%= a.id %>" aria-label="<%= t('Retour à l’accueil Terrain') %>">←</a>
  <h1><%= t('Mon QR') %></h1>
</header>
<main class="app-qr-v2" id="contenu" tabindex="-1">
<% if (it.identite) { const id = it.identite; /* vérification d'identité demandée par la Vigie (server/verification-identite.js) : avant de tendre le téléphone */ %>  <div class="msg msg-identite" role="status"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.1-7.5 9.5-4.3-1.4-7.5-4.9-7.5-9.5V6z"/></svg><div><p><b><%= id.title %></b> <%= id.detail %></p><a class="btn-app" href="<%= id.href %>"><%= id.action %></a></div></div>
<% } %>
  <div class="qr-txt"><p lang="fr">Scannez pour retrouver la photo, donner ou refuser votre accord.</p><p lang="en">Scan to find your photo and give or refuse your consent.</p><p lang="de">Scannen Sie den Code: Dort finden Sie Ihr Foto und können Ihre Einwilligung geben oder verweigern.</p></div>
  <div class="qr-cadre"><img src="/admin/auteurs/<%= a.id %>/qr/vertical-noir.svg?apercu=1" alt="<%= t('QR de {name}, vers {url}', { name: a.name, url: `${it.host}/bonjour/${it.letter}` }) %>" width="420" height="560"></div>
  <p class="qr-adresse" translate="no"><%= it.host %>/bonjour/<%= it.letter %></p>
</main>
</body>
</html>
