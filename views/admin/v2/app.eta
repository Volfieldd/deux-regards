<!doctype html>
<% const t = it.t; %>
<% /* App de terrain de la v2 (MQ-10 ; UX-A-01, UX-A-12) : l'accord d'une personne photographiée, signé dans la rue. Un titre,
      une page, un évitement ; la session se lit avant de commencer ; le photographe replie sa partie avant de tendre le
      téléphone ; la section de la personne passe entière dans sa langue, sans script (:has(), app.css) ; ce qui manque est
      dit en tête, dans sa langue, et sous la question ; la signature est gardée après un refus du serveur ; l'envoi se
      voit, et ni le réseau ni la session ne font perdre l'accord tant que l'écran reste ouvert (app-v2.js). Les champs, la
      route et ses règles sont ceux de la v1 (POST /admin/rencontre, server/encounters.js). */ %>
<% const v = it.values || {}, e = it.errors || {}; const L = ['fr', 'en', 'de']; const NAMES = { fr: 'Français', en: 'English', de: 'Deutsch' };
   const author = it.authors.find(a => a.id === Number(v.author_id)) || it.authors[0] || { name: '', next: '' };
   const on = k => v[k] === 'on'; const b = it.brand || {}; const TL = it.tl; const redo = it.redo || {};
   const lang = L.includes(v.lang) ? v.lang : 'fr';
   const bad = k => (e[k] ? ' aria-invalid="true"' : '');
   const every = fn => L.map(l => `<span data-l="${l}" lang="${l}">${fn(l)}</span>`).join('');
   const E = __eta.e;
   // Les erreurs dans la langue de la personne (traducteurs de l'admin) ; « décision » et « âge » : les phrases de /bonjour.
   const ERR = { what: ['decision', l => it.UI[l].app.errDecision], adult: ['age', l => it.UI[l].app.errAdult], scopes: ['usages', l => TL[l].msg(e.scopes)], name: ['nom', l => TL[l].msg(e.name)],
     guardian: ['parent', l => TL[l].msg(e.guardian)], email: ['email', l => TL[l].msg(e.email)], signature: ['signature', l => TL[l].msg(e.signature)] };
   const personErrors = Object.keys(ERR).filter(k => e[k]);
   const otherErrors = Object.entries(e).filter(([k]) => !ERR[k]);
   const exp = it.session && it.session.expires_at ? new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(it.session.expires_at).reduce((o, p) => ({ ...o, [p.type]: p.value }), {}) : null;
   const until = exp ? (it.lang === 'fr' ? `${Number(exp.hour)} h ${exp.minute}` : `${exp.hour}:${exp.minute}`) : '';
   const IC = { ok: '<path d="M5 12.5l4.5 4.5L19 7.5"/>', pos: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>', alerte: '<path d="M12 3.8L2.8 20h18.4z"/><path d="M12 10v4.6M12 17.4v.2"/>', session: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>' };
   const ic = (k, s = 18) => `<svg class="ic" width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${IC[k]}</svg>`;
   const errFor = k => (e[k] ? '<p class="champ-err" id="' + ERR[k][0] + '-e">' + ic('alerte', 16) + '<span>' + L.map(l => '<span data-l="' + l + '" lang="' + l + '"><b>' + E(TL[l]('Erreur :')) + '</b> ' + E(ERR[k][1](l)) + '</span>').join('') + '</span></p>' : ''); %>
<html lang="<%= it.lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#1d1c1a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Rencontre">
  <link rel="manifest" href="/rencontre.webmanifest">
<% if (b.favicon180) { %>  <link rel="apple-touch-icon" href="/brand/<%= b.favicon180 %>">
<% } %>  <title><%= it.title %> · <%= it.siteName %></title>
  <link rel="stylesheet" href="<%= it.asset('admin/app.css') %>">
  <link rel="stylesheet" href="<%= it.asset('admin/v2/app-v2.css') %>">
  <script src="<%= it.asset('admin/v2/app-v2.js') %>" defer></script>
</head>
<body>
<a class="skip" href="#contenu"><%= t('Aller au formulaire') %></a>
<header class="app-bar">
  <a href="/admin/rencontre/accueil" aria-label="<%= t('Retour à l’accueil Terrain') %>">←</a>
  <h1><%= t('Nouvelle rencontre') %></h1>
  <span class="mono" data-next><%= author.next %></span>
</header>
<main id="contenu" tabindex="-1">
<% if (until) { %><p class="app-session"><%~ ic('session', 16) %><span><%= t('{name} · connecté jusqu’à {h}', { name: String(it.session.name || '').replace(/\s*\(test\)$/, ''), h: until }) %></span></p><% } %>
<form class="app-form" method="post" action="/admin/rencontre" enctype="multipart/form-data" novalidate data-app data-lang="<%= lang %>">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (otherErrors.length) { %>  <div class="msg msg-err" role="alert"><%~ ic('alerte') %><ul><% otherErrors.forEach(([k, m]) => { %><li><%= t.msg(m) %></li><% }) %></ul></div>
<% } %>
  <section class="app-step vous-s" aria-labelledby="s-vous">
    <details class="vous-plie"<%~ Object.keys(e).length && !e.author && !e.portrait ? '' : ' open' %> data-vous>
      <summary><h2 id="s-vous"><%= t('Vous') %></h2><span class="vous-r"><span data-vous-resume><%= author.name %><%= v.place ? ` · ${v.place}` : '' %></span><% if (redo.portrait) { %><span class="redo-r"><%= t('photo de repère à reprendre') %></span><% } %></span><span class="vous-m"><%= t('Modifier') %></span></summary>
      <div class="vous-corps">
        <label><%= t('Photographe') %> <select name="author_id" data-author><% it.authors.forEach(a => { %><option value="<%= a.id %>" data-next="<%= a.next %>"<%~ a.id === author.id ? ' selected' : '' %>><%= a.name %></option><% }) %></select></label>
        <input type="hidden" name="lat" value="<%= v.lat || '' %>" data-lat>
        <input type="hidden" name="lon" value="<%= v.lon || '' %>" data-lon>
        <p class="app-pos" data-pos role="status"><%~ ic('pos', 16) %><span data-pos-texte><%= t('Position : en attente…') %></span> <button type="button" class="linkbtn" data-pos-retry hidden><%= t('Réessayer') %></button></p>
        <label><span><%= t('Lieu') %> <span class="hint"><%= t('facultatif : la ville est déduite de la position') %></span></span><input name="place" value="<%= v.place || '' %>" maxlength="120" placeholder="<%= t('Rue, quartier…') %>"></label>
        <label class="app-photo<%= redo.portrait ? ' redo' : '' %>">
          <span class="app-big"><%= t('Photographier la personne') %></span>
          <span class="hint"><%= redo.portrait ? t('Reprenez la photo de la personne : elle n’est pas gardée après une erreur.') : t('son visage, joint à son accord : pour savoir qui a signé et retrouver les bonnes images ; gardé en privé, aussi longtemps que l’accord, réduit à 1 600 px') %></span>
          <input type="file" name="portrait" accept="image/*" capture="environment" data-portrait>
          <img alt="<%= t('Photo de repère') %>" hidden data-portrait-preview>
        </label>
        <label><span><%= t('Notes') %> <span class="hint"><%= t('facultatif') %></span></span><input name="details" value="<%= v.details || '' %>" maxlength="500" placeholder="<%= t('tenue, scène…') %>"></label>
<% if (it.recent && it.recent.length) { %>        <label><span><%= t('Déjà rencontrée ?') %> <span class="hint"><%= t('facultatif : la rencontre sera ajoutée à sa fiche (un nouvel accord reste à signer pour aujourd’hui)') %></span></span>
          <select name="person_id"><option value=""><%= t('Non, nouvelle personne') %></option><% it.recent.forEach(p => { %><option value="<%= p.id %>"<%~ Number(v.person_id) === p.id ? ' selected' : '' %>><%= [p.initials, p.ref].filter(Boolean).join(' · ') || t('Sans nom') %> · <%= p.day %><%= p.refused ? ` · ${t('refus')}` : '' %></option><% }) %></select></label>
<% } %>
        <a class="btn-app tendre" href="#s-pers" data-tendre><%= t('Tendre le téléphone à la personne') %></a>
      </div>
    </details>
  </section>

  <section class="app-step app-person" aria-labelledby="s-pers">
    <h2 id="s-pers" tabindex="-1"><%= t('La personne') %> <span class="hint"><%= t('à lui tendre') %></span></h2>
    <fieldset class="langues"><legend class="sr-only">Langue · Language · Sprache</legend>
<% L.forEach(l => { %>      <label lang="<%= l %>"><input type="radio" name="lang" value="<%= l %>" data-lang-pick<%~ lang === l ? ' checked' : '' %>><%= NAMES[l] %></label>
<% }) %>    </fieldset>
    <div class="pers-corps">
<% if (personErrors.length) { %>
      <section class="resume" tabindex="-1" aria-labelledby="res-p" data-resume><h3 class="resume-t" id="res-p"><%~ ic('alerte') %><%~ every(l => E(personErrors.length > 1 ? TL[l]('{n} points à corriger', { n: personErrors.length }) : TL[l]('1 point à corriger'))) %></h3>
        <ul><% personErrors.forEach(k => { %><li><a href="#<%= ERR[k][0] %>"><%~ every(l => E(ERR[k][1](l))) %></a></li><% }) %></ul></section>
<% } %>
<% L.forEach(l => { const A = it.UI[l].app; %>
      <div class="app-l10n" data-l="<%= l %>" lang="<%= l %>">
        <h3><%= A.consentTitle %></h3>
        <p class="app-consent"><%= A.consent('\u0000').split('\u0000')[0] %><span data-author-name><%= author.name %></span><%= A.consent('\u0000').split('\u0000')[1] %></p>
      </div>
<% }) %>
      <fieldset class="decision<%= e.what ? ' groupe-err' : '' %>" id="decision" data-group="decision"<%~ e.what ? ' aria-describedby="decision-e"' : '' %>><legend><%~ every(l => E(TL[l]('Votre décision'))) %></legend>
        <%~ errFor('what') %>
        <label class="check big"><input type="radio" name="decision" value="accord"<%~ v.decision === 'accord' ? ' checked' : '' %><%~ bad('what') %>> <%~ every(l => E(TL[l]('J’accepte'))) %></label>
        <fieldset class="sous<%= e.scopes ? ' groupe-err' : '' %>" id="usages"<%~ e.scopes ? ' aria-describedby="usages-e"' : '' %>><legend><%~ every(l => E(TL[l]('J’accepte qu’elles soient utilisées :'))) %></legend>
          <%~ errFor('scopes') %>
<% ['site', 'instagram', 'print', 'name'].forEach(s => { %>          <label class="check"><input type="checkbox" name="scope_<%= s %>"<%~ on(`scope_${s}`) ? ' checked' : '' %>> <%~ every(l => E(it.UI[l].hello.scopes[s])) %></label>
<% }) %>        </fieldset>
        <label class="check big"><input type="radio" name="decision" value="refus"<%~ v.decision === 'refus' ? ' checked' : '' %><%~ bad('what') %>> <%~ every(l => E(it.UI[l].app.refuse)) %></label>
        <label class="check big"><input type="radio" name="decision" value=""<%~ !v.decision ? ' checked' : '' %><%~ bad('what') %>> <%~ every(l => E(it.UI[l].app.later)) %></label>
      </fieldset>
      <label class="champ-l" for="nom"><%~ every(l => E(TL[l]('Prénom et nom'))) %></label>
      <%~ errFor('name') %><input id="nom" name="name" value="<%= v.name || '' %>" maxlength="80" autocomplete="off"<%~ e.name ? ' aria-invalid="true" aria-describedby="nom-e"' : '' %>>
      <label class="champ-l" for="email"><%~ L.map(l => `<span data-l="${l}" lang="${l}">${E(TL[l]('E-mail'))} <span class="facultatif">${E(TL[l]('(facultatif)'))}</span></span>`).join('') %></label>
      <%~ errFor('email') %><input type="email" id="email" name="email" value="<%= v.email || '' %>" maxlength="200" autocomplete="off" inputmode="email"<%~ e.email ? ' aria-invalid="true" aria-describedby="email-e"' : '' %>>
      <label class="check"><input type="checkbox" name="wants_photo"<%~ on('wants_photo') ? ' checked' : '' %>> <%~ every(l => E(it.UI[l].hello.wantsPhoto)) %></label>
      <fieldset class="age<%= e.adult ? ' groupe-err' : '' %>" id="age" data-group="adult"<%~ e.adult ? ' aria-describedby="age-e"' : '' %>><legend><%~ every(l => E(TL[l]('Âge'))) %></legend>
        <%~ errFor('adult') %>
        <label class="check"><input type="radio" name="adult" value="oui"<%~ v.adult === 'oui' ? ' checked' : '' %><%~ bad('adult') %>> <%~ every(l => E(it.UI[l].app.adult)) %></label>
        <label class="check"><input type="radio" name="adult" value="non"<%~ v.adult === 'non' ? ' checked' : '' %><%~ bad('adult') %>> <%~ every(l => E(it.UI[l].app.minor)) %></label>
      </fieldset>
      <label class="champ-l" for="parent"><%~ L.map(l => `<span data-l="${l}" lang="${l}">${E(TL[l]('Nom du parent'))} <span class="facultatif">${E(TL[l]('(si vous avez moins de 18 ans)'))}</span></span>`).join('') %></label>
      <%~ errFor('guardian') %><input id="parent" name="guardian" value="<%= v.guardian || '' %>" maxlength="80" autocomplete="off"<%~ e.guardian ? ' aria-invalid="true" aria-describedby="parent-e"' : '' %>>
      <p class="hint app-privacy"><%~ every(l => E(it.UI[l].app.privacy(it.host))) %></p>
      <div class="sig js-seul<%= redo.signature && !it.signatureKept ? ' redo' : '' %>" id="signature" data-sig>
        <p id="sig-l"><%~ every(l => E(it.UI[l].app.sign)) %></p>
        <%~ errFor('signature') %>
        <canvas data-sign role="img" aria-labelledby="sig-l sig-ok"></canvas>
        <input type="hidden" name="signature" value="<%= it.signatureKept || '' %>" data-sign-value>
        <div class="ligne"><span class="ok" id="sig-ok" data-sig-ok<%~ it.signatureKept ? '' : ' hidden' %>><%~ ic('ok', 16) %><%~ every(l => E(TL[l]('Signature gardée'))) %></span><button class="btn-app" type="button" data-sign-clear><%~ every(l => E(it.UI[l].app.clear)) %></button></div>
        <div class="defaire" role="status" data-sig-defaire hidden><span><%~ every(l => E(TL[l]('Signature effacée.'))) %></span><button type="button" data-sig-undo><%~ every(l => E(TL[l]('Défaire'))) %></button></div>
      </div>
      <p class="msg sans-sig"><%= t('Sans JavaScript, ce téléphone ne prend pas la signature au doigt : enregistrez ici un refus ou une adresse pour envoyer la photo, et faites signer une carte d’accord papier (Personnes › Cartes d’accord).') %></p>
    </div>
  </section>
  <div class="app-actions">
    <div class="envoi" data-envoi hidden><p role="status"><span data-envoi-texte><%~ every(l => E(TL[l]('Envoi de votre accord…'))) %></span> <span data-envoi-pct></span></p><progress max="100" value="0" data-envoi-barre></progress></div>
    <div class="msg msg-err" role="alert" data-reseau hidden><%~ ic('alerte') %><div><p><%~ every(l => E(TL[l]('Pas de réseau. Votre accord est gardé sur cet écran : rien n’est perdu. Réessayez quand le réseau revient.'))) %></p><button class="btn-app" type="button" data-reessayer><%~ every(l => E(TL[l]('Réessayer'))) %></button></div></div>
    <div class="msg msg-err" role="alert" data-session hidden><%~ ic('alerte') %><div lang="<%= it.lang %>"><p><%= t('Votre session a expiré. L’accord est gardé sur cet écran : rien n’est perdu. Reconnectez-vous dans un nouvel onglet, puis revenez ici et appuyez sur « Réessayer ».') %></p><a class="btn-app" href="/admin/rencontre/accueil" target="_blank" rel="noopener"><%= t('Se reconnecter dans un nouvel onglet') %></a> <button class="btn-app" type="button" data-reessayer><%= t('Réessayer') %></button></div></div>
    <button class="app-save" type="submit" data-save><%~ every(l => E(TL[l]('Enregistrer'))) %></button>
    <p class="hint js-seul"><%~ every(l => E(TL[l]('Si le réseau coupe, vos réponses restent sur cet écran jusqu’à l’envoi.'))) %></p>
  </div>
</form>
</main>
</body>
</html>
