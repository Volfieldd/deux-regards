<!doctype html>
<% const t = it.t; %>
<% /* « Merci » de la v2 (MQ-10, état 19 ; UX-A-12) : l'écran tendu à la personne, dans sa langue (titre, QR de sa page, ce
      qu'elle y trouve, sa référence) ; puis, pour le photographe qui reprend le téléphone, dans la langue de l'admin : le
      bandeau de la vérification d'identité demandée par la Vigie (it.identite), le récapitulatif (envoyé par le serveur, ou
      prêt dans Mail) et la suite. Les données, la route et le formulaire de la v1 (GET /admin/rencontre/:id/merci,
      POST …/envoyer, server/routes/rencontres.js). */ %>
<% const e = it.e, A = it.A, b = it.brand || {}; const L = ['fr', 'en', 'de'].includes(e.lang) ? e.lang : 'fr'; const TL = it.tl[L]; %>
<html lang="<%= L %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#1d1c1a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="manifest" href="/rencontre.webmanifest">
<% if (b.favicon180) { %>  <link rel="apple-touch-icon" href="/brand/<%= b.favicon180 %>">
<% } %>  <title><%= it.title %> · <%= it.siteName %></title>
  <link rel="stylesheet" href="<%= it.asset('admin/app.css') %>">
  <link rel="stylesheet" href="<%= it.asset('admin/v2/app-v2.css') %>">
  <link rel="stylesheet" href="<%= it.asset('admin/v2/publier-v2.css') %>">
</head>
<body class="merci">
<a class="skip" href="#contenu"><%= TL('Aller au contenu') %></a>
<main class="app-merci app-merci-v2" id="contenu" tabindex="-1">
  <h1><%= A.thanks %></h1>
  <div class="app-qr" role="img" aria-label="<%= TL('QR de votre page, référence {ref}', { ref: e.ref }) %>"><%~ it.qr %></div>
  <p class="app-scan"><%= A.scan %></p>
  <p class="app-ref" translate="no"><%= e.ref %></p>
</main>
<section class="app-after" lang="<%= it.lang %>" aria-labelledby="pour-vous">
  <h2 id="pour-vous"><%= t('Pour vous') %></h2>
<% if (it.identite) { const id = it.identite; /* vérification d'identité demandée par la Vigie (server/verification-identite.js) */ %>  <div class="msg msg-identite" role="status"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.1-7.5 9.5-4.3-1.4-7.5-4.9-7.5-9.5V6z"/></svg><div><p><b><%= id.title %></b> <%= id.detail %></p><a class="btn-app" href="<%= id.href %>"><%= id.action %></a></div></div>
<% } %>
<% if (it.flash === 'ok') { %>  <p class="ok" role="status"><%= t('Récapitulatif envoyé à {email}.', { email: e.email }) %></p>
<% } else if (it.flash === 'echec') { %>  <p class="ko" role="alert"><%= t('L’e-mail n’est pas parti (voir la fiche de la rencontre) : envoyez-le depuis Mail.') %></p>
<% } %>
<% if (e.email) { %>
<% if (e.mailed_at && it.flash !== 'ok') { %>  <p class="ok"><%= t('Récapitulatif envoyé à {email}.', { email: e.email }) %></p>
<% } else if (!e.mailed_at) { %>
<% if (it.smtp) { %>  <form method="post" action="/admin/rencontre/<%= e.id %>/envoyer"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="app-btn" type="submit"><%= t('Envoyer le récapitulatif à {email}', { email: e.email }) %></button></form>
<% } %>  <p><a class="app-btn<%= it.smtp ? ' ghost' : '' %>" href="<%= it.mailto %>"><%= t('Envoyer le récapitulatif depuis Mail') %></a></p>
<% } %>
<% } else { %>  <p class="hint"><%= t('Pas d’e-mail : la personne garde son lien en scannant le QR.') %></p>
<% } %>
<% /* L'écran est tendu à la personne (QR) : les liens vers l'admin attendent que le photographe reprenne le téléphone. */ %>
  <details class="app-next">
    <summary><%= t('Photographe : reprendre le téléphone') %></summary>
    <p class="app-row"><a class="app-btn" href="/admin/rencontre"><%= t('Nouvelle rencontre') %></a> <a class="app-btn ghost" href="/admin/rencontre/accueil"><%= t('Accueil Terrain') %></a></p>
    <p><a class="app-link" href="/admin/rencontres/<%= e.id %>"><%= t('Voir la fiche de la rencontre') %></a></p>
  </details>
</section>
</body>
</html>
