<% layout('./layout') %>
<% const t = it.t; %>
<% const others = c => it.categories.filter(o => o.id !== c.id); %>
<div class="toolbar">
  <div>
    <h1>Séries</h1>
    <p class="sub"><%= it.categories.length > 1 ? t('{n} séries', { n: it.categories.length }) : t('{n} série', { n: it.categories.length }) %> · <%= t('l’ordre est celui de l’index du site :') %> <span data-js-only hidden><%= t('glissez une carte (ou ↑ ↓ au clavier sur sa poignée), ou passez par le menu ⋯') %></span><span data-nojs><%= t('menu ⋯ de chaque carte') %></span></p>
  </div>
  <div class="acts"><a class="btn big" href="#nouvelle-serie" data-new-series>＋ <%= t('Nouvelle série') %></a></div>
</div>

<div class="scards" data-series-list>
  <form class="scard new" id="nouvelle-serie" method="post" action="/admin/series" data-new-card>
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <div class="cover empty" aria-hidden="true">＋</div>
    <div class="body">
      <label><%= t('Nouvelle série') %> <input name="name" value="<%= it.values.name || '' %>" required maxlength="80" placeholder="<%= t('Nom, puis Entrée') %>"<%~ it.errors.name ? ' aria-invalid="true" aria-describedby="err-serie-nouvelle"' : '' %>></label>
<% if (it.errors.name) { %>      <span class="err" role="alert" id="err-serie-nouvelle"><%= it.errors.name %></span>
<% } %>
      <span class="hint"><%= t('Elle prend la première place ; déplaçable ensuite.') %></span>
    </div>
    <div class="acts"><button class="btn" type="submit"><%= t('Créer') %></button></div>
  </form>
<% it.categories.forEach((c, i) => { const ed = it.editErrors && it.editErrors.id === c.id ? it.editErrors : null; const v = ed ? ed.values : c; %>
  <article class="scard" id="serie-<%= c.id %>" data-id="<%= c.id %>" aria-labelledby="nom-serie-<%= c.id %>">
<% const board = (it.boards && it.boards[c.id]) || []; %>
    <div class="cover<%= board.length === 1 ? ' one' : board.length === 2 ? ' two' : '' %>">
<% if (board.length) { board.forEach((p, k) => { %>      <%~ it.picture(p, { sizes: k ? '160px' : '360px', alt: '' }) %>
<% }) } else { %>      <span class="empty" aria-hidden="true"><%= t('Aucune photo') %></span>
<% } %>
      <button class="grip" type="button" hidden data-grip aria-label="<%= t('Déplacer « {name} » (flèches haut et bas)', { name: c.name }) %>" aria-describedby="grip-help">⠿ <%= t('Déplacer') %></button>
    </div>
    <div class="body">
      <h2 class="title" id="nom-serie-<%= c.id %>"><%= c.name %></h2>
      <span class="count mono"><%= c.count > 1 ? t('{n} photos', { n: c.count }) : t('{n} photo', { n: c.count }) %></span>
    </div>
    <div class="acts">
      <a class="btn ghost" href="/admin/photos?serie=<%= c.slug %>"><%= t('Photos') %> ›</a>
      <details class="inline-edit"<%~ ed ? ' open' : '' %>>
        <summary class="btn ghost"><%= t('Renommer') %></summary>
        <form class="pop" method="post" action="/admin/series/<%= c.id %>">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <label><%= t('Nom') %> <input name="name" value="<%= v.name %>" required maxlength="80"<%~ ed && ed.errors.name ? ` aria-invalid="true" aria-describedby="err-serie-${c.id}"` : '' %>></label>
          <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'name', label: t('Nom'), max: 80 }) %>
          <details class="advanced"<%~ ed && ed.errors.slug ? ' open' : '' %>>
            <summary><%= t('Adresse de la série (avancé)') %></summary>
            <label><span class="mono">/serie/</span><input name="slug" value="<%= v.slug %>" maxlength="80"<%~ ed && ed.errors.slug ? ` aria-invalid="true" aria-describedby="err-serie-${c.id}"` : '' %>></label>
            <span class="cellnote warn"><%= t('Changer l’adresse casse les liens déjà partagés.') %></span>
          </details>
<% if (ed) { %>          <span class="err" role="alert" id="err-serie-<%= c.id %>"><%= Object.values(ed.errors).join(' ') %></span>
<% } %>
          <p class="actions"><button class="btn" type="submit"><%= t('Enregistrer') %></button></p>
        </form>
      </details>
      <details class="menu">
        <summary class="iconbtn" aria-label="<%= t('Plus d’actions pour « {name} »', { name: c.name }) %>"><span aria-hidden="true">⋯</span></summary>
        <div class="menu-pop">
<% [['up', t('Monter d’une place'), i === 0], ['down', t('Descendre d’une place'), i === it.categories.length - 1]].forEach(([dir, label, off]) => { if (off) return; %>
          <form method="post" action="/admin/series/<%= c.id %>/move"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="dir" value="<%= dir %>">
            <button type="submit"><%= label %></button></form>
<% }) %>
          <details class="danger">
            <summary><%= t('Supprimer…') %></summary>
            <form method="post" action="/admin/series/<%= c.id %>/delete" data-delete-series>
              <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (c.count && others(c).length) { %>
              <p><%= t('« {name} » contient', { name: c.name }) %> <strong><%= c.count > 1 ? t('{n} photos', { n: c.count }) : t('{n} photo', { n: c.count }) %></strong>. <%= t('Elles ne seront pas supprimées : choisissez où les déplacer.') %></p>
              <label><%= t('Déplacer vers') %> <select name="move_to"><% others(c).forEach(o => { %><option value="<%= o.id %>"><%= o.name %></option><% }) %></select></label>
              <button class="btn danger" type="submit"><%= c.count > 1 ? t('Déplacer les {n} photos et supprimer', { n: c.count }) : t('Déplacer la photo et supprimer') %></button>
<% } else if (c.count) { %>
              <p><%= c.count > 1 ? t('C’est la seule série : ses {n} photos n’auraient nulle part où aller. Créez d’abord une autre série.', { n: c.count }) : t('C’est la seule série : sa photo n’aurait nulle part où aller. Créez d’abord une autre série.', { n: c.count }) %></p>
<% } else { %>
              <p><%= t('La série est vide.') %></p>
              <button class="btn danger" type="submit"><%= t('Supprimer « {name} »', { name: c.name }) %></button>
<% } %>
            </form>
          </details>
        </div>
      </details>
    </div>
  </article>
<% }) %>
</div>
<p class="sr-only" id="grip-help"><%= t('Flèches haut ou gauche : avancer d’une place. Flèches bas ou droite : reculer d’une place.') %></p>
