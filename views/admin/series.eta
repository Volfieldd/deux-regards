<% layout('./layout') %>
<% const t = it.t; %>
<% const others = c => it.categories.filter(o => o.id !== c.id); %>
<div class="toolbar">
  <div>
    <h1><%= t('Séries') %></h1>
    <p class="sub"><%= it.categories.length > 1 ? t('{n} séries', { n: it.categories.length }) : t('{n} série', { n: it.categories.length }) %> · <%= t('l’ordre est celui de l’index du site :') %> <span data-js-only hidden><%= t('glissez une carte (ou ↑ ↓ au clavier sur sa poignée), ou passez par le menu ⋯') %></span><span data-nojs><%= t('menu ⋯ de chaque carte') %></span></p>
  </div>
  <div class="acts"><a class="btn big" href="#nouvelle-serie" data-new-series>＋ <%= t('Nouvelle série') %></a></div>
</div>

<div class="scards" data-series-list>
  <form class="scard new" id="nouvelle-serie" method="post" action="/admin/series" data-new-card>
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <div class="cover empty" aria-hidden="true">＋</div>
    <div class="body">
      <label><%= t('Nouvelle série') %> <input name="name" value="<%= it.values.name || '' %>" required maxlength="80" placeholder="<%= t('Nom, puis Entrée') %>"<%~ it.errors.name ? ' aria-invalid="true" aria-describedby="err-serie-nouvelle"' : '' %>></label>
<% if (it.errors.name) { %>      <span class="err" role="alert" id="err-serie-nouvelle"><%= it.errors.name %></span>
<% } %>
      <span class="hint"><%= t('Elle prend la première place ; déplaçable ensuite.') %></span>
    </div>
    <div class="acts"><button class="btn" type="submit"><%= t('Créer') %></button></div>
  </form>
<% it.categories.forEach((c, i) => { const ed = it.editErrors && it.editErrors.id === c.id ? it.editErrors : null; const v = ed ? ed.values : c; %>
  <article class="scard" id="serie-<%= c.id %>" data-id="<%= c.id %>" aria-labelledby="nom-serie-<%= c.id %>">
<% const board = (it.boards && it.boards[c.id]) || []; %>
    <div class="cover<%= board.length === 1 ? ' one' : board.length === 2 ? ' two' : '' %>">
<% if (board.length) { board.forEach((p, k) => { %>      <%~ it.picture(p, { sizes: k ? '160px' : '360px', alt: '' }) %>
<% }) } else { %>      <span class="empty" aria-hidden="true"><%= t('Aucune photo') %></span>
<% } %>
      <button class="grip" type="button" hidden data-grip aria-label="<%= t('Déplacer « {name} » (flèches haut et bas)', { name: c.name }) %>" aria-describedby="grip-help">⠿ <%= t('Déplacer') %></button>
    </div>
    <div class="body">
      <h2 class="title" id="nom-serie-<%= c.id %>"><%= c.name %></h2>
      <span class="count mono"><%= c.count > 1 ? t('{n} photos', { n: c.count }) : t('{n} photo', { n: c.count }) %></span>
    </div>
    <div class="acts">
      <a class="btn ghost" href="/admin/photos?serie=<%= c.slug %>"><%= t('Photos') %> ›</a>
      <details class="inline-edit"<%~ ed ? ' open' : '' %>>
        <summary class="btn ghost"><%= t('Renommer') %></summary>
        <form class="pop" method="post" action="/admin/series/<%= c.id %>">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <label><%= t('Nom') %> <input name="name" value="<%= v.name %>" required maxlength="80"<%~ ed && ed.errors.name ? ` aria-invalid="true" aria-describedby="err-serie-${c.id}"` : '' %>></label>
          <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'name', label: t('Nom'), max: 80 }) %>
          <details class="advanced"<%~ ed && ed.errors.slug ? ' open' : '' %>>
            <summary><%= t('Adresse de la série (avancé)') %></summary>
            <label><span class="mono">/serie/</span><input name="slug" value="<%= v.slug %>" maxlength="80"<%~ ed && ed.errors.slug ? ` aria-invalid="true" aria-describedby="err-serie-${c.id}"` : '' %>></label>
            <span class="cellnote warn"><%= t('Changer l’adresse casse les liens déjà partagés.') %></span>
          </details>
<% if (ed) { %>          <span class="err" role="alert" id="err-serie-<%= c.id %>"><%= Object.values(ed.errors).join(' ') %></span>
<% } %>
          <p class="actions"><button class="btn" type="submit"><%= t('Enregistrer') %></button></p>
        </form>
      </details>
      <details class="menu">
        <summary class="iconbtn" aria-label="<%= t('Plus d’actions pour « {name} »', { name: c.name }) %>"><span aria-hidden="true">⋯</span></summary>
        <div class="menu-pop">
<% [['up', t('Monter d’une place'), i === 0], ['down', t('Descendre d’une place'), i === it.categories.length - 1]].forEach(([dir, label, off]) => { if (off) return; %>
          <form method="post" action="/admin/series/<%= c.id %>/move"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="dir" value="<%= dir %>">
            <button type="submit"><%= label %></button></form>
<% }) %>
          <details class="danger">
            <summary><%= t('Supprimer…') %></summary>
            <form method="post" action="/admin/series/<%= c.id %>/delete" data-delete-series>
              <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (c.count && !(it.canAll('photos.modifier') && it.canAll('photos.publiees.modifier'))) { %>
              <p><%= t('« {name} » contient', { name: c.name }) %> <strong><%= c.count > 1 ? t('{n} photos', { n: c.count }) : t('{n} photo', { n: c.count }) %></strong>. <%= t('Seul un compte qui peut modifier toutes les photos peut la vider ; une série vide se supprime ici.') %></p>
<% } else if (c.count && others(c).length) { %>
              <p><%= t('« {name} » contient', { name: c.name }) %> <strong><%= c.count > 1 ? t('{n} photos', { n: c.count }) : t('{n} photo', { n: c.count }) %></strong>. <%= t('Elles ne seront pas supprimées : choisissez où les déplacer.') %></p>
              <label><%= t('Déplacer vers') %> <select name="move_to"><% others(c).forEach(o => { %><option value="<%= o.id %>"><%= o.name %></option><% }) %></select></label>
              <button class="btn danger" type="submit"><%= c.count > 1 ? t('Déplacer les {n} photos et supprimer', { n: c.count }) : t('Déplacer la photo et supprimer') %></button>
<% } else if (c.count) { %>
              <p><%= c.count > 1 ? t('C’est la seule série : ses {n} photos n’auraient nulle part où aller. Créez d’abord une autre série.', { n: c.count }) : t('C’est la seule série : sa photo n’aurait nulle part où aller. Créez d’abord une autre série.', { n: c.count }) %></p>
<% } else { %>
              <p><%= t('La série est vide.') %></p>
              <button class="btn danger" type="submit"><%= t('Supprimer « {name} »', { name: c.name }) %></button>
<% } %>
            </form>
          </details>
        </div>
      </details>
    </div>
  </article>
<% }) %>
</div>
<% const sg = it.suggest; const pct = (a, b) => (b ? Math.round((a / b) * 100) : 0); %>
<% if (it.can('series.propositions')) { /* réglage et suivi réservés à ce droit : sans lui, le suivi recevrait un refus */ %>
<section class="panel suggest-panel" id="propositions" aria-labelledby="propositions-titre" data-suggest-state="<%= sg.status %>">
  <h2 id="propositions-titre"><%= t('Proposer une série') %> <span class="mono"><%= t('désactivé par défaut') %></span></h2>
  <p class="hint"><%= t('Pour une photo dont vous n’avez pas encore choisi la série, le serveur cherche la série dont les photos lui ressemblent le plus, et la propose (vue rapide, fiche, sortie, filtre « Série proposée »). Rien n’est jamais classé sans votre clic.') %></p>
  <p class="hint"><%= t('Analyse des images sur ce serveur, par un modèle libre (CLIP) : aucun envoi à l’extérieur, aucune reconnaissance de personne. Une série n’est proposée qu’à partir de 3 photos rangées.') %></p>
  <p class="suggest-status" role="status" data-suggest-status>
<% if (sg.status === 'off') { %>    <span class="enc-tag"><%= t('Éteint') %></span> <%= t('Au premier allumage, le modèle d’analyse (≈ {n} Mo) est téléchargé une seule fois, puis les photos existantes sont analysées en tâche de fond.', { n: Math.round(sg.modelBytes / 1e6) }) %>
<% } else if (sg.status === 'downloading') { %>    <span class="enc-tag warn"><%= t('Téléchargement du modèle') %></span> <span data-suggest-n><%= t('{got} Mo sur {total}', { got: Math.round(sg.download.got / 1e6), total: Math.round(sg.download.total / 1e6) }) %></span> <progress max="100" value="<%= pct(sg.download.got, sg.download.total) %>"></progress>
<% } else if (sg.status === 'analysing') { %>    <span class="enc-tag warn"><%= t('Analyse en cours') %></span> <span data-suggest-n><%= t('{done} photos sur {total}', { done: sg.done, total: sg.total }) %></span> <progress max="100" value="<%= pct(sg.done, sg.total) %>"></progress>
<% } else if (sg.status === 'error') { %>    <span class="enc-tag no"><%= t('Modèle indisponible') %></span> <%= t.msg(sg.error) %> · <%= t('nouvel essai au prochain démarrage, ou éteignez puis rallumez.') %>
<% } else { %>    <span class="enc-tag ok"><%= t('Prêt') %></span> <%= sg.done > 1 ? t('{n} photos analysées', { n: sg.done }) : t('{n} photo analysée', { n: sg.done }) %>
<% } %>  </p>
  <form method="post" action="/admin/series/propositions" class="actions">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (sg.enabled) { %>    <button class="btn ghost" type="submit" name="action" value="off"><%= t('Éteindre et effacer') %></button>
    <span class="hint"><%= t('Supprime le modèle et toutes les empreintes d’images.') %></span>
<% } else { %>    <button class="btn" type="submit" name="action" value="on"><%= t('Allumer les propositions') %></button>
<% } %>  </form>
</section>
<% } %>
<% const ds = it.describe, DM = it.describeModels; if (ds && it.can('series.propositions')) { %>
<section class="panel suggest-panel" id="descriptions" aria-labelledby="descriptions-titre">
  <h2 id="descriptions-titre"><%= t('Décrire les photos') %> <span class="mono"><%= t('désactivé par défaut') %></span></h2>
  <p class="hint"><%= t('Une phrase courte et factuelle par photo (« un phare rouge sur une petite île »), proposée sur la fiche, sous la légende : à relire et à réécrire, jamais recopiée seule. Modèle libre Florence-2, sur ce serveur : aucune image n’en sort, et il ne nomme jamais les personnes.') %></p>
  <p class="hint"><%= it.translate ? t('Le modèle écrit en anglais ; la description est traduite en français et en allemand par le traducteur du site.') : t('Le modèle écrit en anglais. Sans traducteur configuré (TRANSLATE_URL), la description reste en anglais.') %></p>
  <p class="suggest-status" role="status">
<% if (!ds.on) { %>    <span class="enc-tag"><%= t('Éteint') %></span>
<% } else if (ds.busy) { %>    <span class="enc-tag warn"><%= t('Description en cours') %></span> <%= t('{done} photos décrites sur {total}', { done: ds.done, total: ds.total }) %>
<% } else if (ds.error) { %>    <span class="enc-tag no"><%= t('Dernier essai sans succès') %></span> <%= t.msg(ds.error) %>
<% } else { %>    <span class="enc-tag ok"><%= t('Allumé') %></span> <%= t('{done} photos décrites sur {total}', { done: ds.done, total: ds.total }) %>
<% } %>  </p>
  <form method="post" action="/admin/series/descriptions" class="form">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <fieldset class="row"><legend><%= t('Modèle') %></legend>
<% Object.entries(DM).forEach(([k, m]) => { const ok = ds.fits[k]; %>      <label class="inline"><input type="radio" name="model" value="<%= k %>"<%~ (ds.effective || 'base') === k && ok ? ' checked' : '' %><%~ ok ? '' : ' disabled' %>> <strong><%= k === 'large' ? t('Précis') : t('Léger') %></strong> <span class="mono"><%= t('Florence-2 {k} · ≈ {mb} Mo à télécharger · ≈ {ram} Go de mémoire pendant le calcul', { k, mb: m.mb, ram: m.ram }) %><%= ok ? '' : ` · ${t('mémoire insuffisante')}` %></span></label>
<% }) %>      <p class="hint"><%= t('Mémoire du site : {x} Go.', { x: (ds.memory / 2 ** 30).toFixed(1) }) %> <%= ds.fits.large ? t('« Précis » est possible.') : ds.hostFits.large ? t('« Précis » demande 6 Go : ajoutez SITE_MEM_LIMIT=6g au .env de la pile, puis Compose Up.') : t('« Précis » demande 6 Go : la machine n’en a pas assez, gardez « Léger ».') %></p>
<% if (ds.on && ds.effective && ds.effective !== ds.model) { %>      <p class="cellnote warn">▲ <%= t('« Précis » est choisi, mais la mémoire du site ne suffit plus : les descriptions utilisent « Léger ».') %></p>
<% } else if (!ds.fits.base) { %>      <p class="cellnote warn">▲ <%= t('Même « Léger » demande 3 Go : les descriptions ne peuvent pas tourner avec cette mémoire.') %></p>
<% } %>    </fieldset>
    <div class="row">
      <label><%= t('La nuit, de') %> <input type="number" name="from" min="0" max="23" value="<%= ds.from %>"> <%= t('h') %></label>
      <label><%= t('à') %> <input type="number" name="to" min="0" max="23" value="<%= ds.to %>"> <%= t('h') %></label>
    </div>
    <p class="hint"><%= t('Les photos sans description sont décrites pendant ces heures (heure de Paris), une à la fois, sur un seul cœur. Une photo demandée depuis sa fiche passe tout de suite.') %></p>
    <p class="actions"><button class="btn" type="submit" name="action" value="on"><%= ds.on ? t('Enregistrer') : t('Allumer les descriptions') %></button>
<% if (ds.on) { %>      <button class="btn ghost" type="submit" name="action" value="off" formnovalidate><%= t('Éteindre et effacer le modèle') %></button><% } %></p>
  </form>
</section>
<% } %>
<p class="sr-only" id="grip-help"><%= t('Flèches haut ou gauche : avancer d’une place. Flèches bas ou droite : reculer d’une place.') %></p>
