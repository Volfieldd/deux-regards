<% if (!it.corps) layout('./layout'); const t = it.t, s = it.saison, p = it.propositions; %>
<div class="saisons">
<header class="saisons-entete"><a class="saisons-retour" href="/admin/saisons/<%= s.id %>">← <%= s.title %></a><h1><%= t('Photos proposées au vote') %></h1></header>
<p class="saisons-note"><%= t('Le vote est consultatif. Le photographe propose, le relecteur relit, puis l’administrateur valide. Seule la direction de publication peut réordonner les propositions.') %></p>
<% if (it.error) { %><section class="saisons-erreur" role="alert"><h2><%= t('L’action n’a pas été enregistrée.') %></h2><p><%= it.error %></p><a class="btn ghost" href="/admin/saisons/<%= s.id %>/vote"><%= t('Recharger la dernière version') %></a></section><% } %>
<section class="panel"><h2><%= t('Liste actuelle') %></h2><p><%= t('Version {n}', { n: p.version }) %></p>
<dl class="saisons-recap"><dt><%= t('Relecture') %></dt><dd><%= p.reviewed_version === p.version ? t('Validée pour cette version') : t('En attente') %></dd><dt><%= t('Validation de l’administration') %></dt><dd><%= p.validated_version === p.version ? t('Validée pour cette version') : t('En attente') %></dd></dl>
<% if (p.validated_version !== p.version) { %><p class="saisons-note"><%= t('Les propositions ne sont pas ouvertes au vote tant que les deux validations de cette version ne sont pas enregistrées.') %></p><% } %>
<% if (!it.photos.length) { %><p><%= t('Aucune photographie proposée.') %></p><% } else { %><ol class="saisons-miniatures"><% it.photos.forEach(ph => { %><li><% if (ph.thumb) { %><img class="saisons-vignette" src="<%= ph.thumb %>" width="80" height="<%= Math.round(80 * ph.height / ph.width) %>" alt="" loading="lazy"><% } %><span><%= ph.title %></span></li><% }) %></ol><% } %></section>
<section class="panel"><h2><%= t('Votes consultatifs') %></h2><p class="saisons-note"><%= t('Ces totaux aident la décision éditoriale. Aucun score ne publie une œuvre dans la collection permanente. Les visiteurs ne voient pas ces résultats.') %></p>
<% if (!it.voteCounts.length) { %><p><%= t('Aucun vote enregistré.') %></p><% } else { %><table><thead><tr><th scope="col"><%= t('Photographie') %></th><th scope="col"><%= t('Votes') %></th></tr></thead><tbody><% it.voteCounts.forEach(row => { %><tr><th scope="row"><%= row.title %></th><td><%= row.total %></td></tr><% }) %></tbody></table><% } %></section>
<% if (!it.active) { %><p class="saisons-note"><%= t('Le choix au vote est figé après la clôture ou le retrait.') %></p><% } %>
<% if (it.canPropose) { %><form class="panel form" method="post" action="/admin/saisons/<%= s.id %>/vote/proposer"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= p.version %>"><h2><%= t('Choisir les photographies proposées') %></h2><p class="hint"><%= t('L’ordre des photographies conservées reste identique. Les nouvelles propositions sont ajoutées à la fin.') %></p>
<fieldset class="saisons-choix"><legend><%= t('Photos publiées de l’accrochage') %></legend><% it.candidates.forEach(ph => { %><label><input type="checkbox" name="photo_ids[]" value="<%= ph.id %>"<%~ p.photo_ids.includes(ph.id) ? ' checked' : '' %>><% if (ph.thumb) { %><img class="saisons-vignette" src="<%= ph.thumb %>" width="80" height="<%= Math.round(80 * ph.height / ph.width) %>" alt="" loading="lazy"><% } %><span><%= ph.title %></span></label><% }) %></fieldset><button class="btn" type="submit"><%= t('Enregistrer les propositions') %></button></form><% } %>
<% if (it.canReorder && it.photos.length > 1) { %><form class="panel form" method="post" action="/admin/saisons/<%= s.id %>/vote/ordonner"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= p.version %>"><h2><%= t('Réordonner les propositions') %></h2><p class="hint"><%= t('Tout changement de liste ou d’ordre annule les deux validations, y compris pendant l’exposition.') %></p><% it.photos.forEach((ph, i) => { %><input type="hidden" name="photo_ids[]" value="<%= ph.id %>"><div class="saisons-champ"><label for="position-<%= ph.id %>"><%= t('Position de « {title} »', { title: ph.title }) %></label><input id="position-<%= ph.id %>" name="position_<%= ph.id %>" type="number" min="1" max="<%= it.photos.length %>" value="<%= i + 1 %>" required></div><% }) %><button class="btn" type="submit"><%= t('Enregistrer l’ordre') %></button></form><% } %>
<% if (it.canReview && it.photos.length && p.reviewed_version !== p.version) { %><form class="panel form" method="post" action="/admin/saisons/<%= s.id %>/vote/relire"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= p.version %>"><h2><%= t('Relecture de la liste') %></h2><p><%= t('Je valide les photographies et leur ordre dans la version affichée.') %></p><button class="btn" type="submit"><%= t('Valider la relecture') %></button></form><% } %>
<% if (it.canValidate && p.reviewed_version === p.version && p.validated_version !== p.version) { %><form class="panel form" method="post" action="/admin/saisons/<%= s.id %>/vote/valider"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= p.version %>"><h2><%= t('Validation de l’administration') %></h2><p><%= t('Je valide les photographies et leur ordre dans la version affichée.') %></p><button class="btn" type="submit"><%= t('Ouvrir cette liste au vote') %></button></form><% } %>
</div>
