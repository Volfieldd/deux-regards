<% layout('./layout') %>
<% /* Messages et demandes (admin v1) : la boîte des messages envoyés par la page Contact et par la demande de licence
      (server/routes/messages.js). La liste ne montre aucune donnée personnelle (ni nom, ni adresse, ni message) : on les
      lit en ouvrant le message, lecture notée au journal. */ %>
<% const t = it.t; const KIND = { contact: t('Message (page Contact)'), licence: t('Demande de licence') };
   const USAGE = { presse: t('livre ou presse imprimée'), web: t('site web ou réseaux sociaux'), publicite: t('publicité, affiche'), autre: t('autre usage') };
   const when = ms => new Intl.DateTimeFormat(it.locale, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' }).format(ms);
   const to = m => (m.author_name ? t('Pour {name}', { name: m.author_name }) : m.to_all ? t('Pour les deux photographes') : t('Photographe supprimé depuis'));
   const C = it.box.counts;
   const q = (etat, page) => { const p = new URLSearchParams(); if (etat) p.set('etat', etat); if (page > 1) p.set('page', page); const s = p.toString(); return '/admin/messages' + (s ? '?' + s : ''); }; %>
<h1><%= t('Messages et demandes') %></h1>
<p class="prose"><%= t('Envoyés depuis la page Contact et les demandes de licence du site. Nom, adresse et message chiffrés, effacés au bout de 12 mois ; ils ne s’affichent qu’en ouvrant le message (lecture notée au journal). Aucun accusé de réception n’est envoyé : répondez depuis le message.') %><% if (it.ownScope) { %> <%= t('Vous voyez les messages qui vous sont adressés et ceux adressés aux deux photographes.') %><% } %></p>
<p class="actions"><a class="btn ghost" href="<%= q('') %>"<%~ !it.etat ? ' aria-current="page"' : '' %>><%= t('Tous') %> (<%= C.total %>)</a> <a class="btn ghost" href="<%= q('nouveau') %>"<%~ it.etat === 'nouveau' ? ' aria-current="page"' : '' %>><%= t('Nouveaux') %> (<%= C.nouveaux %>)</a></p>
<% if (!it.list.length) { %>
<p class="empty"><%= !C.total ? t('Aucun message.') : t('Aucun message pour ce filtre.') %></p>
<% } else { %>
<ul class="reports">
<% it.list.forEach(m => { %>
  <li class="panel<%= m.status === 'nouveau' ? ' fresh' : '' %>">
<% if (m.photo) { %>    <a class="rp-photo" href="/admin/photos/<%= m.photo_id %>"><% if (m.photo.ready) { %><%~ it.picture(m.photo, { sizes: '96px', alt: '' }) %><% } %><span><%= m.photo_title %></span></a>
<% } %>    <div class="rp-body">
      <p><span class="enc-tag<%= m.kind === 'licence' ? ' warn' : '' %>"><%= KIND[m.kind] %></span> <span class="mono"><%= when(m.created_at) %> · <%= m.lang.toUpperCase() %><%= m.status === 'traite' ? ` · ${t('traité')}` : '' %></span></p>
      <p><%= to(m) %><%= m.usage ? ` · ${USAGE[m.usage] || m.usage}` : '' %></p>
      <div class="rp-acts"><a class="btn ghost" href="/admin/messages/<%= m.id %>"><%= m.kind === 'licence' ? t('Lire la demande n° {id}', { id: m.id }) : t('Lire le message n° {id}', { id: m.id }) %></a></div>
    </div>
  </li>
<% }) %>
</ul>
<% } %>
<% if (it.box.pages > 1) { %><p class="actions"><% if (it.box.page > 1) { %><a class="btn ghost" href="<%= q(it.etat, it.box.page - 1) %>"><%= t('Page précédente') %></a> <% } %><span><%= t('Page {p} sur {n}', { p: it.box.page, n: it.box.pages }) %></span><% if (it.box.page < it.box.pages) { %> <a class="btn ghost" href="<%= q(it.etat, it.box.page + 1) %>"><%= t('Page suivante') %></a><% } %></p>
<% } %>
