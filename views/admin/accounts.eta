<% layout('./layout') %>
<% const t = it.t; const STATUS = { actif: t('actif'), en_attente: t('en attente'), desactive: t('désactivé') };
   const when = ms => (ms ? new Intl.DateTimeFormat(it.locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Paris' }).format(ms) : t('jamais')); %>
<h1><%= t('Comptes et rôles') %></h1>
<p class="prose"><%= t('Un compte est créé à la première connexion. Il reste « en attente » tant qu’aucun rôle ne lui est donné ; un rôle s’applique tout de suite, et le retirer aussi.') %> <%= t('Le photographe lié sert aux valeurs par défaut (import, app Terrain) et décide de ce que voit un compte Photographe : seulement ses photos, ses sorties et ses personnes.') %></p>
<ul class="role-legend" aria-label="<%= t('Rôles') %>">
  <li><strong><%= t('Administrateur') %></strong> <%= t('tout, y compris les comptes et le journal') %></li>
  <li><strong><%= t('Modérateur') %></strong> <%= t('valide et publie, signalements, remarques au photographe ; ne retouche pas, aucune donnée personnelle') %></li>
  <li><strong><%= t('Relecteur') %></strong> <%= t('relit et traduit les textes') %></li>
  <li><strong><%= t('Photographe') %></strong> <%= t('ses photos, ses sorties, ses personnes ; ne publie pas') %></li>
</ul>
<% if (it.guarded) { %><p class="hint"><%= t('Garde-fou ADMIN_SUBS : les comptes marqués « protégé » restent toujours administrateurs.') %></p><% } %>
<ul class="accounts">
<% it.accounts.forEach(a => { const self = a.sub === it.me; %>
  <li class="panel<%= a.status === 'en_attente' ? ' fresh' : '' %>">
    <form method="post" action="/admin/comptes/<%= a.id %>" class="acc-form">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <div class="acc-who">
        <strong><%= a.name || t('sans nom') %></strong><% if (self) { %> <span class="enc-tag"><%= t('vous') %></span><% } %><% if (a.locked) { %> <span class="enc-tag ok"><%= t('protégé') %></span><% } %>
        <span class="enc-tag <%= a.status === 'actif' ? 'ok' : a.status === 'en_attente' ? 'warn' : 'no' %>"><%= STATUS[a.status] %></span>
        <span class="mono"><% if (a.email) { %><%= a.email %> · <% } %><%= t('dernière connexion : {date}', { date: when(a.last_login_at) }) %></span>
        <span class="mono acc-sub"><%= t('Identifiant (sub)') %> : <code class="sub-nolang"><%= a.sub %></code></span>
      </div>
      <fieldset class="acc-roles"><legend><%= t('Rôles') %></legend>
<% it.roles.forEach(r => { const on = a.roles.includes(r.key); %>        <label class="inline"><input type="checkbox" name="roles" value="<%= r.key %>"<%~ on ? ' checked' : '' %><%~ !r.ready || (a.locked && r.key === 'admin') ? ' disabled' : '' %>> <%= t(r.label) %></label>
<% }) %>      </fieldset>
<% if (a.roles.includes('photographe') && !a.author_id && !a.roles.includes('admin')) { %>      <p class="cellnote warn"><%= t('Photographe sans photographe lié : il ne voit rien tant qu’un photographe ne lui est pas relié.') %></p>
<% } %>      <label><%= t('Photographe lié') %> <select name="author_id"><option value=""><%= t('aucun') %></option><% it.authors.forEach(au => { %><option value="<%= au.id %>"<%~ au.id === a.author_id ? ' selected' : '' %>><%= au.name %></option><% }) %></select></label>
<% if (!self && !a.locked) { %>      <label class="inline"><input type="checkbox" name="status" value="desactive"<%~ a.status === 'desactive' ? ' checked' : '' %>> <%= t('Désactivé (ne peut plus se connecter)') %></label>
<% } %>      <p class="actions"><button class="btn" type="submit"><%= a.status === 'en_attente' ? t('Donner ce rôle') : t('Enregistrer') %></button></p>
    </form>
<% if (!self && !a.locked) { %>    <form method="post" action="/admin/comptes/<%= a.id %>/supprimer" class="acc-del"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="linkbtn" type="submit"><%= t('Supprimer ce compte') %></button></form>
<% } %>  </li>
<% }) %>
</ul>
<p class="hint"><%= t('Qui a fait quoi :') %> <a class="more" href="/admin/journal"><%= t('Journal') %></a></p>

<section class="panel" id="email" aria-labelledby="email-title">
  <h2 id="email-title"><%= t('E-mails') %> <% if (it.mail.enabled) { %><span class="enc-tag ok"><%= t('configurés') %></span><% } else { %><span class="enc-tag no"><%= t('non configurés') %></span><% } %></h2>
<% if (it.mail.enabled) { %>
  <p class="prose"><%= t('Le serveur envoie les e-mails de l’admin (propositions, décisions, remarques, récapitulatifs, demandes RGPD et leurs relances) depuis {from}.', { from: it.mail.from || t('l’adresse de SMTP_URL') }) %></p>
  <form method="post" action="/admin/comptes/test-email" class="form row-form">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label><%= t('Envoyer un e-mail de test à') %> <input type="email" name="adresse" value="<%= it.mail.mine %>" maxlength="200" required></label>
    <p class="actions"><button class="btn ghost" type="submit"><%= t('Envoyer le test') %></button></p>
  </form>
<% } else { %>
  <p class="prose"><%= t('Renseignez SMTP_URL et MAIL_FROM dans la configuration du serveur : sans eux, seul « Aujourd’hui » prévient, et les relances RGPD ne partent pas.') %></p>
<% } %>
  <p class="hint"><%= t('Demandes RGPD : e-mail au photographe concerné dès l’arrivée, rappel au quart du délai d’un mois, puis à la moitié avec l’administrateur en copie, et un dernier e-mail prioritaire aux trois quarts. Sans photographe joignable, l’administrateur les reçoit directement.') %></p>
</section>
