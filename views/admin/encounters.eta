<% layout('./layout') %>
<% const consentTag = e => e.refused ? '<span class="enc-tag no">Refus de publication</span>'
     : e.consent ? `<span class="enc-tag ok">Accord ${e.consent_source !== 'en_ligne' ? 'signé' : 'en ligne'} : ${it.SCOPES.filter(s => e.consent[s]).map(s => it.SCOPE_LABELS[s]).join(', ')}</span>` : ''; %>
<div class="toolbar">
  <div>
    <h1>Personnes photographiées</h1>
    <p class="sub">Les personnes photographiées dans la rue : demandes reçues par la page <a href="/bonjour" target="_blank" rel="noopener">/bonjour</a> (QR des cartes) et accords signés sur les cartes.</p>
  </div>
  <span class="toolbar-actions"><a class="btn" href="/admin/rencontre">Nouvelle rencontre</a> <a class="btn ghost" href="/admin/terrain">Sur le terrain</a></span>
</div>
<nav class="chips" aria-label="Filtrer les rencontres">
  <a href="/admin/rencontres"<%~ !it.status ? ' aria-current="true"' : '' %>>Toutes</a>
<% Object.entries(it.STATUS).forEach(([k, label]) => { %>  <a href="/admin/rencontres?statut=<%= k %>"<%~ it.status === k ? ' aria-current="true"' : '' %>><%= label %>s</a>
<% }) %></nav>
<% if (it.list.length) { %>
<ul class="enc-list">
<% it.list.forEach(e => { %>
  <li class="enc-item <%= e.status %>">
    <div>
      <h2><% if (e.hasPortrait) { %><img class="enc-face" src="/admin/rencontres/<%= e.id %>/portrait?mini=1" alt="" width="32" height="32" loading="lazy"> <% } %><a href="/admin/rencontres/<%= e.id %>"><%= e.anonymized ? 'Refus anonymisé' : (e.ref || 'Sans carte') %><%= e.name ? ` · ${e.name}` : '' %></a></h2>
      <div class="enc-meta">
        <span class="enc-tag"><%= it.STATUS[e.status] %></span>
<% if (e.author) { %>        <span class="enc-tag"><%= e.author %></span><% } %>
<% if (e.ref && !e.verified) { %>        <span class="enc-tag warn" title="Référence tapée sans le code de contrôle de la carte">non vérifiée</span><% } %>
<% if (e.wants_photo) { %>        <span class="enc-tag">veut la photo</span><% } %>
        <%~ consentTag(e) %>
<% if (e.photos) { %>        <span class="enc-tag"><%= e.photos %> photo<%= e.photos > 1 ? 's' : '' %> liée<%= e.photos > 1 ? 's' : '' %></span><% } %>
<% if (e.rights_request && !e.rights_done_at) { const due = e.rights_requested_at + 30 * 864e5; %>        <span class="enc-tag no">Demande <%= e.rights_request === 'acces' ? 'd’accès' : 'd’effacement' %> · avant le <%= it.fmt(due).replace(/,? \d+:\d+$/, '') %></span><% } %>
<% if (e.anonymized) { %>        <span class="enc-tag">refus anonymisé</span><% } %>
      </div>
    </div>
    <span class="mono"><%= it.fmt(e.updated_at) %></span>
<% if (e.last && (e.last.message || e.last.place)) { %>    <p class="enc-quote"><%= e.last.message ? `« ${e.last.message.slice(0, 160)}${e.last.message.length > 160 ? '…' : ''} »` : `${e.last.met_on || ''} · ${e.last.place}` %></p><% } %>
  </li>
<% }) %>
</ul>
<% } else { %>
<p class="panel hint">Aucune rencontre<%= it.status ? ' dans cette catégorie' : ' pour l’instant' %>. Les demandes envoyées depuis <a href="/bonjour" target="_blank" rel="noopener">/bonjour</a> arrivent ici.</p>
<% } %>

<details class="panel" id="nouvelle"<%~ Object.keys(it.errors).length ? ' open' : '' %>>
  <summary><strong>Saisir une carte signée</strong> <span class="mono">accord papier (carte « pour nous »)</span></summary>
  <%~ include('./_encounter-form', { ...it, v: it.values || {}, action: '/admin/rencontres', isNew: true }) %>
</details>
