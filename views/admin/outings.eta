<% layout('./layout') %>
<% const t = it.t; const TAG = { refus: 'no', 'a-trier': 'warn', terminee: 'ok' };
   const pl = (n, zero, one, many) => n > 1 ? many : n === 1 ? one : zero;
   const q = o => { const p = new URLSearchParams(); const all = { photographe: it.author ? it.author.slug : '', etat: it.state, ...o }; for (const [k, v] of Object.entries(all)) if (v) p.set(k, v); const s = p.toString(); return '/admin/sorties' + (s ? '?' + s : ''); }; %>
<div class="outing-head"><h1><%= t('Sorties') %></h1><a class="btn ghost" href="/admin/voyages"><%= t('Voyages') %></a></div>
<p class="prose"><%= t('Une sortie, c’est une journée de prise de vue d’un photographe : ses photos de ce jour-là (date de l’appareil) et les personnes rencontrées. Elles se créent toutes seules, à l’import des photos ou à la première rencontre du jour ; une sortie se coupe en deux (matin, soir) depuis sa fiche.') %></p>
<nav class="chips" aria-label="<%= t('État') %>">
  <a class="chip" href="<%= q({ etat: '' }) %>"<%~ !it.state ? ' aria-current="true"' : '' %>><%= t('Toutes') %> <span class="n"><%= it.total %></span></a>
<% Object.entries(it.STATES).forEach(([k, label]) => { %>  <a class="chip" href="<%= q({ etat: k }) %>"<%~ it.state === k ? ' aria-current="true"' : '' %>><span class="enc-tag <%= TAG[k] %>"><%= label %></span> <span class="n"><%= it.counts[k] %></span></a>
<% }) %>
</nav>
<% if (it.authors.length > 1) { %>
<nav class="chips" aria-label="<%= t('Photographe') %>">
  <a class="chip" href="<%= q({ photographe: '' }) %>"<%~ !it.author ? ' aria-current="true"' : '' %>><%= it.authors.length === 2 ? t('Les deux') : t('Tous') %></a>
<% it.authors.forEach(a => { %>  <a class="chip" href="<%= q({ photographe: a.slug }) %>"<%~ it.author && it.author.id === a.id ? ' aria-current="true"' : '' %>><%= a.name %></a>
<% }) %></nav>
<% } %>
<% if (!it.list.length) { %>
<p class="empty"><%= it.state ? t('Aucune sortie dans cet état : importez des photos datées par l’appareil, ou enregistrez une rencontre.') : t('Aucune sortie : importez des photos datées par l’appareil, ou enregistrez une rencontre.') %></p>
<% } else { %>
<ul class="outings">
<% it.list.forEach(o => { %>
  <li class="outing-row">
    <a class="o-main" href="<%= o.url %>"><strong><%= o.when %><%= o.place ? ` · ${o.place}` : '' %></strong><span class="mono"><%= o.author.name %><%= o.range ? ` · ${o.range}` : '' %><%= o.trip ? ` · ${t('voyage « {name} »', { name: o.trip.name })}` : '' %></span></a>
    <span class="o-strip" aria-hidden="true"><% o.strip.forEach(p => { %><%~ it.picture(p, { sizes: '48px', alt: '' }) %><% }) %></span>
    <span class="o-n"><%= pl(o.counts.photos, t('0 photo'), t('1 photo'), t('{n} photos', { n: o.counts.photos })) %><small><%= o.counts.published > 1 ? t('{n} publiées', { n: o.counts.published }) : t('{n} publiée', { n: o.counts.published }) %></small></span>
    <span class="o-people">
<% if (!o.people.length) { %>      <span class="hint"><%= t('personne') %></span>
<% } else { %>      <span class="faces"><% o.people.slice(0, 5).forEach(e => { %><% if (e.hasPortrait) { %><img class="enc-face" src="/admin/rencontres/<%= e.id %>/portrait?mini=1" alt="" width="26" height="26" loading="lazy"><% } else { %><span class="face-ini" aria-hidden="true"><%= (e.name || e.ref || '?').charAt(0).toUpperCase() %></span><% } %><% }) %></span>
      <span class="o-tags"><% if (o.counts.accords) { %><span class="enc-tag ok"><%= o.counts.accords > 1 ? t('{n} accords', { n: o.counts.accords }) : t('{n} accord', { n: o.counts.accords }) %></span><% } %><% if (o.counts.refusals) { %> <span class="enc-tag no"><%= t('{n} refus', { n: o.counts.refusals }) %></span><% } %><% if (o.counts.undecided) { %> <span class="enc-tag"><%= t('{n} sans décision', { n: o.counts.undecided }) %></span><% } %></span>
<% } %>    </span>
    <span class="o-state"><span class="enc-tag <%= TAG[o.state] %>"><%= it.STATES[o.state] %></span></span>
  </li>
<% }) %>
</ul>
<% } %>
