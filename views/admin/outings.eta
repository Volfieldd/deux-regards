<% layout('./layout') %>
<% const TAG = { refus: 'no', 'a-trier': 'warn', terminee: 'ok' };
   const q = o => { const p = new URLSearchParams(); const all = { photographe: it.author ? it.author.slug : '', etat: it.state, ...o }; for (const [k, v] of Object.entries(all)) if (v) p.set(k, v); const s = p.toString(); return '/admin/sorties' + (s ? '?' + s : ''); }; %>
<h1>Sorties</h1>
<p class="prose">Une sortie, c’est une journée de prise de vue d’un photographe : ses photos de ce jour-là (date de l’appareil) et les personnes rencontrées. Elles se créent toutes seules, à l’import des photos ou à la première rencontre du jour ; une sortie se coupe en deux (matin, soir) depuis sa fiche.</p>
<nav class="chips" aria-label="État">
  <a class="chip" href="<%= q({ etat: '' }) %>"<%~ !it.state ? ' aria-current="true"' : '' %>>Toutes <span class="n"><%= it.total %></span></a>
<% Object.entries(it.STATES).forEach(([k, label]) => { %>  <a class="chip" href="<%= q({ etat: k }) %>"<%~ it.state === k ? ' aria-current="true"' : '' %>><span class="enc-tag <%= TAG[k] %>"><%= label %></span> <span class="n"><%= it.counts[k] %></span></a>
<% }) %>
</nav>
<% if (it.authors.length > 1) { %>
<nav class="chips" aria-label="Photographe">
  <a class="chip" href="<%= q({ photographe: '' }) %>"<%~ !it.author ? ' aria-current="true"' : '' %>>Les deux</a>
<% it.authors.forEach(a => { %>  <a class="chip" href="<%= q({ photographe: a.slug }) %>"<%~ it.author && it.author.id === a.id ? ' aria-current="true"' : '' %>><%= a.name %></a>
<% }) %></nav>
<% } %>
<% if (!it.list.length) { %>
<p class="empty">Aucune sortie<%= it.state ? ' dans cet état' : '' %> : importez des photos datées par l’appareil, ou enregistrez une rencontre.</p>
<% } else { %>
<ul class="outings">
<% it.list.forEach(o => { %>
  <li class="outing-row">
    <a class="o-main" href="<%= o.url %>"><strong><%= o.when %><%= o.place ? ` · ${o.place}` : '' %></strong><span class="mono"><%= o.author.name %><%= o.range ? ` · ${o.range}` : '' %></span></a>
    <span class="o-strip" aria-hidden="true"><% o.strip.forEach(p => { %><%~ it.picture(p, { sizes: '48px', alt: '' }) %><% }) %></span>
    <span class="o-n"><%= o.counts.photos %> photo<%= o.counts.photos > 1 ? 's' : '' %><small><%= o.counts.published %> publiée<%= o.counts.published > 1 ? 's' : '' %></small></span>
    <span class="o-people">
<% if (!o.people.length) { %>      <span class="hint">personne</span>
<% } else { %>      <span class="faces"><% o.people.slice(0, 5).forEach(e => { %><% if (e.hasPortrait) { %><img class="enc-face" src="/admin/rencontres/<%= e.id %>/portrait?mini=1" alt="" width="26" height="26" loading="lazy"><% } else { %><span class="face-ini" aria-hidden="true"><%= (e.name || e.ref || '?').charAt(0).toUpperCase() %></span><% } %><% }) %></span>
      <span class="o-tags"><% if (o.counts.accords) { %><span class="enc-tag ok"><%= o.counts.accords %> accord<%= o.counts.accords > 1 ? 's' : '' %></span><% } %><% if (o.counts.refusals) { %> <span class="enc-tag no"><%= o.counts.refusals %> refus</span><% } %><% if (o.counts.undecided) { %> <span class="enc-tag"><%= o.counts.undecided %> sans décision</span><% } %></span>
<% } %>    </span>
    <span class="o-state"><span class="enc-tag <%= TAG[o.state] %>"><%= it.STATES[o.state] %></span></span>
  </li>
<% }) %>
</ul>
<% } %>
