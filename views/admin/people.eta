<% layout('./layout') %>
<% const t = it.t; const LABELS = { site: t('site'), instagram: t('Instagram'), print: t('tirages'), name: t('prénom') };
   const pl = (n, zero, one, many) => n > 1 ? many : n === 1 ? one : zero; %>
<div class="toolbar">
  <div>
    <h1><%= t('Personnes photographiées') %></h1>
    <p class="sub"><%= t('Une personne peut avoir été rencontrée lors de plusieurs sorties : une rencontre par sortie, chacune avec son accord ; un refus vaut pour toutes.') %></p>
  </div>
  <span class="toolbar-actions"><a class="btn" href="/admin/rencontre">＋ <%= t('Nouvelle rencontre') %></a> <a class="btn ghost" href="/admin/rencontres"><%= t('Demandes et rencontres') %></a></span>
</div>
<form class="filters" method="get" action="/admin/personnes" role="search"><input type="search" name="q" value="<%= it.search %>" placeholder="<%= t('Nom, référence, adresse…') %>" aria-label="<%= t('Rechercher une personne') %>"> <button class="btn ghost" type="submit"><%= t('Rechercher') %></button></form>
<% if (!it.list.length) { %>
<p class="empty"><%= it.search ? t('Aucune personne pour cette recherche. Elles apparaissent à chaque rencontre : sur le téléphone (Nouvelle rencontre), par une carte signée saisie, ou par une demande sur /bonjour.') : t('Aucune personne. Elles apparaissent à chaque rencontre : sur le téléphone (Nouvelle rencontre), par une carte signée saisie, ou par une demande sur /bonjour.') %></p>
<% } else { %>
<ul class="people-list">
<% it.list.forEach(p => { const L = p.latest; %>
  <li>
    <a class="pp-main" href="/admin/personnes/<%= p.id %>">
      <% if (p.faceFrom) { %><img class="enc-face" src="/admin/rencontres/<%= p.faceFrom %>/portrait?mini=1" alt="" width="40" height="40" loading="lazy"><% } else { %><span class="face-ini big" aria-hidden="true"><%= (p.name || p.ref || '?').charAt(0).toUpperCase() %></span><% } %>
      <span class="pp-who"><strong><%= p.name || p.ref || t('Sans nom') %></strong><small class="mono"><%= p.meetings.map(e => e.ref).filter(Boolean).join(' · ') || t('sans carte') %> · <%= pl(p.meetings.length, t('0 rencontre'), t('1 rencontre'), t('{n} rencontres', { n: p.meetings.length })) %> · <%= pl(p.photos.length, t('0 photo'), t('1 photo'), t('{n} photos', { n: p.photos.length })) %></small></span>
    </a>
    <span class="pp-tags">
<% if (p.refused) { %>      <span class="enc-tag no"><%= t('refuse la publication') %></span>
<% } else if (L && L.consent) { %>      <span class="enc-tag ok"><%= t('dernier accord : {usages}', { usages: Object.keys(LABELS).filter(s => L.consent[s]).map(s => LABELS[s]).join(', ') }) %></span>
<% } else { %>      <span class="enc-tag"><%= t('sans décision') %></span>
<% } %><% if (p.fresh) { %>      <span class="enc-tag warn"><%= t('nouvelle demande') %></span>
<% } %><% if (p.rights) { %>      <span class="enc-tag no"><%= p.rights.rights_request === 'effacement' ? t('droits : effacement') : t('droits : accès') %></span>
<% } %><% if (p.suggestions) { %>      <span class="enc-tag warn"><%= t('rapprochement proposé') %></span>
<% } %>    </span>
  </li>
<% }) %>
</ul>
<% } %>
