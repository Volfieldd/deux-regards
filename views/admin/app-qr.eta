<!doctype html>
<html lang="fr">
<head>
<%~ include('./_app-head', it) %>
</head>
<body class="app-qr-page">
<header class="app-bar">
  <a href="/admin/rencontre/accueil?photographe=<%= it.author.id %>" aria-label="Retour à l’accueil Terrain">←</a>
  <strong>Mon QR</strong>
</header>
<main class="app-qr-show">
  <p class="hint">Scannez pour retrouver la photo, donner ou refuser votre accord.<br><span lang="en">Scan to find the photo, give or refuse your consent.</span></p>
  <img src="/admin/auteurs/<%= it.author.id %>/qr/vertical-noir.svg?apercu=1" alt="QR de <%= it.author.name %>, vers <%= it.host %>/bonjour/<%= it.letter %>">
  <p class="mono"><%= it.host %>/bonjour/<%= it.letter %></p>
</main>
</body>
</html>
