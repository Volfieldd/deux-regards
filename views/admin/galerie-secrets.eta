<% if (!it.corps) layout('./layout') /* it.corps : le contenu seul, repris dans la coquille de l'admin v2 (views/admin/v2/galerie-secrets.eta) */ %>
<% /* Lien et mot de passe, une seule fois (MQ-18, état « 11 h 24 » ; G7, G57) : lus dans une mémoire du serveur liée à la
      session, effacée à cette lecture ; page « no-store », sans Referer. « Copier » n'existe qu'avec le script ; sans lui, le
      texte se sélectionne. Le site n'envoie aucun e-mail : le message du lien et celui du mot de passe sont prêts à copier,
      à envoyer par deux moyens différents. Relue (F5, Précédent) : déjà affichés, il faut en créer de nouveaux. */ %>
<% const t = it.t, s = it.s, i = it.inv, sec = it.secret; %>
<div class="gp">
<p class="help-link"><a href="/admin/aide#galeries-privees"><%= t('Aide sur cette page') %></a></p>
<header class="ep">
  <a class="ep-retour" href="/admin/galeries/<%= s.id %>"><%= s.title %></a>
  <div class="ep-titre"><h1><%= t('Accès de {name}', { name: i.label }) %></h1><%~ include('./_galerie-etat', { key: i.stateKey, text: i.stateText }) %></div>
  <p class="ep-meta"><span><%= i.is_group ? t('lien de groupe') : t('lien personnel') %></span><span><%= t('jusqu’au {date}', { date: i.expiresText }) %></span></p>
</header>
<% if (!sec) { %>
<div class="signal" role="note"><p class="signal-t"><span aria-hidden="true">▲</span> <%= t('Le lien et le mot de passe ont déjà été affichés') %></p><p><%= t('Seule leur empreinte est gardée : ils ne peuvent pas être relus. S’ils sont perdus, remplacez-les.') %></p>
  <div class="actions"><a class="btn ghost" href="/admin/galeries/<%= s.id %>/acces/<%= i.id %>/nouveau-mot-de-passe"><%= t('Nouveau mot de passe…') %></a><a class="btn ghost" href="/admin/galeries/<%= s.id %>/acces/<%= i.id %>/nouveau-lien"><%= t('Nouveau lien…') %></a><a class="btn" href="/admin/galeries/<%= s.id %>/acces/<%= i.id %>"><%= t('Voir le suivi de l’accès') %></a></div></div>
<% } else { %>
<div class="deux-col">
<section class="panel" aria-labelledby="t-sec">
  <h2 class="panel-t" id="t-sec"><%= t('À donner à {name} par un autre moyen', { name: it.first }) %></h2>
  <div class="signal gp-marge-b" role="note"><p class="signal-t"><span aria-hidden="true">▲</span> <%= t('Notez-les maintenant') %></p><p><%= t('En quittant cette page, ni le lien ni le mot de passe ne pourront être relus : seule leur empreinte est gardée. Perdus, ils se remplacent par « Nouveau mot de passe » ou « Nouveau lien ».') %></p></div>
  <div class="secrets">
<% if (sec.password) { %>    <div class="secret"><span class="lb" id="mdp-l"><%= t('Mot de passe') %></span><output class="mdp" id="mdp-v" aria-labelledby="mdp-l"><%= sec.password %></output><button class="btn ghost" type="button" hidden data-js-only data-copier="mdp-v" data-copie="<%= t('Copié') %>"><%= t('Copier le mot de passe') %></button><p class="aide"><%= t('La personne peut le taper avec ou sans espaces, en minuscules ou en majuscules.') %></p></div>
<% } %><% if (sec.link) { %>    <div class="secret"><span class="lb" id="lien-l"><%= t('Lien personnel') %></span><output id="lien-v" aria-labelledby="lien-l"><%= sec.link %></output><button class="btn ghost" type="button" hidden data-js-only data-copier="lien-v" data-copie="<%= t('Copié') %>"><%= t('Copier le lien') %></button></div>
<% } %>  </div>
</section>
<div>
<% if (it.mail) { %><section class="panel" aria-labelledby="t-mail">
  <h2 class="panel-t" id="t-mail"><%= t('Message du lien, prêt à envoyer par e-mail') %></h2>
  <div class="courriel" lang="<%= i.lang %>"><pre id="mail-v"><%= it.mail %></pre></div>
  <div class="btns-ligne gp-marge"><button class="btn ghost" type="button" hidden data-js-only data-copier="mail-v" data-copie="<%= t('Copié') %>"><%= t('Copier le message') %></button></div>
</section><% } %>
<% if (it.sms) { %><section class="panel" aria-labelledby="t-sms">
  <h2 class="panel-t" id="t-sms"><%= t('Message du mot de passe, prêt à envoyer par SMS') %></h2>
  <div class="courriel" lang="<%= i.lang %>"><p id="sms-v"><%= it.sms %></p></div>
  <div class="btns-ligne gp-marge"><button class="btn ghost" type="button" hidden data-js-only data-copier="sms-v" data-copie="<%= t('Copié') %>"><%= t('Copier le message') %></button></div>
</section><% } %>
<p class="form-pied"><a class="btn" href="/admin/galeries/<%= s.id %>/acces/<%= i.id %>"><%= t('J’ai transmis le lien et le mot de passe') %></a></p>
</div>
</div>
<% } %>
</div>
