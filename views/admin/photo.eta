<% layout('./layout') %>
<% const t = it.t, fr = !['en', 'de'].includes(it.lang), esc = __eta.e; %>
<% const v = it.values, e = it.errors; %>
<% // Droits du compte : la fiche complète, ou les textes seuls (modérateur, relecteur) ; le reste selon les droits.
   const can = it.can, pubOk = can('photos.publier'), seePeople = it.seePeople;      // personnes : celles du photographe de la photo
   // Une photo publiée ne se modifie qu'avec « modifier ses photos publiées » (réglable par photographe).
   const editableHere = it.photo.status !== 'published' || can('photos.publiees.modifier');
   const full = can('photos.modifier') && editableHere; %>
<% const inv = k => e[k] ? ` aria-invalid="true" aria-describedby="err-${k}"` : ''; %>
<p class="mono"><a class="more eyebrow" href="/admin/photos">← <%= t('Photos') %></a></p>
<h1><%= it.photo.title %></h1>
<% const R = it.ready, F = R.faces, LV = { ok: t('prête'), warn: t('à vérifier'), no: t('bloquée') }; %>
<section class="ready-band" aria-label="<%= t('État de la photo') %>">
  <span class="enc-tag <%= R.site.level %>"><%= t('Site : {state}', { state: LV[R.site.level] }) %></span>
  <span class="enc-tag <%= R.instagram.level %>"><%= t('Instagram : {state}', { state: LV[R.instagram.level] }) %></span>
  <span class="mono"><%= F.source === 'main' ? (F.has ? t('quelqu’un sur la photo (indiqué à la main)') : t('personne de reconnaissable (indiqué à la main)')) : F.source === 'attente' ? t('visages : examen en attente') : F.source === 'echec' ? t('visages : examen impossible') : F.n ? (F.n > 1 ? t('{n} visages détectés', { n: F.n }) : t('{n} visage détecté', { n: F.n })) : t('aucun visage détecté') %></span>
<% if (can('personnes.gerer')) { %>  <form class="faces-fix" method="post" action="/admin/photos/<%= it.photo.id %>/visages">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (!(F.source === 'main' && F.has)) { %>    <button class="linkbtn" type="submit" name="valeur" value="oui"><%= t('Il y a quelqu’un') %></button>
<% } %><% if (!(F.source === 'main' && !F.has)) { %>    <button class="linkbtn" type="submit" name="valeur" value="non"><%= t('Personne de reconnaissable') %></button>
<% } %><% if (F.source === 'main') { %>    <button class="linkbtn" type="submit" name="valeur" value="auto"><%= t('Revenir à la détection') %></button>
<% } %>  </form>
<% } %>
<% const reasons = [...new Set([...R.site.reasons, ...R.instagram.reasons])]; if (reasons.length && seePeople) { %>
  <ul class="ready-reasons"><% reasons.forEach(r => { %><li><%= r %></li><% }) %></ul>
<% } else if (reasons.length) { %>
  <p class="hint"><%= t('Le détail (personnes et accords) est visible du photographe et des administrateurs.') %></p>
<% } %>
<% if (it.confirmations.length) { %>
  <p class="mono"><%= t('Confirmations :') %> <%= it.confirmations.map(c => t('{usage} par {name} le {date}', { usage: c.usage === 'site' ? t('site') : 'Instagram', name: c.by_name || '?', date: new Intl.DateTimeFormat(it.locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Paris' }).format(c.at) })).join(' · ') %></p>
<% } %>
</section>
<div class="edit">
  <figure class="preview">
    <%~ it.picture(it.photo, { sizes: '(min-width: 900px) 40vw, 92vw', alt: '' }) %>
    <figcaption class="mono"><%= it.photo.width %> × <%= it.photo.height %> px<% if (it.photo.status === 'published') { %> · <a href="/photo/<%= it.photo.slug %>" target="_blank" rel="noopener"><%= t('voir sur le site') %></a><% } %></figcaption>
  </figure>
<% if (full) { %>
  <form class="panel form" method="post" action="/admin/photos/<%= it.photo.id %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (Object.keys(e).length) { %><p class="err" role="alert"><%= t('Le formulaire contient des erreurs.') %></p><% } %>
<% const has = k => Boolean(String(v[k] || '').trim()); const flag = (k, l) => `<span class="flag${has(k) ? '' : ' miss'}" title="${has(k) ? l : esc(t('{lang} : manquant', { lang: l }))}">${l.slice(0, 2).toUpperCase()}</span>`; %>
    <details class="rub" open>
      <summary><%= t('Infos') %> <span class="sum"><%~ flag('title', 'fr') %><%~ flag('title_en', 'en') %><%~ flag('title_de', 'de') %></span></summary>
      <div class="rub-body">
    <label><%= t('Titre') %> <input name="title" value="<%= v.title %>" required maxlength="160"<%~ inv('title') %>></label><% if (e.title) { %><span class="err" id="err-title"><%= e.title %></span><% } %>
    <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'title', label: t('Titre'), max: 160 }) %>
    <label><%= t('Adresse') %> <span class="mono">/photo/</span><input name="slug" value="<%= v.slug %>" maxlength="80"<%~ inv('slug') %>></label><% if (e.slug) { %><span class="err" id="err-slug"><%= e.slug %></span><% } %>
    <div class="row">
      <label><%= t('Série') %> <select name="category_id"<%~ inv('category_id') %>><% it.categories.forEach(c => { %><option value="<%= c.id %>"<%~ c.id === Number(v.category_id) ? ' selected' : '' %>><%= c.name %></option><% }) %></select></label><% if (e.category_id) { %><span class="err" id="err-category_id"><%= e.category_id %></span><% } %>
      <label><%= t('Photographe') %> <select name="author_id"<%~ inv('author_id') %>><% it.authors.forEach(a => { %><option value="<%= a.id %>"<%~ a.id === Number(v.author_id) ? ' selected' : '' %>><%= a.name %></option><% }) %></select></label><% if (e.author_id) { %><span class="err" id="err-author_id"><%= e.author_id %></span><% } %>
    </div>
<% if (it.suggest && it.suggest.length) { %>
    <div class="sug-list" data-suggest-fiche>
      <input type="hidden" name="serie_choisie" value="" data-series-chosen>
<% it.suggest.forEach((x, i) => { %>
      <div class="sugbox<%= i ? ' alt' : '' %>">
        <span><%= i ? t('ou') : '✦ ' + t('Série proposée :') %> <b><%= x.name %></b></span>
        <span class="why"><%= t('ressemble à {n} de ses {total} photos', { n: x.votes, total: x.size }) %><% if (x.like && x.like.length) { %><span class="mini"><% x.like.forEach(l => { %><img src="<%= l.thumb %>" alt="" title="<%= l.title %>"><% }) %></span><% } %></span>
        <span class="acts" data-js-only hidden><button class="btn<%= i ? ' ghost' : '' %> sm" type="button" data-pick-series="<%= x.id %>"><%= t('Choisir') %></button></span>
      </div>
<% }) %>
      <p class="hint"><span data-js-only hidden><%= t('« Choisir » remplit le champ Série, « Enregistrer » valide.') %> <button class="more" type="button" data-pick-series="<%= it.photo.category_id %>"><%= t('Garder « {name} »', { name: it.photo.category }) %></button></span><span data-nojs><%= t('Changez la série ci-dessus si la proposition vous convient.') %></span></p>
    </div>
<% } %>
    <label><%= t('Date') %> <span class="mono"><%= t('AAAA-MM ou AAAA-MM-JJ') %><%= it.photo.taken_time ? ' · ' + t('prise à {time}', { time: fr ? it.photo.taken_time.replace(':', ' h ') : it.photo.taken_time }) : '' %></span><input name="taken_on" value="<%= v.taken_on || '' %>" placeholder="<%= t('AAAA-MM ou AAAA-MM-JJ') %>" inputmode="numeric"<%~ inv('taken_on') %>></label><% if (e.taken_on) { %><span class="err" id="err-taken_on"><%= e.taken_on %></span><% } %>
    <label><%= t('Légende') %> <textarea name="legend" rows="3" maxlength="2000"><%= v.legend %></textarea></label>
    <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'legend', label: t('Légende'), max: 2000, rows: 3 }) %>
<% if (it.description) { const d = it.description; %>    <div class="desc-sugg" id="description" data-desc data-desc-url="/admin/photos/<%= it.photo.id %>/description"<%~ d.pending ? ' data-desc-pending' : '' %>>
      <p><span class="mono"><%= t('Description suggérée') %> :</span> <span data-desc-text><%= d.pending ? t('en cours de calcul…') : d.text ? `« ${d.text} »` : d.error ? t('Dernier essai sans succès : {error}', { error: t.msg(d.error) }) : t('pas encore calculée') %></span><% if (d.text && !d.translated && it.lang !== 'en') { %> <span class="mono">(<%= it.translate ? t('en anglais : traduction pas encore faite, nouvel essai dans quelques minutes') : t('en anglais : aucun traducteur configuré') %>)</span><% } %><% if (d.text && d.error && !d.pending) { %> <span class="err"><%= t('Dernier essai sans succès : {error}', { error: t.msg(d.error) }) %></span><% } %></p>
      <p class="actions"><% if (d.text && d.use && d.use.text) { %><button class="btn ghost sm" type="button" data-desc-use="<%= d.use.text %>" data-desc-field="<%= d.use.field %>" data-js-only hidden><%= d.use.field === 'legend' ? t('Reprendre comme légende') : t('Reprendre comme légende anglaise') %></button> <% } %><button class="btn ghost sm" type="submit" form="desc-form"><%= d.text ? t('Décrire de nouveau') : t('Décrire cette photo') %></button>
        <span class="hint"><%= t('Florence-2, sur ce serveur : une phrase factuelle, à relire et à réécrire à votre façon.') %></span></p>
    </div>
<% } %>
    <label><%= t('Mots-clés') %> <span class="mono"><%= t('séparés par des virgules · pour la recherche sur le site ; en plusieurs langues si besoin') %></span><input name="keywords" value="<%= v.keywords || '' %>" maxlength="1200" placeholder="<%= t('brume, Loire, matin') %>"></label>
<% if (it.keywordSuggestions && it.keywordSuggestions.length) { %>    <p class="kw-sugg" data-kw-sugg><span class="mono"><%= t('Suggestions') %> :</span> <% it.keywordSuggestions.forEach(k => { %><button type="button" class="kw-chip" data-kw-add="<%= k.word %>" hidden>+ <%= k.word %></button><span class="kw-plain" data-nojs><%= k.word %></span> <% }) %><span class="hint" data-js-only hidden><%= t('un clic ajoute le mot, à enregistrer ensuite') %></span></p>
<% } else if (it.keywordSuggestions === null && !it.seriesSuggestOn && it.can('series.gerer')) { %>    <p class="hint"><%= t('Mots-clés suggérés : activez les propositions de séries (page Séries), le même modèle les calcule.') %></p>
<% } %>
      </div>
    </details>
    <details class="rub" open>
      <summary><%= t('Où') %> <span class="sum"><%= v.city_label || t('sans ville') %><%= Number(v.on_map) ? ' · ' + t('sur la carte du monde') : '' %></span></summary>
      <div class="rub-body">
    <label><%= t('Lieu affiché') %> <span class="mono"><%= t('texte libre, avec la photo') %></span><input name="place" value="<%= v.place %>" maxlength="120"></label>
    <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'place', label: t('Lieu'), max: 120 }) %>
    <div class="city-field" data-city>
      <label for="city_label"><%= t('Ville') %> <span class="mono"><%= t('pour la carte du monde · toutes les communes de France, plus de 500 habitants ailleurs') %></span></label>
      <input id="city_label" name="city_label" value="<%= v.city_label || '' %>" maxlength="120" autocomplete="off" placeholder="<%= t('Commencez à taper : Angers, Lisbonne…') %>" data-city-input<%~ inv('city') %>>
      <input type="hidden" name="city_id" value="<%= v.city_id || '' %>" data-city-id>
<% if (e.city) { %>      <span class="err" id="err-city"><%= e.city %></span>
<% } else if (it.photo.city_source === 'gps' && v.city_label) { %>      <span class="cellnote"><%= t('Proposée d’après le GPS de la photo : vérifiez-la. Seule la ville est gardée, jamais la position exacte.') %></span>
<% } %>      <span class="cellnote"><%~ t('Villes : {link}, licence CC BY 4.0.', { link: '<a href="https://www.geonames.org" target="_blank" rel="noopener">GeoNames</a>' }) %></span>
    </div>
    <label class="inline"><input type="checkbox" name="on_map"<%~ Number(v.on_map) ? ' checked' : '' %><%~ inv('on_map') %>> <%= t('Afficher sur la carte du monde') %></label><% if (e.on_map) { %><span class="err" id="err-on_map"><%= e.on_map %></span><% } %>
      </div>
    </details>
    <details class="rub" open>
      <summary><%= t('Diffusion') %> <span class="sum"><%= v.status === 'published' ? t('publiée') : t('brouillon') %> · <%= v.watermark === 0 ? t('filigrane jamais') : t('filigrane selon les réglages') %></span></summary>
      <div class="rub-body">
<% if (e.status) { %>    <span class="err" id="err-status" role="alert"><%= e.status %></span>
<% } %><% if (pubOk) { %>    <fieldset class="row">
      <legend><%= t('Statut') %></legend>
<% Object.entries(it.STATUSES).forEach(([k, label]) => { %>
      <label class="inline"><input type="radio" name="status" value="<%= k %>"<%~ v.status === k ? ' checked' : '' %>> <%= t(label) %></label>
<% }) %>
    </fieldset>
<% } else { %>    <input type="hidden" name="status" value="<%= it.photo.status %>">
    <p class="hint"><%= t('Statut : {status}. La publication est faite par un administrateur ou un modérateur.', { status: it.photo.status === 'published' ? t('publiée') : t('brouillon') }) %></p>
<% } %>
<% if (!pubOk) { %><% } else if (R.site.level === 'warn' && !it.siteConfirmed) { %>
    <label class="inline confirm-box"><input type="checkbox" name="confirmer" value="1"> <%= it.photo.status === 'published' ? t('Photo en ligne à vérifier : je confirme que les personnes reconnaissables sur cette photo ont accepté le site, ou n’y sont pas reconnaissables.') : t('Pour publier : je confirme que les personnes reconnaissables sur cette photo ont accepté le site, ou n’y sont pas reconnaissables.') %></label>
<% } else if (it.photo.status !== 'published' && R.site.level === 'no') { %>
    <p class="cellnote err"><%= t('Publication impossible : {reasons}.', { reasons: R.site.reasons.join(' ; ') }) %></p>
<% } %>
    <fieldset class="row">
      <legend><%= t('Filigrane') %></legend>
      <label class="inline"><input type="radio" name="watermark" value="default"<%~ v.watermark !== 0 ? ' checked' : '' %>> <%~ t('Selon les {link}', { link: `<a href="/admin/images">${esc(t('réglages'))}</a>` }) %></label>
      <label class="inline"><input type="radio" name="watermark" value="none"<%~ v.watermark === 0 ? ' checked' : '' %>> <%= t('Jamais sur cette photo') %></label>
    </fieldset>
    <p class="hint"><%~ t('Instagram : voir la rubrique {link}.', { link: '<a class="more" href="#instagram">Instagram</a>' }) %></p>
      </div>
    </details>
    <p class="actions"><button class="btn" type="submit"><%= t('Enregistrer') %></button></p>
  </form>
<% } else { %>
  <div class="panel form texts-only">
<% if (can('photos.textes') && editableHere) { %>
    <form class="form" method="post" action="/admin/photos/<%= it.photo.id %>/textes">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <p class="hint"><%= t('Ce compte corrige les textes ; la série, la date, le lieu sur la carte et le reste sont réglés par le photographe ou un administrateur.') %></p>
      <label><%= t('Titre') %> <input name="title" value="<%= v.title %>" required maxlength="160"></label>
      <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'title', label: t('Titre'), max: 160 }) %>
      <label><%= t('Légende') %> <textarea name="legend" rows="3" maxlength="2000"><%= v.legend %></textarea></label>
      <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'legend', label: t('Légende'), max: 2000, rows: 3 }) %>
<% if (it.description) { const d = it.description; %>    <div class="desc-sugg" id="description" data-desc data-desc-url="/admin/photos/<%= it.photo.id %>/description"<%~ d.pending ? ' data-desc-pending' : '' %>>
      <p><span class="mono"><%= t('Description suggérée') %> :</span> <span data-desc-text><%= d.pending ? t('en cours de calcul…') : d.text ? `« ${d.text} »` : d.error ? t('Dernier essai sans succès : {error}', { error: t.msg(d.error) }) : t('pas encore calculée') %></span><% if (d.text && !d.translated && it.lang !== 'en') { %> <span class="mono">(<%= it.translate ? t('en anglais : traduction pas encore faite, nouvel essai dans quelques minutes') : t('en anglais : aucun traducteur configuré') %>)</span><% } %><% if (d.text && d.error && !d.pending) { %> <span class="err"><%= t('Dernier essai sans succès : {error}', { error: t.msg(d.error) }) %></span><% } %></p>
      <p class="actions"><% if (d.text && d.use && d.use.text) { %><button class="btn ghost sm" type="button" data-desc-use="<%= d.use.text %>" data-desc-field="<%= d.use.field %>" data-js-only hidden><%= d.use.field === 'legend' ? t('Reprendre comme légende') : t('Reprendre comme légende anglaise') %></button> <% } %><button class="btn ghost sm" type="submit" form="desc-form"><%= d.text ? t('Décrire de nouveau') : t('Décrire cette photo') %></button>
        <span class="hint"><%= t('Florence-2, sur ce serveur : une phrase factuelle, à relire et à réécrire à votre façon.') %></span></p>
    </div>
<% } %>
      <label><%= t('Lieu affiché') %> <input name="place" value="<%= v.place %>" maxlength="120"></label>
      <%~ include('./_tr', { asset: it.asset, translate: it.translate, t: it.t, v, name: 'place', label: t('Lieu'), max: 120 }) %>
      <label><%= t('Mots-clés') %> <span class="mono"><%= t('séparés par des virgules · pour la recherche sur le site ; en plusieurs langues si besoin') %></span><input name="keywords" value="<%= v.keywords || '' %>" maxlength="1200" placeholder="<%= t('brume, Loire, matin') %>"></label>
<% if (it.keywordSuggestions && it.keywordSuggestions.length) { %>    <p class="kw-sugg" data-kw-sugg><span class="mono"><%= t('Suggestions') %> :</span> <% it.keywordSuggestions.forEach(k => { %><button type="button" class="kw-chip" data-kw-add="<%= k.word %>" hidden>+ <%= k.word %></button><span class="kw-plain" data-nojs><%= k.word %></span> <% }) %><span class="hint" data-js-only hidden><%= t('un clic ajoute le mot, à enregistrer ensuite') %></span></p>
<% } else if (it.keywordSuggestions === null && !it.seriesSuggestOn && it.can('series.gerer')) { %>    <p class="hint"><%= t('Mots-clés suggérés : activez les propositions de séries (page Séries), le même modèle les calcule.') %></p>
<% } %>
      <p class="mono"><%= it.photo.category %> · <%= it.photo.author %><%= it.photo.taken_on ? ` · ${it.photo.taken_on}` : '' %></p>
      <p class="actions"><button class="btn" type="submit"><%= t('Enregistrer') %></button></p>
    </form>
<% } else { %>
    <dl class="facts"><dt><%= t('Titre') %></dt><dd><%= it.photo.title %></dd><dt><%= t('Légende') %></dt><dd><%= it.photo.legend || '—' %></dd><dt><%= t('Lieu') %></dt><dd><%= it.photo.place || '—' %></dd><dt><%= t('Série') %></dt><dd><%= it.photo.category %> · <%= it.photo.author %></dd></dl>
    <p class="hint"><%= can('photos.modifier') && !editableHere ? t('Publiée sur le site. La modifier demande un droit que le modérateur peut vous donner.') : t('Pour une correction, écrivez une remarque au photographe (plus bas) ou renvoyez-lui la photo.') %></p>
<% } %>
  </div>
<% } %>
<% if (it.description) { /* « Décrire cette photo » : son propre formulaire (form="desc-form"), hors du formulaire d'édition : il
     n'emporte pas la saisie en cours, et Entrée dans un champ enregistre la fiche au lieu de demander une description. */ %>
  <form id="desc-form" method="post" action="/admin/photos/<%= it.photo.id %>/description" hidden><input type="hidden" name="_csrf" value="<%= it.csrf %>"></form>
<% } %>
  <div class="edit-lower">
<% const RV = it.review, propose = can('photos.proposer'), when = ms => new Intl.DateTimeFormat(it.locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(ms);
   const ACT = { proposee: t('proposée'), retiree: t('proposition retirée'), programmee: t('programmée'), deprogrammee: t('programmation annulée'), modifiee: t('modifiée après validation'), publiee: t('publiée'), renvoyee: t('renvoyée avec une remarque'), depubliee: t('dépubliée') }; %>
<% if (propose || pubOk) { %>
<section class="panel rub-panel publication" id="publication" aria-labelledby="pub-title">
  <h2 id="pub-title"><%= t('Publication') %> <span class="sum"><%= it.photo.status === 'published' ? t('publiée') : RV.state === 'proposee' ? t('proposée, attend le modérateur') : RV.state === 'programmee' ? t('programmée le {date}', { date: when(RV.at) }) : RV.state === 'a_reprendre' ? t('à reprendre') : t('brouillon') %></span></h2>
<% if (it.photo.status === 'published') { %>
<% if (pubOk) { %>  <form class="form" method="post" action="/admin/photos/<%= it.photo.id %>/depublier">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label><%= t('Dépublier : pourquoi ?') %> <span class="mono"><%= t('le photographe reçoit la raison') %></span><textarea name="raison" rows="2" maxlength="1000" required></textarea></label>
    <p class="actions"><button class="btn ghost" type="submit"><%= t('Dépublier') %></button></p>
  </form>
<% } else { %>  <p class="hint"><%= can('photos.publiees.modifier') ? t('Publiée sur le site. Vos modifications y apparaissent tout de suite.') : t('Publiée sur le site. La modifier demande un droit que le modérateur peut vous donner.') %></p>
<% } %>
<% } else if (RV.state === 'programmee') { %>
  <p><%= t('Validée : elle sera publiée le {date}.', { date: when(RV.at) }) %></p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/<%= pubOk ? 'deprogrammer' : 'retirer-proposition' %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit"><%= pubOk ? t('Annuler la programmation') : t('Retirer la proposition') %></button></form>
<% } else { %>
<% if (RV.state === 'proposee' && propose && !pubOk) { %>  <p><%= t('Proposée : le modérateur va la publier, la programmer ou vous la renvoyer avec une remarque.') %></p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/retirer-proposition"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit"><%= t('Retirer la proposition') %></button></form>
<% } else if (propose && !pubOk) { %>
<% if (RV.state === 'a_reprendre') { %>  <p class="cellnote warn"><%= t('Renvoyée : voyez la remarque ci-dessous, corrigez, puis proposez-la de nouveau.') %></p><% } %>
<% if (R.site.level === 'no') { %>  <p class="hint"><%= t('Bloquée par un refus : elle ne peut pas être proposée.') %></p>
<% } else { %>  <form class="form" method="post" action="/admin/photos/<%= it.photo.id %>/proposer">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label><%= t('Un mot pour le modérateur') %> <span class="mono"><%= t('facultatif') %></span><textarea name="message" rows="2" maxlength="1000"></textarea></label>
<% if (R.site.level === 'warn' && !it.siteConfirmed) { %>    <label class="inline confirm-box"><input type="checkbox" name="confirmer" value="1"> <%= t('À vérifier : je confirme que les personnes reconnaissables sur cette photo ont accepté le site, ou n’y sont pas reconnaissables.') %></label>
<% } %>    <p class="actions"><button class="btn" type="submit"><%= t('Proposer à la publication') %></button></p>
  </form>
<% } %>
<% } %>
<% if (pubOk) { %>
<% if (RV.state === 'proposee') { const last = RV.history.find(h => h.action === 'proposee'); %>  <p><%= t('Proposée par {name} le {date}.', { name: last?.by_name || '?', date: last ? when(last.at) : '' }) %><% if (last?.message) { %> <q><%= last.message %></q><% } %></p><% } %>
<% if (R.site.level === 'ok' || it.siteConfirmed) { %>  <form class="form row-form" method="post" action="/admin/photos/<%= it.photo.id %>/valider">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label class="inline"><input type="radio" name="quand" value="maintenant" checked> <%= t('Publier maintenant') %></label>
    <label class="inline"><input type="radio" name="quand" value="date"> <%= t('Programmer le') %> <input type="datetime-local" name="date" aria-label="<%= t('Jour et heure de publication') %>"></label>
    <p class="actions"><button class="btn" type="submit"><%= t('Valider') %></button></p>
  </form>
<% } else { %>  <p class="hint"><%= R.site.level === 'no' ? t('Bloquée : elle ne peut pas être publiée.') : t('À vérifier : la confirmation des accords revient au photographe ou à un administrateur, qui voient les personnes.') %></p>
<% } %><% if (RV.state === 'proposee') { %>  <form class="form" method="post" action="/admin/photos/<%= it.photo.id %>/renvoyer">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label><%= t('Renvoyer au photographe avec une remarque') %><textarea name="message" rows="2" maxlength="1000" required></textarea></label>
    <p class="actions"><button class="btn ghost" type="submit"><%= t('Renvoyer') %></button></p>
  </form>
<% } %>
<% } %>
<% } %>
<% if (RV.history.length) { %>  <details class="pub-history"><summary><%= t('Historique') %></summary><ul class="rank plain"><% RV.history.forEach(h => { %><li><span class="t"><%= ACT[h.action] || h.action %> · <%= h.by_name || '—' %><%= h.publish_at ? ` · ${when(h.publish_at)}` : '' %><% if (h.message) { %> · <q><%= h.message %></q><% } %></span><span class="mono"><%= when(h.at) %></span></li><% }) %></ul></details>
<% } %>
</section>
<% } %>
<% if (it.notes.length || can('taches.adresser')) { %>
<details class="panel rub-panel" id="remarques"<%~ it.notes.length ? ' open' : '' %>>
  <summary><h2><%= t('Remarques') %> <span class="sum"><%= it.notes.length ? (it.notes.length > 1 ? t('{n} à traiter', { n: it.notes.length }) : t('1 à traiter')) : t('aucune') %></span></h2></summary>
<% it.notes.forEach(n => { %>  <div class="note-item"><p><strong><%= n.from_name || t('l’équipe') %></strong> <span class="mono"><%= new Intl.DateTimeFormat(it.locale, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' }).format(n.created_at) %></span></p><p><%= n.message %></p>
<% if (can('taches.adresser') || it.ownPhoto) { %>    <form method="post" action="/admin/remarques/<%= n.id %>/fait"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>#remarques"><button class="btn ghost" type="submit"><%= t('Fait') %></button></form><% } %></div>
<% }) %><% if (can('taches.adresser')) { %>  <form class="form" method="post" action="/admin/photos/<%= it.photo.id %>/remarques">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <label><%= t('Remarque pour le photographe') %> <span class="mono"><%= t('elle apparaît dans son « Aujourd’hui » ; parlez de la photo, jamais des personnes') %></span><textarea name="message" rows="2" maxlength="1000" required></textarea></label>
    <p class="actions"><button class="btn ghost" type="submit"><%= t('Envoyer au photographe') %></button></p>
  </form>
<% } %></details>
<% } %>
<% if (seePeople && it.encounters && it.encounters.length) { %>
<details class="panel rub-panel" id="rencontres"<%~ R.site.level !== 'ok' || R.instagram.level !== 'ok' ? ' open' : '' %>>
  <summary><h2 id="enc-title"><%= t('Personnes & accords') %> <span class="sum"><%= it.encounters.length > 1 ? t('{n} personnes', { n: it.encounters.length }) : t('{n} personne', { n: it.encounters.length }) %> · <%= t('accords de la sortie et photos liées') %></span></h2></summary>
<% if (it.outingUrl) { %>  <p><a class="btn ghost" href="<%= it.outingUrl %>"><%= t('Ouvrir la sortie →') %></a></p><% } %>
  <p class="hint"><%= t('Les personnes rencontrées par {author} le jour de cette photo (date EXIF), et celles liées à la photo. Vérifiez que celles qui y apparaissent ont accepté l’usage prévu.', { author: it.photo.author || t('le photographe') }) %></p>
  <ul class="rank plain">
<% it.encounters.forEach(r => { %>    <li><span class="t"><span class="enc-who"><% if (r.hasPortrait) { %><img class="enc-face" src="/admin/rencontres/<%= r.id %>/portrait?mini=1" alt="" width="32" height="32" loading="lazy"><% } %><a href="/admin/rencontres/<%= r.id %>"><%= t('Rencontre {ref}', { ref: r.ref || t('sans carte') }) %><%= r.name ? ` · ${r.name}` : '' %></a> <span class="mono"><%= r.via === 'session' ? t('même sortie') : t('liée à la photo') %></span></span></span>
      <% if (r.via === 'session') { %><form class="enc-absent" method="post" action="/admin/rencontres/<%= r.id %>/session/<%= it.photo.id %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="exclure" value="1"><input type="hidden" name="depuis" value="photo"><button class="btn ghost" type="submit"><%= t('Pas sur cette photo') %></button></form><% } %>
      <% if (r.refused && r.via === 'lien') { %><span class="enc-tag no"><%= t('Refuse la publication : la photo ne peut pas être publiée') %></span><% } else if (r.refused) { %><span class="enc-tag warn"><%= t('A refusé : si elle est sur cette photo, liez-la au refus (fiche de la rencontre)') %></span><% } else if (r.consent) { const uses = ['site', 'instagram', 'print', 'name'].filter(s => r.consent[s]).map(s => ({ site: t('site'), instagram: 'Instagram', print: t('expositions et tirages'), name: t('avec son prénom') })[s]).join(', '); %><span class="enc-tag ok"><%= r.consent_source !== 'en_ligne' ? t('Accord signé : {uses}', { uses }) : t('Accord en ligne : {uses}', { uses }) %></span><% } else { %><span class="enc-tag"><%= t('Ni accord ni refus pour l’instant') %></span><% } %></li>
<% }) %>  </ul>
</details>
<% } %>
<% const au = it.audience; %>
<% if (it.seeStats) { %>
<details class="panel audience rub-panel" id="audience">
  <summary><h2 id="audience-title"><%= t('Audience') %> <span class="sum"><%= au && au.total ? (au.total > 1 ? t('{n} ouvertures en 30 jours', { n: au.total }) : t('{n} ouverture en 30 jours', { n: au.total })) : t('pas encore vue en grand') %><%= it.photo.likes ? ` · ${t('{n} j’aime sur le site', { n: it.photo.likes })}` : '' %><%= it.shares ? ` · ${it.shares > 1 ? t('{n} partages', { n: it.shares }) : t('{n} partage', { n: it.shares })}` : '' %></span></h2></summary>
<% if (au && au.total) { %>
  <p><%~ au.total > 1 ? t('{n} ouvertures en grand', { n: `<strong>${esc(au.total)}</strong>` }) : t('{n} ouverture en grand', { n: `<strong>${esc(au.total)}</strong>` }) %><%= au.rank ? ' · ' + (au.rank === 1 ? t('1ʳᵉ photo la plus vue') : t('{rank}ᵉ photo la plus vue', { rank: au.rank })) : '' %></p>
  <%~ au.spark %>
<% } else { %>
  <p class="hint"><%= it.photo.status === 'draft' ? t('Pas encore ouverte en grand ces 30 derniers jours (brouillon : invisible sur le site).') : t('Pas encore ouverte en grand ces 30 derniers jours.') %></p>
<% } %>
  <p><a class="more" href="/admin/statistiques"><%= t('Toutes les statistiques') %></a></p>
</details>
<% } %>
<% const ig = it.insta, igFile = it.igFile, pr = it.igProposal;
   // Erreur Instagram : ses raisons (« bloquée : J-0042 refuse la publication ») nomment les accords ; qui ne voit
   // pas les personnes n'en lit que la nature, comme pour le bandeau d'état.
   const IG_HIDE = { 'bloquée': 'bloquée par un accord (détail réservé au photographe et aux administrateurs)', 'à vérifier': 'à vérifier : un accord manque (détail réservé au photographe et aux administrateurs)' };
   const igErr = m => t.msg(seePeople ? m : String(m || '').replace(/(^|: )(bloquée|à vérifier) : [\s\S]*$/, (x, pre, k) => pre + IG_HIDE[k])); %>
<% if (igFile || it.igPropose) { %>
<details class="panel ig rub-panel" id="instagram" data-ig<%~ ig.active || R.instagram.level !== 'ok' ? ' open' : '' %>>
  <summary><h2 id="ig-title">Instagram <span class="sum"><%= ig.post && ig.post.status === 'published' ? t('publiée sur Instagram') : ig.active ? t('dans la file') : ig.post && ig.post.status === 'failed' ? t('en échec') : R.instagram.level === 'no' ? t('bloquée') : R.instagram.level === 'warn' ? t('à vérifier') : t('pas encore partagée') %></span></h2></summary>
<% if (ig.post && ig.post.status === 'published') { %>
  <p><%= t('Publiée sur Instagram') %><% if (ig.post.permalink) { %> · <a class="more" href="<%= ig.post.permalink %>" target="_blank" rel="noopener"><%= t('voir le post ↗') %></a><% } %>.</p>
<% if (ig.engagement) { const e = ig.engagement; %>
  <p class="ig-likes"><span><strong><%= e.likes %></strong> <%= e.likes > 1 ? t('likes') : t('like') %></span> · <span><strong><%= e.comments %></strong> <%= e.comments > 1 ? t('commentaires') : t('commentaire') %></span>
    <span class="mono"><%= t('relevé le {date}', { date: new Intl.DateTimeFormat(it.locale, { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(e.day)) }) %></span></p>
<% if (ig.likesSpark) { %>  <figure class="ig-spark"><%~ ig.likesSpark %><figcaption class="mono"><%= t('likes, {n} derniers relevés', { n: e.series.length }) %></figcaption></figure>
<% } %>
<% } else { %>
  <p class="hint"><%~ t('Likes et commentaires : relevés chaque matin (voir {link}).', { link: '<a href="/admin/instagram#likes">Instagram</a>' }) %></p>
<% } %>
<% } else if (ig.post && ig.post.status === 'publishing') { %>
  <p><%= t('Envoi à Instagram en cours…') %></p>
<% } else if (ig.active) { const slot = ig.slot || '', sp = slot.indexOf(' '); const day = d => (/^\d{4}-\d{2}-\d{2}$/.test(d) ? new Intl.DateTimeFormat(it.locale, { timeZone: 'UTC', day: 'numeric', month: 'long' }).format(new Date(`${d}T12:00:00Z`)) : d);
   const when = sp < 0 ? (fr ? slot.replace(':', ' h ') : slot) : t('{date} à {time}', { date: day(slot.slice(0, sp)), time: fr ? slot.slice(sp + 1).replace(':', ' h ') : slot.slice(sp + 1) }); %>
  <p><%~ t('Dans la file : prévue le {slot}.', { slot: `<strong>${esc(when)}</strong>` }) %><% if (ig.post.error) { %> <span class="err"><%= t('Dernier essai : {error}', { error: igErr(ig.post.error) }) %></span><% } %></p>
<% } else if (ig.post && ig.post.status === 'failed' && !igFile) { %>
  <p class="err"><%= t('Échec de la publication : {error}', { error: igErr(ig.post.error) }) %></p>
<% if (ig.post.retry_requested_at) { %>  <p><span class="enc-tag ok"><%= t('Republication demandée') %></span> <span class="mono"><%= t('l’équipe qui gère la file Instagram est prévenue') %></span></p>
<% } else { %>  <form method="post" action="/admin/photos/<%= it.photo.id %>/instagram/demande" class="actions"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn" type="submit"><%= t('Demander la republication') %></button> <span class="hint"><%= t('la file Instagram est gérée par le modérateur : il sera prévenu') %></span></form>
<% } %>
<% } else if (ig.post && ig.post.status === 'failed') { %>
  <p class="err"><%= t('Échec de la publication : {error}', { error: igErr(ig.post.error) }) %></p>
<% if (ig.post.retry_requested_at) { %>  <p><span class="enc-tag warn"><%= t('Republication demandée') %></span> <span class="mono"><%= t('par {name}, le {date}', { name: ig.post.retry_requested_by || t('le photographe'), date: new Intl.DateTimeFormat(it.locale, { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(ig.post.retry_requested_at) }) %></span></p>
<% } %>  <form method="post" action="/admin/instagram/<%= ig.post.id %>/reessayer" class="actions"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>#instagram"><button class="btn" type="submit"><%= t('Republier (remettre en tête de file)') %></button> <span class="hint"><%= t('ou modifiez le cadre et la légende ci-dessous puis remettez-la dans la file') %></span></form>
<% } %>
<% if (ig.blocked.length && !seePeople) { %>
  <p class="ig-blocked" role="note"><strong><%= t('Instagram bloqué') %></strong> · <%= t('Le détail (personnes et accords) est visible du photographe et des administrateurs.') %></p>
<% } else if (ig.blocked.length) { %>
  <p class="ig-blocked" role="note"><%~ t('{title} : {reasons}. Aucune confirmation ne lève ce blocage : si la personne n’est pas sur cette photo, indiquez-le dans {link}.', { title: `<strong>${esc(t('Instagram bloqué'))}</strong>`, reasons: esc(ig.blocked.join(' ; ')), link: `<a class="more" href="#rencontres">${esc(t('Personnes & accords'))}</a>` }) %></p>
<% } else if (it.photo.status !== 'published') { %>
  <p class="hint"><%= t('Publiez d’abord la photo sur le site pour la partager sur Instagram.') %></p>
<% } else if (!igFile && ig.active) { %>
  <p class="hint"><%= t('La file Instagram est réglée par le modérateur.') %></p>
<% } else if (!ig.post || ig.active || ig.post.status === 'failed' || ig.post.status === 'published') { if (!(ig.post && ig.post.status === 'publishing')) {
     const src = !igFile && pr ? pr : ig.post; const fFrame = src ? src.frame : ig.s.frame, fWm = src ? src.watermark : ig.s.watermark; %>
<% if (!igFile && pr) { %>  <p><span class="enc-tag warn"><%= t('Proposée pour Instagram') %></span> <span class="mono"><%= t('le {date}, en attente du modérateur', { date: new Intl.DateTimeFormat(it.locale, { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(pr.at) }) %></span></p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/instagram/retirer-proposition" class="actions"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit"><%= t('Retirer la proposition') %></button></form>
<% } else if (!igFile) { %>  <p class="hint"><%= t('Proposez la photo : le modérateur la met dans la file Instagram, ou vous la renvoie avec une remarque.') %></p>
<% } %>
  <div class="ig-edit">
    <figure class="ig-preview"><img src="/admin/instagram/apercu.jpg?photo=<%= it.photo.id %>&cadre=<%= fFrame %>&filigrane=<%= fWm ? 1 : 0 %>" alt="<%= t('Aperçu de l’image envoyée à Instagram') %>" data-ig-preview loading="lazy">
      <figcaption class="mono"><%= t('L’image telle qu’elle partira (1080 px, JPEG, sans métadonnées)') %></figcaption></figure>
    <form class="form" method="post" action="<%= igFile ? '/admin/instagram/file' : `/admin/photos/${it.photo.id}/instagram/proposer` %>" data-ig-form>
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <input type="hidden" name="photo_id" value="<%= it.photo.id %>">
      <input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>#instagram">
      <input type="hidden" name="watermark_set" value="1">
      <div class="row">
        <label><%= t('Cadre') %> <select name="frame" data-ig-frame><% Object.entries(ig.FRAMES).forEach(([k, l]) => { %><option value="<%= k %>"<%~ fFrame === k ? ' selected' : '' %>><%= t(l) %></option><% }) %></select></label>
        <label class="inline"><input type="checkbox" name="watermark" data-ig-watermark<%~ fWm ? ' checked' : '' %>> <%= t('Avec le filigrane') %></label>
      </div>
<% if (R.instagram.level === 'warn' && !it.igConfirmed && seePeople) { %>      <label class="inline confirm-box"><input type="checkbox" name="confirmer" value="1"> <%= t('Instagram à vérifier ({reasons}) : je confirme que les personnes reconnaissables ont accepté Instagram, ou n’y sont pas reconnaissables.', { reasons: R.instagram.reasons.join(' ; ') }) %></label>
<% } %><% if (ig.signature) { %>      <input type="hidden" name="signature_set" value="1">
      <label class="inline"><input type="checkbox" name="signature"<%~ it.photo.ig_signature !== 0 ? ' checked' : '' %>> <%= t('Ajouter ma signature') %> <span class="mono">« <%= ig.signature %> »<%= String(it.photo.legend || '').trim() ? '' : ' · ' + t('seulement si la photo a une légende') %></span></label>
<% } %>      <label class="inline"><input type="checkbox" name="custom" data-ig-custom<%~ (!igFile && pr ? Boolean(pr.caption) : ig.custom) ? ' checked' : '' %>> <%= t('Légende personnalisée pour cette photo') %> <span class="mono"><%= t('sinon, celle du modèle') %></span></label>
      <label><%= t('Légende') %> <% const cap = !igFile && pr && pr.caption ? pr.caption : ig.caption; %><span class="mono" data-ig-count><%= cap.length %> / 2200</span><textarea name="caption" rows="9" maxlength="2200" data-ig-caption><%= cap %></textarea></label>
<% if (ig.warnings.length) { %>      <ul class="warn-list" data-ig-warnings><% ig.warnings.forEach(w => { %><li><%= w %></li><% }) %></ul>
<% } %><% if (!igFile) { %>      <label><%= t('Un mot pour le modérateur') %> <span class="mono"><%= t('facultatif') %></span><textarea name="message" rows="2" maxlength="1000"><%= pr ? pr.message : '' %></textarea></label>
<% } %>
      <p class="actions">
        <button class="btn" type="submit"><%= !igFile ? (pr ? t('Mettre à jour la proposition') : ig.post && ig.post.status === 'published' ? t('Proposer de nouveau pour Instagram') : t('Proposer pour Instagram')) : ig.active ? t('Mettre à jour') : ig.post && ig.post.status === 'published' ? t('Republier (remettre dans la file)') : t('Ajouter à la file Instagram') %></button>
        <button class="btn ghost" type="button" data-ig-template hidden><%= t('Revenir au modèle') %></button>
<% if (!ig.connected && igFile) { %>        <span class="hint"><%~ t('Aucun compte connecté : la photo attendra dans la file ({link}).', { link: '<a href="/admin/instagram">Instagram</a>' }) %></span><% } %>
      </p>
    </form>
<% if (igFile && ig.active && ig.post.status === 'queued') { %>
    <form method="post" action="/admin/instagram/<%= ig.post.id %>/annuler"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>#instagram"><button class="btn ghost" type="submit"><%= t('Retirer de la file') %></button></form>
<% } %>
  </div>
<% } } %>
</details>
<% } else if ((it.ownPhoto || it.canAll('photos.proposer')) && can('photos.proposer') && ig.post && ig.post.status === 'failed') { %>
<details class="panel ig rub-panel" id="instagram" open>
  <summary><h2 id="ig-title">Instagram <span class="sum"><%= t('en échec') %></span></h2></summary>
  <p class="err"><%= t('Échec de la publication : {error}', { error: igErr(ig.post.error) }) %></p>
<% if (ig.post.retry_requested_at) { %>  <p><span class="enc-tag ok"><%= t('Republication demandée') %></span> <span class="mono"><%= t('l’équipe qui gère la file Instagram est prévenue') %></span></p>
<% } else { %>  <form method="post" action="/admin/photos/<%= it.photo.id %>/instagram/demande" class="actions"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn" type="submit"><%= t('Demander la republication') %></button> <span class="hint"><%= t('la file Instagram est gérée par le modérateur : il sera prévenu') %></span></form>
<% } %></details>
<% } %>
<% const pf = it.proof; %>
<details class="panel proof rub-panel" id="preuve">
  <summary><h2><%= t('Preuve d’antériorité') %> <span class="sum"><%= pf && pf.status === 'ok' && pf.sha256 === it.photo.sha256 ? t('horodatée') : it.photo.sha256 ? t('empreinte calculée') : t('en cours') %></span></h2></summary>
  <dl class="facts">
    <dt><%= t('Empreinte SHA-256 de l’original') %></dt><dd><code class="mono"><%= it.photo.sha256 || t('en cours de calcul') %></code></dd>
    <dt><%= t('Horodatage RFC 3161') %></dt>
    <dd>
<% if (pf && pf.status === 'ok' && pf.sha256 === it.photo.sha256) { %>
      <strong><%= t('Horodatée le {date} UTC', { date: t('{date} à {time}', { date: pf.gen_time.slice(0, 10), time: pf.gen_time.slice(11, 19) }) }) %></strong><br>
<% const cn = /CN=([^,]+)/.exec(pf.signer), org = /O=([^,]+)/.exec(pf.signer); %>
      <span class="mono" title="<%= pf.signer %>"><%= t('Autorité : {name}', { name: (cn ? cn[1] : pf.signer) + (org ? ` (${org[1]})` : '') }) %> · <%= t('n° {n}', { n: pf.serial }) %></span>
<% } else if (!it.tsa.url) { %>
      <%~ t('Désactivé sur ce serveur ({code}).', { code: '<code>TSA_URL=off</code>' }) %>
<% } else if (pf && pf.status === 'error') { %>
      <span class="err"><%= t('En attente : {error} (essai n° {n}, nouvel essai automatique).', { error: t.msg(pf.error), n: pf.attempts }) %></span>
<% } else { %>
      <%= t('En attente (quelques secondes après l’import).') %>
<% } %>
    </dd>
  </dl>
<% if (pf && pf.status === 'ok' && pf.sha256 === it.photo.sha256) { %>
  <p class="actions downloads">
<% if (can('photos.original')) { %>    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/original" download><%= t('Original') %></a>
<% } %>
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/preuve.tsr" download><%= t('Jeton (.tsr)') %></a>
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/preuve.txt" download><%= t('Fiche de preuve') %></a>
<% if (it.tsa.caFile) { %>    <a class="btn ghost" href="/admin/preuves/autorite.pem" download><%= t('Certificat de l’autorité') %></a><% } %>
  </p>
<% if (full) { %>  <form method="post" action="/admin/photos/<%= it.photo.id %>/verifier">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn" type="submit"><%= t('Vérifier la preuve') %></button>
  </form>
<% } %>
<% } else if (pf && pf.status === 'error' && full) { %>
  <form method="post" action="/admin/preuves/reessayer">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>">
    <button class="btn ghost" type="submit"><%= t('Réessayer maintenant') %></button>
  </form>
<% } %>
</details>

<% if (can('photos.supprimer')) { %>
<details class="danger panel">
  <summary><%= t('Supprimer cette photo') %></summary>
  <p><%= t('L’original, ses variantes et sa preuve d’antériorité seront effacés. Cette action est définitive : téléchargez d’abord l’original et la preuve si vous voulez les garder.') %></p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn danger" type="submit"><%= t('Supprimer définitivement') %></button>
  </form>
</details>
<% } %>
  </div>
</div>
