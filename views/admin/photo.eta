<% layout('./layout') %>
<% const v = it.values, e = it.errors; %>
<% const inv = k => e[k] ? ` aria-invalid="true" aria-describedby="err-${k}"` : ''; %>
<p class="mono"><a class="more eyebrow" href="/admin/photos">← Photos</a></p>
<h1><%= it.photo.title %></h1>
<div class="edit">
  <figure class="preview">
    <%~ it.picture(it.photo, { sizes: '(min-width: 900px) 40vw, 92vw', alt: '' }) %>
    <figcaption class="mono"><%= it.photo.width %> × <%= it.photo.height %> px<% if (it.photo.status === 'published') { %> · <a href="/photo/<%= it.photo.slug %>" target="_blank" rel="noopener">voir sur le site</a><% } %></figcaption>
  </figure>
  <form class="panel form" method="post" action="/admin/photos/<%= it.photo.id %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (Object.keys(e).length) { %><p class="err" role="alert">Le formulaire contient des erreurs.</p><% } %>
    <label>Titre <input name="title" value="<%= v.title %>" required maxlength="160"<%~ inv('title') %>></label><% if (e.title) { %><span class="err" id="err-title"><%= e.title %></span><% } %>
    <label>Adresse <span class="mono">/photo/</span><input name="slug" value="<%= v.slug %>" maxlength="80"<%~ inv('slug') %>></label><% if (e.slug) { %><span class="err" id="err-slug"><%= e.slug %></span><% } %>
    <div class="row">
      <label>Série <select name="category_id"<%~ inv('category_id') %>><% it.categories.forEach(c => { %><option value="<%= c.id %>"<%~ c.id === Number(v.category_id) ? ' selected' : '' %>><%= c.name %></option><% }) %></select></label><% if (e.category_id) { %><span class="err" id="err-category_id"><%= e.category_id %></span><% } %>
      <label>Auteur <select name="author_id"<%~ inv('author_id') %>><% it.authors.forEach(a => { %><option value="<%= a.id %>"<%~ a.id === Number(v.author_id) ? ' selected' : '' %>><%= a.name %></option><% }) %></select></label><% if (e.author_id) { %><span class="err" id="err-author_id"><%= e.author_id %></span><% } %>
    </div>
    <div class="row">
      <label>Lieu <input name="place" value="<%= v.place %>" maxlength="120"></label>
      <label>Date <input name="taken_on" value="<%= v.taken_on || '' %>" placeholder="AAAA-MM ou AAAA-MM-JJ" inputmode="numeric"<%~ inv('taken_on') %>></label><% if (e.taken_on) { %><span class="err" id="err-taken_on"><%= e.taken_on %></span><% } %>
    </div>
    <div class="city-field" data-city>
      <label for="city_label">Ville <span class="mono">pour la carte du site · toutes les communes de France, plus de 500 habitants ailleurs</span></label>
      <input id="city_label" name="city_label" value="<%= v.city_label || '' %>" maxlength="120" autocomplete="off" placeholder="Commencez à taper : Angers, Lisbonne…" data-city-input<%~ inv('city') %>>
      <input type="hidden" name="city_id" value="<%= v.city_id || '' %>" data-city-id>
<% if (e.city) { %>      <span class="err" id="err-city"><%= e.city %></span>
<% } else if (it.photo.city_source === 'gps' && v.city_label) { %>      <span class="cellnote">Proposée d’après le GPS de la photo : vérifiez-la. Seule la ville est gardée, jamais la position exacte.</span>
<% } %>      <span class="cellnote">Villes : <a href="https://www.geonames.org" target="_blank" rel="noopener">GeoNames</a>, licence CC BY 4.0.</span>
    </div>
    <label class="inline"><input type="checkbox" name="on_map"<%~ Number(v.on_map) ? ' checked' : '' %><%~ inv('on_map') %>> Afficher sur la carte du site</label><% if (e.on_map) { %><span class="err" id="err-on_map"><%= e.on_map %></span><% } %>
    <label>Légende <textarea name="legend" rows="3" maxlength="2000"><%= v.legend %></textarea></label>
    <fieldset class="row">
      <legend>Statut</legend>
<% Object.entries(it.STATUSES).forEach(([k, label]) => { %>
      <label class="inline"><input type="radio" name="status" value="<%= k %>"<%~ v.status === k ? ' checked' : '' %>> <%= label %></label>
<% }) %>
    </fieldset>
    <fieldset class="row">
      <legend>Filigrane</legend>
      <label class="inline"><input type="radio" name="watermark" value="default"<%~ v.watermark !== 0 ? ' checked' : '' %>> Selon les <a href="/admin/images">réglages</a></label>
      <label class="inline"><input type="radio" name="watermark" value="none"<%~ v.watermark === 0 ? ' checked' : '' %>> Jamais sur cette photo</label>
    </fieldset>
    <p class="actions"><button class="btn" type="submit">Enregistrer</button></p>
  </form>
</div>
<section class="panel audience" id="audience" aria-labelledby="audience-title">
  <h2 id="audience-title">Audience <span class="mono">30 derniers jours</span></h2>
<% const au = it.audience; %>
<% if (au && au.total) { %>
  <p><strong><%= au.total %></strong> ouverture<%= au.total > 1 ? 's' : '' %> en grand<%= au.rank ? ` · ${au.rank === 1 ? '1ʳᵉ' : au.rank + 'ᵉ'} photo la plus vue` : '' %></p>
  <%~ au.spark %>
<% } else { %>
  <p class="hint">Pas encore ouverte en grand ces 30 derniers jours<%= it.photo.status === 'draft' ? ' (brouillon : invisible sur le site)' : '' %>.</p>
<% } %>
  <p><a class="more" href="/admin/statistiques">Toutes les statistiques</a></p>
</section>
<% const ig = it.insta; %>
<section class="panel ig" id="instagram" aria-labelledby="ig-title" data-ig>
  <h2 id="ig-title">Instagram</h2>
<% if (ig.post && ig.post.status === 'published') { %>
  <p>Publiée sur Instagram<% if (ig.post.permalink) { %> · <a class="more" href="<%= ig.post.permalink %>" target="_blank" rel="noopener">voir le post ↗</a><% } %>.</p>
<% } else if (ig.post && ig.post.status === 'publishing') { %>
  <p>Envoi à Instagram en cours…</p>
<% } else if (ig.active) { %>
  <p>Dans la file : prévue le <strong><%= (ig.slot || '').replace(' ', ' à ').replace(':', ' h ') %></strong>.<% if (ig.post.error) { %> <span class="err">Dernier essai : <%= ig.post.error %></span><% } %></p>
<% } else if (ig.post && ig.post.status === 'failed') { %>
  <p class="err">Échec de la publication : <%= ig.post.error %> (voir la page <a href="/admin/instagram">Instagram</a> pour réessayer).</p>
<% } %>
<% if (it.photo.status !== 'published') { %>
  <p class="hint">Publiez d’abord la photo sur le site pour la partager sur Instagram.</p>
<% } else if (!ig.post || ig.active || ig.post.status === 'failed' || ig.post.status === 'published') { if (!(ig.post && ig.post.status === 'publishing')) { %>
  <div class="ig-edit">
    <figure class="ig-preview"><img src="/admin/instagram/apercu.jpg?photo=<%= it.photo.id %>&cadre=<%= ig.post ? ig.post.frame : ig.s.frame %>&filigrane=<%= (ig.post ? ig.post.watermark : ig.s.watermark) ? 1 : 0 %>" alt="Aperçu de l’image envoyée à Instagram" data-ig-preview loading="lazy">
      <figcaption class="mono">L’image telle qu’elle partira (1080 px, JPEG, sans métadonnées)</figcaption></figure>
    <form class="form" method="post" action="/admin/instagram/file" data-ig-form>
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <input type="hidden" name="photo_id" value="<%= it.photo.id %>">
      <input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>#instagram">
      <input type="hidden" name="watermark_set" value="1">
      <div class="row">
        <label>Cadre <select name="frame" data-ig-frame><% Object.entries(ig.FRAMES).forEach(([k, l]) => { %><option value="<%= k %>"<%~ (ig.post ? ig.post.frame : ig.s.frame) === k ? ' selected' : '' %>><%= l %></option><% }) %></select></label>
        <label class="inline"><input type="checkbox" name="watermark" data-ig-watermark<%~ (ig.post ? ig.post.watermark : ig.s.watermark) ? ' checked' : '' %>> Avec le filigrane</label>
      </div>
      <label class="inline"><input type="checkbox" name="custom" data-ig-custom<%~ ig.custom ? ' checked' : '' %>> Légende personnalisée pour cette photo <span class="mono">sinon, celle du modèle</span></label>
      <label>Légende <span class="mono" data-ig-count><%= ig.caption.length %> / 2200</span><textarea name="caption" rows="9" maxlength="2200" data-ig-caption><%= ig.caption %></textarea></label>
<% if (ig.warnings.length) { %>      <ul class="warn-list" data-ig-warnings><% ig.warnings.forEach(w => { %><li><%= w %></li><% }) %></ul>
<% } %>
      <p class="actions">
        <button class="btn" type="submit"><%= ig.active ? 'Mettre à jour' : ig.post && ig.post.status === 'published' ? 'Republier (remettre dans la file)' : 'Ajouter à la file Instagram' %></button>
        <button class="btn ghost" type="button" data-ig-template hidden>Revenir au modèle</button>
<% if (!ig.connected) { %>        <span class="hint">Aucun compte connecté : la photo attendra dans la file (<a href="/admin/instagram">Instagram</a>).</span><% } %>
      </p>
    </form>
<% if (ig.active && ig.post.status === 'queued') { %>
    <form method="post" action="/admin/instagram/<%= ig.post.id %>/annuler"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>#instagram"><button class="btn ghost" type="submit">Retirer de la file</button></form>
<% } %>
  </div>
<% } } %>
</section>
<section class="panel proof" id="preuve">
  <h2>Preuve d’antériorité</h2>
<% const t = it.proof; %>
  <dl class="facts">
    <dt>Empreinte SHA-256 de l’original</dt><dd><code class="mono"><%= it.photo.sha256 || 'en cours de calcul' %></code></dd>
    <dt>Horodatage RFC 3161</dt>
    <dd>
<% if (t && t.status === 'ok' && t.sha256 === it.photo.sha256) { %>
      <strong>Horodatée le <%= t.gen_time.replace('T', ' à ').slice(0, 21) %> UTC</strong><br>
<% const cn = /CN=([^,]+)/.exec(t.signer), org = /O=([^,]+)/.exec(t.signer); %>
      <span class="mono" title="<%= t.signer %>">Autorité : <%= cn ? cn[1] : t.signer %><%= org ? ` (${org[1]})` : '' %> · n° <%= t.serial %></span>
<% } else if (!it.tsa.url) { %>
      Désactivé sur ce serveur (<code>TSA_URL=off</code>).
<% } else if (t && t.status === 'error') { %>
      <span class="err">En attente : <%= t.error %> (essai n° <%= t.attempts %>, nouvel essai automatique).</span>
<% } else { %>
      En attente (quelques secondes après l’import).
<% } %>
    </dd>
  </dl>
<% if (t && t.status === 'ok') { %>
  <p class="actions downloads">
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/original" download>Original</a>
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/preuve.tsr" download>Jeton (.tsr)</a>
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/preuve.txt" download>Fiche de preuve</a>
<% if (it.tsa.caFile) { %>    <a class="btn ghost" href="/admin/preuves/autorite.pem" download>Certificat de l’autorité</a><% } %>
  </p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/verifier">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn" type="submit">Vérifier la preuve</button>
  </form>
<% } else if (t && t.status === 'error') { %>
  <form method="post" action="/admin/preuves/reessayer">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>">
    <button class="btn ghost" type="submit">Réessayer maintenant</button>
  </form>
<% } %>
</section>

<details class="danger panel">
  <summary>Supprimer cette photo</summary>
  <p>L’original, ses variantes et sa preuve d’antériorité seront effacés. Cette action est définitive : téléchargez d’abord l’original et la preuve si vous voulez les garder.</p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn danger" type="submit">Supprimer définitivement</button>
  </form>
</details>
