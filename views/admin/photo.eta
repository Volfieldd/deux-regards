<% layout('./layout') %>
<% const v = it.values, e = it.errors; %>
<% const inv = k => e[k] ? ` aria-invalid="true" aria-describedby="err-${k}"` : ''; %>
<p class="mono"><a class="more eyebrow" href="/admin/photos">← Photos</a></p>
<h1><%= it.photo.title %></h1>
<div class="edit">
  <figure class="preview">
    <%~ it.picture(it.photo, { sizes: '(min-width: 900px) 40vw, 92vw', alt: '' }) %>
    <figcaption class="mono"><%= it.photo.width %> × <%= it.photo.height %> px<% if (it.photo.status === 'published') { %> · <a href="/photo/<%= it.photo.slug %>" target="_blank" rel="noopener">voir sur le site</a><% } %></figcaption>
  </figure>
  <form class="panel form" method="post" action="/admin/photos/<%= it.photo.id %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% if (Object.keys(e).length) { %><p class="err" role="alert">Le formulaire contient des erreurs.</p><% } %>
    <label>Titre <input name="title" value="<%= v.title %>" required maxlength="160"<%~ inv('title') %>></label><% if (e.title) { %><span class="err" id="err-title"><%= e.title %></span><% } %>
    <label>Adresse <span class="mono">/photo/</span><input name="slug" value="<%= v.slug %>" maxlength="80"<%~ inv('slug') %>></label><% if (e.slug) { %><span class="err" id="err-slug"><%= e.slug %></span><% } %>
    <div class="row">
      <label>Série <select name="category_id"<%~ inv('category_id') %>><% it.categories.forEach(c => { %><option value="<%= c.id %>"<%~ c.id === Number(v.category_id) ? ' selected' : '' %>><%= c.name %></option><% }) %></select></label><% if (e.category_id) { %><span class="err" id="err-category_id"><%= e.category_id %></span><% } %>
      <label>Auteur <select name="author_id"<%~ inv('author_id') %>><% it.authors.forEach(a => { %><option value="<%= a.id %>"<%~ a.id === Number(v.author_id) ? ' selected' : '' %>><%= a.name %></option><% }) %></select></label><% if (e.author_id) { %><span class="err" id="err-author_id"><%= e.author_id %></span><% } %>
    </div>
    <div class="row">
      <label>Lieu <input name="place" value="<%= v.place %>" maxlength="120"></label>
      <label>Date <input name="taken_on" value="<%= v.taken_on || '' %>" placeholder="AAAA-MM ou AAAA-MM-JJ" inputmode="numeric"<%~ inv('taken_on') %>></label><% if (e.taken_on) { %><span class="err" id="err-taken_on"><%= e.taken_on %></span><% } %>
    </div>
    <label>Légende <textarea name="legend" rows="3" maxlength="2000"><%= v.legend %></textarea></label>
    <fieldset class="row">
      <legend>Statut</legend>
<% Object.entries(it.STATUSES).forEach(([k, label]) => { %>
      <label class="inline"><input type="radio" name="status" value="<%= k %>"<%~ v.status === k ? ' checked' : '' %>> <%= label %></label>
<% }) %>
    </fieldset>
    <fieldset class="row">
      <legend>Filigrane</legend>
      <label class="inline"><input type="radio" name="watermark" value="default"<%~ v.watermark !== 0 ? ' checked' : '' %>> Selon les <a href="/admin/images">réglages</a></label>
      <label class="inline"><input type="radio" name="watermark" value="none"<%~ v.watermark === 0 ? ' checked' : '' %>> Jamais sur cette photo</label>
    </fieldset>
    <p class="actions"><button class="btn" type="submit">Enregistrer</button></p>
  </form>
</div>
<section class="panel proof" id="preuve">
  <h2>Preuve d’antériorité</h2>
<% const t = it.proof; %>
  <dl class="facts">
    <dt>Empreinte SHA-256 de l’original</dt><dd><code class="mono"><%= it.photo.sha256 || 'en cours de calcul' %></code></dd>
    <dt>Horodatage RFC 3161</dt>
    <dd>
<% if (t && t.status === 'ok' && t.sha256 === it.photo.sha256) { %>
      <strong>Horodatée le <%= t.gen_time.replace('T', ' à ').slice(0, 21) %> UTC</strong><br>
      <span class="mono"><%= t.signer %> · n° <%= t.serial %></span>
<% } else if (!it.tsa.url) { %>
      Désactivé sur ce serveur (<code>TSA_URL=off</code>).
<% } else if (t && t.status === 'error') { %>
      <span class="err">En attente : <%= t.error %> (essai n° <%= t.attempts %>, nouvel essai automatique).</span>
<% } else { %>
      En attente (quelques secondes après l’import).
<% } %>
    </dd>
  </dl>
<% if (t && t.status === 'ok') { %>
  <p class="actions downloads">
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/original" download>Original</a>
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/preuve.tsr" download>Jeton (.tsr)</a>
    <a class="btn ghost" href="/admin/photos/<%= it.photo.id %>/preuve.txt" download>Fiche de preuve</a>
<% if (it.tsa.caFile) { %>    <a class="btn ghost" href="/admin/preuves/autorite.pem" download>Certificat de l’autorité</a><% } %>
  </p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/verifier">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn" type="submit">Vérifier la preuve</button>
  </form>
<% } else if (t && t.status === 'error') { %>
  <form method="post" action="/admin/preuves/reessayer">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin/photos/<%= it.photo.id %>">
    <button class="btn ghost" type="submit">Réessayer maintenant</button>
  </form>
<% } %>
</section>

<details class="danger panel">
  <summary>Supprimer cette photo</summary>
  <p>L’original, ses variantes et sa preuve d’antériorité seront effacés. Cette action est définitive : téléchargez d’abord l’original et la preuve si vous voulez les garder.</p>
  <form method="post" action="/admin/photos/<%= it.photo.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="btn danger" type="submit">Supprimer définitivement</button>
  </form>
</details>
