<% layout('./layout') %>
<% /* Galeries privées : la liste (MQ-18, état 13). Une ligne par galerie : photos, photographe, accès ouverts sur total
      (un accès « ouvert » : son mot de passe a été accepté), dernière activité, état en symbole et en mot ; sous le nom, des
      signaux (sélection envoyée, accès en pause ou suspendu, lien ouvert sur plus de 3 appareils), qui ne sont pas des états. */ %>
<% const t = it.t; const q = (k, v) => { const p = new URLSearchParams(); if (k !== 'etat' && it.etat !== 'toutes') p.set('etat', it.etat); if (k !== 'de' && it.de) p.set('de', it.de); if (v) p.set(k, v); const s = p.toString(); return s ? `?${s}` : '/admin/galeries'; }; %>
<div class="gp">
<p class="help-link"><a href="/admin/aide#galeries-privees"><%= t('Aide sur cette page') %></a></p>
<header class="ep">
  <div class="ep-titre"><h1><%= t('Galeries privées') %></h1></div>
  <p class="ep-meta"><span><%= it.list.length > 1 ? t('{n} galeries', { n: it.list.length }) : t('{n} galerie', { n: it.list.length }) %></span><span><%= t('{n} accès', { n: it.nInvites }) %></span><span><%= t('heure de Paris') %></span></p>
<% if (it.canCreate) { %>  <div class="ep-actions"><a class="btn" href="/admin/galeries/nouvelle"><%= t('Nouvelle galerie') %></a></div>
<% } %></header>
<div class="filtres-l">
  <nav class="chips" aria-label="<%= t('Filtrer les galeries par état') %>">
    <a class="chip" href="<%= q('etat', '') %>"<%~ it.etat === 'toutes' ? ' aria-current="page"' : '' %>><%= t('Toutes') %> <span class="n"><%= it.counts.toutes %></span></a>
    <a class="chip" href="<%= q('etat', 'ouverte') %>"<%~ it.etat === 'ouverte' ? ' aria-current="page"' : '' %>><span class="chip-st chip-st--abouti" aria-hidden="true">●</span><%= t('Ouvertes') %> <span class="n"><%= it.counts.ouverte %></span></a>
    <a class="chip" href="<%= q('etat', 'brouillon') %>"<%~ it.etat === 'brouillon' ? ' aria-current="page"' : '' %>><span class="chip-st chip-st--afaire" aria-hidden="true">○</span><%= t('Brouillons') %> <span class="n"><%= it.counts.brouillon %></span></a>
    <a class="chip" href="<%= q('etat', 'fermee') %>"<%~ it.etat === 'fermee' ? ' aria-current="page"' : '' %>><span class="chip-st chip-st--arret" aria-hidden="true">✕</span><%= t('Fermées') %> <span class="n"><%= it.counts.fermee %></span></a>
  </nav>
<% if (it.authors.length > 1) { %>  <div class="seg" role="group" aria-label="<%= t('Photographe') %>"><a href="<%= q('de', '') %>"<%~ !it.de ? ' aria-current="page"' : '' %>><%= it.authors.length === 2 ? t('Les deux') : t('Tous') %></a><% it.authors.forEach(a => { %><a href="<%= q('de', a.slug) %>"<%~ it.de === a.slug ? ' aria-current="page"' : '' %>><%= a.name %></a><% }) %></div>
<% } %></div>
<% if (!it.list.length) { %>
<p class="empty"><%= t('Aucune galerie privée pour l’instant.') %><% if (it.canCreate) { %> <a class="more" href="/admin/galeries/nouvelle"><%= t('Créer la première') %></a><% } %></p>
<% } else { %>
<div class="tablewrap liste-wrap"><table class="liste-a">
<caption><%= t('{n} galeries : les ouvertes d’abord, par date de fermeture. Un accès « ouvert » : son mot de passe a été accepté, pas seulement son lien chargé.', { n: it.list.length }) %></caption>
<thead><tr><th scope="col"><%= t('Galerie') %></th><th scope="col" class="num"><%= t('Photos') %></th><th scope="col"><%= t('Photographe') %></th><th scope="col"><%= t('Accès ouverts') %></th><th scope="col"><%= t('Dernière activité') %></th><th scope="col"><%= t('État') %></th></tr></thead>
<tbody>
<% it.list.forEach(g => { %><tr><th scope="row"><a class="ligne-lien" href="/admin/galeries/<%= g.id %>"><%= g.title %></a><% g.signals.forEach(sg => { %><span class="att"><span aria-hidden="true">▲</span> <%= sg %></span><% }) %></th>
<td class="num c-haut"><%= g.nPhotos > 1 ? t('{n} photos', { n: g.nPhotos }) : t('{n} photo', { n: g.nPhotos }) %></td><td class="c-demi" data-label="<%= t('Photographe') %>"><%= g.who %></td>
<td class="c-demi" data-label="<%= t('Accès ouverts') %>"><%= t('{n} sur {total}', { n: g.nOpened, total: g.nLive }) %><% if (g.groups) { %><span class="sec"><%= t('lien de groupe') %></span><% } %></td>
<td class="c-demi" data-label="<%= t('Dernière activité') %>"><%= g.last ? new Intl.DateTimeFormat(it.locale, { day: 'numeric', month: 'short', timeZone: 'Europe/Paris' }).format(g.last) : t('aucune') %></td>
<td class="c-etat"><%~ include('./_galerie-etat', { key: g.stateKey, text: g.stateText }) %><span class="sec"><%= g.stateSec %></span></td></tr>
<% }) %></tbody></table></div>
<% } %>
<div class="pied-liste"><ul class="etats-legende" aria-label="<%= t('États d’une galerie') %>">
<li class="etat--afaire"><span aria-hidden="true">○</span><%= t('Brouillon (l’équipe seule)') %></li><li class="etat--abouti"><span aria-hidden="true">●</span><%= t('Ouverte') %></li><li class="etat--attention"><span aria-hidden="true">▲</span><%= t('Ferme dans 7 jours') %></li><li class="etat--arret"><span aria-hidden="true">✕</span><%= t('Fermée') %></li></ul>
<p><%= t('Sous le nom, en ambre, des signaux, qui ne sont pas des états : sélection envoyée, accès en pause ou suspendu, lien ouvert sur plus de 3 appareils. Chaque photographe voit ses galeries, l’administrateur toutes ; Modérateur et Relecteur n’y ont pas accès.') %></p></div>
</div>
