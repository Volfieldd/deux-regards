<% /* État en symbole, en couleur et en mot (lexique des maquettes, § 3) : ○ à faire, ◐ en cours, ● abouti, ▲ attention, ✕ arrêt. */ %>
<% const SYM = { afaire: '○', encours: '◐', abouti: '●', attention: '▲', arret: '✕' }; %>
<span class="etat etat--<%= it.key %>"><span aria-hidden="true"><%= SYM[it.key] %></span><%= it.text %></span>
