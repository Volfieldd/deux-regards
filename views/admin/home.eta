<% layout('./layout') %>
<% const t = it.t; %>
<% // Date et salutation à l'heure de Paris (le serveur peut tourner en UTC).
   const paris = new Intl.DateTimeFormat(it.locale, { timeZone: 'Europe/Paris', weekday: 'long', day: 'numeric', month: 'long', hour: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).reduce((o, p) => ({ ...o, [p.type]: p.value }), {});
   const SHORT = it.lang === 'fr' || !it.lang ? ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.']
     : Array.from({ length: 12 }, (_, i) => new Intl.DateTimeFormat(it.locale, { month: 'short', timeZone: 'UTC' }).format(Date.UTC(2000, i, 1)));
   const h = Number(paris.hour);
   const first = (it.me && it.me.name) || (it.session.name || '').split(' ')[0];
   const max = Math.max(1, ...it.rhythm.map(r => r.n));
   const ago = iso => { const d = (Date.now() - new Date(iso.replace(' ', 'T') + 'Z')) / 1000; if (d < 3600) return t('il y a {n} min', { n: Math.max(1, Math.round(d / 60)) }); if (d < 86400) return t('il y a {n} h', { n: Math.round(d / 3600) }); if (d < 172800) return t('hier'); return t('il y a {n} j', { n: Math.round(d / 86400) }); };
   const photosN = n => n > 1 ? t('{n} photos', { n }) : t('{n} photo', { n });
   const pr = it.proofs; %>
<div class="today">
  <div class="head">
    <div>
      <p class="date"><%= t('{weekday} {day} {month}', { weekday: paris.weekday, day: paris.day, month: paris.month }) %></p>
      <h1><%= h < 5 || h >= 18 ? t('Bonsoir') : t('Bonjour') %><%= first ? `, ${first}` : '' %>.</h1>
    </div>
    <span class="sp"></span>
    <a class="btn ghost" href="/" target="_blank" rel="noopener"><%= t('Voir le site') %></a>
    <a class="btn big" href="/admin/photos?importer#import">＋ <%= t('Importer des photos') %></a>
  </div>

  <section class="panel tasks" aria-labelledby="tasks-title">
    <h2 id="tasks-title"><%= t('À faire') %> <span class="mono"><%= it.tasks.length ? (it.tasks.length > 1 ? t('{n} choses, les plus urgentes d’abord', { n: it.tasks.length }) : t('1 chose, les plus urgentes d’abord')) : t('rien pour l’instant') %></span></h2>
<% if (!it.tasks.length) { %>
    <p class="hint"><%= t('Rien ne demande votre attention : ni demande à traiter, ni refus en attente, ni photo à finir.') %></p>
<% } else { const LABEL = { urgent: t('Urgent'), bientot: t('Bientôt'), 'plus-tard': t('Quand vous avez le temps') }; %>
    <ul class="task-list">
<% it.tasks.forEach(task => { %>
      <li class="task <%= task.level %>">
        <span class="st" aria-hidden="true"></span>
        <span class="t"><a href="<%= task.href %>"><%= task.title %></a><small><span class="sr-only"><%= t('{level} :', { level: LABEL[task.level] }) %> </span><%= task.detail %></small></span>
        <a class="btn <%= task.level === 'urgent' ? '' : 'ghost' %>" href="<%= task.href %>" tabindex="-1" aria-hidden="true"><%= task.action %></a>
      </li>
<% }) %>
    </ul>
    <p class="task-legend mono" aria-hidden="true"><span class="task urgent"><span class="st"></span><%= t('urgent') %></span><span class="task bientot"><span class="st"></span><%= t('bientôt') %></span><span class="task plus-tard"><span class="st"></span><%= t('quand vous avez le temps') %></span></p>
<% } %>
  </section>

  <div class="bento">
    <section class="panel" id="a-finir" aria-labelledby="todo-title">
      <h2 id="todo-title"><%= t('À finir') %> <span class="mono"><%= it.todoCount ? photosN(it.todoCount) : t('rien') %></span><% if (it.todo.length) { %><a class="btn ghost push" href="/admin/photos?statut=afinir"><%= t('Tout finir en un écran →') %></a><% } %></h2>
<% if (!it.todo.length) { %>
      <p class="hint"><%= t('Tout est publié et titré. Belle journée.') %></p>
<% } else { %>
      <ul class="todo">
<% it.todo.forEach(p => { %>
        <li>
          <% if (p.ready) { %><%~ it.picture(p, { sizes: '56px', alt: '' }) %><% } else { %><span class="ph">…</span><% } %>
          <span class="t"><a href="/admin/photos/<%= p.id %>"><%= p.title %></a><small><%= p.provisional ? t('titre provisoire') : t('brouillon, prêt à publier') %><%= p.place ? '' : ' · ' + t('sans lieu') %></small></span>
<% if (p.provisional) { %>
          <a class="btn ghost" href="/admin/photos/<%= p.id %>"><%= t('Titrer') %></a>
<% } else { %>
          <form method="post" action="/admin/photos/<%= p.id %>/status">
            <input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="/admin"><input type="hidden" name="status" value="published">
            <button class="btn ghost" type="submit"><%= t('Publier') %></button>
          </form>
<% } %>
        </li>
<% }) %>
      </ul>
<% } %>
    </section>

    <section class="panel" aria-labelledby="site-title">
      <h2 id="site-title"><%= t('Le site, en ce moment') %></h2>
      <div class="filmstrip"><% it.hero.forEach(p => { %><%~ it.picture(p, { sizes: '140px', alt: '' }) %><% }) %></div>
      <p class="hint"><%= it.heroChosen ? t('Ouverture : {photos}, dans l’ordre choisi', { photos: photosN(it.hero.length) }) : t('Ouverture : {photos} (les premières de la galerie)', { photos: photosN(it.hero.length) }) %> · <%= t('thème {theme}', { theme: it.themeLabel || '—' }) %> · <a class="more" href="/admin/site#ouverture"><%= t('modifier') %></a></p>
    </section>

    <section class="panel" aria-label="<%= t('Chiffres') %>">
      <div class="figures">
        <a href="/admin/statistiques"><b><%= it.visitorsToday %></b><span><%= it.visitorsToday > 1 ? t('visiteurs aujourd’hui') : t('visiteur aujourd’hui') %></span></a>
        <a href="/admin/photos?statut=published"><b><%= it.counts.published %></b><span><%= t('photos publiées') %></span></a>
        <a href="/admin/photos?statut=draft"><b><%= it.counts.draft %></b><span><%= t('brouillons') %></span></a>
        <a href="/admin/series"><b><%= it.categories %></b><span><%= t('séries') %></span></a>
        <a href="/admin/auteurs"><b><%= it.authors.length %></b><span><%= it.authors.length > 1 ? t('photographes') : t('photographe') %></span></a>
      </div>
    </section>

<% if (it.monthTop) { %>
    <section class="panel" aria-labelledby="top-title">
      <h2 id="top-title"><%= t('La photo du moment') %> <span class="mono"><%= it.monthTop.views > 1 ? t('{n} ouvertures en 30 jours', { n: it.monthTop.views }) : t('{n} ouverture en 30 jours', { n: it.monthTop.views }) %></span><a class="btn ghost push" href="/admin/statistiques"><%= t('Statistiques') %> →</a></h2>
      <a class="motm" href="/admin/photos/<%= it.monthTop.id %>"><% if (it.monthTop.ready) { %><%~ it.picture(it.monthTop, { sizes: '320px', alt: '' }) %><% } %><span><%= it.monthTop.title %></span></a>
    </section>
<% } %>
    <section class="panel" aria-labelledby="rhythm-title">
      <h2 id="rhythm-title"><%= t('Rythme') %> <span class="mono"><%= t('photos importées par mois') %></span></h2>
      <div class="rhythm" role="img" aria-label="<%= it.rhythm.map(r => t('{month} : {n}', { month: `${SHORT[Number(r.month.slice(5)) - 1]} ${r.month.slice(0, 4)}`, n: r.n })).join(', ') %>">
<% it.rhythm.forEach((r, i) => { %>        <i class="h<%= Math.round((r.n / max) * 10) %><%= i === it.rhythm.length - 1 ? ' now' : '' %>"></i>
<% }) %>
      </div>
      <p class="rhythm-legend"><span><%= SHORT[Number(it.rhythm[0].month.slice(5)) - 1] %> <%= it.rhythm[0].month.slice(0, 4) %></span><span><%= SHORT[Number(it.rhythm.at(-1).month.slice(5)) - 1] %> <%= it.rhythm.at(-1).month.slice(0, 4) %></span></p>
    </section>

    <section class="panel" aria-labelledby="recent-title">
      <h2 id="recent-title"><%= t('Dernières modifications') %></h2>
      <ul class="recent">
<% it.recent.forEach(p => { %>
        <li><% if (p.ready) { %><%~ it.picture(p, { sizes: '40px', alt: '' }) %><% } else { %><span class="ph"></span><% } %><a href="/admin/photos/<%= p.id %>"><%= p.title %></a><span class="mono"><%= p.status === 'published' ? t('publiée') : t('brouillon') %> · <%= p.author %></span><span class="w"><%= ago(p.updated_at) %></span></li>
<% }) %>
      </ul>
    </section>

    <section class="panel" aria-labelledby="proofs-title">
      <h2 id="proofs-title"><%= t('Preuves d’antériorité') %></h2>
<% if (!it.tsa.url) { %>
      <p class="hint"><%~ t('Horodatage désactivé sur ce serveur ({code}) : seules les empreintes des originaux sont calculées.', { code: '<code>TSA_URL=off</code>' }) %></p>
<% } else { %>
      <p><%~ pr.errors ? t('{ok} photo(s) sur {total} horodatée(s), {errors} en attente après une erreur.', { ok: `<strong>${__eta.e(pr.ok)}</strong>`, total: __eta.e(pr.photos), errors: __eta.e(pr.errors) }) : t('{ok} photo(s) sur {total} horodatée(s).', { ok: `<strong>${__eta.e(pr.ok)}</strong>`, total: __eta.e(pr.photos) }) %> <span class="hint"><%= t('Autorité : {name}', { name: it.tsa.url }) %></span></p>
<% if (pr.errors) { %>
      <form method="post" action="/admin/preuves/reessayer"><input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <button class="btn ghost" type="submit"><%= t('Réessayer maintenant') %></button></form>
<% } %>
<% } %>
    </section>

    <section class="panel wide2" aria-labelledby="account-title">
      <h2 id="account-title"><%= t('Votre compte') %></h2>
      <p><%~ t('Connecté en tant que {name}.', { name: `<strong>${__eta.e(it.session.name || it.session.email || it.session.sub)}</strong>` }) %>
<% if (it.me) { %>
      <%~ t('Ce compte est lié au photographe {name} : vos imports lui sont attribués par défaut.', { name: `<strong>${__eta.e(it.me.name)}</strong>` }) %></p>
<% } else { %>
      <%= t('Ce compte n’est lié à aucun photographe : un administrateur peut le relier dans « Comptes et rôles ».') %></p>
<% } %>
      <p class="mono"><%= t('Rôles : {roles}', { roles: (it.session.roles || []).map(r => t(it.roleLabels[r] || r)).join(', ') || '—' }) %><% if (it.can('comptes.gerer')) { %> · <a class="more" href="/admin/comptes"><%= t('Comptes et rôles') %></a><% } %></p>
    </section>
  </div>
</div>
