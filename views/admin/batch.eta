<% layout('./layout') %>
<% const t = it.t; %>
<% const E = it.errors, V = it.values; %>
<div class="toolbar">
  <div>
    <h1><%= t('Compléter et publier') %></h1>
    <p class="sub"><%= it.photos.length > 1 ? t('{n} photos', { n: it.photos.length }) : t('{n} photo', { n: it.photos.length }) %> · <span data-js-only hidden><%= t('chaque champ s’enregistre quand vous le quittez') %></span><span data-nojs><%= t('enregistrez avec le bouton en bas du tableau') %></span></p>
  </div>
  <div class="acts"><a class="btn ghost" href="/admin/photos"><%= t('Toutes les photos') %></a></div>
</div>
<% if (it.rest && it.rest.length) { %>
<p class="flash" role="note"><%= t('{n} photos sur {total} : une page en montre 200 au plus.', { n: it.photos.length, total: it.total }) %> <a class="more" href="/admin/photos/lot?ids=<%= it.rest.join(',') %>"><%= it.rest.length > 1 ? t('Les {n} suivantes →', { n: it.rest.length }) : t('La suivante →') %></a></p>
<% } %>
<ol class="steps" aria-label="<%= t('Étapes de l’import') %>">
  <li class="done"><span class="n">1.</span> <%= t('Choisir et vérifier') %></li>
  <li class="done"><span class="n">2.</span> <%= t('Envoi et traitement') %></li>
  <li aria-current="step"><span class="n">3.</span> <%= t('Compléter et publier') %></li>
</ol>

<form class="bulk" id="bulk" method="post" action="/admin/photos/actions" data-bulk data-batch aria-label="<%= t('Appliquer à la sélection') %>">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <input type="hidden" name="back" value="/admin/photos/lot?ids=<%= it.ids.join(',') %>">
  <strong data-bulk-count role="status"><%= t('Pour les photos cochées :') %></strong><span class="hint-dark" data-js-only hidden><%= t('série, lieu et date s’appliquent dès que vous les changez') %></span>
  <%/* Sur téléphone, ces champs sont repliés derrière un bouton : ils changent toutes les photos cochées d'un coup. */%>
  <button class="btn ghost bulk-toggle" type="button" data-bulk-toggle aria-expanded="false" aria-controls="bulk-groups" hidden><%= t('Série, lieu ou date pour toutes les cochées…') %></button>
  <div class="bulk-groups" id="bulk-groups">
  <span class="group">
    <select name="category_id" aria-label="<%= t('Série') %>" data-bulk-category>
      <option value=""><%= t('Série…') %></option>
<% it.categories.forEach(c => { %>      <option value="<%= c.id %>"><%= c.name %></option>
<% }) %>      <option value="new">＋ <%= t('Nouvelle série…') %></option>
    </select>
    <input name="new_category" maxlength="80" placeholder="<%= t('Nom de la nouvelle série') %>" aria-label="<%= t('Nom de la nouvelle série') %>" data-bulk-new>
    <button class="btn ghost" type="submit" name="action" value="category" data-nojs><%= t('Appliquer la série') %></button>
  </span>
  <span class="group">
    <input name="place" maxlength="120" placeholder="<%= t('Lieu') %>" aria-label="<%= t('Lieu pour la sélection') %>">
    <input name="taken_on" maxlength="40" placeholder="<%= t('Date : oct. 2026') %>" aria-label="<%= t('Date pour la sélection') %>">
    <button class="btn ghost" type="submit" name="action" value="fields" data-nojs><%= t('Appliquer lieu et date') %></button>
  </span>
  </div>
  <span class="spacer"></span>
<% if (it.can('photos.publier')) { %>  <button class="btn" type="submit" name="action" value="publish" data-publish><%= t('Publier') %></button>
<% } %></form>

<form method="post" action="/admin/photos/lot" data-lot novalidate>
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <input type="hidden" name="ids" value="<%= it.ids.join(',') %>">
<% if (Object.keys(E).length) { %>  <p class="flash error" role="alert"><%= t('Certaines photos n’ont pas été enregistrées : corrigez les champs signalés.') %></p>
<% } %>
  <div class="tablewrap">
  <table class="lot">
    <thead><tr>
      <th scope="col"><label class="inline"><input type="checkbox" class="chk" checked data-select-all-lot aria-label="<%= t('Tout sélectionner') %>"></label></th>
      <th scope="col"><%= t('Aperçu') %></th><th scope="col"><%= t('Titre') %></th><th scope="col"><%= t('Série') %></th><th scope="col"><%= t('Lieu') %></th><th scope="col"><%= t('Date') %></th><th scope="col"><%= t('État') %></th>
    </tr></thead>
    <tbody>
<% it.photos.forEach(p => { const e = E[p.id] || {}, v = { ...p, ...(V[p.id] || {}) }; %>
      <tr data-id="<%= p.id %>" data-title="<%= p.title %>"<%~ p.provisional ? ' data-provisional' : '' %>>
        <td class="c-chk"><input class="chk" type="checkbox" name="ids" value="<%= p.id %>" form="bulk" checked aria-label="<%= t('Sélectionner « {title} »', { title: p.title }) %>"></td>
        <td class="thumbcell c-thumb"><% if (p.ready) { %><%~ it.picture(p, { sizes: '84px', alt: '' }) %><% } else { %><span class="ph" data-processing><%= t('Traitement…') %></span><% } %></td>
        <td class="c-title" data-label="<%= t('Titre') %>">
          <input name="title_<%= p.id %>" value="<%= v.title %>" maxlength="160" aria-label="<%= t('Titre de la photo {id}', { id: p.id }) %>" data-field="title"<%~ e.title ? ' aria-invalid="true"' : '' %> aria-describedby="prov-<%= p.id %><%= e.title ? ` err-title-${p.id}` : '' %>">
          <span class="cellnote warn" id="prov-<%= p.id %>"<%~ p.provisional ? '' : ' hidden' %>><%= t('Titre provisoire (nom du fichier)') %></span>
<% if (e.title) { %>          <span class="err" id="err-title-<%= p.id %>"><%= e.title %></span>
<% } %>
        </td>
        <td class="c-cat" data-label="<%= t('Série') %>"><select name="category_id_<%= p.id %>" aria-label="<%= t('Série de la photo {id}', { id: p.id }) %>" data-field="category_id"><% it.categories.forEach(c => { %><option value="<%= c.id %>"<%~ c.id === Number(v.category_id) ? ' selected' : '' %>><%= c.name %></option><% }) %></select></td>
        <td class="c-place" data-label="<%= t('Lieu') %>"><input name="place_<%= p.id %>" value="<%= v.place || '' %>" maxlength="120" aria-label="<%= t('Lieu de la photo {id}', { id: p.id }) %>" data-field="place"></td>
        <td class="c-date" data-label="<%= t('Date') %>">
          <input name="taken_on_<%= p.id %>" value="<%= v.taken_on || '' %>" maxlength="40" placeholder="<%= t('oct. 2026') %>" aria-label="<%= t('Date de la photo {id}', { id: p.id }) %>" data-field="taken_on" aria-describedby="date-<%= p.id %>"<%~ e.taken_on ? ' aria-invalid="true"' : '' %>>
<% /* Heure de prise de vue (EXIF) avec la date ; data-time : gardée par admin.js quand la date est réécrite. */
   const shot = p.taken_time ? t('prise à {time}', { time: it.lang === 'fr' ? p.taken_time.replace(':', ' h ') : p.taken_time }) : ''; %>
          <span class="cellnote<%= e.taken_on ? ' err' : '' %>" id="date-<%= p.id %>" data-time="<%= shot %>"><%= e.taken_on || [p.when && t('compris : {date}', { date: p.when }), shot].filter(Boolean).join(' · ') %></span>
        </td>
        <td class="c-state"><span class="saved" data-state><%= p.status === 'published' ? '● ' + t('Publiée') : '○ ' + t('Brouillon') %></span></td>
      </tr>
<% }) %>
    </tbody>
  </table>
  </div>
  <p class="actions" data-nojs>
    <button class="btn ghost" type="submit"><%= t('Enregistrer') %></button>
<% if (it.can('photos.publier')) { %>    <button class="btn" type="submit" name="publish" value="1"><%= t('Enregistrer et publier tout') %></button>
<% } %>
  </p>
  <p class="hint"><%= t('Légende, filigrane et preuve d’antériorité : depuis la fiche de chaque photo (Photos › titre).') %></p>
</form>

