<% layout('./layout') %>
<h1>Auteurs</h1>
<% const fields = (v, errs) => { const bad = k => errs && errs[k] ? ` aria-invalid="true" aria-describedby="err-auteur-${v.id || 'nouveau'}"` : ''; %>
      <div class="row">
        <label>Nom <input name="name" value="<%= v.name || '' %>" required maxlength="80"<%~ bad('name') %>></label>
<% if (v.id) { %>        <label>Adresse <span class="mono">/auteur/</span><input name="slug" value="<%= v.slug %>" maxlength="80"<%~ bad('slug') %>></label><% } %>
      </div>
      <label>Biographie <textarea name="bio" rows="3" maxlength="2000"><%= v.bio || '' %></textarea></label>
      <%~ include('./_tr', { asset: it.asset, translate: it.translate, v, name: 'bio', label: 'Biographie', max: 2000, rows: 3 }) %>
      <label>Compte de connexion (identifiant OIDC « sub »)
        <input name="oidc_sub" value="<%= v.oidc_sub || '' %>" maxlength="255" class="mono" placeholder="affiché sur le tableau de bord après connexion"<%~ bad('oidc_sub') %>></label>
<% if (errs) { %>      <p class="err" role="alert" id="err-auteur-<%= v.id || 'nouveau' %>"><%= Object.values(errs).join(' ') %></p><% } %>
<% } %>
<% it.authors.forEach(a => { const ed = it.editErrors && it.editErrors.id === a.id ? it.editErrors : null; %>
  <section class="panel">
    <h2><%= a.name %> <span class="mono"><%= a.count %> photo(s)</span></h2>
    <form class="form" method="post" action="/admin/auteurs/<%= a.id %>">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% fields(ed ? { ...a, ...ed.values } : a, ed && ed.errors) %>
      <p class="actions"><button class="btn" type="submit">Enregistrer</button></p>
    </form>
    <details class="danger">
      <summary>Supprimer</summary>
<% if (a.count) { %>
      <p>Impossible : <%= a.name %> a encore <%= a.count %> photo(s).</p>
<% } else { %>
      <form method="post" action="/admin/auteurs/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <button class="btn danger" type="submit">Supprimer « <%= a.name %> »</button></form>
<% } %>
    </details>
  </section>
<% }) %>
<section class="panel">
  <h2>Nouvel auteur</h2>
  <form class="form" method="post" action="/admin/auteurs">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% fields(it.values, Object.keys(it.errors).length ? it.errors : null) %>
    <p class="actions"><button class="btn" type="submit">Ajouter</button></p>
  </form>
</section>
