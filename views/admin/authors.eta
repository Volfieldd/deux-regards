<% layout('./layout') %>
<h1>Auteurs</h1>
<% const fields = (v, errs) => { const bad = k => errs && errs[k] ? ` aria-invalid="true" aria-describedby="err-auteur-${v.id || 'nouveau'}"` : ''; %>
      <div class="row">
        <label>Nom <input name="name" value="<%= v.name || '' %>" required maxlength="80"<%~ bad('name') %>></label>
<% if (v.id) { %>        <label>Adresse <span class="mono">/auteur/</span><input name="slug" value="<%= v.slug %>" maxlength="80"<%~ bad('slug') %>></label><% } %>
      </div>
      <label>Biographie <textarea name="bio" rows="3" maxlength="2000"><%= v.bio || '' %></textarea></label>
      <%~ include('./_tr', { asset: it.asset, translate: it.translate, v, name: 'bio', label: 'Biographie', max: 2000, rows: 3 }) %>
      <label>Lettre des cartes de rencontre <span class="mono">J-0142 ; vide : <%= v.slug ? v.slug.charAt(0).toUpperCase() : 'première lettre de l’adresse' %></span><input name="card_prefix" value="<%= v.card_prefix || '' %>" maxlength="1" autocapitalize="characters" class="mono" size="2"<%~ bad('card_prefix') %>></label>
      <label>Compte de connexion (identifiant OIDC « sub »)
        <input name="oidc_sub" value="<%= v.oidc_sub || '' %>" maxlength="255" class="mono" placeholder="affiché sur le tableau de bord après connexion"<%~ bad('oidc_sub') %>></label>
<% if (errs) { %>      <p class="err" role="alert" id="err-auteur-<%= v.id || 'nouveau' %>"><%= Object.values(errs).join(' ') %></p><% } %>
<% } %>
<% it.authors.forEach(a => { const ed = it.editErrors && it.editErrors.id === a.id ? it.editErrors : null; %>
  <section class="panel">
    <h2><%= a.name %> <span class="mono"><%= a.count %> photo(s)</span></h2>
    <form class="form" method="post" action="/admin/auteurs/<%= a.id %>">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% fields(ed ? { ...a, ...ed.values } : a, ed && ed.errors) %>
      <p class="actions"><button class="btn" type="submit">Enregistrer</button></p>
    </form>
    <details class="qr-wear">
      <summary>QR pour les vêtements <span class="mono"><%= it.publicUrl.replace(/^https?:\/\/(www\.)?/, '') %>/bonjour/<%= a.card_prefix || a.slug.charAt(0).toUpperCase() %></span></summary>
      <p class="hint">Le QR générique de <%= a.name %> : il ouvre la page <a href="/bonjour/<%= a.card_prefix || a.slug.charAt(0).toUpperCase() %>" target="_blank" rel="noopener">/bonjour</a> avec son nom, sans numéro de carte (la personne indique la date et le lieu). Pour un tee-shirt, un sac, une casquette, un écusson. Fichiers vectoriels (SVG, texte en tracés : l’imprimeur n’a pas besoin des polices) ou PNG transparent à 300 dpi.</p>
      <div class="qr-models">
<% [['vertical', 'Dos de tee-shirt, sac', '12 × 17,5 cm'], ['carre', 'Écusson, casquette', '8 × 8 cm'], ['qr', 'QR seul', 'à la taille voulue']].forEach(([model, label, size]) => { %>
<% ['noir', 'blanc'].forEach(ink => { const f = `/admin/auteurs/${a.id}/qr/${model}-${ink}`; %>
        <figure class="qr-model <%= ink %>">
          <img src="<%= f %>.svg?apercu=1" alt="" loading="lazy">
          <figcaption><strong><%= label %></strong> · <%= ink === 'noir' ? 'encre noire, textile clair' : 'encre blanche, textile foncé' %><br><span class="mono"><%= size %></span> · <a href="<%= f %>.svg">SVG</a> · <a href="<%= f %>.png">PNG</a></figcaption>
        </figure>
<% }) %>
<% }) %>      </div>
      <p class="hint">Taille conseillée du QR : 8 à 10 cm de côté au moins sur un dos (lisible à un ou deux mètres), 4 à 5 cm sur une casquette ou un écusson (scanné de près). Gardez la marge blanche autour du QR.</p>
    </details>
    <details class="danger">
      <summary>Supprimer</summary>
<% if (a.count) { %>
      <p>Impossible : <%= a.name %> a encore <%= a.count %> photo(s).</p>
<% } else { %>
      <form method="post" action="/admin/auteurs/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <button class="btn danger" type="submit">Supprimer « <%= a.name %> »</button></form>
<% } %>
    </details>
  </section>
<% }) %>
<section class="panel">
  <h2>Nouvel auteur</h2>
  <form class="form" method="post" action="/admin/auteurs">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% fields(it.values, Object.keys(it.errors).length ? it.errors : null) %>
    <p class="actions"><button class="btn" type="submit">Ajouter</button></p>
  </form>
</section>
