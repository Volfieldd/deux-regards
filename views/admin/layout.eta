<!doctype html>
<html lang="<%= it.lang || 'fr' %>"<%~ it.adminTheme ? ` data-theme="${it.adminTheme}"` : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="<%= it.adminTheme || 'dark light' %>">
  <title><%= it.pageTitle %></title>
  <link rel="stylesheet" href="<%= it.asset('admin/admin.css') %>">
<% const masks = it.brand ? [it.brand.emblem, it.brand.icon, it.brand.logotype].filter(Boolean).join('.') : ''; %>
<% if (masks) { %>
  <link rel="stylesheet" href="/brand.css?v=<%= masks %>">
<% } %>
  <script src="<%= it.asset('admin/admin.js') %>" defer></script>
</head>
<body class="admin" data-csrf="<%= it.csrf %>" data-can="<%= (it.grants || []).join(' ') %>">
<% const t = it.t; %>
<a class="skip" href="#contenu"><%= t('Aller au contenu') %></a>
<% if (it.local) { %>
  <p class="testbar" role="note"><%= t('Connexion locale de test') %> — <%= it.session.name %></p>
<% } %>
<%
  const ICON = {
    home: '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>',
    encounters: '<path d="M4 7h16v12H4z"/><path d="M4 7l8 6 8-6"/>',
    photos: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 16l-5-5-9 9"/>',
    series: '<rect x="3" y="9" width="18" height="11" rx="1.5"/><path d="M6 6h12M8.5 3h7"/>',
    authors: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>',
    images: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
    appearance: '<circle cx="12" cy="12" r="9"/><circle cx="8" cy="10" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16" cy="10" r="1"/><path d="M12 21a3 3 0 0 1 0-6h2"/>',
    settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/>',
    help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14"/><path d="M12 17h.01"/>',
    site: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
    upload: '<path d="M12 16V4M7 9l5-5 5 5M4 20h16"/>',
    menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
    instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
    stats: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
    people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c1-3.5 3.5-5.5 6.5-5.5s5.5 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.5c2.6.2 4.4 2 5.3 4.8"/>',
    trip: '<path d="M4 19c3-1 4-4 8-4s5 3 8 4"/><path d="M12 15V4l6 3-6 3"/>',
    star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
    globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3z"/>',
    outing: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><circle cx="12" cy="15" r="2"/>',
    pin: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
    shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/>',
    flag: '<path d="M5 21V4"/><path d="M5 4h12l-2.5 4L17 12H5"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="M10.8 12.2L20 3M16 7l3 3M14 9l2 2"/>',
    journal: '<path d="M6 3h11a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6z"/><path d="M9 8h6M9 12h6M9 16h4"/>',
    sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"/>',
    moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
    logout: '<path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 17l5-5-5-5M15 12H3"/>',
  };
  const ic = (k, s = 18) => `<svg class="ic" width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[k]}</svg>`;
  const cur = (key) => it.section === key || (key === 'photos' && (it.section === 'photo' || it.section === 'batch' || it.section === 'confirm-delete'));
  const b = it.brand || {};
  const nextTheme = it.adminTheme === 'light' ? 'dark' : 'light';
%>
<div class="shell">
<aside class="side" id="admin-nav" data-side>
  <a class="word" href="/admin"><% if (b.emblem) { %><span class="emblem" aria-hidden="true"></span><% } %><span><%= it.siteName %></span></a>
  <button class="cmdk" type="button" data-cmdk-open hidden><%~ ic('search', 16) %><span><%= t('Rechercher, agir…') %></span><kbd>⌘K</kbd></button>
<%
  // Menu rangé par intention : travailler les photos et les personnes, publier, préparer le terrain, régler.
  const esc = v => String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  // Une entrée n'apparaît que si le compte a le droit d'ouvrir la page.
  const can = it.can || (() => true);
  const item = ([key, href, label, icon, extra, perm]) => (perm && !can(perm) ? '' : `<a href="${href}"${(extra || cur(key)) ? ' aria-current="page"' : ''}>${ic(icon)}${esc(t(label))}</a>`);
  const people = it.section === 'encounters' || it.section === 'encounter' || it.section === 'people' || it.section === 'person';
%>
  <nav class="nav" aria-label="<%= t('Administration') %>">
    <a href="/admin"<%~ cur('home') ? ' aria-current="page"' : '' %>><%~ ic('home') %><%= t('Aujourd’hui') %><% if (it.urgent) { /* nombre lu par un texte masqué : aria-label ne nomme pas un simple span */ %><span class="nav-badge urgent"><span aria-hidden="true">✕ <%= it.urgent %></span><span class="sr-only"><%= it.urgent > 1 ? t('{n} urgences', { n: it.urgent }) : t('1 urgence') %></span></span><% } %></a>
  </nav>
  <p class="grp" id="nav-work"><%= t('Travailler') %></p>
  <nav class="nav" aria-labelledby="nav-work">
<% if (can('sorties.voir')) { %>    <a href="/admin/sorties"<%~ it.section === 'outings' || it.section === 'outing' ? ' aria-current="page"' : '' %>><%~ ic('outing') %><%= t('Sorties') %></a>
    <a href="/admin/voyages"<%~ it.section === 'trips' || it.section === 'trip' ? ' aria-current="page"' : '' %>><%~ ic('trip') %><%= t('Voyages') %></a>
<% } %>
    <%~ item(['photos', '/admin/photos', 'Photothèque', 'photos', null, 'photos.voir']) %>
<% if (can('personnes.voir')) { %>    <a href="/admin/personnes"<%~ people ? ' aria-current="page"' : '' %>><%~ ic('people') %><%= t('Personnes') %><% if (it.encountersNew) { %><span class="nav-badge"><span aria-hidden="true"><%= it.encountersNew %></span><span class="sr-only"><%= it.encountersNew > 1 ? t('{n} nouvelles', { n: it.encountersNew }) : t('1 nouvelle') %></span></span><% } %></a>
<% } %>  </nav>
  <p class="grp" id="nav-publish"><%= t('Publier') %></p>
  <nav class="nav" aria-labelledby="nav-publish">
<% if (it.canAll && it.canAll('photos.publier')) { %>    <a href="/admin/a-valider"<%~ it.section === 'review' ? ' aria-current="page"' : '' %>><%~ ic('photos') %><%= t('À valider') %><% if (it.toValidate) { %><span class="nav-badge"><%= it.toValidate %></span><% } %></a>
<% } %>    <%~ item(['site', '/admin/site', 'Site public', 'globe', null, 'site.textes']) %>
    <%~ item(['series', '/admin/series', 'Séries', 'series', null, 'series.gerer']) %>
  </nav>
<% if (it.navSeries && it.navSeries.length && can('photos.voir')) { %>
  <ul class="ser" aria-label="<%= t('Séries') %>">
<% it.navSeries.forEach(c => { %>
    <li><a href="/admin/photos?serie=<%= c.slug %>" data-drop-series="<%= c.id %>" data-series-name="<%= c.name %>"><span class="sw"><% if (c.thumb) { %><img src="<%= c.thumb %>" alt="" loading="lazy"><% } %></span><span class="t"><%= c.name %></span><span class="n"><%= c.count %></span></a></li>
<% }) %>
  </ul>
<% } %>
  <nav class="nav" aria-label="<%= t('Diffusion') %>">
    <%~ item(['instagram', '/admin/instagram', 'Instagram', 'instagram', null, 'instagram.voir']) %>
    <%~ item(['stats', '/admin/statistiques', 'Statistiques', 'stats', null, 'statistiques.voir']) %>
<% if (can('signalements.traiter')) { %>    <a href="/admin/signalements"<%~ it.section === 'reports' ? ' aria-current="page"' : '' %>><%~ ic('flag') %><%= t('Signalements') %><% if (it.reportsNew) { %><span class="nav-badge"><span aria-hidden="true"><%= it.reportsNew %></span><span class="sr-only"><%= it.reportsNew > 1 ? t('{n} nouveaux', { n: it.reportsNew }) : t('1 nouveau') %></span></span><% } %></a>
<% } %>  </nav>
<% if (can('terrain.app')) { %>  <p class="grp" id="nav-field"><%= t('Sur le terrain') %></p>
  <nav class="nav" aria-labelledby="nav-field">
    <a href="/admin/terrain"<%~ it.section === 'terrain' || it.section === 'cards' ? ' aria-current="page"' : '' %>><%~ ic('pin') %><%= t('App, cartes, QR') %></a>
  </nav>
<% } %>
  <p class="grp" id="nav-settings"><%= t('Réglages') %></p>
  <nav class="nav" aria-labelledby="nav-settings">
    <%~ item(['authors', '/admin/auteurs', 'Photographes', 'authors', null, 'photographes.gerer']) %>
    <%~ item(['accounts', '/admin/comptes', 'Comptes et rôles', 'key', null, 'comptes.gerer']) %>
    <%~ item(['circuit', '/admin/circuit', 'Circuit de publication', 'journal', null, 'circuit.regler']) %>
    <%~ item(['journal', '/admin/journal', 'Journal', 'journal', null, 'journal.voir']) %>
    <%~ item(['appearance', '/admin/apparence', 'Apparence', 'appearance', null, 'site.apparence']) %>
    <%~ item(['images', '/admin/images', 'Filigrane & EXIF', 'images', null, 'site.filigrane']) %>
    <%~ item(['droits', '/admin/droits', 'Droits & confidentialité', 'shield', null, 'reglages.droits']) %>
    <%~ item(['help', '/admin/aide', 'Aide', 'help']) %>
    <a href="/admin/nouveautes"<%~ it.section === 'releases' ? ' aria-current="page"' : '' %>><%~ ic('star') %><%= t('Nouveautés') %><span class="nav-ver mono"><%= it.releaseCurrent %></span></a>
    <a href="/" target="_blank" rel="noopener"><%~ ic('site') %><%= t('Voir le site') %></a>
  </nav>
  <details class="lang-pick admin-lang">
    <summary aria-label="<%= t('Langue de l’administration') %> : <%= it.langNames[it.lang] %>"><img class="flag" src="<%= it.asset(`flags/${it.lang}.svg`) %>" alt="" width="20" height="14"><span><%= it.lang.toUpperCase() %></span></summary>
    <ul role="list" aria-label="<%= t('Langue de l’administration') %>">
<% it.adminLangs.forEach(l => { %>      <li><form method="post" action="/admin/langue"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="<%= it.currentPath %>"><button type="submit" name="lang" value="<%= l %>" lang="<%= l %>"<%~ l === it.lang ? ' aria-current="true"' : '' %>><img class="flag" src="<%= it.asset(`flags/${l}.svg`) %>" alt="" width="20" height="14"><%= it.langNames[l] %></button></form></li>
<% }) %>    </ul>
  </details>
  <div class="foot">
    <a class="job" href="/admin/photos?statut=draft" data-activity<%~ it.activity ? '' : ' hidden' %>><span class="spin" aria-hidden="true"></span><span data-activity-text><%= it.activity > 1 ? t('Traitement : {n} photos', { n: it.activity }) : t('Traitement : {n} photo', { n: it.activity }) %></span></a>
    <div class="me">
      <span class="av" aria-hidden="true"><%= (it.session.name || '?').trim().charAt(0).toUpperCase() %></span>
      <span class="who" title="<%= it.session.name || t('Administrateur') %>"><%= it.session.name || t('Administrateur') %><small><%= t('Administration') %></small></span>
      <form method="post" action="/admin/theme" data-theme-form>
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <input type="hidden" name="back" value="<%= it.currentPath %>">
        <button class="iconbtn" type="submit" name="theme" value="<%= nextTheme %>" data-theme-toggle aria-label="<%= nextTheme === 'light' ? t('Passer en mode clair') : t('Passer en mode sombre') %>" title="<%= t('Mode clair / sombre') %>"><span class="when-dark"><%~ ic('sun') %></span><span class="when-light"><%~ ic('moon') %></span></button>
      </form>
      <form method="post" action="/auth/logout">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <button class="iconbtn" type="submit" aria-label="<%= t('Se déconnecter') %>" title="<%= t('Se déconnecter') %>"><%~ ic('logout') %></button>
      </form>
    </div>
  </div>
</aside>

<main class="main<%= it.wide ? ' wide' : '' %>" id="contenu" tabindex="-1">
<% const HELP = { review: 'photos-le-circuit-de-publication', circuit: 'photos-le-circuit-de-publication', accounts: 'reglages-comptes-et-rôles', journal: 'reglages-journal', people: 'rencontres-les-personnes', person: 'rencontres-les-personnes', outings: 'rencontres-les-sorties', outing: 'rencontres-les-sorties', trips: 'rencontres-les-voyages', trip: 'rencontres-les-voyages', releases: 'tableau-de-bord', reports: 'site-public-visionneuse-page-dune-photo', site: 'reglages-site-public', droits: 'reglages-droits-et-confidentialité', terrain: 'rencontres-sur-le-terrain', instagram: 'instagram', stats: 'statistiques', home: 'tableau-de-bord', photos: 'photos', photo: 'photos-la-fiche-dune-photo', encounters: 'rencontres', encounter: 'rencontres', cards: 'rencontres-les-cartes', batch: 'photos-3-compléter-et-publier', series: 'series', authors: 'auteurs', images: 'filigrane-exif', appearance: 'apparence', settings: 'reglages' }; %>
<% if (HELP[it.section]) { %>
  <p class="help-link"><a href="/admin/aide#<%= HELP[it.section] %>"><%= t('Aide sur cette page') %></a></p>
<% } %>
<% if (it.variants.running || it.variants.errors.length) { %>
  <div class="flash<%= it.variants.errors.length ? ' error' : '' %>" data-variants>
<% if (it.variants.running) { %>
    <p data-running><%= t('Mise à jour des images en cours :') %> <span data-done><%= it.variants.done %></span> / <span data-total><%= it.variants.total %></span>.</p>
<% } %>
    <p role="status" data-final><% if (!it.variants.running && it.variants.errors.length) { %><%= t('{n} image(s) n’ont pas pu être recalculées : {titles}.', { n: it.variants.errors.length, titles: it.variants.errors.map(e => e.title).join(', ') }) %><% } %></p>
  </div>
<% } %>
<% if (it.flash) { %>
  <div class="flash <%= it.flash.type %>" role="<%= it.flash.type === 'error' ? 'alert' : 'status' %>">
    <p><%= it.flash.text %></p>
<% if (it.flash.details && it.flash.details.length) { %>
    <ul><% it.flash.details.forEach(d => { %><li><%= d %></li><% }) %></ul>
<% } %>
  </div>
<% } %>
<%~ it.body %>
</main>
</div>

<nav class="tabbar" aria-label="<%= t('Navigation rapide') %>">
  <a href="/admin"<%~ cur('home') ? ' aria-current="page"' : '' %>><%~ ic('home', 22) %><%= t('Aujourd’hui') %></a>
<% if (can('photos.voir')) { %>  <a href="/admin/photos"<%~ cur('photos') ? ' aria-current="page"' : '' %>><%~ ic('photos', 22) %><%= t('Photos') %></a>
<% } %><% if (can('photos.importer')) { %>  <a class="imp" href="/admin/photos?importer#import" data-import-open aria-label="<%= t('Importer des photos') %>"><%~ ic('upload', 22) %></a>
<% } %><% if (can('terrain.app')) { %>  <a href="/admin/rencontre/accueil"<%~ it.section === 'terrain' ? ' aria-current="page"' : '' %>><%~ ic('pin', 22) %><%= t('Terrain') %></a>
<% } %>
  <button type="button" data-menu aria-expanded="false" aria-controls="admin-nav"><%~ ic('menu', 22) %><%= t('Menu') %></button>
</nav>

<% if (it.releasePopup) { const rp = it.releasePopup; %>
<dialog class="release-pop" open data-release-pop aria-labelledby="rel-pop-t">
  <form method="dialog" class="rel-pop-in">
    <p class="eyebrow"><%= t('Version {v}', { v: it.releaseCurrent }) %></p>
    <h2 id="rel-pop-t"><%= rp.length > 1 ? t('Nouveau depuis votre dernière visite : {n} versions', { n: rp.length }) : t('Nouveau depuis votre dernière visite') %></h2>
    <div class="rel-pop-list">
<% rp.forEach(r => { %>      <section><h3><span class="rel-v mono"><%= r.version %></span> <%= r.title %></h3><ul><% r.items.forEach(i => { %><li><%= i %></li><% }) %></ul></section>
<% }) %>    </div>
    <p class="actions"><button class="btn" type="submit" autofocus><%= t('C’est noté') %></button> <a class="more" href="/admin/nouveautes"><%= t('Toutes les nouveautés') %></a></p>
  </form>
</dialog>
<% } %>
<div class="toast" role="status" aria-live="polite" data-toast></div>
<dialog class="palette" data-cmdk aria-label="<%= t('Rechercher et agir') %>">
  <div class="pal-in"><%~ ic('search', 20) %><input type="text" data-cmdk-input placeholder="<%= t('Rechercher une photo, une série, une action…') %>" aria-label="<%= t('Rechercher') %>" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="cmdk-list"><kbd><%= t('Échap') %></kbd></div>
  <ul class="pal-list" id="cmdk-list" role="listbox" data-cmdk-list></ul>
  <p class="pal-ft"><span><kbd>↑</kbd> <kbd>↓</kbd> <%= t('choisir') %></span><span><kbd>↵</kbd> <%= t('exécuter') %></span><span><kbd><%= t('Échap') %></kbd> <%= t('fermer') %></span></p>
</dialog>
</body>
</html>
