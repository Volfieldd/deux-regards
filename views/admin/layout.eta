<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.pageTitle %></title>
  <link rel="stylesheet" href="<%= it.asset('css/site.css') %>">
  <link rel="stylesheet" href="<%= it.asset('admin/admin.css') %>">
<% const masks = it.brand ? [it.brand.emblem, it.brand.icon, it.brand.logotype].filter(Boolean).join('.') : ''; %>
<% if (masks) { %>
  <link rel="stylesheet" href="/brand.css?v=<%= masks %>">
<% } %>
  <script src="<%= it.asset('admin/admin.js') %>" defer></script>
</head>
<body class="admin" data-csrf="<%= it.csrf %>">
<% if (it.local) { %>
  <p class="testbar mono" role="note">Connexion locale de test — <%= it.session.name %></p>
<% } %>
<header class="top wrap">
  <%~ include('../brand', it) %>
  <nav class="eyebrow" aria-label="Administration">
<% [['home', '/admin', 'Tableau de bord'], ['photos', '/admin/photos', 'Photos'], ['series', '/admin/series', 'Séries'], ['authors', '/admin/auteurs', 'Auteurs'], ['images', '/admin/images', 'Filigrane & EXIF'], ['appearance', '/admin/apparence', 'Apparence'], ['settings', '/admin/reglages', 'Réglages']].forEach(([key, href, label]) => { %>
    <a href="<%= href %>"<%~ (it.section === key || (key === 'photos' && it.section === 'photo')) ? ' aria-current="page"' : '' %>><%= label %></a>
<% }) %>
    <a href="/" target="_blank" rel="noopener">Voir le site</a>
  </nav>
  <form method="post" action="/auth/logout">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <button class="eyebrow" type="submit">Se déconnecter</button>
  </form>
</header>
<main class="adm wrap" id="contenu">
<% if (it.variants.running || it.variants.errors.length) { %>
  <div class="flash<%= it.variants.errors.length ? ' error' : '' %>" data-variants>
<% if (it.variants.running) { %>
    <p data-running>Mise à jour des images en cours : <span data-done><%= it.variants.done %></span> / <span data-total><%= it.variants.total %></span>.</p>
<% } %>
    <p role="status" data-final><% if (!it.variants.running && it.variants.errors.length) { %><%= it.variants.errors.length %> image(s) n’ont pas pu être recalculées : <%= it.variants.errors.map(e => e.title).join(', ') %>.<% } %></p>
  </div>
<% } %>
<% if (it.flash) { %>
  <div class="flash <%= it.flash.type %>" role="<%= it.flash.type === 'error' ? 'alert' : 'status' %>">
    <p><%= it.flash.text %></p>
<% if (it.flash.details && it.flash.details.length) { %>
    <ul><% it.flash.details.forEach(d => { %><li><%= d %></li><% }) %></ul>
<% } %>
  </div>
<% } %>
<%~ it.body %>
</main>
</body>
</html>
