<% layout('./layout') %>
<% const s = it.settings; const hero = Array.isArray(s.hero) ? s.hero : []; const chosen = hero.map(slug => it.published.find(p => p.slug === slug)).filter(Boolean); %>
<h1>Réglages</h1>
<form class="form" method="post" action="/admin/reglages">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
  <button class="sr-only" type="submit" tabindex="-1" aria-hidden="true">Enregistrer les réglages</button>
  <section class="panel">
    <h2>Textes</h2>
    <label>Nom du site <input name="site_name" value="<%= s.site_name || '' %>" maxlength="60" placeholder="<%= it.defaultName %>"></label>
    <p class="hint">Le site est en français, anglais et allemand : chaque texte a sa version anglaise et allemande, facultative (vide : la version française s’affiche).</p>
    <label>Accroche <input name="tagline" value="<%= s.tagline || '' %>" maxlength="200"></label>
    <%~ include('./_tr', { asset: it.asset, translate: it.translate, v: s, name: 'tagline', label: 'Accroche', max: 200 }) %>
    <label>Introduction (accueil) <textarea name="intro" rows="3" maxlength="1000"><%= s.intro || '' %></textarea></label>
    <%~ include('./_tr', { asset: it.asset, translate: it.translate, v: s, name: 'intro', label: 'Introduction', max: 1000, rows: 3 }) %>
    <label>À propos <span class="mono">paragraphes séparés par une ligne vide</span><textarea name="about" rows="8" maxlength="10000"><%= s.about || '' %></textarea></label>
    <%~ include('./_tr', { asset: it.asset, translate: it.translate, v: s, name: 'about', label: 'À propos', max: 10000, rows: 8 }) %>
  </section>
  <section class="panel">
    <h2>Droits d’utilisation <span class="mono">page <a href="/droits" target="_blank" rel="noopener">/droits</a>, liée aux mentions IPTC des images</span></h2>
    <p class="hint">Le texte affiché ci-dessous est celui que lisent les visiteurs. Tant que vous gardez le texte par défaut, il suit les noms des auteurs ; modifié, il est enregistré tel quel.</p>
<% const frOwn = Boolean(String(s.rights_text || '').trim()); %>
<% it.rights.forEach(r => { const own = Boolean(String(s[r.setting] || '').trim()); %>
    <div class="rights-field">
      <label for="<%= r.setting %>"><%= r.name %> <a class="mono" href="<%= r.path %>" target="_blank" rel="noopener"><%= r.path %></a>
        <span class="badge-text<%= own ? ' own' : '' %>"><%= own ? 'Texte personnalisé' : 'Texte par défaut' %></span></label>
<% if (r.lang !== 'fr' && frOwn && !own) { %>      <p class="cellnote warn">Le texte français a été modifié : adaptez aussi cette traduction, sinon les visiteurs lisent la traduction du texte par défaut.</p>
<% } %>      <textarea id="<%= r.setting %>" name="<%= r.setting %>" rows="<%= r.lang === 'fr' ? 7 : 6 %>" maxlength="10000" lang="<%= r.lang %>" data-default="<%= it.rightsDefaults[r.lang] %>"><%= own ? s[r.setting] : it.rightsDefaults[r.lang] %></textarea>
      <p class="actions" data-js-only hidden><button class="btn ghost" type="button" data-reset-default="<%= r.setting %>">Rétablir le texte par défaut</button></p>
    </div>
<% }) %>
    <label>Contact pour les demandes d’utilisation <span class="mono">adresse e-mail ou lien https://</span><input name="rights_contact" value="<%= s.rights_contact || '' %>" maxlength="200"></label>
  </section>
  <section class="panel" id="carte">
    <h2>Page Carte <span class="mono"><a href="/carte" target="_blank" rel="noopener">/carte</a><%= s.map_page ? '' : ' · aperçu réservé aux auteurs' %></span></h2>
    <p class="hint">Une carte du monde avec la vignette des photos à l’emplacement de leur ville, et la liste des lieux. Seules les photos publiées dont la fiche coche « Afficher sur la carte » y figurent (<%= it.mapCount %> aujourd’hui<%= it.mapCount ? `, ${it.mapCities} ville${it.mapCities > 1 ? 's' : ''}` : '' %>).</p>
    <label class="inline"><input type="checkbox" name="map_page"<%~ s.map_page ? ' checked' : '' %>> Publier la page Carte <span class="mono">lien « Carte » dans le menu du site</span></label>
  </section>
  <fieldset class="panel hero-panel" id="ouverture" data-hero data-max="<%= it.heroMax %>">
    <legend>Photos de l’ouverture</legend>
    <p class="hint">Le diaporama plein écran de l’accueil, dans cet ordre. <%= it.heroMax %> photos au plus ; sans choix, les 5 premières de la galerie.</p>
    <p class="actions"><span class="counter" role="status" data-hero-count><%= chosen.length %> / <%= it.heroMax %> choisie<%= chosen.length > 1 ? 's' : '' %></span>
      <button class="btn" type="submit" name="hero_save" value="1">Enregistrer l’ouverture</button></p>
    <h3>Ordre du diaporama</h3>
    <p class="hint"><span data-js-only hidden>Glissez une vignette, ou utilisez ← → ; ✕ la retire.</span><span data-nojs>← → changent l’ordre, ✕ retire la photo (les réglages sont enregistrés en même temps).</span></p>
    <ol class="chosen" data-hero-chosen>
<% chosen.forEach((p, i) => { %>
      <li class="it" data-slug="<%= p.slug %>">
        <input type="hidden" name="hero" value="<%= p.slug %>">
        <span class="n mono" aria-hidden="true"><%= i + 1 %></span>
        <%~ it.picture(p, { sizes: '120px', alt: '' }) %>
        <span class="t"><%= p.title %></span>
        <span class="mv">
          <button type="submit" name="hero_op" value="left:<%= p.slug %>" aria-label="Avancer « <%= p.title %> »" data-hero-left>←</button>
          <button type="submit" name="hero_op" value="right:<%= p.slug %>" aria-label="Reculer « <%= p.title %> »" data-hero-right>→</button>
          <button type="submit" name="hero_op" value="remove:<%= p.slug %>" aria-label="Retirer « <%= p.title %> » de l’ouverture" data-hero-remove>✕</button>
        </span>
      </li>
<% }) %>
    </ol>
<% if (!chosen.length) { %>    <p class="hint" data-hero-empty>Aucune photo choisie : l’ouverture montre les 5 premières photos de la galerie.</p>
<% } %>
    <h3>Ajouter des photos publiées</h3>
    <p class="hint">Une case cochée ajoute la photo en fin de diaporama. <span data-hero-full<%~ chosen.length >= it.heroMax ? '' : ' hidden' %>><strong>Le diaporama est complet (<%= it.heroMax %> photos) : retirez-en une pour en ajouter une autre.</strong></span></p>
    <div class="herogrid" data-hero-pool>
<% it.published.forEach(p => { const on = hero.includes(p.slug); %>
      <label class="pick" data-slug="<%= p.slug %>" data-title="<%= p.title %>"<%~ on ? ' hidden' : '' %>><input type="checkbox" name="hero" value="<%= p.slug %>"<%~ on ? ' disabled' : '' %><%~ !on && chosen.length >= it.heroMax ? ' disabled' : '' %>>
        <%~ it.picture(p, { sizes: '160px', alt: '' }) %><span><%= p.title %></span></label>
<% }) %>
    </div>
<% if (!it.published.length) { %><p>Aucune photo publiée pour l’instant.</p><% } %>
  </fieldset>
  <p class="actions"><button class="btn" type="submit">Enregistrer les réglages</button></p>
</form>
