<% layout('./layout') %>
<% const s = it.s, a = it.account, t = it.t;
   const hm = x => (it.lang === 'fr' ? x.replace(/:/g, ' h ') : x);
   const fmtDate = ms => new Intl.DateTimeFormat(it.locale, { timeZone: 'Europe/Paris', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(ms));
   // Jour d'un créneau (« 2026-10-16 », heure de Paris) : écrit dans la langue de l'admin (« 16 octobre »).
   const slotDay = d => (/^\d{4}-\d{2}-\d{2}$/.test(d || '') ? new Intl.DateTimeFormat(it.locale, { timeZone: 'UTC', day: 'numeric', month: 'long' }).format(new Date(`${d}T12:00:00Z`)) : d);
   const days = a ? Math.round((a.expires_at - Date.now()) / 86400000) : 0;
   // Erreurs et journal : les raisons des accords (« bloquée : J-0042 refuse la publication ») ne sont lues que par qui
   // voit toutes les personnes ; les autres n'en lisent que la nature (le détail est sur la fiche, pour qui y a droit).
   const IG_HIDE = { 'bloquée': 'bloquée par un accord (détail réservé au photographe et aux administrateurs)', 'à vérifier': 'à vérifier : un accord manque (détail réservé au photographe et aux administrateurs)' };
   const igErr = m => t.msg(it.canAll('personnes.voir') ? m : String(m || '').replace(/(^|: )(bloquée|à vérifier) : [\s\S]*$/, (x, pre, k) => pre + IG_HIDE[k])); %>
<div class="toolbar">
  <div>
    <h1>Instagram</h1>
    <p class="sub"><%= t('Les photos publiées sur le site partent sur Instagram une par une, aux heures choisies, avec une légende tirée du modèle.') %></p>
  </div>
</div>

<% const u = it.usage; %>
<% if (u.paused) { %><p class="flash error" role="status">⏸ <%= t('File en pause jusqu’{when} : {reason}.', { when: t.lang === 'fr' ? u.paused.when.replace(/^le /, 'au ') : u.whenText(u.paused.until, it.locale), reason: t.msg(u.paused.reason) }) %></p>
<% if (it.can('instagram.compte')) { %><form method="post" action="/admin/instagram/reprendre" class="actions"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit"><%= t('Reprendre maintenant') %></button></form><% } %>
<% } %>
<div class="ig-status">
  <section class="panel" aria-labelledby="ig-account">
    <h2 id="ig-account"><%= t('Compte') %></h2>
<% if (!it.conf.configured) { %>
    <p class="err"><%~ t('Le serveur n’a pas encore d’application Instagram : renseignez <code>INSTAGRAM_APP_ID</code> et <code>INSTAGRAM_APP_SECRET</code> dans sa configuration.') %></p>
    <p class="hint"><%= t('Création du compte professionnel et de l’application Meta, pas à pas :') %> <a class="more" href="/admin/aide#instagram"><%= t('aide « Instagram »') %></a>.</p>
<% } else if (!it.conf.https) { %>
    <p class="err"><%~ t('Le site doit être en HTTPS (<code>PUBLIC_URL</code>) pour se connecter à Instagram : Meta refuse les adresses en http, et doit pouvoir télécharger les images.') %></p>
<% } else if (a && !it.connected) { %>
    <p class="err"><%= t('Le compte @{name} est enregistré, mais son jeton d’accès ne peut plus être lu : la clé de chiffrement a changé', { name: a.username }) %> (<code>INSTAGRAM_TOKEN_KEY</code> <%= t('ou') %> <code>COOKIE_SECRET</code>), <%= t('par exemple après une restauration sur un autre serveur.') %></p>
<% if (it.can('instagram.compte')) { %>    <p class="actions"><a class="btn" href="/admin/instagram/connexion"><%= t('Reconnecter le compte') %></a></p>
<% } %>
<% } else if (a && it.connected) { %>
    <p class="ig-big"><span class="enc-tag ok"><%= t('Connecté') %></span> <strong>@<%= a.username %></strong></p>
    <p class="hint"><%= t('Accès valable jusqu’au {date} ({n} jours) ; renouvelé automatiquement avant expiration.', { date: fmtDate(a.expires_at), n: days }) %><%= days < 7 ? ` ${t('Il expire bientôt : reconnectez le compte si le renouvellement échoue.')}` : '' %></p>
<% if (it.can('instagram.compte')) { %>    <form method="post" action="/admin/instagram/deconnexion"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit"><%= t('Déconnecter') %></button></form>
<% } %>
<% } else { %>
    <p><%= t('Aucun compte connecté. Les photos s’accumulent dans la file et partiront dès la connexion.') %></p>
<% if (it.can('instagram.compte')) { %>    <p class="actions"><a class="btn" href="/admin/instagram/connexion"><%= t('Connecter le compte Instagram') %></a></p>
    <p class="hint"><%= t('Adresse de retour à déclarer dans l’application Meta :') %> <code><%= it.conf.redirectUri %></code></p>
<% } %>
<% } %>
<% if (!it.can('instagram.compte')) { %>    <p class="hint"><%= t('Le compte et les réglages Instagram sont gérés par un administrateur.') %></p>
<% } %>
  </section>

  <section class="panel" aria-labelledby="ig-rhythm">
    <h2 id="ig-rhythm"><%= t('Rythme de publication') %></h2>
    <p class="ig-big"><%= s.times.length > 1 ? t('{n} publications par jour, à {times} (heure de Paris).', { n: s.times.length, times: hm(s.times.join(', ')) }) : t('Une publication par jour, à {times} (heure de Paris).', { times: hm(s.times.join(', ')) }) %></p>
<% const autoNames = it.categories.filter(c => s.autoSeries.includes(c.id)).map(c => c.name); %>
    <p class="hint"><%= autoNames.length ? t('Mise en file automatique à la publication : {names}. Les autres séries seulement depuis la fiche de la photo.', { names: autoNames.join(', ') }) : t('Aucune mise en file automatique : une photo n’entre dans la file que si vous l’y ajoutez depuis sa fiche.') %> <% if (it.can('instagram.compte')) { %><a class="more" href="#reglages"><%= t('Modifier') %></a><% } %></p>
  </section>

  <section class="panel" aria-labelledby="ig-usage">
    <h2 id="ig-usage"><%= t('Consommation') %> <span class="mono"><%= t('limites « {name} »', { name: t(it.IG_PRESETS[u.preset].label) }) %></span></h2>
    <ul class="ig-meters">
      <li><span id="ig-m-posts"><%= t('Publications sur 24 h glissantes :') %></span> <strong><%= u.posts24h %> / <%= u.limits.postsPerDay %></strong><meter aria-labelledby="ig-m-posts" min="0" max="<%= u.limits.postsPerDay %>" value="<%= u.posts24h %>" high="<%= Math.max(1, u.limits.postsPerDay - 1) %>"></meter></li>
      <li><span id="ig-m-calls"><%= t('Appels à l’API sur la dernière heure :') %></span> <strong><%= u.callsHour %> / <%= u.limits.callsPerHour %></strong><meter aria-labelledby="ig-m-calls" min="0" max="<%= u.limits.callsPerHour %>" value="<%= u.callsHour %>" high="<%= Math.round(u.limits.callsPerHour * 0.8) %>"></meter></li>
<% if (u.liveQuota) { %>      <li><span><%= t('Quota lu chez Instagram :') %></span> <strong><%= u.liveQuota.usage %> / <%= u.liveQuota.total || '?' %></strong> <span class="mono"><%= t('sur 24 h') %></span></li>
<% } %><% if (u.limits.minGapMinutes) { %>      <li><span><%= t('Au moins') %> <strong><%= t('{n} min', { n: u.limits.minGapMinutes }) %></strong> <%= t('entre deux publications') %></span></li>
<% } %>    </ul>
    <p class="mono"><%= t('{n} appels à l’API sur 24 h', { n: u.calls24h }) %></p>
<% if (!u.budget.ok && !u.paused) { %>    <p class="cellnote warn">⚠ <%= u.budget.key ? t(u.budget.key, { ...u.budget.params, when: u.whenText(u.budget.until, it.locale) }) : t.msg(u.budget.reason) %></p>
<% } %>  </section>
</div>

<div class="ig-main">
  <section class="panel" aria-labelledby="ig-queue">
    <h2 id="ig-queue"><%= t('File d’attente') %> <span class="mono"><%= it.queue.length > 1 ? t('{n} photos', { n: it.queue.length }) : t('{n} photo', { n: it.queue.length }) %></span></h2>
<% if (!it.queue.length) { %>
    <p class="hint"><%= s.autoSeries.length ? t('La file est vide. Ajoutez une photo depuis sa fiche (section « Instagram »), ou publiez-en une dans une série en mise en file automatique.') : t('La file est vide. Ajoutez une photo depuis sa fiche (section « Instagram »).') %></p>
<% } else { %>
    <ol class="igq">
<% it.queue.forEach((p, i) => { %>
      <li data-ig-item="<%= p.id %>">
        <a class="igthumb" href="/admin/instagram/apercu.jpg?photo=<%= p.photo_id %>&cadre=<%= p.frame %>&filigrane=<%= p.watermark ? 1 : 0 %>" target="_blank" rel="noopener" aria-label="<%= t('Aperçu exact de l’image envoyée (nouvel onglet)') %>"><% if (p.photo.ready) { %><%~ it.picture(p.photo, { sizes: '72px', alt: '' }) %><% } %></a>
        <div class="t">
          <a href="/admin/photos/<%= p.photo_id %>#instagram"><span class="igq-n mono"><%= i + 1 %>.</span> <strong><%= p.photo.title %></strong></a>
          <span class="mono"><%= p.status === 'publishing' ? t('Envoi en cours') : t('Prévue le {date} à {time}', { date: slotDay(p.slot.split(' ')[0]), time: hm(p.slot.split(' ')[1] || '') }) %> · <%= it.lang === 'de' ? t(it.FRAMES[p.frame]) : t(it.FRAMES[p.frame]).toLowerCase() %><%= p.watermark ? ` · ${t('filigrane')}` : '' %></span>
          <span class="cap-excerpt"><%= p.caption.split('\n')[0] %>…</span>
<% if (p.error) { %>          <span class="err"><%= t('Dernier essai : {error} (essai {n} sur 3)', { error: igErr(p.error), n: p.attempts }) %></span>
<% } %>
          <div class="ig-progress" data-ig-progress<%~ p.status === 'publishing' ? ` data-ig-watch="${p.id}"` : ' hidden' %> role="status" aria-live="polite"><progress max="100" value="<%= p.status === 'publishing' ? 10 : 0 %>"></progress> <span class="mono" data-ig-progress-label><%= p.status === 'publishing' ? t('Envoi en cours…') : '' %></span></div>
        </div>
<% if (p.status === 'queued' && it.can('instagram.file')) { %>
        <div class="acts">
<% [['monter', '↑', t('Avancer « {title} »', { title: p.photo.title }), i === 0], ['descendre', '↓', t('Reculer « {title} »', { title: p.photo.title }), i === it.queue.length - 1]].forEach(([act, sign, label, off]) => { %>
          <form method="post" action="/admin/instagram/<%= p.id %>/<%= act %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="iconbtn" type="submit" aria-label="<%= label %>"<%~ off ? ' disabled' : '' %>><%= sign %></button></form>
<% }) %>
<% if (it.can('instagram.publier')) { %>          <form method="post" action="/admin/instagram/<%= p.id %>/publier" data-ig-publish="<%= p.id %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn" type="submit" aria-label="<%= t('Publier maintenant « {title} »', { title: p.photo.title }) %>"<%~ it.connected ? '' : ' disabled' %>><%= t('Publier maintenant') %></button></form>
<% } %>          <form method="post" action="/admin/instagram/<%= p.id %>/annuler"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit" aria-label="<%= t('Retirer « {title} » de la file', { title: p.photo.title }) %>"><%= t('Retirer') %></button></form>
        </div>
<% } %>
      </li>
<% }) %>
    </ol>
<% } %>
  </section>

  <div class="ig-side">
<% if (it.failed.length) { %>
  <section class="panel" id="ig-echecs" aria-labelledby="ig-failed">
    <h2 id="ig-failed">✕ <%= t('En échec') %> <span class="mono"><%= it.failed.length > 1 ? t('{n} photos', { n: it.failed.length }) : t('{n} photo', { n: it.failed.length }) %></span></h2>
    <ul class="igpub">
<% it.failed.forEach(p => { %>
      <li>
        <a class="igthumb sm" href="/admin/photos/<%= p.photo_id %>#instagram" tabindex="-1" aria-hidden="true"><% if (p.photo.ready) { %><%~ it.picture(p.photo, { sizes: '48px', alt: '' }) %><% } %></a>
        <span class="t"><a href="/admin/photos/<%= p.photo_id %>#instagram"><%= p.photo.title %></a>
          <span class="err"><%= igErr(p.error) %></span>
<% if (p.retry_requested_at) { %>          <span class="enc-tag warn"><%= t('Republication demandée') %><%= p.retry_requested_by ? ` · ${p.retry_requested_by}` : '' %></span>
<% } %>        </span>
<% if (it.can('instagram.file')) { %>        <form method="post" action="/admin/instagram/<%= p.id %>/reessayer"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit" aria-label="<%= t('Réessayer « {title} »', { title: p.photo.title }) %>"><%= t('Réessayer') %></button></form>
<% } %>      </li>
<% }) %>
    </ul>
  </section>
<% } %>
  <section class="panel" aria-labelledby="ig-history">
    <h2 id="ig-history">✓ <%= t('Dernières publications') %> <span class="mono"><%= t('les {n} plus récentes', { n: 10 }) %></span></h2>
<% if (!it.published.length) { %>    <p class="hint"><%= t('Rien de publié sur Instagram pour l’instant.') %></p>
<% } else { %>    <ul class="igpub">
<% it.published.forEach(p => { %>
      <li>
        <a class="igthumb sm" href="/admin/photos/<%= p.photo_id %>#instagram" tabindex="-1" aria-hidden="true"><% if (p.photo.ready) { %><%~ it.picture(p.photo, { sizes: '48px', alt: '' }) %><% } %></a>
        <span class="t"><a href="/admin/photos/<%= p.photo_id %>#instagram"><%= p.photo.title %></a>
          <span class="mono"><%= t('publiée le {date}', { date: fmtDate(p.published_at) }) %><%= p.engagement ? ` · ${p.engagement.likes > 1 ? t('{n} likes', { n: p.engagement.likes }) : t('{n} like', { n: p.engagement.likes })}, ${t('{n} comm.', { n: p.engagement.comments })}` : '' %></span></span>
<% if (p.permalink) { %>        <a class="more" href="<%= p.permalink %>" target="_blank" rel="noopener" aria-label="<%= t('Voir « {title} » sur Instagram (nouvel onglet)', { title: p.photo.title }) %>"><%= t('Voir') %> ↗</a>
<% } %>      </li>
<% }) %>
    </ul>
<% } %>
  </section>
  </div>
</div>

<section class="panel" id="journal" aria-labelledby="ig-log">
  <h2 id="ig-log"><%= t('Journal') %> <span class="mono"><%= t('les {n} derniers événements · gardés 90 jours', { n: 50 }) %></span></h2>
<% if (!it.events.length) { %>  <p class="hint"><%= t('Rien pour l’instant : chaque mise en file, envoi, publication ou échec s’inscrit ici.') %></p>
<% } else { const LV = { ok: ['ok', t('réussi')], error: ['no', t('échec')], warn: ['warn', t('attention')], info: ['', t('info')] };      // le symbole vient de la classe (✓ ✕ ▲)
   const tf = new Intl.DateTimeFormat(it.locale, { timeZone: 'Europe/Paris', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); %>
  <div class="table-wrap"><table class="ig-log">
    <thead><tr><th scope="col"><%= t('Quand') %></th><th scope="col"><%= t('État') %></th><th scope="col"><%= t('Photo') %></th><th scope="col"><%= t('Événement') %></th><th scope="col"><%= t('Par') %></th></tr></thead>
    <tbody>
<% it.events.forEach(e => { const [cls, word] = LV[e.level] || LV.info; %>      <tr><td class="mono"><%= tf.format(new Date(e.at)) %></td><td><span class="enc-tag <%= cls %>"><%= word %></span></td><td><% if (e.photo_id && e.title) { %><a href="/admin/photos/<%= e.photo_id %>#instagram"><%= e.title %></a><% } else { %>—<% } %></td><td><%= igErr(e.message) %></td><td class="mono"><%= e.by_name || t('automatique') %></td></tr>
<% }) %>    </tbody>
  </table></div>
<% } %>
</section>

<% if (it.connected || it.mostLiked.length) { const es = it.engagementState; %>
<section class="panel" id="likes" aria-labelledby="ig-likes">
  <h2 id="ig-likes"><%= t('Les plus aimées sur Instagram') %></h2>
  <p class="hint"><%= t('Likes et commentaires des photos publiées depuis le site, relevés chaque matin (seulement des nombres : Instagram ne dit pas qui a aimé).') %>
    <%= es.at ? t('Dernier relevé : {date} à {time}.', { date: fmtDate(es.at), time: new Intl.DateTimeFormat(it.locale, { timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit' }).format(new Date(es.at)) }) : t('Pas encore de relevé.') %></p>
<% if (es.error) { %>  <p class="cellnote warn"><%= t('Dernier essai sans succès : {error}', { error: t.msg(es.error) }) %></p>
<% } %>
<% if (it.mostLiked.length) { %>
  <ol class="rank plain ig-top">
<% it.mostLiked.forEach(m => { %>    <li><span class="t"><a href="/admin/photos/<%= m.photo_id %>#instagram"><%= m.photo.title %></a>
      <span class="mono"><%= t('publiée le {date}', { date: fmtDate(m.published_at) }) %></span></span>
      <span class="ig-n"><strong><%= m.likes %></strong> <%= m.likes > 1 ? t('likes') : t('like') %> · <%= t('{n} comm.', { n: m.comments }) %></span>
<% if (m.permalink) { %>      <a class="more" href="<%= m.permalink %>" target="_blank" rel="noopener" aria-label="<%= t('Voir « {title} » sur Instagram (nouvel onglet)', { title: m.photo.title }) %>"><%= t('Voir') %> ↗</a>
<% } %></li>
<% }) %>  </ol>
<% } %>
<% if (it.connected && it.can('instagram.compte')) { %>  <form method="post" action="/admin/instagram/likes"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><button class="btn ghost" type="submit"><%= t('Relever maintenant') %></button></form>
<% } %>
</section>
<% } %>

<% if (it.can('instagram.compte')) { /* réglages : même droit que leur enregistrement */ %>
<details class="panel rub-panel ig-settings" id="reglages"<%~ it.openSettings ? ' open' : '' %>>
  <summary><h2 id="ig-settings-sum"><%= t('Réglages') %> <span class="mono"><%= t('limites, mise en file automatique, heures, cadre, légende, hashtags') %></span></h2></summary>
  <form class="form" method="post" action="/admin/instagram/reglages" aria-labelledby="ig-settings-sum">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <fieldset id="limites">
      <legend><%= t('Limites de l’API') %> <span class="mono"><%= t('Meta ne vend pas de quota supplémentaire : on règle le rythme') %></span></legend>
<% const L = s.limits; %><% Object.entries(it.IG_PRESETS).forEach(([k, p]) => { %>      <label class="inline"><input type="radio" name="limits_preset" value="<%= k %>"<%~ L.preset === k ? ' checked' : '' %>> <strong><%= t(p.label) %></strong><% if (k !== 'custom') { %> <span class="mono"><%= k === 'meta' ? t('quota lu chez Instagram (100 / 24 h aujourd’hui)') : `${p.postsPerDay} / 24 h` %>, <%= p.minGapMinutes ? t('{n} min entre deux', { n: p.minGapMinutes }) : t('sans écart minimal') %>, <%= t('{n} appels / h', { n: p.callsPerHour }) %></span><% } %></label>
<% }) %>      <div class="row">
        <label><%= t('Publications sur 24 h') %> <span class="mono"><%= t('« {name} » · {range}', { name: t(it.IG_PRESETS.custom.label), range: it.IG_BOUNDS.postsPerDay.join('–') }) %></span><input type="number" name="limits_posts" value="<%= L.postsPerDay %>" min="<%= it.IG_BOUNDS.postsPerDay[0] %>" max="<%= it.IG_BOUNDS.postsPerDay[1] %>"></label>
        <label><%= t('Minutes entre deux') %> <span class="mono"><%= it.IG_BOUNDS.minGapMinutes.join('–') %></span><input type="number" name="limits_gap" value="<%= L.minGapMinutes %>" min="<%= it.IG_BOUNDS.minGapMinutes[0] %>" max="<%= it.IG_BOUNDS.minGapMinutes[1] %>"></label>
        <label><%= t('Appels par heure') %> <span class="mono"><%= it.IG_BOUNDS.callsPerHour.join('–') %></span><input type="number" name="limits_calls" value="<%= L.callsPerHour %>" min="<%= it.IG_BOUNDS.callsPerHour[0] %>" max="<%= it.IG_BOUNDS.callsPerHour[1] %>"></label>
      </div>
      <p class="hint"><%= t('Hors budget, la photo attend dans la file (« Publier maintenant » refuse en expliquant pourquoi). Si Instagram signale une limite, la file se met en pause le temps indiqué (sinon 1 h, 2 h, 4 h…) sans compter d’essai, puis reprend à raison d’une photo par créneau.') %></p>
    </fieldset>
    <fieldset class="row" id="auto">
      <legend><%= t('Mise en file automatique') %> <span class="mono"><%= t('à la publication sur le site · décochez tout pour ne choisir qu’à la main') %></span></legend>
<% it.categories.forEach(c => { %>      <label class="inline"><input type="checkbox" name="auto_<%= c.id %>"<%~ s.autoSeries.includes(c.id) ? ' checked' : '' %>> <%= c.name %></label>
<% }) %>
      <p class="hint"><%= t('Une photo publiée dans une série cochée entre seule dans la file. Pour les autres, utilisez « Ajouter à la file Instagram » sur la fiche de la photo. Les photos déjà dans la file y restent : retirez-les une par une si besoin.') %></p>
    </fieldset>
    <div class="row">
      <label><%= t('Heures de publication') %> <span class="mono"><%= t('heure de Paris, séparées par des virgules · 4 au plus') %></span><input name="times" value="<%= s.times.join(', ') %>" maxlength="40" placeholder="18:30"></label>
      <label><%= t('Cadre par défaut') %> <select name="frame"><% Object.entries(it.FRAMES).forEach(([k, l]) => { %><option value="<%= k %>"<%~ s.frame === k ? ' selected' : '' %>><%= t(l) %></option><% }) %></select></label>
    </div>
    <label class="inline"><input type="checkbox" name="watermark"<%~ s.watermark ? ' checked' : '' %>> <%= t('Filigrane par défaut (celui des réglages') %> <a href="/admin/images"><%~ t('Filigrane & EXIF') %></a>)</label>
    <label><%= t('Modèle de légende') %>
      <span class="mono"><%= t('Variables :') %> {titre} {legende} {signature} {lieu} {date} {auteur} {serie} {site} {hashtags} · <%= t('une ligne dont les variables sont vides disparaît ; sans {signature}, la signature du photographe se place sous la légende') %></span>
      <textarea name="template" rows="9" maxlength="2200"><%= s.template %></textarea></label>
    <label><%= t('Hashtags pour toutes les photos') %> <input name="hashtags" value="<%= s.hashtags %>" maxlength="600" placeholder="#photographie #nicephos"></label>
    <fieldset class="row">
      <legend><%= t('Hashtags par série') %> <span class="mono"><%= t('ajoutés à ceux de toutes les photos · 30 au plus en tout') %></span></legend>
<% it.categories.forEach(c => { %>      <label><%= c.name %> <input name="hashtags_<%= c.id %>" value="<%= (s.seriesHashtags || {})[c.id] || '' %>" maxlength="300" placeholder="#<%= c.slug.replace(/-/g, '') %>"></label>
<% }) %>
    </fieldset>
    <p class="actions"><button class="btn" type="submit"><%= t('Enregistrer les réglages') %></button></p>
  </form>
</details>
<% } %>
