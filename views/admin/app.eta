<!doctype html>
<% const t = it.t; %>
<% const v = it.values || {}, e = it.errors || {}; const L = ['fr', 'en', 'de']; const FLAG = { fr: 'FR', en: 'EN', de: 'DE' };
   const author = it.authors.find(a => a.id === Number(v.author_id)) || it.authors[0] || { name: '', next: '' };
   const on = k => v[k] === 'on'; const b = it.brand || {};
   // Groupe de boutons radio refusé par le serveur : aria-invalid sur ses boutons, phrase d'erreur (dans la langue de la
   // personne) sous la légende, reliée au groupe par aria-describedby ; app.js fait de même avant l'envoi.
   const bad = k => (e[k] ? ' aria-invalid="true"' : '');
   const said = (k, id) => (e[k] ? ` aria-describedby="${id}"` : ''); %>
<html lang="<%= it.lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#1d1c1a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Rencontre">
  <link rel="manifest" href="/rencontre.webmanifest">
<% if (b.favicon180) { %>  <link rel="apple-touch-icon" href="/brand/<%= b.favicon180 %>">
<% } %>  <title><%= it.title %> · <%= it.siteName %></title>
  <link rel="stylesheet" href="<%= it.asset('admin/app.css') %>">
  <script src="<%= it.asset('admin/app.js') %>" defer></script>
</head>
<body>
<header class="app-bar">
  <a href="/admin/rencontre/accueil" aria-label="<%= t('Retour à l’accueil Terrain') %>">←</a>
  <strong><%= t('Nouvelle rencontre') %></strong>
  <span class="mono" data-next><%= author.next %></span>
</header>
<form class="app-form" method="post" action="/admin/rencontre" enctype="multipart/form-data" data-app data-lang="<%= L.includes(v.lang) ? v.lang : 'fr' %>">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">
<% const redo = it.redo || {}; %>
<% if (Object.keys(e).length) { %>  <div class="app-errors" role="alert"><ul><% Object.values(e).forEach(m => { %><li><%= t.msg(m) %></li><% }) %></ul>
<% if (redo.signature || redo.portrait) { %>    <p class="app-redo"><%= redo.signature && redo.portrait ? t('Faites signer de nouveau la personne et reprenez sa photo : elles ne sont pas gardées après une erreur.') : redo.signature ? t('Faites signer de nouveau la personne : la signature n’est pas gardée après une erreur.') : t('Reprenez la photo de la personne : elle n’est pas gardée après une erreur.') %></p>
<% } %>  </div>
<% } %>
  <section class="app-step">
    <h2><%= t('Vous') %></h2>
    <label><%= t('Photographe') %> <select name="author_id" data-author><% it.authors.forEach(a => { %><option value="<%= a.id %>" data-next="<%= a.next %>"<%~ a.id === author.id ? ' selected' : '' %>><%= a.name %></option><% }) %></select></label>
    <input type="hidden" name="lat" value="<%= v.lat || '' %>" data-lat>
    <input type="hidden" name="lon" value="<%= v.lon || '' %>" data-lon>
    <p class="app-pos" data-pos role="status"><%= t('Position : en attente…') %> <button type="button" class="linkbtn" data-pos-retry hidden><%= t('Réessayer') %></button></p>
    <label><%= t('Lieu') %> <span class="hint"><%= t('facultatif : la ville est déduite de la position') %></span><input name="place" value="<%= v.place || '' %>" maxlength="120" placeholder="<%= t('Rue, quartier…') %>"></label>
    <label class="app-photo<%= redo.portrait ? ' redo' : '' %>">
      <span class="app-big"><%= t('Photographier la personne') %></span>
      <span class="hint"><%= t('son visage, joint à son accord : pour savoir qui a signé et retrouver les bonnes images ; gardé en privé, aussi longtemps que l’accord') %></span>
      <input type="file" name="portrait" accept="image/*" capture="environment" data-portrait>
      <img alt="" hidden data-portrait-preview>
    </label>
    <label><%= t('Notes') %> <input name="details" value="<%= v.details || '' %>" maxlength="500" placeholder="<%= t('tenue, scène…') %>"></label>
<% if (it.recent && it.recent.length) { %>    <label><%= t('Déjà rencontrée ?') %> <span class="hint"><%= t('facultatif : la rencontre sera ajoutée à sa fiche (un nouvel accord reste à signer pour aujourd’hui)') %></span>
      <select name="person_id"><option value=""><%= t('Non, nouvelle personne') %></option><% it.recent.forEach(p => { %><option value="<%= p.id %>"<%~ Number(v.person_id) === p.id ? ' selected' : '' %>><%= [p.initials, p.ref].filter(Boolean).join(' · ') || t('Sans nom') %> · <%= p.day %><%= p.refused ? ` · ${t('refus')}` : '' %></option><% }) %></select></label>
<% } %>
  </section>

  <section class="app-step app-person">
    <h2><%= t('La personne') %> <span class="hint"><%= t('à lui tendre') %></span></h2>
    <fieldset class="app-langs">
      <legend class="sr-only"><%= t('Langue') %></legend>
<% L.forEach(l => { %>      <label><input type="radio" name="lang" value="<%= l %>" data-lang-pick<%~ (v.lang || 'fr') === l ? ' checked' : '' %>> <img class="flag" src="<%= it.asset(`flags/${l}.svg`) %>" alt="" width="24" height="17"> <%= FLAG[l] %></label>
<% }) %>    </fieldset>
<% L.forEach(l => { const A = it.UI[l].app, H = it.UI[l].hello; %>
    <div class="app-l10n" data-l="<%= l %>" lang="<%= l %>">
      <h3><%= A.consentTitle %></h3>
      <p class="app-consent"><%= A.consent('\u0000').split('\u0000')[0] %><span data-author-name><%= author.name %></span><%= A.consent('\u0000').split('\u0000')[1] %></p>
    </div>
<% }) %>
    <fieldset class="app-decision" data-group="decision"<%~ said('what', 'err-decision') %>>
      <legend class="sr-only"><%= t('Décision') %></legend>
      <p class="app-err" id="err-decision" data-err-for="decision"<%~ e.what ? '' : ' hidden' %>><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.errDecision %></span><% }) %></p>
      <label class="check big"><input type="radio" name="decision" value="accord"<%~ v.decision === 'accord' ? ' checked' : '' %><%~ bad('what') %>> <% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.accept %></span><% }) %></label>
      <div class="app-scopes">
<% ['site', 'instagram', 'print', 'name'].forEach(s => { %>        <label class="check"><input type="checkbox" name="scope_<%= s %>"<%~ on(`scope_${s}`) ? ' checked' : '' %>> <% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].hello.scopes[s] %></span><% }) %></label>
<% }) %>      </div>
      <label class="check big"><input type="radio" name="decision" value="refus"<%~ v.decision === 'refus' ? ' checked' : '' %><%~ bad('what') %>> <% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.refuse %></span><% }) %></label>
      <label class="check big"><input type="radio" name="decision" value=""<%~ !v.decision ? ' checked' : '' %><%~ bad('what') %>> <% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.later %></span><% }) %></label>
    </fieldset>
    <label><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.name %></span><% }) %><input name="name" value="<%= v.name || '' %>" maxlength="80" autocomplete="off"></label>
    <label><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.email %></span><% }) %><input type="email" name="email" value="<%= v.email || '' %>" maxlength="200" autocomplete="off" inputmode="email"></label>
    <label class="check"><input type="checkbox" name="wants_photo"<%~ on('wants_photo') ? ' checked' : '' %>> <% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].hello.wantsPhoto %></span><% }) %></label>
    <fieldset class="app-age" data-group="adult"<%~ said('adult', 'err-adult') %>>
      <legend class="sr-only"><%= t('Âge') %></legend>
      <p class="app-err" id="err-adult" data-err-for="adult"<%~ e.adult ? '' : ' hidden' %>><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.errAdult %></span><% }) %></p>
      <label class="check"><input type="radio" name="adult" value="oui"<%~ v.adult === 'oui' ? ' checked' : '' %><%~ bad('adult') %>> <% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.adult %></span><% }) %></label>
      <label class="check"><input type="radio" name="adult" value="non"<%~ v.adult === 'non' ? ' checked' : '' %><%~ bad('adult') %>> <% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.minor %></span><% }) %></label>
      <label><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.guardian %></span><% }) %><input name="guardian" value="<%= v.guardian || '' %>" maxlength="80" autocomplete="off"></label>
    </fieldset>
    <p class="hint app-privacy"><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.privacy(it.host) %></span><% }) %></p>
    <div class="app-sign<%= redo.signature ? ' redo' : '' %>">
      <p><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.sign %></span><% }) %></p>
      <canvas data-sign aria-label="<%= t('Signature') %>" role="img"></canvas>
      <input type="hidden" name="signature" data-sign-value>
      <button type="button" class="linkbtn" data-sign-clear><% L.forEach(l => { %><span data-l="<%= l %>" lang="<%= l %>"><%= it.UI[l].app.clear %></span><% }) %></button>
    </div>
  </section>
  <p class="app-actions"><button class="app-save" type="submit" data-save><%= t('Enregistrer') %></button></p>
</form>
</body>
</html>
