<% if (!it.corps) layout('./layout') %>
<% const t = it.t, s = it.saison, r = it.report, f = it.fields, edit = it.canEdit;
   const langs = [{ code: 'fr', name: 'Français' }, { code: 'en', name: 'English' }, { code: 'de', name: 'Deutsch' }];
   const invalid = field => it.errorField === field, url = `/admin/saisons/${s.id}/bilans/${r.id}`;
   const field = (base, lang) => lang === 'fr' ? base : `${base}_${lang}`; %>
<div class="saisons">
<header class="saisons-entete"><a class="saisons-retour" href="/admin/saisons/<%= s.id %>/bilans">← <%= t('Bilans et prolongements') %></a><h1><%= r.title %></h1><p class="sub"><%= r.rectifies_id == null ? t('Bilan initial') : t('Rectificatif du bilan n° {id}', { id: r.rectifies_id }) %></p></header>
<% if (it.error) { %><section class="saisons-erreur" role="alert"><h2><%= t('Les modifications n’ont pas été enregistrées.') %></h2><p><%= it.error %></p><% if (invalid('version')) { %><a class="btn ghost" href="<%= url %>"><%= t('Recharger la dernière version') %></a><% } %></section><% } %>
<% if (r.published_at != null) { %><p class="saisons-note"><%= t('Ce bilan a été publié. Ses textes et sa sélection sont immuables ; préparez un rectificatif pour le compléter ou le corriger.') %></p><% } %>
<form class="form" method="post" action="<%= url %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= it.version %>">
  <section class="panel form" aria-labelledby="recit-t"><h2 id="recit-t"><%= t('Récit du bilan') %></h2><p class="hint"><%= t('Le français, l’anglais et l’allemand sont nécessaires à la publication. Le brouillon peut rester incomplet.') %></p>
<% langs.forEach(lang => { %>    <fieldset class="saisons-langue"><legend lang="<%= lang.code %>"><%= lang.name %></legend>
<% [{ base: 'title', label: 'Titre', max: 120 }, { base: 'body', label: 'Récit', max: 12000 }].forEach(def => { const name = field(def.base, lang.code); %>
      <div class="saisons-champ"><label for="<%= name %>"><%= t(def.label) %></label><% if (def.base === 'body') { %><textarea id="<%= name %>" name="<%= name %>" rows="8" maxlength="<%= def.max %>" lang="<%= lang.code %>"<%~ edit ? '' : ' readonly' %><%~ invalid(name) ? ` aria-invalid="true" aria-describedby="${name}-erreur"` : '' %>><%= f[name] %></textarea><% } else { %><input id="<%= name %>" name="<%= name %>" maxlength="<%= def.max %>" value="<%= f[name] %>" lang="<%= lang.code %>"<%~ edit ? '' : ' readonly' %><%~ invalid(name) ? ` aria-invalid="true" aria-describedby="${name}-erreur"` : '' %>><% } %><% if (invalid(name)) { %><p class="err" id="<%= name %>-erreur"><%= it.error %></p><% } %></div>
<% }) %>    </fieldset>
<% }) %>  </section>
  <section class="panel form" aria-labelledby="selection-t"><h2 id="selection-t"><%= t('Photographies retenues') %></h2><p class="hint" id="selection-aide"><%= t('Vous pouvez ne retenir aucune photo. Cochez les œuvres choisies et attribuez des positions distinctes pour leur ordre.') %></p><% if (invalid('photo_ids')) { %><p class="err" id="selection-erreur"><%= it.error %></p><% } %>
<% it.photos.forEach(ph => { %>    <div class="saisons-langue"><div class="saisons-choix"><label><input type="checkbox" name="photo_ids[]" value="<%= ph.id %>"<%~ ph.selected ? ' checked' : '' %><%~ edit ? '' : ' disabled' %>><% if (ph.thumb) { %><img class="saisons-vignette" src="<%= ph.thumb %>" width="80" height="<%= Math.round(80 * ph.height / ph.width) %>" alt="" loading="lazy"><% } %> <span><%= ph.title %></span></label></div><% if (!ph.available) { %><p class="err"><%= edit ? t('Photo indisponible : décochez-la avant d’enregistrer.') : t('Photo indisponible') %></p><% } %><div class="saisons-champ"><label for="position-<%= ph.id %>"><%= t('Position de « {title} »', { title: ph.title }) %></label><input id="position-<%= ph.id %>" name="position_<%= ph.id %>" type="number" min="1" max="500" value="<%= ph.position %>" aria-describedby="selection-aide<%= invalid('photo_ids') ? ' selection-erreur' : '' %>"<%~ edit ? '' : ' readonly' %>></div></div>
<% }) %><% if (edit) { %><div class="actions"><button class="btn" type="submit"><%= t('Enregistrer le bilan') %></button></div><% } %>
  </section>
</form>
<% if (it.confirm) { %><form class="panel form" method="post" action="<%= url %>/<%= it.confirm.action %>" aria-labelledby="confirmation-t"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="version" value="<%= it.version %>"><h2 id="confirmation-t"><%= it.confirm.label %></h2><p><%= it.confirm.message %></p><div class="actions"><a class="btn ghost" href="<%= url %>"><%= t('Annuler') %></a><button class="btn" type="submit"><%= it.confirm.label %></button></div></form>
<% } else if (it.canPublish) { %><section class="panel form" aria-labelledby="publication-t"><h2 id="publication-t"><%= t('Publication') %></h2><div class="actions"><% if (r.state === 'brouillon') { %><a class="btn ghost" href="<%= url %>/publier"><%= t('Publier…') %></a><% } else if (r.state === 'publie') { %><a class="btn danger" href="<%= url %>/retirer"><%= t('Retirer…') %></a><% } %></div></section><% } %>
<% if (!it.confirm && r.state === 'publie' && it.canEdit === false && it.canWrite) { %>
<form class="panel form" method="post" action="/admin/saisons/<%= s.id %>/bilans"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="rectifies_id" value="<%= r.id %>"><h2><%= t('Préparer un rectificatif') %></h2><div class="saisons-champ"><label for="rectificatif-titre"><%= t('Titre en français') %></label><input id="rectificatif-titre" name="title" maxlength="120" required></div><div class="actions"><button class="btn ghost" type="submit"><%= t('Créer le rectificatif') %></button></div></form>
<% } %>
<section class="panel form" aria-labelledby="collections-t"><h2 id="collections-t"><%= t('Prolongements dans les collections') %></h2><% if (!it.collections.length) { %><p class="hint"><%= t('Aucune collection issue de ce bilan.') %></p><% } else { %><ul><% it.collections.forEach(c => { %><li><a class="saisons-retour" href="/admin/saisons/<%= s.id %>/collections/<%= c.id %>"><%= c.title %></a></li><% }) %></ul><% } %>
<% if (!it.confirm && r.state === 'publie' && it.canWrite) { %><form class="form" method="post" action="<%= url %>/collections"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><div class="saisons-champ"><label for="collection-titre"><%= t('Titre du prolongement en français') %></label><input id="collection-titre" name="title" maxlength="120" value="<%= it.collectionTitle || '' %>" required></div><div class="actions"><button class="btn ghost" type="submit"><%= t('Préparer une collection') %></button></div></form><% } %>
</section>
</div>
