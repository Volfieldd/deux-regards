<% layout('./layout') %>
<% const f = it.filter; %>
<% if (!it.hero.length) { %><h1 class="sr-only"><%= it.siteName %></h1><% } %>
<section class="hero" id="hero" data-hero>
  <div class="ph">
<% it.hero.forEach((p, i) => { %>
    <div class="hero-item<%= i === 0 ? ' on' : '' %>" data-h="<%= i %>">
      <%~ it.picture(p, { sizes: '100vw', eager: i === 0, alt: '' }) %>
    </div>
<% }) %>
  </div>
  <div class="veil"></div>
  <header class="wrap">
    <%~ include('./brand', it) %>
    <%~ include('./nav', { ...it, home: true }) %>
  </header>
<% it.hero.forEach((p, i) => { %>
  <div class="cap wrap<%= i === 0 ? ' on' : '' %>" data-h="<%= i %>">
    <span class="k mono"><%= [p.category.toUpperCase(), 'N°' + it.pad(p.n), [p.place, p.when].filter(Boolean).join(', '), p.author].filter(Boolean).join(' · ') %></span>
    <h1><%= p.title %></h1>
    <a class="open eyebrow" href="<%= it.photoUrl(p.slug) %>"><%= it.t.seePhoto %></a>
  </div>
<% }) %>
<% if (it.hero.length > 1) { %>
  <div class="strip wrap" data-js-only hidden>
<% it.hero.forEach((p, i) => { %>
    <button type="button" data-h="<%= i %>" aria-label="<%= p.title %>" aria-current="<%= i === 0 %>"><%~ it.picture(p, { sizes: '64px', alt: '' }) %></button>
<% }) %>
  </div>
  <button type="button" class="pause eyebrow" data-pause data-play="<%= it.t.play %>" hidden><%= it.t.pause %></button>
  <div class="bar"></div>
<% } %>
</section>

<main id="contenu">
<section class="regards wrap" id="regards">
  <div>
    <h2><%= it.tagline || it.siteName %></h2>
<% if (it.intro) { %>
    <p><%= it.intro %></p>
<% } %>
  </div>
  <nav class="who" aria-label="<%= it.t.photographer %>">
<% it.regards.forEach(r => { const on = r.slug === f.regard; %>
    <a href="<%= it.galleryUrl({ regard: r.slug, serie: f.serie, ordre: f.ordre }) %>" data-filter <%~ on ? 'aria-current="page"' : '' %>><span class="n"><%= r.name %></span><span class="c mono"><%= it.t.photos(it.pad(r.count)) %></span></a>
<% }) %>
  </nav>
</section>

<section class="series wrap" id="series">
  <nav aria-label="<%= it.t.nav.series %>">
<% it.series.forEach(c => { const on = c.slug === f.serie; %>
<% if (c.count) { %>
    <a class="idx" href="<%= it.galleryUrl({ regard: f.regard, serie: on ? undefined : c.slug, ordre: f.ordre }) %>" data-filter data-scroll data-peek="<%= c.slug %>" <%~ on ? 'aria-current="page"' : '' %>><span><%= c.name %><% if (on) { %><span class="sr-only"> <%= it.t.removeFilter %></span><% } %></span><span class="mono"><%= it.pad(c.count) %></span></a>
<% } else { %>
    <span class="idx off"><span><%= c.name %></span><span class="mono">00</span></span>
<% } %>
<% }) %>
  </nav>
  <div class="peek" aria-hidden="true">
<% const peekDefault = f.serie || (it.series.find(c => c.count) || {}).slug; %>
<% it.series.filter(c => c.cover).forEach(c => { %>
    <figure class="<%= c.slug === peekDefault ? 'on' : '' %>" data-peek="<%= c.slug %>">
      <%~ it.picture(c.cover, { sizes: '(min-width: 900px) 40vw, 1px', alt: '' }) %>
      <figcaption class="mono"><span><%= c.name.toUpperCase() %> · N°<%= it.pad(c.cover.n) %></span><span><%= c.cover.title %></span></figcaption>
    </figure>
<% }) %>
  </div>
</section>

<div class="gridhead" id="galerie">
  <h3 tabindex="-1"><%= it.activeSerie ? it.activeSerie.name : it.t.allSeries %><%= it.activeAuthor ? ', ' + it.t.by(it.activeAuthor.name) : '' %></h3>
  <span class="mono"><%= it.pad(it.photos.length) %> / <%= it.pad(it.total) %> <%= it.t.views %><% if (f.regard || f.serie) { %> · <a class="reset" href="<%= it.galleryUrl({ ordre: f.ordre }) %>#galerie" data-filter><%= it.t.showAll %></a><% } %></span>
  <nav class="order mono" aria-label="<%= it.t.order %>"><%= it.t.orderLabel %>
    <a href="<%= it.galleryUrl({ regard: f.regard, serie: f.serie }) %>#galerie" data-filter <%~ f.ordre ? '' : 'aria-current="true"' %>><%= it.t.selection %></a> ·
    <a href="<%= it.galleryUrl({ regard: f.regard, serie: f.serie, ordre: 'recentes' }) %>#galerie" data-filter <%~ f.ordre === 'recentes' ? 'aria-current="true"' : '' %>><%= it.t.recent %></a>
  </nav>
</div>
<section class="grid wrap" id="grid">
<% if (it.photos.length) { %>
<% it.photos.forEach(p => { %>
  <a class="tile" href="<%= it.photoUrl(p.slug, f) %>">
    <div class="im"><%~ it.picture(p, { sizes: '(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 92vw', alt: '' }) %></div>
    <div class="t"><span class="ttl"><%= p.title %></span><span class="mono">N°<%= it.pad(p.n) %> · <%= p.category %> · <span aria-hidden="true"><%= p.author[0] %></span><span class="sr-only"><%= p.author %></span></span></div>
  </a>
<% }) %>
<% } else { %>
  <p class="empty"><%= it.t.emptyGallery %></p>
<% } %>
</section>

</main>
<p class="sr-only" aria-live="polite" data-announce></p>
<%~ include('./footer', it) %>
