<% layout('./layout') %>
<header class="top wrap">
  <%~ include('./brand', it) %>
  <%~ include('./nav', { ...it, current: 'about' }) %>
</header>
<main class="about wrap">
<% if (it.brand && it.brand.logotype) { %>
  <div class="logotype" role="img" aria-label="<%= it.siteName %><%= it.brand.subtitle ? ' — ' + it.brand.subtitle : '' %>"></div>
<% } %>
  <h1><%= it.tagline || it.t.nav.about %></h1>
  <div class="prose">
<% it.paragraphs.forEach(t => { %>
    <p><%= t %></p>
<% }) %>
  </div>
  <div class="people">
<% it.authors.forEach(a => { %>
    <section>
      <h2><a href="<%= it.galleryUrl({ regard: a.slug }) %>"><%= a.name %></a></h2>
<% if (a.bio) { %>
      <p><%= a.bio %></p>
<% } %>
      <a class="eyebrow more" href="<%= it.galleryUrl({ regard: a.slug }) %>#galerie"><%= it.t.seePhotosOf %></a>
    </section>
<% }) %>
  </div>
</main>
<%~ include('./footer', it) %>
