<!doctype html>
<% const theme = it.theme || {}; const brand = it.brand || {};
   const masks = [brand.emblem, brand.icon, brand.logotype].filter(Boolean).join('.');
   const ogImage = it.ogImage ? it.publicUrl + it.ogImage : (brand.share ? `${it.publicUrl}/brand/${brand.share}` : null); %>
<html lang="<%= it.lang || 'fr' %>"<% if (theme.classes) { %> class="<%= theme.classes %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="<%= theme.scheme || 'light' %>">
  <title><%= it.pageTitle %></title>
<% if (it.description) { %>
  <meta name="description" content="<%= it.description %>">
<% } %>
<% const lang = it.lang || 'fr'; %>
<% if (it.canonical) { %>
  <link rel="canonical" href="<%= it.publicUrl + it.localize(it.canonical, lang) %>">
  <meta property="og:url" content="<%= it.publicUrl + it.localize(it.canonical, lang) %>">
<% it.langs.forEach(l => { %>
  <link rel="alternate" hreflang="<%= l %>" href="<%= it.publicUrl + it.localize(it.canonical, l) %>">
<% }) %>
  <link rel="alternate" hreflang="x-default" href="<%= it.publicUrl + it.canonical %>">
<% } %>
  <meta property="og:locale" content="<%= it.locales[lang] %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= it.pageTitle %>">
  <meta property="og:site_name" content="<%= it.siteName %>">
<% if (it.description) { %>
  <meta property="og:description" content="<%= it.description %>">
<% } %>
<% if (ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="summary_large_image">
<% } %>
<% if (theme.preload) { %>
  <link rel="preload" href="<%= theme.preload %>" as="font" type="font/woff2" crossorigin>
<% } %>
  <link rel="stylesheet" href="<%= it.asset('css/site.css') %>">
<% if (theme.stylesheet) { %>
  <link rel="stylesheet" href="<%= it.asset(theme.stylesheet) %>">
<% } %>
<% if (masks) { %>
  <link rel="stylesheet" href="/brand.css?v=<%= masks %>">
<% } %>
<% if (brand.favicon64) { %>
  <link rel="icon" type="image/png" href="/brand/<%= brand.favicon64 %>">
  <link rel="apple-touch-icon" href="/brand/<%= brand.favicon180 %>">
<% } %>
  <script src="<%= it.asset('js/site.js') %>" defer></script>
</head>
<body class="<%= it.bodyClass || '' %>">
<% if (theme.preview) { %>
<p class="preview-bar mono" role="note">Aperçu du thème « <%= theme.label %> » (visible par vous seul) · <a href="/admin/apparence">Apparence</a> · <a href="?theme=off">Quitter l’aperçu</a></p>
<% } %>
<% if (it.apercuV2) { %>
<div class="preview-bar mono" role="note"><form method="post" action="/admin/apparence/apercu-v2"><input type="hidden" name="_csrf" value="<%= it.apercuV2.csrf %>"><input type="hidden" name="apercu" value="0"><input type="hidden" name="vers" value="<%= it.apercuV2.vers %>">Aperçu de la v2 (visible par vous seul) : cette page n’a pas encore sa version v2 · <a href="/admin/apparence">Apparence</a> · <button type="submit">Quitter l’aperçu</button></form></div>
<% } %>
<%~ it.body %>
</body>
</html>
