<% /* Boutons « Voir en v1 / v2 / v3 » (server/vue-site.js) : administrateur connecté seulement, dans toutes les versions. */ %>
<aside class="vue-site<%= it.forced ? ' vue-site--forcee' : '' %>" aria-label="<%= it.label %>"><p class="vue-site-t"><%= it.etat %><% if (it.note) { %> <%= it.note %><% } %></p><% it.boutons.forEach(b => { %><form method="post" action="/admin/apparence/apercu-v2"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="vue" value="<%= b.vue %>"><input type="hidden" name="vers" value="<%= b.vers %>"><button class="vue-site-b" type="submit"><%= b.bouton %></button></form><% }) %></aside>
