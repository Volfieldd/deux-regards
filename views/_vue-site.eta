<% /* Bouton « Voir en v1 / Voir en v2 » (server/vue-site.js) : administrateur connecté seulement, en v1 comme en v2. */ %>
<aside class="vue-site<%= it.forced ? ' vue-site--forcee' : '' %>" aria-label="<%= it.label %>"><form method="post" action="/admin/apparence/apercu-v2"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="vue" value="<%= it.vue %>"><input type="hidden" name="vers" value="<%= it.vers %>"><p class="vue-site-t"><%= it.etat %><% if (it.note) { %> <%= it.note %><% } %></p><button class="vue-site-b" type="submit"><%= it.bouton %></button></form></aside>
