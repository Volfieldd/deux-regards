<% layout('./layout') %>
<% const p = it.photo; %>
<link rel="prefetch" href="<%= it.photoUrl(it.next.slug, it.filter) %>">
<main class="viewer" data-viewer data-prev="<%= it.photoUrl(it.prev.slug, it.filter) %>" data-next="<%= it.photoUrl(it.next.slug, it.filter) %>" data-back="<%= it.backUrl %>">
  <div class="vh wrap">
    <a class="back eyebrow" href="<%= it.backUrl %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>Fermer</a>
    <span class="mono"><%= it.pad(it.position) %> / <%= it.pad(it.count) %></span>
  </div>
  <div class="vimg"><%~ it.picture(p, { sizes: '100vw', eager: true }) %></div>
  <div class="vf wrap">
    <div class="vtext">
      <h1><%= p.title %></h1>
      <div class="meta mono">N°<%= it.pad(p.n) %> · <%= p.category %> · <a href="<%= it.galleryUrl({ regard: p.author_slug }) %>"><%= p.author %></a><%= p.place ? ' · ' + p.place : '' %><%= p.when ? ', ' + p.when : '' %></div>
<% if (p.legend) { %>
      <p class="legend" id="legende"><%= p.legend %></p>
<% } %>
    </div>
<% if (it.count > 1) { %>
    <nav class="nav" aria-label="Photos">
      <a href="<%= it.photoUrl(it.prev.slug, it.filter) %>" rel="prev" aria-label="Photo précédente : <%= it.prev.title %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></a>
      <a href="<%= it.photoUrl(it.next.slug, it.filter) %>" rel="next" aria-label="Photo suivante : <%= it.next.title %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </nav>
<% } %>
  </div>
</main>
