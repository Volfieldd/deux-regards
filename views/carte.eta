<% layout('./layout') %>
<% const terre = it.asset('carte-terre.svg'); const fine = it.asset('carte-terre-fine.svg'); const t = it.t, m = it.t.map; %>
<header class="top wrap">
  <%~ include('./brand', it) %>
  <%~ include('./nav', { ...it, current: 'carte', mapPage: true }) %>
</header>
<main class="carte-page wrap">
<% if (it.preview) { %>
  <p class="apercu mono" role="note">Aperçu réservé aux auteurs : cette page n’est pas publiée. Les visiteurs ne la voient pas et le menu du site ne la montre pas. <a href="/admin/reglages#carte">Publier la page Carte dans les Réglages</a></p>
<% } %>
  <div class="carte-head">
    <h1><%= m.title %></h1>
    <p class="mono"><%= it.places.length ? `${t.photos(it.count)} · ${t.places(it.places.length)}` : m.none %></p>
  </div>
  <figure class="carte" data-carte data-cluster-one="<%= m.cluster('{name}', 1, '{n}') %>" data-cluster-many="<%= m.cluster('{name}', 99, '{n}').replace('99', '{others}') %>">
    <div class="carte-vue" data-carte-vue>
      <svg class="carte-svg" viewBox="0 0 <%= it.map.width %> <%= it.map.height %>" data-carte-svg data-tiles="<%= it.asset('carte-tuiles/index.json') %>" role="group" aria-labelledby="carte-titre">
        <title id="carte-titre"><%= m.svgTitle %><%= it.places.length ? ` : ${it.places.slice(0, 8).map(c => c.name).join(', ')}${it.places.length > 8 ? '…' : ''}` : '' %></title>
        <defs><clipPath id="carte-rond" clipPathUnits="objectBoundingBox"><circle cx=".5" cy=".5" r=".5"/></clipPath></defs>
        <use class="globe" href="<%= terre %>#globe" width="<%= it.map.width %>" height="<%= it.map.height %>"/>
        <use class="terre" href="<%= terre %>#terre" data-fine="<%= fine %>#terre" width="<%= it.map.width %>" height="<%= it.map.height %>"/>
        <use class="frontieres" href="<%= terre %>#frontieres" data-fine="<%= fine %>#frontieres" width="<%= it.map.width %>" height="<%= it.map.height %>"/>
        <g class="detail" data-detail display="none"></g>
        <g class="pins" data-pins>
<% it.places.forEach(c => { const n = c.photos.length; %>
          <a class="pin" href="#lieu-<%= c.id %>" data-pin="<%= c.id %>" data-x="<%= c.x %>" data-y="<%= c.y %>" data-n="<%= n %>" data-name="<%= c.name %>" transform="translate(<%= c.x %> <%= c.y %>)" aria-label="<%= c.name %>, <%= c.country %><%= t.colon %> <%= t.photos(n) %>">
            <g class="pin-in" data-pin-in>
              <circle class="pin-bord" r="15"/>
              <image href="<%= c.thumb %>" x="-13" y="-13" width="26" height="26" preserveAspectRatio="xMidYMid slice" clip-path="url(#carte-rond)"/>
              <g class="pin-n"><circle cx="12" cy="-12" r="8"/><text x="12" y="-12" data-pin-count><%= n %></text></g>
            </g>
          </a>
<% }) %>
        </g>
      </svg>
    </div>
    <div class="carte-outils" data-js-only hidden>
      <button type="button" data-carte-zoom="in" aria-label="<%= m.zoomIn %>">+</button>
      <button type="button" data-carte-zoom="out" aria-label="<%= m.zoomOut %>" disabled>−</button>
      <button type="button" class="eyebrow" data-carte-zoom="reset" disabled><%= m.world %></button>
    </div>
    <figcaption class="mono"><span data-js-only hidden><%= m.help %> </span><%= m.base %> · <%= m.credit %></figcaption>
  </figure>
<% if (it.places.length) { %>
  <div class="lieux">
<% it.places.forEach(c => { %>
    <section class="lieu" id="lieu-<%= c.id %>">
      <h2><%= c.name %> <span class="mono"><%= c.country %> · <%= t.photos(c.photos.length) %></span></h2>
      <ul>
<% c.photos.forEach(p => { %>
        <li><a href="<%= it.photoUrl(p.slug) %>"><span class="im"><%~ it.picture(p, { sizes: '(min-width: 640px) 220px, 45vw', alt: '' }) %></span><span class="ttl"><%= p.title %></span></a></li>
<% }) %>
      </ul>
    </section>
<% }) %>
  </div>
<% } else { %>
  <p class="empty"><%= it.preview ? 'Aucune photo sur la carte : choisissez la ville d’une photo publiée et cochez « Afficher sur la carte » dans sa fiche.' : m.soon %></p>
<% } %>
</main>
<%~ include('./footer', it) %>
