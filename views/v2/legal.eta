<% /* Mentions légales / Impressum / Legal notice en v2 : le texte de server/legal.js, rempli par les réglages de l'admin
      (éditeurs, contact, directeur de la publication, hébergement tel qu'il est réglé), présenté en lecture longue avec
      son sommaire (views/v2/_lecture.eta). Même contenu que la v1 (views/legal.eta). */ %>
<% layout('./layout', { pageTitle: it.v2.typo(it.pageTitle), description: it.v2.typo(it.description) }) %>
<%~ include('./_entete', it) %>
<main id="contenu">
  <div class="wrap tete-page"><h1 class="titre-page"><%= it.L.title %></h1></div>
<%~ include('./_lecture', it) %>
</main>
<%~ include('./_pied', it) %>
