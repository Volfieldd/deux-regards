<% /* Sélecteur de langue (MQ-00 § 2) : le code visible, puis son nom lu (« FR – Langue : français », WCAG 2.5.3) ; la même
      page dans chaque langue, cochée pour la langue de la page. Sans drapeau (UX-F-32). Des liens /langue/… (cookie de
      langue, comme en v1). */ %>
<% const t = it.t, lang = it.lang || 'fr', ic = it.v2.ic; %>
      <details class="lang-pick" data-lang-pick>
        <summary><span><%= lang.toUpperCase() %></span><span class="sr-only"> – <%= t.nav.langCurrent.replace(' :', '\u202f:') %></span><%~ ic('bas', { size: 16 }) %></summary>
        <% /* Navigation nommée : Safari conserve la liste native malgré les puces masquées. */ %>
        <nav aria-label="<%= t.nav.lang %>"><ul>
<% it.langs.forEach(l => { %>          <li><a href="/langue/<%= l %>?vers=<%= encodeURIComponent(it.here) %>" hreflang="<%= l %>" lang="<%= l %>" rel="nofollow"<%~ l === lang ? ' aria-current="true"' : '' %>><%= it.langNames[l] %><% if (l === lang) { %><%~ ic('coche', { size: 18 }) %><% } %></a></li>
<% }) %>        </ul></nav>
      </details>
