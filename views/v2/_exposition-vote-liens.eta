<% if (it.voteLinks?.voteHref || it.voteLinks?.manageHref || it.voteLinks?.entryHref) { const vote = it.voteLinks; %>
<div class="expo-actions">
  <% if (vote.entryHref) { %><a class="lien" href="<%= vote.entryHref %>"><%= vote.v.seeProposals %></a><% } %>
  <% if (vote.voteHref) { %><a class="btn" href="<%= vote.voteHref %>"><%= vote.v.title %></a><% } %>
  <% if (vote.manageHref) { %><a class="lien" href="<%= vote.manageHref %>"><%= vote.v.manage %></a><% } %>
</div>
<% } %>
