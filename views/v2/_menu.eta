<% /* Menu (MQ-00 § 3) : un <details>, sans script ; le mot « Menu » ne change pas, l'icône devient ✕. Les entrées de
      _liens.eta, puis Rechercher. En-tête Contexte (visionneuse) : « Accueil » en tête, le panneau nommé « Navigation » ;
      en-tête Site (it.site), la marque est déjà visible : le panneau, second repère de navigation de la page, est nommé
      « Navigation (téléphone) ». */ %>
<% const t = it.t, ic = it.v2.ic, home = it.u('/'), site = Boolean(it.site); %>
      <details class="sh-menu" data-menu>
        <summary><span class="sh-ouvrir"><%~ ic('menu') %><span class="sh-menu-t"><%= t.v2.menu %></span></span><span class="sh-fermer"><%~ ic('fermer') %><span class="sh-menu-t"><%= t.v2.menu %></span></span></summary>
        <nav class="sh-panneau" aria-label="<%= site ? t.v2.navPhone : t.nav.label %>">
          <ul>
<% if (!site) { %>            <li><a href="<%= home %>"><%= t.v2.home %><span class="sh-panneau-marque"><%= it.siteName %></span></a></li>
<% } %>            <%~ include('./_liens', it) %>
<% if (it.searchPage) { %>            <li><a href="<%= it.u('/recherche') %>"<%~ it.courant === 'recherche' ? ' aria-current="page"' : '' %>><%~ ic('loupe') %><%= t.nav.search %></a></li>
<% } %>          </ul>
        </nav>
      </details>
