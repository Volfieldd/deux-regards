<% /* Confidentialité en v2 : le texte de server/privacy.js (journal de sécurité compris quand la Vigie est là), présenté
      en lecture longue avec son sommaire (views/v2/_lecture.eta) ; la date de mise à jour sous le titre, le contact à la
      fin. Même contenu que la v1 (views/privacy.eta). */ %>
<% layout('./layout', { pageTitle: it.v2.typo(it.pageTitle), description: it.v2.typo(it.description) }) %>
<% const v = it.v2; %>
<%~ include('./_entete', it) %>
<main id="contenu">
  <div class="wrap tete-page"><h1 class="titre-page"><%= it.P.title %></h1><p class="lecture-maj"><%= v.typo(it.updated) %></p></div>
<%~ include('./_lecture', { ...it, fin: it.contactHref ? `    <p class="lecture-contact"><a class="lien" href="${v.esc(it.contactHref)}">${v.esc(it.contact)}</a></p>\n` : '' }) %>
</main>
<%~ include('./_pied', it) %>
