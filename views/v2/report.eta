<% /* « Signaler cette photo » en v2 : la page sans script de la visionneuse (/photo/<slug>/signaler), sans maquette propre ;
      composants et règles de la planche MQ-00 (§ 8, formulaires et erreurs) et mise en page de MQ-05. Même route, même
      méthode, mêmes champs que la v1 (views/report.eta : kind, message, email, et le champ piège website). Après l'envoi
      (?envoye=1), le message de succès prend le focus. */ %>
<% const t = it.t, f = it.f, F = t.v2form, R = F.report, ic = it.v2.ic, ty = it.v2.typo, p = it.photo;
   const v = it.values || {}, e = it.errors || {};
   const ORDER = ['kind', 'message', 'email'];
   const TARGET = { kind: `sg-kind-${Object.keys(f.kinds)[0]}`, message: 'sg-message', email: 'sg-email' };
   const text = k => ty(F.errors[e[k]] || f.errors[e[k]] || String(e[k]));
   const keys = [...ORDER.filter(k => e[k]), ...Object.keys(e).filter(k => k !== 'limit' && !ORDER.includes(k))];
   const errs = keys.map(k => ({ key: k, target: TARGET[k] || TARGET.kind, text: text(k) }));
   const limit = e.limit ? ty(f.errors.limit) : '';
   const focusOn = !limit && errs.length === 1 ? errs[0].target : null;
   const af = id => (focusOn === id ? ' autofocus' : '');
   const desc = (...ids) => { const l = ids.filter(Boolean); return l.length ? ` aria-describedby="${l.join(' ')}"` : ''; };
   const bad = k => (e[k] ? ' aria-invalid="true"' : '');
   const err = k => (e[k] ? `<p class="champ-err" id="err-${k}">${ic('alerte', { size: 16 })}<span><b>${F.error}</b> ${it.v2.esc(after(text(k)))}</span></p>` : '');
   // Après « Erreur : », la phrase continue en minuscule en français (« Erreur : adresse e-mail invalide… »).
   const after = s => (it.lang === 'fr' && !/^\p{Lu}{2}/u.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s);
   const ek = k => (e[k] ? `err-${k}` : null);
   const pageTitle = it.sent ? it.pageTitle
     : limit ? `${F.limitTitle} · ${it.pageTitle}`
     : errs.length > 1 ? `${F.titleError(F.points(errs.length))} · ${it.pageTitle}`
     : errs.length ? `${F.titleError(F.fields[errs[0].key] || F.fields.kind)} · ${it.pageTitle}` : it.pageTitle;
   const back = it.photoUrl(p.slug), meta = ty([p.author, p.place, (it.v2.date(p.taken_on) || '').replace(/ /g, '\u00a0')].filter(Boolean).join(' · ')); %>
<% layout('./layout', { pageTitle: ty(pageTitle), description: ty(it.description), formulaires: true }) %>
<%~ include('./_contexte', { ...it, retour: { href: back, label: p.title } }) %>
<main id="contenu" class="wrap">
<div class="pf<%= it.sent ? ' pf--seul' : '' %>">
  <div class="pf-intro">
    <p class="etiquette"><%= R.label %></p>
    <h1 class="titre-page"><%= f.reportTitle %></h1>
<% if (it.sent) { %>
    <div class="msg msg--ok" role="status" tabindex="-1" autofocus><%~ ic('coche', { size: 18 }) %><p><b><%= F.sent %></b> <%= ty(f.thanks) %></p></div>
    <p class="pf-suite"><a class="lien" href="<%= back %>"><%= f.back %></a></p>
<% } else { %>
    <p class="chapo"><%= ty(f.reportIntro(p.title)) %></p>
    <div class="photo-ref">
      <%~ it.picture(p, { sizes: '(max-width: 420px) 120px, 160px', alt: '' }) %>
      <div><p class="cartel"><span class="cartel-t"><%= p.title %></span><span class="cartel-m"><%= meta %></span></p></div>
    </div>
    <p class="chapo chapo--texte"><%= ty(f.me) %> <a href="<%= it.u('/bonjour') %>"><%= f.meLink %></a></p>
<% } %>
  </div>
<% if (!it.sent) { %>
  <form class="form" method="post" action="<%= it.u(`/photo/${p.slug}/signaler`) %>" novalidate>
<%~ include('./_erreurs', { ...it, errs, limit }) %>
    <p class="form-oblig"><%= F.required %></p>
    <fieldset class="bloc groupe<%= e.kind ? ' groupe--erreur' : '' %>"<%~ desc(ek('kind')) %>><legend><%= ty(f.kind) %></legend>
<%~ err('kind') %>
<% Object.entries(f.kinds).forEach(([k, label]) => { %>      <label class="choix"><input id="sg-kind-<%= k %>" type="radio" name="kind" value="<%= k %>"<%~ v.kind === k ? ' checked' : '' %><%~ bad('kind') %><%~ af(`sg-kind-${k}`) %>><span><%= label %></span></label>
<% }) %>    </fieldset>
    <div class="champ"><label for="sg-message"><%= f.message %></label><p class="champ-aide" id="sg-message-aide"><%= R.messageHint %></p>
      <textarea id="sg-message" name="message" rows="4" maxlength="2000"<%~ desc(ek('message'), 'sg-message-aide') %><%~ bad('message') %><%~ af('sg-message') %>><%= v.message || '' %></textarea><%~ err('message') %></div>
    <div class="champ"><label for="sg-email"><%= f.email %> <span class="facultatif"><%= F.optional %></span></label><p class="champ-aide" id="sg-email-aide"><%= R.emailHint %></p>
      <input id="sg-email" type="email" name="email" value="<%= v.email || '' %>" maxlength="200" autocomplete="email"<%~ desc(ek('email'), 'sg-email-aide') %><%~ bad('email') %><%~ af('sg-email') %>><%~ err('email') %></div>
    <p class="note-donnees"><%= ty(f.privacy) %></p>
    <div class="piege" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
    <div class="envoi"><button class="btn" type="submit"><%= f.send %></button><a class="lien" href="<%= back %>"><%= f.back %></a></div>
  </form>
<% } %>
</div>
</main>
<%~ include('./_pied', it) %>
