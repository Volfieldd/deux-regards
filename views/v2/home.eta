<% /* Accueil, galerie et page d'une série en v2 (maquettes MQ-01, MQ-02 et MQ-03 de l'audit d'ergonomie du 16 oct.
      2026). Le serveur rend « home » pour /, /auteur/<slug>, /serie/<slug> et /?regard=&serie=&ordre= ; it.page dit
      laquelle des trois pages v2 montrer (server/routes/public.js) : « accueil » (/ sans filtre ni ordre), « serie »
      (/serie/<slug>), « galerie » (toute autre vue). Mêmes données que la v1 (views/home.eta), aucun paramètre nouveau. */ %>
<% const t = it.t, page = it.page || 'accueil', A = it.activeAuthor, S = it.activeSerie, site = it.siteName;
   const list = names => (names.length > 1 ? names.slice(0, -1).join(', ') + t.v2.and + names.at(-1) : names[0] || '');
   const names = list(it.regards.slice(1).filter(r => r.count).map(r => r.name));
   const label = A && S ? `${S.name}, ${t.by(A.name)}` : A ? t.by(A.name) : S ? S.name : '';
   const serieBy = S ? list(it.regards.slice(1).filter(r => it.photos.some(p => p.author_slug === r.slug)).map(r => r.name)) : '';
   const pageTitle = page === 'accueil' ? t.v2.titleHome(site, names)
     : page === 'serie' ? `${serieBy ? t.v2.serieTitle(S.name, serieBy) : S.name} · ${site}`
     : t.nav.gallery + (label ? `, ${label} (${t.photos(it.photos.length)})` : '') + ` · ${site}`; %>
<% layout('./layout', { pageTitle }) %>
<%~ include('./_entete', { ...it, courant: page === 'serie' ? 'series' : page === 'galerie' ? 'galerie' : null, surPhoto: it.v3 && page === 'accueil' && it.hero.length > 0 }) %>
<main id="contenu">
<% if (page === 'serie' && S) { %>
<%~ include('./_serie', it) %>
<% } else if (page === 'galerie') { %>
  <div class="wrap tete-page"><h1 class="titre-page"><%= t.nav.gallery %></h1><p class="chapo"><%= t.v2.galleryLead(it.total, names) %></p></div>
<%~ include('./_galerie', { ...it, gridId: 'galerie' }) %>
<% } else { %>
<%~ include('./_accueil', { ...it, names, promise: it.tagline || site, promiseSub: t.v2.promiseSub(names) }) %>
<% } %>
</main>
<%~ include('./_pied', it) %>
