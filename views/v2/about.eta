<% /* À propos en v2 : l'accroche en titre, le texte « À propos » de l'admin (sinon l'introduction) en lecture longue, puis
      les photographes : leur nom, leur biographie, le chemin vers leurs photos. Sans le logo en tête de page (UX-F-33 : il
      repoussait le premier mot à 480 px) : la marque est dans l'en-tête. Mêmes données que la v1 (views/about.eta). */ %>
<% layout('./layout', { pageTitle: it.v2.typo(it.pageTitle), description: it.v2.typo(it.description) }) %>
<% const t = it.t, v = it.v2, ic = v.ic; %>
<%~ include('./_entete', { ...it, courant: 'a-propos' }) %>
<main id="contenu">
  <div class="wrap tete-page"><h1 class="titre-page"><%= it.tagline || t.nav.about %></h1></div>
<% if (it.paragraphs.length) { %>  <div class="wrap lecture lecture--seule">
    <div class="lecture-texte lecture-texte--prose">
<% it.paragraphs.forEach(p => { %>      <p><%= v.typo(p) %></p>
<% }) %>    </div>
  </div>
<% } %><% if (it.authors.length) { %>  <section class="wrap partie apropos-gens" aria-labelledby="gens-t">
    <div class="partie-tete"><h2 class="titre-2" id="gens-t"><%= t.pages.people %></h2></div>
    <ul class="apropos-liste">
<% it.authors.forEach(a => { %>      <li class="apropos-qui">
        <h3 class="titre-3"><%= a.name %></h3>
<% if (a.bio) { %>        <p><%= v.typo(a.bio) %></p>
<% } %>        <a class="lien" href="<%= it.galleryUrl({ regard: a.slug }) %>#galerie"><%= t.pages.seePhotos(a.name) %><%~ ic('fleche', { size: 18 }) %></a>
      </li>
<% }) %>    </ul>
  </section>
<% } %></main>
<%~ include('./_pied', it) %>
