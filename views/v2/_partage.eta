<% /* Fenêtre « Partager » de la v2 : celle de la v1 (views/_share.eta), le champ du lien nommé (contrôle des formulaires), la
      miniature en loading="lazy" (fenêtre fermée : rien n'est chargé avant l'ouverture). */ %>
<% const sh = it.share, s = sh.s, p = it.photo; %>
<% const ICONS = {
  whatsapp: '<path fill="currentColor" d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.2 21.8l5.1-1.3A9.7 9.7 0 1 0 12 2.2zm0 17.7a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.2.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.8 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.6 4.1 3.7 1.5.7 2.1.7 2.9.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.3z"/>',
  facebook: '<path fill="currentColor" d="M13.4 21v-7.6h2.6l.4-3h-3V8.5c0-.9.2-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.7v3h2.6V21h3.1z"/>',
  bluesky: '<path fill="currentColor" d="M6.3 4.6C8.4 6.2 10.6 9.3 12 11.6c1.4-2.3 3.6-5.4 5.7-7 1.5-1.1 3.9-2 3.9.8 0 .6-.3 4.7-.5 5.4-.7 2.4-3.1 3-5.3 2.6 3.8.7 4.8 2.8 2.7 5-4 4-5.7-1-6.2-2.3l-.3-.7-.3.7c-.5 1.3-2.2 6.3-6.2 2.3-2.1-2.2-1.1-4.3 2.7-5-2.2.4-4.6-.2-5.3-2.6-.2-.7-.5-4.8-.5-5.4 0-2.8 2.4-1.9 3.9-.8z"/>',
  x: '<path fill="currentColor" d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.3L5.6 21H2.6l7.1-8.1L2.2 3h6.2l4.4 5.8L17.8 3zm-1 16.2h1.7L7.3 4.7H5.5l11.3 14.5z"/>',
  pinterest: '<path fill="currentColor" d="M12.3 2.2c-5.4 0-8.1 3.9-8.1 7.1 0 1.9.7 3.7 2.3 4.3.3.1.5 0 .6-.3l.2-.9c.1-.3 0-.4-.2-.7-.5-.6-.8-1.3-.8-2.4 0-3.1 2.3-5.8 6-5.8 3.3 0 5.1 2 5.1 4.7 0 3.5-1.6 6.5-3.9 6.5-1.3 0-2.2-1-1.9-2.3.4-1.5 1.1-3.2 1.1-4.3 0-1-.5-1.8-1.6-1.8-1.3 0-2.3 1.3-2.3 3.1 0 1.1.4 1.9.4 1.9l-1.5 6.5c-.5 1.9-.1 4.3 0 4.5 0 .1.2.2.3.1.1-.2 1.6-2 2.1-3.8l.8-3.2c.4.8 1.6 1.4 2.8 1.4 3.7 0 6.2-3.4 6.2-7.9 0-3.4-2.9-6.6-7.3-6.6z"/>',
  email: '<path d="M3.5 6.5h17v11h-17zM3.5 7l8.5 6 8.5-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/>',
  more: '<circle cx="6" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="18" cy="12" r="1.6" fill="currentColor"/>',
}; const icon = k => `<span class="ic ic-${k}" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24">${ICONS[k]}</svg></span>`; %>
<div class="share-card"><img src="<%= sh.thumb %>"<% if (sh.thumbSet) { %> srcset="<%= sh.thumbSet.srcset %>" sizes="<%= sh.thumbSet.sizes %>"<% } %> alt="" width="92" height="61" loading="lazy" decoding="async"><div><b><%= p.title %></b><small class="mono"><%= p.author %>&nbsp;· <%= sh.host %></small></div></div>
<ul class="share-nets" data-share-nets>
<% /* Réseaux et Instagram : ouverts dans un nouvel onglet, annoncé aux lecteurs d'écran. */ %>
<% sh.links.forEach(l => { %>  <li><a class="net" href="<%= l.href %>"<%~ l.id === 'email' ? '' : ' target="_blank" rel="noopener noreferrer"' %> data-via="<%= l.id %>"><%~ icon(l.id) %><span><%= l.id === 'email' ? s.email : l.label %><% if (l.id !== 'email') { %><span class="sr-only"><%= s.newWindow %></span><% } %></span></a></li>
<% }) %><% if (sh.instagram) { %>  <li><a class="net" href="<%= sh.instagram %>" target="_blank" rel="noopener noreferrer" data-via="instagram"><%~ icon('instagram') %><span><%= s.instagram %><span class="sr-only"><%= s.newWindow %></span></span></a></li>
<% } %>  <li data-share-more-item hidden><button type="button" class="net" data-share-more><%~ icon('more') %><span><%= s.more %></span></button></li>
</ul>
<div class="share-copy"><input readonly name="lien" value="<%= sh.url %>" aria-label="<%= s.link %>" data-share-url><button type="button" class="share-copy-btn" data-share-copy data-copied="<%= s.copied %>" data-js-only hidden><%= s.copyLink %></button></div>
<div class="share-qr"><span class="qr"><%~ sh.qr %></span><p><%= s.qr %></p></div>
