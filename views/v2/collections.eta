<% layout('./layout') %>
<% const x = it.x; %>
<%~ include('./_entete', { ...it, courant: 'expositions', courantSous: true }) %>
<main id="contenu" class="wrap expo">
  <header class="tete-page expo-index-entete"><p class="etiquette"><%= x.permanent %></p><h1 class="titre-page"><%= x.title %></h1><p class="chapo"><%= x.lead %></p></header>
  <div class="expo-actions"><a class="lien" href="<%= it.u('/expositions') %>"><%= x.exhibitions %></a></div>
<% if (!it.list.length) { %>  <p class="expo-note"><%= x.empty %></p>
<% } else { %>  <ol class="expo-index">
<% it.list.forEach((c, i) => { %>    <li><article class="expo-carte" aria-labelledby="collection-<%= c.id %>"><div class="expo-carte-texte"><p class="etiquette"><%= x.permanent %></p><h2 class="titre-2" id="collection-<%= c.id %>"><a href="<%= it.u(`/collection/${c.slug}`) %>"><%= c.title %></a></h2><% if (c.subtitle) { %><p class="expo-carte-intention"><%= c.subtitle %></p><% } %></div>
<% if (c.cover) { %>      <figure class="expo-carte-couverture"><%~ it.picture(c.cover, { sizes: '(min-width: 900px) calc((100vw - 192px) / 2), calc(100vw - 48px)', eager: i === 0, alt: '' }) %></figure>
<% } %>    </article></li>
<% }) %>  </ol>
<% } %>
<% if (it.pages > 1) { %>  <nav class="expo-pagination" aria-label="<%= x.pageLabel %>"><p><%= x.pages(it.page, it.pages) %></p><% if (it.prevHref) { %><a class="lien" href="<%= it.prevHref %>" rel="prev"><%= x.pagePrevious %></a><% } %><% if (it.nextHref) { %><a class="lien" href="<%= it.nextHref %>" rel="next"><%= x.pageNext %></a><% } %></nav>
<% } %>
</main>
<%~ include('./_pied', it) %>
