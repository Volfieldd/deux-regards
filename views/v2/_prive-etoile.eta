<% /* Étoile d'un favori (MQ-17 repère 5) : une bascule POST qui marche sans script et revient à la photo (G48) ; nom lu
      « Favori : titre », aria-pressed ; jamais le cœur de « J'aime ». it.p : la photo ; it.retour : la page d'où l'on vient ;
      it.mot : le mot « Favori » visible (visionneuse). */ %>
<% const P = it.P, p = it.p, on = it.favSet.has(p.item_id);
   const star = '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>'; %>
<form class="<%= it.mot ? 'bascule-form' : 'fav' %>" method="post" action="/prive/<%= it.pid %>/selection/<%= p.n %>"><input type="hidden" name="csrf" value="<%= it.csrf %>"><input type="hidden" name="retour" value="<%= it.retour %>"><button class="bascule" type="submit" aria-pressed="<%= on ? 'true' : 'false' %>"><svg class="ic ic-vide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%~ star %></svg><svg class="ic ic-plein" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false"><%~ star %></svg><% if (it.mot) { %><%= P.fav %><span class="sr-only"><%= it.v2.typo(P.favOf(p.title).slice(P.fav.length)) %></span><% } else { %><span class="sr-only"><%= it.v2.typo(P.favOf(p.title)) %></span><% } %></button></form>
