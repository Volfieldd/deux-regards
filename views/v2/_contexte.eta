<% /* En-tête « Contexte » (MQ-00 § 1, visionneuse) : un retour qui dit où il mène, la marque au centre (dès 560 px), la
      langue et le Menu. it.retour : { href, label, prefix (lu avant le libellé : « Retour au billet : »), lang }. */ %>
<% const t = it.t, ic = it.v2.ic; %>
<header class="sh sh--contexte">
  <div class="sh-bar">
    <a class="sh-retour<%= it.retour.prefix ? ' sh-retour--long' : '' %>" href="<%= it.retour.href %>" data-retour><%~ ic('retour') %><span class="sh-retour-t"><span class="sr-only"><%= it.retour.prefix || t.v2.back %></span><% if (it.retour.lang) { %><span lang="<%= it.retour.lang %>"><%= it.retour.label %></span><% } else { %><%= it.retour.label %><% } %></span></a>
    <a class="sh-marque" href="<%= it.u('/') %>" aria-label="<%= t.v2.homeOf(it.siteName) %>"><%= it.siteName %></a>
    <div class="sh-outils">
<%~ include('./_langue', it) %>
<%~ include('./_menu', it) %>
    </div>
  </div>
</header>
