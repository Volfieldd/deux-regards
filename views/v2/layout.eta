<!doctype html>
<% /* Gabarit commun des pages v2 du site public (server/version-publique.js) : mêmes métadonnées que la v1
      (views/layout.eta), feuilles et script de la v2 seulement. */ %>
<% const theme = it.theme || {}; const brand = it.brand || {};
   const ogImage = it.ogImage ? it.publicUrl + it.ogImage : (brand.share ? `${it.publicUrl}/brand/${brand.share}` : null);
   const lang = it.lang || 'fr'; const t = it.t;
   const title = it.seoTitle || it.pageTitle, description = it.seoDescription ?? it.description; %>
<html lang="<%= lang %>"<% if (theme.classes) { %> class="<%= theme.classes %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="<%= it.bodyClass === 'dark' ? 'dark' : theme.scheme || 'light' %>">
  <title><%= title %></title>
<% if (it.neutral) { /* Galeries privées (G33) : ni description, ni Open Graph, ni canonical, ni hreflang ; jamais indexées. */ %>
  <meta name="robots" content="noindex">
  <meta name="referrer" content="no-referrer">
<% } else { %>
<% if (description) { %>
  <meta name="description" content="<%= description %>">
<% } %>
<% if (it.canonical) { %>
  <link rel="canonical" href="<%= it.publicUrl + it.localize(it.canonical, lang) %>">
  <meta property="og:url" content="<%= it.publicUrl + it.localize(it.canonical, lang) %>">
<% /* it.alternates : les langues où la page existe vraiment (un billet : ses langues publiées, B67) ; sinon les trois. */ (it.alternates || it.langs).forEach(l => { %>
  <link rel="alternate" hreflang="<%= l %>" href="<%= it.publicUrl + it.localize(it.canonical, l) %>">
<% }) %>
  <link rel="alternate" hreflang="x-default" href="<%= it.publicUrl + it.canonical %>">
<% } %>
  <meta property="og:locale" content="<%= it.locales[lang] %>">
<% if (it.seoRobots || it.robots) { %>  <meta name="robots" content="<%= it.seoRobots || it.robots %>">
<% } %>  <meta property="og:type" content="<%= it.ogType || 'website' %>">
<% if (it.article) { /* Billet des Carnets (B66) : dates, auteurs, rubrique. */ %>  <meta property="article:published_time" content="<%= it.article.published %>">
  <meta property="article:modified_time" content="<%= it.article.modified %>">
<% it.article.authors.forEach(a => { %>  <meta property="article:author" content="<%= a %>">
<% }) %>  <meta property="article:tag" content="<%= it.article.tag %>">
<% } %>
  <meta property="og:title" content="<%= title %>">
  <meta property="og:site_name" content="<%= it.siteName %>">
<% if (description) { %>
  <meta property="og:description" content="<%= description %>">
<% } %>
<% if (ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="summary_large_image">
<% } %>
<% } %>
  <link rel="stylesheet" href="<%= it.asset('css/v2/tokens.css') %>">
  <link rel="stylesheet" href="<%= it.asset('css/v2/public.css') %>">
  <link rel="stylesheet" href="<%= it.asset('css/v2/pages.css') %>">
<% if (it.expositionsCss) { %>  <link rel="stylesheet" href="<%= it.asset('css/expositions.css') %>">
<% } %>
<% if (it.carnetCss) { %>  <link rel="stylesheet" href="<%= it.asset('css/v2/carnet.css') %>">
<% } %><% if (it.feed) { /* Flux des Carnets (B58), déclaré sur leurs pages. */ %>  <link rel="alternate" type="application/atom+xml" title="<%= it.feed.title %>" href="<%= it.feed.href %>">
<% } %><% if (it.jsonLd) { /* Bloc de données, non exécuté (CSP : rien à autoriser) ; « < » échappé (B68). */ %>  <script type="application/ld+json"><%~ it.jsonLd %></script>
<% } %>
<% if (it.formulaires || it.prive) { %>  <link rel="stylesheet" href="<%= it.asset('css/v2/formulaires.css') %>">
<% } %><% if (it.prive) { %>  <link rel="stylesheet" href="<%= it.asset('css/v2/prive.css') %>">
<% } %><% if (it.v3) { /* v3 : le dessin de la v3, chargé en dernier (docs/maquettes-v3, server/version-publique.js) */ %>  <link rel="stylesheet" href="<%= it.asset('css/v3/v3.css') %>">
<% } %><% if (it.darkroom) { %>
  <link rel="stylesheet" href="<%= it.asset('css/themes/chambre-noire.css') %>">
  <script src="<%= it.asset('js/chambre-noire.js') %>" defer></script>
<% } %><% if (brand.favicon64) { %>
  <link rel="icon" type="image/png" href="/brand/<%= brand.favicon64 %>">
  <link rel="apple-touch-icon" href="/brand/<%= brand.favicon180 %>">
<% } %>
  <script src="<%= it.asset('js/v2/site.js') %>" defer></script>
</head>
<body class="<%= it.bodyClass || '' %>"<% if (it.darkroom) { %> data-composition="<%= it.darkroom %>" data-section="<%= it.designSection %>"<% } %>>
<a class="skip" href="#contenu"><%= t.v2.skip %></a>
<% if (it.vueSite) { %>
<%~ include('../_vue-site', it.vueSite) %>
<% } %>
<%~ it.body %>
<% if (it.darkroom) { %><div class="wrap room-preferences"><button type="button" class="bascule" data-room-calm hidden aria-pressed="false"><%= ({fr:'Mode calme',en:'Calm mode',de:'Ruhiger Modus'})[lang] || 'Mode calme' %></button></div><% } %>
</body>
</html>
