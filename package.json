{
  "name": "site-photo",
  "version": "0.1.0",
  "private": true,
  "description": "Site photo de Sébastien et Julien : galerie publique et admin OIDC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env server/db/cli.js migrate",
    "seed": "node --env-file-if-exists=.env server/db/cli.js seed",
    "variants": "node --env-file-if-exists=.env server/db/cli.js variants",
    "test": "AVIF_EFFORT=0 node --test \"test/**/*.test.js\"",
    "e2e": "e2e/run.sh",
    "backup": "node --env-file-if-exists=.env server/db/backup.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.4",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "better-sqlite3": "13.0.3",
    "eta": "4.6.0",
    "exif-reader": "2.0.3",
    "fastify": "5.12.5",
    "marked": "18.1.0",
    "openid-client": "6.8.8",
    "qrcode": "1.5.4",
    "sharp": "0.35.5"
  }
}
