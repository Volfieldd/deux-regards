{
  "name": "site-photo",
  "version": "1.193.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Sébastien Wojcicki",
  "description": "Site photo de Sébastien et Julien : galerie publique et admin OIDC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env server/db/cli.js migrate",
    "seed": "node --env-file-if-exists=.env server/db/cli.js seed",
    "variants": "node --env-file-if-exists=.env server/db/cli.js variants",
    "test": "AVIF_EFFORT=0 node --test \"test/**/*.test.js\"",
    "test:vigie": "AVIF_EFFORT=0 TEST_AVEC_VIGIE=1 node --test \"test/**/*.test.js\"",
    "e2e": "e2e/run.sh",
    "backup": "node --env-file-if-exists=.env server/db/backup.js",
    "attaques": "node scripts/attaques/index.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.4",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@huggingface/transformers": "3.7.1",
    "better-sqlite3": "13.0.3",
    "eta": "4.6.0",
    "exif-reader": "2.0.3",
    "fastify": "5.12.5",
    "marked": "18.1.0",
    "nodemailer": "10.0.10",
    "onnxruntime-node": "1.22.0",
    "openid-client": "6.8.8",
    "opentype.js": "1.3.4",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": "$onnxruntime-node",
      "sharp": "$sharp"
    }
  }
}
