# Vigie (facultative) : copier en « vigie.env » à côté de compose.yaml (jamais dans le .env du site, jamais dans le
# dépôt). Les trois clés se génèrent une fois :
#   docker run --rm ghcr.io/volfieldd/deux-regards-vigie:latest node vigie/cli.js cles
# La commande donne aussi les deux lignes à mettre dans le .env du site (même VIGIE_INGEST_KEY, et la clé publique).

# À REMPLIR (sortie de « cles »)
VIGIE_INGEST_KEY=
VIGIE_LOG_KEY=
VIGIE_DECISIONS_PRIVATE_KEY=

# Lecture des événements de Zitadel (facultative) : compte de service « vigie-lecture » (IAM_OWNER_VIEWER), clé JSON
# posée dans VIGIE_SECRETS_DIR/zitadel.json (voir deploy/unraid/vigie-phase-0.md, étape 1.3).
# VIGIE_ZITADEL_ISSUER=https://<instance>.zitadel.cloud

# Conservation des événements (jours, 6 mois par défaut, recommandation de la CNIL)
# VIGIE_RETENTION_DAYS=183
