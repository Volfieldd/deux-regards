# Passerelle Signal de la Vigie : copier en « .env » de cette pile (Docker Compose Manager → Edit Stack → ENV FILE).

# À REMPLIR : dossier des clés du compte Signal, à créer avant (propriétaire 1000:1000, droits 700).
#   mkdir -p /mnt/cache/appdata/nicephos/signal
#   chown 1000:1000 /mnt/cache/appdata/nicephos/signal && chmod 700 /mnt/cache/appdata/nicephos/signal
SIGNAL_DATA_DIR=/mnt/cache/appdata/nicephos/signal

# Les valeurs suivantes ne servent pas à cette pile : notez-les pour le .env de la Vigie (phase B).
# Ne les écrivez jamais dans le dépôt (il est public).
#   VIGIE_SIGNAL_URL=http://nicephos-signal:8080
#   VIGIE_SIGNAL_NUMERO=+33…                 numéro enregistré pour la Vigie
#   VIGIE_SIGNAL_GROUPE=group.…              identifiant du groupe « Vigie Nicephos » (étape 7 du guide)
