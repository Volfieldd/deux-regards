# Nicephos sur Unraid : copier en « .env » de la pile (Docker Compose Manager → Edit Stack → ENV FILE).
# Les lignes « À REMPLIR » sont obligatoires.

# ---------- dossiers (à créer avant, propriétaire 99:100) ----------
# Données : sur le pool cache, chemin DIRECT (/mnt/cache/…, pas /mnt/user/…) : SQLite n'aime pas FUSE.
DATA_DIR=/mnt/cache/appdata/nicephos/data
# Sauvegardes : sur le tableau (autres disques que les données).
BACKUP_DIR=/mnt/user/backups/nicephos
PUID=99
PGID=100
# Port du site sur le réseau local (contrôle uniquement)
LAN_PORT=3080

# ---------- site ----------
SITE_NAME="Nicephos"
# Domaine principal (nicephos.art y est redirigé par Cloudflare, voir README)
PUBLIC_URL=https://nicephos.com
# À REMPLIR : 32+ caractères aléatoires
#   openssl rand -base64 32
COOKIE_SECRET=

# ---------- connexion à l'admin (Zitadel) ----------
# À REMPLIR. Dans Zitadel : redirect URI https://nicephos.com/auth/callback, post-logout https://nicephos.com/
OIDC_ISSUER=https://<instance>.zitadel.cloud
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROJECT_ID=
OIDC_ORG_ID=
OIDC_ADMIN_ROLE=admin

# ---------- tunnel Cloudflare ----------
# À REMPLIR : jeton du tunnel (Zero Trust → Networks → Tunnels → votre tunnel → Configure)
TUNNEL_TOKEN=

# ---------- facultatif ----------
# Sauvegardes : nombre d'instantanés de la base gardés, fréquence en heures
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
# Effort d'encodage AVIF (0 rapide … 9 compact)
# AVIF_EFFORT=4
# Horodatage des preuves (défaut FreeTSA ; « off » pour désactiver)
# TSA_URL=https://freetsa.org/tsr
# Image à utiliser (par défaut la dernière publiée)
# IMAGE=ghcr.io/volfieldd/deux-regards:latest

# JAMAIS en ligne : LOCAL_AUTH_TOKEN (le serveur refuserait de démarrer).
