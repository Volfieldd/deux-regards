# Nicephos sur Unraid : copier en « .env » de la pile (Docker Compose Manager → Edit Stack → ENV FILE).
# Les lignes « À REMPLIR » sont obligatoires.

# ---------- dossiers (à créer avant : README.md, étape 2) ----------
# À REMPLIR. Dossier de Nicephos, sur un pool (chiffré de préférence), chemin DIRECT (/mnt/<pool>/…, jamais
# /mnt/user/… : SQLite n'aime pas FUSE). Il contient data/ (le site), et, s'ils servent, vigie/, vigie-secrets/, signal/.
NICEPHOS_DIR=/mnt/cache/appdata/nicephos
# À REMPLIR. Sauvegardes : sur d'autres disques que les données (le tableau, par exemple). Celles de la Vigie vont à côté,
# dans le même chemin suivi de « -vigie » (ici /mnt/user/backups/nicephos-vigie).
BACKUP_DIR=/mnt/user/backups/nicephos
PUID=99
PGID=100
# Port du site sur le réseau local (contrôle uniquement)
LAN_PORT=3080

# ---------- site ----------
SITE_NAME="Nicephos"
# Adresse publique unique : toutes les autres (nicephos.art, sous-domaines, HTTP) y sont redirigées par Cloudflare (voir README)
PUBLIC_URL=https://www.nicephos.art
# À REMPLIR : 32+ caractères aléatoires
#   openssl rand -base64 32
COOKIE_SECRET=

# ---------- connexion à l'admin (Zitadel) ----------
# À REMPLIR. Dans Zitadel : redirect URI https://www.nicephos.art/auth/callback, post-logout https://www.nicephos.art/
OIDC_ISSUER=https://<instance>.zitadel.cloud
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROJECT_ID=
OIDC_ORG_ID=
OIDC_ADMIN_ROLE=admin

# ---------- tunnel Cloudflare ----------
# À REMPLIR : jeton du tunnel (Zero Trust → Networks → Tunnels → votre tunnel → Configure)
TUNNEL_TOKEN=

# ---------- facultatif ----------
# Sauvegardes : nombre d'instantanés de la base gardés, fréquence en heures (1 à 168)
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
# Jours pendant lesquels un fichier supprimé (original, logo) reste dans la sauvegarde
# BACKUP_DELETED_DAYS=90
# Garde-fou : identifiants « sub » toujours administrateurs (séparés par des virgules ; visibles dans Comptes et rôles)
# ADMIN_SUBS=
# Mémoire du site (défaut 3g). Descriptions « Précis » (page Séries) : 6g. « Léger » tient dans 3g.
# SITE_MEM_LIMIT=3g
# Effort d'encodage AVIF (0 rapide … 9 compact)
# AVIF_EFFORT=4
# Threads de libvips par opération d'image (défaut 4) et photos importées traitées en même temps (défaut 2)
# IMAGE_THREADS=4
# IMPORT_CONCURRENCY=2
# Horodatage des preuves (défaut FreeTSA ; « off » pour désactiver)
# TSA_URL=https://freetsa.org/tsr
# Image à utiliser (par défaut la dernière publiée)
# IMAGE=ghcr.io/volfieldd/deux-regards:latest

# JAMAIS en ligne : LOCAL_AUTH_TOKEN (le serveur refuserait de démarrer).

# ---------- Instagram (facultatif) ----------
# Publication sur un compte Instagram professionnel : voir l'aide de l'admin, « Instagram » (pas à pas).
# INSTAGRAM_APP_ID=           # ID de l'application Instagram (Meta)
# INSTAGRAM_APP_SECRET=       # clé secrète de l'application Instagram
# INSTAGRAM_TOKEN_KEY=        # facultatif : openssl rand -base64 32 (sinon dérivée de COOKIE_SECRET)
# INSTAGRAM_API_VERSION=v23.0

# Propositions de traduction dans l'admin (LibreTranslate de la pile, sur place). Par défaut le conteneur
# « libretranslate » de la pile ; vide pour retirer le bouton « Proposer une traduction ».
# TRANSLATE_URL=http://libretranslate:5000
# TRANSLATE_API_KEY=          # seulement si votre LibreTranslate exige une clé

# Chiffrement des données personnelles dans la base (noms, e-mails, signatures, photos de repère…) : fortement conseillé.
# Générez la clé une fois : openssl rand -base64 32 ; gardez-en une copie dans un gestionnaire de mots de passe :
# perdue, ces données sont illisibles (sauvegardes comprises). Les données existantes sont chiffrées au redémarrage.
# DATA_KEY=

# E-mails envoyés par le site (récapitulatif d'une rencontre saisie sur le téléphone) : facultatif. Par la boîte
# d'une adresse que vous possédez, par exemple Gmail avec un « mot de passe d'application » (Compte Google →
# Sécurité → Validation en deux étapes → Mots de passe des applications). Sans ces deux lignes : bouton « Mail ».
# SMTP_URL=smtps://adresse%40gmail.com:motdepasseapplication@smtp.gmail.com:465
# MAIL_FROM=Nicephos <adresse@gmail.com>

# Vigie (journalisation de sécurité, FACULTATIVE ; docs/etudes/annexe-vigie-architecture.md) : sans ces lignes, le site
# n'envoie ni ne garde rien de plus. Avec elles, il envoie ses événements de sécurité, signés, à la Vigie.
# La clé se génère une fois (openssl rand -base64 32) et se met à l'identique dans le .env de la Vigie.
# VIGIE_URL=http://vigie-reception:4100
# VIGIE_INGEST_KEY=
# VIGIE_DECISIONS_PUBKEY=        # clé publique des décisions (sortie de « node vigie/cli.js cles »)
# VIGIE_APPLIQUER=0               # dernier recours : décisions lues mais jamais appliquées
# VIGIE_CONSOLE_URL=https://vigie.nicephos.art   # lien « Sécurité » de l'admin (par défaut)
# COMPOSE_PROFILES=vigie          # démarre aussi la Vigie et sa sauvegarde (secrets dans vigie.env, voir docs/wiki/Vigie.md)
#                                 # « vigie,signal » : et la passerelle Signal de ses alertes (signal/README.md)
# Dossiers de la Vigie et de Signal : NICEPHOS_DIR/vigie, NICEPHOS_DIR/vigie-secrets, NICEPHOS_DIR/signal et
# BACKUP_DIR-vigie. À ne renseigner que pour forcer un autre chemin (de même DATA_DIR pour NICEPHOS_DIR/data) :
# VIGIE_DATA_DIR=
# VIGIE_SECRETS_DIR=
# VIGIE_BACKUP_DIR=
# SIGNAL_DATA_DIR=

# ---------- réseau (rarement à changer) ----------
# Sous-réseau Docker de la pile et adresse fixe du tunnel : le site ne croit X-Forwarded-For que venant de lui.
# Les autres conteneurs prennent leur adresse dans NET_IP_RANGE, que TUNNEL_IP ne doit jamais toucher.
# À changer seulement si ce sous-réseau est déjà pris sur votre Unraid (alors les trois ensemble).
# NET_SUBNET=172.29.42.0/24
# NET_IP_RANGE=172.29.42.128/25
# TUNNEL_IP=172.29.42.10
