# Image de la Vigie (composant de sécurité facultatif, docs/wiki/Vigie.md) : petite, sans traitement d'image ni
# modèles d'analyse (surface réduite). Les données (base de la Vigie) ne sont JAMAIS dans l'image : /data est un dossier
# de l'hôte, à part de celui du site.
# 1. Dépendances (better-sqlite3 se compile : outillage dans cette étape seulement).
FROM node:22-bookworm-slim AS deps
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app/vigie
COPY vigie/package.json vigie/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force \
 && node --input-type=module -e "await import('better-sqlite3'); await import('fastify'); await import('openid-client'); await import('eta')"

# 2. Image finale, sans compilateur.
FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    VIGIE_DATA_DIR=/data \
    VIGIE_INGEST_PORT=4100
WORKDIR /app
# Le vocabulaire des événements et le calcul des réseaux (/24, /48) sont communs au site et à la Vigie : seuls ces deux
# fichiers du site sont repris.
RUN echo '{ "private": true, "license": "UNLICENSED", "type": "module" }' > package.json
COPY LICENSE ./
COPY --from=deps /app/vigie/node_modules ./vigie/node_modules
COPY vigie ./vigie
COPY server/securite/vocabulaire.js ./server/securite/vocabulaire.js
COPY server/securite/adresses-ip.js ./server/securite/adresses-ip.js
USER node
EXPOSE 4100 4200
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const h=process.env.VIGIE_HOST&&process.env.VIGIE_HOST!=='0.0.0.0'?process.env.VIGIE_HOST:'127.0.0.1';fetch('http://'+h+':'+(process.env.VIGIE_INGEST_PORT||4100)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "vigie/index.js"]
