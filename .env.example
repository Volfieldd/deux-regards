# Copier en .env et compléter.

# Nom affiché du site (provisoire, à changer ici uniquement)
SITE_NAME="Deux Regards"

HOST=127.0.0.1
PORT=3000
# URL publique, utilisée pour les redirections OIDC
PUBLIC_URL=http://localhost:3000
# Proxys de confiance pour X-Forwarded-* (en ligne, par défaut : loopback,uniquelocal = Caddy)
# TRUST_PROXY=

# Données : base SQLite et dossier des images (originaux + variantes)
DATABASE_PATH=./storage/site.db
STORAGE_DIR=./storage

# Secret de signature des cookies (32+ caractères aléatoires), obligatoire dès que
# PUBLIC_URL est en HTTPS ou NODE_ENV=production
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=

# OIDC (Zitadel Cloud)
OIDC_ISSUER=https://<instance>.zitadel.cloud
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Par défaut PUBLIC_URL + /auth/callback ; à déclarer tel quel dans Zitadel
OIDC_REDIRECT_URI=
OIDC_PROJECT_ID=
# ID de l'organisation Zitadel du projet : un rôle donné dans une autre organisation est ignoré
OIDC_ORG_ID=
OIDC_ADMIN_ROLE=admin
# Repli (Google en direct) : liste de sub autorisés, séparés par des virgules
OIDC_ALLOWED_SUBS=
