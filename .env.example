# Copier en .env et compléter.

# Nom affiché du site (aussi réglable dans l’admin, Réglages)
SITE_NAME="Nicephos"

HOST=127.0.0.1
PORT=3000
# URL publique, utilisée pour les redirections OIDC
PUBLIC_URL=http://localhost:3000
# Proxys de confiance pour X-Forwarded-* (en ligne, par défaut : loopback,uniquelocal = le conteneur cloudflared du même réseau Docker)
# TRUST_PROXY=

# Données : base SQLite et dossier des images (originaux + variantes)
DATABASE_PATH=./storage/site.db
STORAGE_DIR=./storage

# Secret de signature des cookies (32+ caractères aléatoires), obligatoire dès que
# PUBLIC_URL est en HTTPS ou NODE_ENV=production
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=

# OIDC (Zitadel Cloud)
OIDC_ISSUER=https://<instance>.zitadel.cloud
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Par défaut PUBLIC_URL + /auth/callback ; à déclarer tel quel dans Zitadel
OIDC_REDIRECT_URI=
OIDC_PROJECT_ID=
# ID de l'organisation Zitadel du projet : un rôle donné dans une autre organisation est ignoré
OIDC_ORG_ID=
OIDC_ADMIN_ROLE=admin
# Repli (Google en direct) : liste de sub autorisés, séparés par des virgules
OIDC_ALLOWED_SUBS=

# Connexion locale de TEST (sans IdP), avec ce jeton (16+ caractères). Refusée par le serveur
# dès que PUBLIC_URL est en HTTPS ou NODE_ENV=production. Ne jamais définir en ligne.
# LOCAL_AUTH_TOKEN=

# Tentatives de connexion autorisées par IP sur 10 minutes (défaut 30)
# AUTH_RATE_LIMIT=

# Effort d'encodage AVIF des variantes, de 0 (rapide) à 9 (plus compact). Défaut 4.
# AVIF_EFFORT=
# Threads de libvips par opération d'image (défaut 4, ou moins si la machine a moins de cœurs)
# IMAGE_THREADS=
# Photos importées traitées en même temps (défaut 2)
# IMPORT_CONCURRENCY=

# Preuve d'antériorité : autorité d'horodatage RFC 3161 (défaut FreeTSA ; « off » pour désactiver)
# TSA_URL=https://freetsa.org/tsr
# Certificat racine (PEM) de l'autorité ; fourni pour FreeTSA (assets/tsa/)
# TSA_CA_FILE=

# --- Docker Compose (voir docs/wiki/Déploiement.md) ---
# DATA_DIR=/srv/site-photo/data             # dossier des données sur l'hôte (obligatoire)
# BACKUP_DIR=/srv/site-photo/sauvegardes    # dossier des sauvegardes (obligatoire, hors DATA_DIR)
# APP_UID=1000
# APP_GID=1000
# BIND_ADDR=127.0.0.1
# HOST_PORT=3000
# TUNNEL_TOKEN=                             # Cloudflare Tunnel (profil « tunnel »)
# BACKUP_KEEP=14                            # instantanés de base gardés (lu aussi par npm run backup)
# BACKUP_INTERVAL_HOURS=24                  # intervalle de npm run backup -- --loop
# REQUIRE_PERSISTENT_STORAGE=1              # refuse de démarrer si STORAGE_DIR n'est pas un montage (vaut 1 dans l'image Docker)

# ---------- Instagram (facultatif) ----------
# Publication sur un compte Instagram professionnel : voir l'aide de l'admin, « Instagram » (pas à pas).
# INSTAGRAM_APP_ID=           # ID de l'application Instagram (Meta)
# INSTAGRAM_APP_SECRET=       # clé secrète de l'application Instagram
# INSTAGRAM_TOKEN_KEY=        # facultatif : openssl rand -base64 32 (sinon dérivée de COOKIE_SECRET)
# INSTAGRAM_API_VERSION=v23.0

# Propositions de traduction dans l'admin : serveur LibreTranslate du réseau local (profil « traduction »).
# TRANSLATE_URL=http://libretranslate:5000
# TRANSLATE_API_KEY=          # seulement si votre LibreTranslate exige une clé
