<%
/* MV-13, première livraison : l'explication du moteur et les équivalents textuels des dessins. */
const v = it.vue;
layout('./layout', { titre: it.titre });
%>
<header class="ep ds-entete"><a class="ep-retour" href="/dossiers">Dossiers</a><div class="ep-titre"><h1><%= v.titre %></h1><span class="ep-pastilles"><%~ include('./_grav', { gravClasse: v.grav.classe, gravMot: v.grav.mot }) %><%~ include('./_etat', { etatK: v.etat, etatMot: v.statut }) %></span></div><p class="ep-meta"><span>Dossier #<%= v.id %> · piste <%= v.piste %></span><span>ouvert le <%= v.ouvert %></span><span>dernier signe le <%= v.derniere %></span></p></header>
<% if (v.fusion) { %><p class="note-a">Ce dossier a été fusionné dans <a class="vg-lien" href="/dossiers/<%= v.fusion %>">le dossier #<%= v.fusion %></a>, qui porte la suite de l’enquête.</p><% } %>
<% if (v.lecteur) { %><p class="note-a"><b>Lecture seule : vous lisez le dossier, vous n’y agissez pas.</b> Les adresses sont tronquées (/24, /48).</p><% } %>
<% if (v.tronque) { %><p class="note-a">Dossier tronqué : un plafond du moteur a été atteint. Les événements du journal peuvent compléter les signaux conservés ici.</p><% } %>
<% if (v.recidive || v.classement || v.par || v.note) { %><p class="note-a"><% if (v.recidive) { %>Récidive. <% } %><%= v.classement %><% if (v.par) { %> · par <%= v.par %><% } %><% if (v.note) { %> · <%= v.note %><% } %></p><% } %>
<div class="ds-expl"><% for (const [i, s] of v.lignes.entries()) { %><p class="l<%= i + 1 %>"><%= s %></p><% } %><% if (v.modifs.length) { %><ul class="ds-modifs" aria-label="Modificateurs de la gravité"><% for (const m of v.modifs) { %><li><%= m %></li><% } %></ul><% } %><% if (v.non.length) { %><p class="ds-ou">Où chercher : <%= v.non.join(', ') %> non observé. L’absence de signal ne prouve pas l’absence d’action.</p><% } %></div>
<% if (v.agir) { %><div class="btns-ligne ds-gestes"><% if (!v.clos) { %><a class="btn" href="/dossiers/<%= v.id %>/prendre">Prendre en charge</a><a class="btn ghost" href="/dossiers/<%= v.id %>/classer">Classer…</a><% } %><a class="btn ghost" href="/dossiers/<%= v.id %>/rattacher">Rattacher une entité…</a><a class="btn ghost" href="/dossiers/<%= v.id %>/fusionner">Fusionner avec un autre dossier…</a><% if (!v.clos) { %><a class="btn ghost" href="/dossiers/<%= v.id %>/scinder">Scinder…</a><% } %></div><% } %>
<ul class="ds-nav" aria-label="Parties du dossier"><% for (const [id, mot] of [['entites','Entités'],['signaux','Signaux et faits'],['alertes','Alertes'],['reponses','Réponses'],['journal','Journal du dossier']]) { %><li><a href="#<%= id %>"><%= mot %></a></li><% } %></ul>
<section class="ds-section" id="entites"><h2 class="vg-section-t">Entités</h2><% if (v.entitesVue.length) { %><div class="tablewrap"><table class="liste-a vg-ds-t"><caption>Acteurs, cibles et contexte du dossier</caption><thead><tr><th scope="col">Rôle</th><th scope="col">Entité</th><th scope="col">Lien</th><th scope="col">Entrée par</th><th scope="col">Depuis</th><th scope="col">Geste</th></tr></thead><tbody>
<% for (const e of v.entitesVue) { %><tr><td data-label="Rôle"><%= e.role %></td><th scope="row"><%= e.type %> <span class="sub"><%= e.texte %></span><% if (e.detache) { %><span class="sec">Détachée</span><% } %></th><td data-label="Lien"><%= e.force %></td><td data-label="Entrée par"><%= e.via || '—' %></td><td data-label="Depuis"><%= e.depuis %></td><td data-label="Geste"><% if (e.href) { %><a class="vg-lien" href="<%= e.href %>">Fiche de <%= e.texte %></a><% } %><% if (v.agir && !e.detache) { %> <a class="vg-lien" href="/dossiers/<%= v.id %>/detacher?entite=<%= encodeURIComponent(e.cle) %>">Détacher <%= e.texte %>…</a><% } %></td></tr><% } %>
</tbody></table></div><% } else { %><p>Aucune entité rattachée.</p><% } %><% if (v.entitesCoupees) { %><p class="note-a">Les 200 premières entités sont affichées.</p><% } %></section>
<section class="ds-section" id="signaux"><h2 class="vg-section-t">Signaux et faits</h2><p>Les 40 plus récents par page, à l’heure de la source. Les faits devenus jalons restent nommés comme tels.</p><% if (v.avantInvalide) { %><p class="note-a">Position ignorée : sa valeur n’est pas reconnue.</p><% } %><% if (v.signaux.length) { %><div class="tablewrap"><table class="liste-a vg-ds-t"><caption>Signaux conservés dans le dossier</caption><thead><tr><th scope="col">Heure</th><th scope="col">Phase et nature</th><th scope="col">Signal</th><th scope="col">Entités et objets</th><th scope="col">Alerte</th></tr></thead><tbody>
<% for (const s of v.signaux) { %><tr id="signal-<%= s.id %>"><td data-label="Heure"><%= s.heure %></td><td data-label="Phase et nature"><%= s.phase %><span class="sec"><%= s.nature %><% if (s.marqueurs) { %> · <%= s.marqueurs %><% } %></span></td><th scope="row"><% if (s.evenement) { %><a class="vg-lien" href="<%= s.evenement %>"><%= s.titre %></a><% } else { %><%= s.titre %><span class="sec">Événement source absent du journal</span><% } %><span class="sec sub"><%= s.regle %> · <%= s.cas %><% if (s.techniques.length) { %> · <%= s.techniques.join(', ') %><% } %></span></th><td data-label="Entités et objets"><span class="sub"><%= s.entite || '—' %></span></td><td data-label="Alerte"><% if (s.alerte) { %><a class="vg-lien" href="/alertes/<%= s.alerte %>">Alerte #<%= s.alerte %></a><% } else { %>—<% } %></td></tr><% } %>
</tbody></table></div><% } %><% if (!v.signaux.length) { %><p>Aucun signal à cette position.</p><% } %><div class="pied-liste"><% if (v.debut) { %><a class="btn ghost" href="<%= v.debut %>">Les plus récents</a><% } %><% if (v.suivante) { %><a class="btn ghost" href="<%= v.suivante %>">Signaux plus anciens</a><% } %></div></section>
<section class="ds-section" id="alertes"><h2 class="vg-section-t">Alertes</h2><ul class="ds-liste"><% for (const a of v.alertesVue) { %><li><a class="vg-lien" href="/alertes/<%= a.id %>">Alerte #<%= a.id %> · <%= a.titre %></a> · <%= a.grav.mot %> · <%= a.statut %> · <%= a.mode %></li><% } %></ul><% if (!v.alertesVue.length) { %><p>Aucune alerte rattachée.</p><% } %><% if (v.alertesCoupees) { %><p>Les 200 premières alertes sont affichées.</p><% } %><p class="hint">Les décisions sur une cible se prennent depuis sa fiche ou celle de son alerte.</p></section>
<section class="ds-section" id="reponses"><h2 class="vg-section-t">Réponses déjà faites</h2><p>Aucune réponse automatique au niveau du dossier pendant le mois d’observation.</p><ul class="ds-liste"><% for (const r of v.reponses) { %><li><b><%= r.type %></b> · <span class="sub"><%= r.cible %></span><span class="sec">Décision #<%= r.id %> · <%= r.date %> · <%= r.fin %> · <%= r.motif %> · <a class="vg-lien" href="/alertes/<%= r.alerte %>">Alerte #<%= r.alerte %></a></span></li><% } %></ul><% if (!v.reponses.length) { %><p>Aucune réponse rattachée aux alertes de ce dossier.</p><% } %><% if (v.reponsesCoupees) { %><p>Les 50 dernières réponses sont affichées ; les fiches des alertes donnent la suite.</p><% } %></section>
<section class="ds-section" id="journal"><h2 class="vg-section-t">Journal du dossier</h2><ol class="ds-liste"><% for (const h of v.journal) { %><li><a class="vg-lien" href="<%= h.href %>"><%= h.action %> · <%= h.heure %></a><span class="sec"><%= h.par %><% if (h.detail) { %> · <%= h.detail %><% } %></span></li><% } %></ol><% if (!v.journal.length) { %><p>Aucun geste encore conservé au journal.</p><% } %><% if (v.journalCoupe) { %><p>Les 50 derniers gestes sont affichés.</p><% } %></section>
