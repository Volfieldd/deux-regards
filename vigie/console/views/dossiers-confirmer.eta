<%
/* Confirmation des gestes : GET ne change aucun dossier. La scission présente d'abord sa répartition, puis demande
   un second POST avec la même sélection et une empreinte du dossier. Aucun script n'est nécessaire. */
const v = it.vue, b = v.valeurs || {}, a = v.apercu;
const choisis = k => Array.isArray(b[k]) ? b[k] : b[k] ? [b[k]] : [];
layout('./layout', { titre: it.titre });
%>
<header class="ep"><a class="ep-retour" href="<%= v.retour %>">Revenir au dossier #<%= v.id %></a><div class="ep-titre"><h1><%= v.titre %></h1></div><p class="ep-meta">Rien n’est encore enregistré.</p></header>
<% if (v.erreur) { %><p class="err" id="erreur" role="alert"><b>Non fait :</b> <%= v.erreur.texte %></p><% } %>
<form class="panel form ds-form" method="post" action="/dossiers/<%= v.id %>/<%= v.geste %>"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="revision" value="<%= v.revision %>">
<% if (v.geste === 'prendre') { %><p>Vous prenez en charge le dossier #<%= v.id %>. Votre nom et l’heure seront inscrits au journal ; les alertes gardent leur statut.</p><% } %>
<% if (v.geste === 'classer') { %>
<fieldset class="choix-a"><legend>Classement</legend><% for (const [k, mot] of Object.entries(v.classements)) { %><label><input type="radio" name="classement" value="<%= k %>" required<% if (k === 'legitime' && v.apprentissageTronque) { %> disabled<% } %><% if (b.classement === k) { %> checked<% } %>><span><%= mot %></span><% if (k === 'legitime') { %><span class="sec">Les indices identiques ne compteront plus pendant 90 jours ; une preuve ne s’apprend jamais.</span><% } %></label><% } %></fieldset>
<div class="champ-a"><label for="note">Motif <span class="facultatif">(obligatoire pour « Légitime »)</span></label><textarea id="note" name="note" maxlength="500" rows="3" aria-describedby="apprentissage<%= v.erreur ? ' erreur' : '' %>"><%= b.note || '' %></textarea></div>
<div id="apprentissage"><p>Avec « Légitime », ces indices ne compteront plus pendant 90 jours :</p><% if (v.apprentissageTronque) { %><p>Plus de 200 indices : le classement « Légitime » exige un examen en ligne de commande. Ce formulaire ne peut pas tous les présenter.</p><% } else if (v.appris.length) { %><ul><% for (const s of v.appris) { %><li class="sub"><%= s %></li><% } %></ul><% } else { %><p>Aucun indice à apprendre dans ce dossier. Les preuves restent prises en compte.</p><% } %></div>
<% } %>
<% if (v.geste === 'detacher') { %><div class="champ-a"><label for="entite">Entité à détacher</label><select id="entite" name="entite" required><option value="">Choisir…</option><% for (const e of v.entites) { %><option value="<%= e.cle %>"<% if (b.entite === e.cle) { %> selected<% } %>><%= e.type %> · <%= e.texte %></option><% } %></select></div><p>Elle ne reviendra pas automatiquement dans ce dossier. Les signaux déjà rattachés restent ; le dossier est recalculé. Un rattachement manuel permet de la rétablir.</p><% } %>
<% if (v.geste === 'rattacher') { %><div class="champ-a"><label for="type">Type</label><select id="type" name="type"><% for (const [k, mot] of Object.entries(v.types)) { %><option value="<%= k %>"<% if (b.type === k) { %> selected<% } %>><%= mot %></option><% } %></select></div><div class="champ-a"><label for="cle">Clé</label><input id="cle" name="cle" class="sub" value="<%= b.cle || '' %>" maxlength="200" required autocomplete="off" spellcheck="false" aria-describedby="r-aide"><p class="aide" id="r-aide">L’entité entre par un lien manuel. Le moteur recherche ses signaux antérieurs dans les fenêtres du dossier (24 heures, 7 jours pour le repérage). Exemple : acces:41 pour un accès de galerie.</p></div><% } %>
<% if (v.geste === 'fusionner') { %><div class="champ-a"><label for="autre">Autre dossier</label><select id="autre" name="autre" required><option value="">Choisir…</option><% for (const d of v.autres) { %><option value="<%= d.id %>"<% if (String(b.autre) === String(d.id)) { %> selected<% } %>>#<%= d.id %> · <%= d.titre %></option><% } %></select></div><p>Les entités, signaux et alertes seront réunis. Le plus ancien numéro sera conservé, y compris s’il appartient à l’autre dossier ; celui absorbé renverra vers lui. Les alertes gardent leur gravité.</p><p class="aide">Les 100 dossiers les plus récents sont proposés.</p><% } %>
<% if (v.geste === 'scinder') { %>
<% if (a) { %><h2>Répartition à confirmer</h2><p>Le nouveau dossier recevra <%= a.entites %> entités et <%= a.signaux %> signaux. Le dossier #<%= v.id %> conservera <%= a.restantes %> entités et <%= a.restants %> signaux.</p><p>Alertes transférées : <%= a.alertes.map(n => '#' + n).join(', ') || 'aucune' %>. Leur statut, leurs notifications et leurs décisions ne changent pas.</p><p>Motif : <%= b.motif %></p><input type="hidden" name="confirme" value="oui"><% for (const k of ['entites','signaux']) { for (const val of choisis(k)) { %><input type="hidden" name="<%= k %>" value="<%= val %>"><% } } %><input type="hidden" name="motif" value="<%= b.motif %>">
<% } else { %>
<p>Choisissez les entités et les signaux à déplacer. Chaque dossier doit garder au moins une entité et un signal ; les signaux d’une même alerte restent ensemble. Les événements du journal restent intacts.</p>
<fieldset class="choix-a"><legend>Entités à déplacer</legend><% for (const e of v.entites) { %><label><input type="checkbox" name="entites" value="<%= e.cle %>"<% if (choisis('entites').includes(e.cle)) { %> checked<% } %>><span class="sub"><%= e.type %> · <%= e.texte %></span></label><% } %></fieldset>
<fieldset class="choix-a"><legend>Signaux à déplacer</legend><% for (const s of v.signaux) { %><label><input type="checkbox" name="signaux" value="<%= s.id %>"<% if (choisis('signaux').includes(String(s.id))) { %> checked<% } %>><span>#<%= s.id %> · <%= s.heure %> · <%= s.titre %></span><span class="sec"><%= s.nature %> · <%= s.entite %><% if (s.alerte) { %> · alerte #<%= s.alerte %><% } %></span></label><% } %></fieldset>
<% if (v.trop) { %><p class="note-a">La scission dépasse les 2 000 signaux que ce formulaire peut présenter. Utilisez la ligne de commande avec une sélection explicite.</p><% } %>
<% } %><p>La séparation sera conservée : les signaux déjà répartis ne reviendront pas par le rattachement rétroactif. Si un nouveau signal rejoint les deux dossiers, le compte, la session ou l’accès prime sur l’adresse ; à égalité, le dossier le plus ancien le reçoit. Une fusion manuelle permet de les réunir.</p>
<% } %>
<% if (['detacher','scinder'].includes(v.geste) && !a) { %><div class="champ-a"><label for="motif">Motif obligatoire</label><textarea id="motif" name="motif" maxlength="300" rows="3" required<% if (v.erreur) { %> aria-describedby="erreur"<% } %>><%= b.motif || '' %></textarea></div><% } %>
<div class="btns-ligne"><button class="btn" type="submit"<% if (v.geste === 'scinder' && v.trop) { %> disabled<% } %>><%= v.geste === 'scinder' ? (a ? 'Confirmer la scission' : 'Voir la répartition avant de scinder') : v.geste === 'classer' ? 'Classer et clore le dossier' : v.geste === 'prendre' ? 'Prendre en charge le dossier' : v.geste === 'detacher' ? 'Détacher l’entité' : v.geste === 'rattacher' ? 'Rattacher l’entité' : 'Confirmer la fusion' %></button><a class="btn ghost" href="<%= v.retour %>">Annuler</a></div>
</form>
