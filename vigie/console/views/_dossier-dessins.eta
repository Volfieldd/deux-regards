<% /* Dessins serveur de MV-13 ; seules les sorties échappées de dossiers-dessins.js entrent en sortie brute. */
const x = it.vue.dessins; %>
<% if (x.filtres.ignores.length) { %><p class="note-a">Paramètres ignorés : <%= x.filtres.ignores.join(', ') %>.</p><% } %>
<% if (x.coupe) { %><p class="note-a">Les dessins et leur matrice portent sur les <%= x.maximum %> derniers signaux. Le tableau paginé donne aussi les plus anciens.</p><% } %>
<% if (x.filtres.technique) { %><p class="note-a">Frise et signaux filtrés sur <b><%= x.filtres.technique %> · <%= x.techniqueNom %></b>. <a class="vg-lien" href="<%= x.toutesTechniques %>">Toutes les techniques du dossier</a></p><% } %>
<section class="panel ds-section" id="frise" aria-labelledby="t-frise"><h2 class="panel-t" id="t-frise">Frise</h2>
<p class="sec">Heure de la source, du <%= x.debut %> au <%= x.fin %>. La fenêtre se termine au dernier signal du dossier.</p>
<div class="ds-frise">
<% if (x.frise) { %><figure class="ds-dessin"><div class="ds-std"><%~ x.frise.std %></div><div class="ds-large"><%~ x.frise.large %></div><figcaption>
<ul class="ds-leg" aria-label="Lire la frise"><% for (const [c, mot] of [['jalon','jalon : une phase a eu lieu'],['preuve','preuve : accès hostile'],['indice','indice : accès douteux'],['fait','fait ordinaire'],['marqueur','marqueur : dissimulation ou disponibilité'],['chaine','suite dans l’ordre']]) { %><li><span class="ds-sym <%= c %>" aria-hidden="true"></span><%= mot %></li><% } %></ul>
<p class="sec">Un signal peut porter une phase et un marqueur. Les repères regroupés portent leur nombre ; chaque lien ouvre le premier signal du groupe dans le tableau. La gravité est aussi écrite dans ce tableau.</p></figcaption></figure><% } else { %><p>Aucun signal à dessiner dans cette fenêtre avec ces filtres.</p><% } %>
<div class="ds-tel"><% for (const b of x.blocs) { if (b.items.length || b.non) { %><section class="ds-ph<%= b.non && !b.items.length ? ' non' : '' %>"><h3><%= b.nom %><span class="sec"><%= b.items.length ? b.items.length + ' repère(s)' : 'non observé dans le dossier' %></span></h3><% if (b.items.length) { %><ol><% for (const p of b.items) { %><li><span class="ds-sym <%= p.forme === 'promu' ? 'jalon' : p.forme %>" aria-hidden="true"></span><span><b><%= p.vue.heure %></b> · <a class="vg-lien" href="<%= p.href %>"><%= p.vue.titre %></a> · <%= p.vue.nature %></span></li><% } %></ol><% } %></section><% } } %></div>
</div><nav class="ds-zoom" aria-label="Zoom de la frise">Zoom : <% for (const z of x.zooms) { %><a class="vg-lien" href="<%= z.href %>"<% if (z.courant) { %> aria-current="true"<% } %>><%= z.mot %></a> <% } %></nav>
<p><%= x.horsFenetre %> signal(s) hors de cette fenêtre. Faits ordinaires dans la fenêtre : <%= x.faits %>. <a class="vg-lien" href="<%= x.lienFaits %>"><%= x.filtres.faits ? 'Replier les faits dans la frise' : 'Afficher les faits dans la frise' %></a></p>
</section>
<section class="ds-section" id="attack" aria-labelledby="t-attack"><h2 class="vg-section-t" id="t-attack">Matrice ATT&amp;CK du dossier</h2>
<p>Les 15 tactiques d’ATT&amp;CK <%= x.version %>, dans l’ordre de MITRE. Le numéro dit l’ordre de première apparition de la technique ; sa phase est propre au dossier. La matrice porte sur tout le dossier, indépendamment du zoom.</p>
<div class="ds-matrice"><div class="ds-dessin"><div class="ds-std"><%~ x.matrice.std %></div><div class="ds-large"><%~ x.matrice.large %></div></div>
<div class="ds-tel"><ul class="ak-matrice"><% for (const c of x.cartes.filter(c => c.hors || c.items.length || c.sans)) { %><li class="ak-tac"><h3><%= c.nom_fr %><span class="sec"><%= c.id %> · <%= c.nom %></span></h3><% if (c.hors) { %><p>Non observable ici : la préparation de l’attaquant se fait hors du site.</p><% } %><ul class="ak-tq"><% for (const z of c.items) { %><li><a class="vg-lien" href="<%= z.href %>"><%= z.ordre %>. <%= z.id %> · <%= z.nom %></a><span class="ak-ph"><%= z.n %> signal(s) · <%= z.phase %></span></li><% } %></ul><% if (c.sans) { %><p><%= c.sans %> signal(s) sans technique de cette tactique.</p><% } %></li><% } %></ul>
<details class="ak-sans"><summary>Tactiques sans signal</summary><ul><% for (const c of x.cartes.filter(c => !c.hors && !c.items.length && !c.sans)) { %><li><%= c.nom_fr %> · <%= c.id %></li><% } %></ul></details></div></div>
<% if (x.total) { %><details class="plier ds-table"><summary>Matrice en tableau</summary><div class="tablewrap"><table class="liste-a vg-ds-t"><caption>ATT&amp;CK : tactiques, techniques, ordre, signaux et phases</caption><thead><tr><th scope="col">Tactique</th><th scope="col">Technique</th><th scope="col">Ordre</th><th scope="col">Signaux</th><th scope="col">Phase du dossier</th></tr></thead><tbody>
<% for (const c of x.cartes) { for (const z of c.items) { %><tr><th scope="row"><%= c.nom_fr %> · <%= c.id %></th><td data-label="Technique"><a class="vg-lien" href="<%= z.href %>"><%= z.id %> · <%= z.nom %></a><span class="sec"><%= z.anglais %></span></td><td data-label="Ordre"><%= z.ordre %></td><td data-label="Signaux"><%= z.n %></td><td data-label="Phase"><%= z.phase %></td></tr><% } if (!c.items.length || c.sans) { %><tr><th scope="row"><%= c.nom_fr %> · <%= c.id %></th><td data-label="Technique"><%= c.hors ? 'Non observable ici' : c.sans ? 'Sans technique de cette tactique' : 'Aucun signal' %></td><td data-label="Ordre">—</td><td data-label="Signaux"><%= c.sans %></td><td data-label="Phase">—</td></tr><% } } %>
</tbody></table></div></details><% } %></section>
