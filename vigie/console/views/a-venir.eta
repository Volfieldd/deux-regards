<%
/* Écran pas encore codé (phases D3b et D3c) : une page en session, sobre, avec un chemin de retour. */
const NOMS = { vue: 'Vue d’ensemble', alertes: 'Alertes', evenements: 'Événements', entites: 'Entités', sante: 'Santé', flux: 'Flux',
  decisions: 'Décisions', reglages: 'Règles et réglages', droits: 'Droits' };
const nom = NOMS[it.page] || it.titre || 'Cet écran';
layout('./layout', { titre: it.titre && it.titre !== 'Vigie' ? it.titre : nom });
%>
<header class="ep">
  <div class="ep-titre"><h1><%= nom %></h1></div>
</header>
<div class="vg-vide">
<p class="t">Cet écran arrive bientôt.</p>
<p>La console s’ouvre écran par écran ; celui-ci n’est pas encore en service. En attendant, la ligne de commande de la Vigie, sur le serveur, fait tout ce que fera la console.</p>
<ul>
<li><a class="vg-lien" href="/">Revenir à la vue d’ensemble</a></li>
</ul>
</div>
