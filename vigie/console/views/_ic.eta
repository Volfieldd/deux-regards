const classe = it.icClasse ? ' ' + String(it.icClasse).replace(/[^a-z0-9 -]/g, '') : '';
%><svg class="ic<%= classe %>" width="<%= taille %>" height="<%= taille %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%~ P[it.icone] || '' %></svg>