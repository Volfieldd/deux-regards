<%
/* Icônes des écrans Santé et Flux qui ne sont pas dans _ic (dessins des maquettes, dr-tmp/vigie-mq/commun.py, P) ; les
   autres passent à _ic. include('./_flux-ic', { icone, taille }). Les tracés sont des constantes : rien de la requête n'y entre. */
const P = {
  chaine: '<path d="M10 14.5l-2.2 2.2a3.3 3.3 0 0 1-4.6-4.6L5.5 9.8M14 9.5l2.2-2.2a3.3 3.3 0 0 1 4.6 4.6L18.5 14.2"/><path d="M8.5 3.5l1 2.2M15.5 20.5l-1-2.2M3.5 8.5l2.2 1M20.5 15.5l-2.2-1"/>',
  liste: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2"/>',
  base: '<ellipse cx="12" cy="6" rx="7.5" ry="2.8"/><path d="M4.5 6v12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V6M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8"/>',
  'nuage-barre': '<path d="M7 18.5h10a4 4 0 0 0 .6-8 6 6 0 0 0-11.6 1.6A3.4 3.4 0 0 0 7 18.5z"/><path d="M4 4l16 16"/>',
  chevron: '<path d="M9 6l6 6-6 6"/>',
  'reseau-barre': '<rect x="3" y="3.5" width="7" height="5" rx="1"/><rect x="14" y="3.5" width="7" height="5" rx="1"/><rect x="8.5" y="15.5" width="7" height="5" rx="1"/><path d="M6.5 8.5v3h11v-3M12 11.5v4"/><path d="M4 4l16 16"/>',
  erreur: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5h.01"/>',
};
const taille = Number(it.taille) || 18;
if (Object.hasOwn(P, it.icone)) { %><svg class="ic" width="<%= taille %>" height="<%= taille %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%~ P[it.icone] %></svg><% } else { %><%~ include('./_ic', { icone: it.icone, taille }) %><% } %>
