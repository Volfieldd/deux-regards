<%
/* Icônes propres aux formulaires de décision (dessins des maquettes MV-02, MV-04, MV-05) : include('./_dec-ic', { icone, taille }).
   Les tracés sont des constantes de ce gabarit : rien de la requête n'y entre. */
const P = {
  erreur: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5h.01"/>',
  bouclier: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.1-7.5 9.5-4.3-1.4-7.5-4.9-7.5-9.5V6z"/>',
  triangle: '<path d="M12 3.5l9 16H3z"/><path d="M12 10v4.5M12 17.2h.01"/>',
  coche: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  interdit: '<circle cx="12" cy="12" r="8.5"/><path d="M6 6l12 12"/>',
  ouvert: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 7.6-1.7"/><path d="M12 14.5v2.5"/>',
  cadenas: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.5"/>',
  retour: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  points: '<circle cx="5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="19" cy="12" r="1.2"/>',
};
const taille = Number(it.taille) || 14;
%><svg class="ic" width="<%= taille %>" height="<%= taille %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><%~ P[it.icone] || P.erreur %></svg>